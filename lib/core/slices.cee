// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// lib/core: methods of slices and vectors that take closures (type-system.md §36.4). Bundled with ceesafec and part of
// every package. `s.sortBy(cmp)` is `SliceAlgorithms<T>.sortBy(s, cmp)`, and so on; `v.retain(keep)` is
// `SliceAlgorithms<T>.retain` on the vector's elements, then `v.truncate` to the count it returns.

/// The two parts of a slice that `splitAt` divides (type-system.md §16.5): the elements before the split, and from it on.
public struct SliceHalves<region r, T> {
    public left: Slice<r, T>;
    public right: Slice<r, T>;
}

/// The two parts of a mutable slice that `splitAtMut` divides: disjoint, so both may be written at once.
public struct SliceHalvesMut<region r, T> {
    public left: SliceMut<r, T>;
    public right: SliceMut<r, T>;
}

/// Splitting a slice in two (type-system.md §16.5): `s.splitAt(mid)` is `SliceSplitting<T>.splitAt(s, mid)`. The
/// struct's region ties the halves to the slice they come from; it has no fields and is never made.
public struct SliceSplitting<region r, T> {
    /// The elements before `mid`, and from `mid` on; panics if `mid` is past the end.
    public fn splitAt(s: Slice<r, T>, mid: usize) -> SliceHalves<r, T> =>
        SliceHalves { left: s[..mid], right: s[mid..] };

    /// As splitAt, for a mutable slice: two mutable slices that do not overlap.
    /// Safety: slicing `s[mid..]` checks `mid` against the length (it panics past the end), so `[0, mid)` and
    /// `[mid, length)` are inside `s` and disjoint, and each is lent for as long as `s` is.
    public fn splitAtMut(s: SliceMut<r, T>, mid: usize) -> SliceHalvesMut<r, T> {
        let length = s.length;
        let tail = s[mid..].length;
        let start = s.ptr as *mut T;
        return SliceHalvesMut {
            left: unsafe { SliceMut.fromRaw(start, length - tail) },
            right: unsafe { SliceMut.fromRaw(start.add(length - tail), tail) },
        };
    }
}

/// The algorithms over a slice of `T`, as static functions: the struct has no fields and is never made.
public struct SliceAlgorithms<T> {
    /// Orders `s` so that `cmp` of each element and the next is at most zero, for a consistent `cmp`. Not stable.
    /// An introsort: quicksort with a median-of-three pivot, insertion sort for short runs, and heapsort past a
    /// depth of 2·log₂ n, so O(n log n) calls of `cmp` in the worst case. Allocates nothing; the recursion is on
    /// the shorter side, so the stack is O(log n). An inconsistent `cmp` leaves some permutation of `s`.
    @effectsOf(cmp)
    public fn sortBy(s: SliceMut<T>, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        var depth: u32 = 0;
        var n = s.length;
        while (n > 1) {
            depth += 2;
            n = n >> 1;
        }
        let length = s.length;
        SliceAlgorithms<T>.introsort(s, 0, length, depth, cmp);
    }

    /// Sorts `s[lo..hi]`, with `depth` partitions left before heapsort takes over.
    @effectsOf(cmp)
    fn introsort(s: SliceMut<T>, lo: usize, hi: usize, depth: u32, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        var low = lo;
        var high = hi;
        var left = depth;
        while (high - low > 16) {
            if (left == 0) {
                SliceAlgorithms<T>.heapsort(s, low, high, cmp);
                return;
            }
            left -= 1;
            let p = SliceAlgorithms<T>.partition(s, low, high, cmp);
            // Recurse into the shorter side and loop on the longer one: at most log₂ n frames.
            if (p - low < high - p) {
                SliceAlgorithms<T>.introsort(s, low, p, left, cmp);
                low = p + 1;
            } else {
                SliceAlgorithms<T>.introsort(s, p + 1, high, left, cmp);
                high = p;
            }
        }
        SliceAlgorithms<T>.insertion(s, low, high, cmp);
    }

    /// Partitions `s[lo..hi]` (at least 3 elements) around a median-of-three pivot; returns the pivot's index.
    /// Everything before it compares below the pivot, nothing after it does.
    @effectsOf(cmp)
    fn partition(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) -> usize {
        let last = hi - 1;
        let mid = lo + (hi - lo) / 2;
        // Order s[lo], s[mid], s[last]; the median goes to `last`, the pivot's place while partitioning.
        if (cmp(borrow s[mid], borrow s[lo]) < 0) { s.swap(mid, lo); }
        if (cmp(borrow s[last], borrow s[mid]) < 0) {
            s.swap(last, mid);
            if (cmp(borrow s[mid], borrow s[lo]) < 0) { s.swap(mid, lo); }
        }
        s.swap(mid, last);
        var store = lo;
        for (i in lo..last) {
            if (cmp(borrow s[i], borrow s[last]) < 0) {
                s.swap(i, store);
                store += 1;
            }
        }
        s.swap(store, last);
        return store;
    }

    /// Insertion sort of `s[lo..hi]`, by adjacent swaps.
    @effectsOf(cmp)
    fn insertion(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        for (i in lo + 1..hi) {
            var j = i;
            while (j > lo && cmp(borrow s[j], borrow s[j - 1]) < 0) {
                s.swap(j, j - 1);
                j -= 1;
            }
        }
    }

    /// Heapsort of `s[lo..hi]`: a max-heap, then the largest moved to the end, one at a time.
    @effectsOf(cmp)
    fn heapsort(s: SliceMut<T>, lo: usize, hi: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        let n = hi - lo;
        var start = n / 2;
        while (start > 0) {
            start -= 1;
            SliceAlgorithms<T>.siftDown(s, lo, start, n, cmp);
        }
        var end = n;
        while (end > 1) {
            end -= 1;
            s.swap(lo, lo + end);
            SliceAlgorithms<T>.siftDown(s, lo, 0, end, cmp);
        }
    }

    /// Restores the heap property below `root` in the heap `s[base..base + n]`.
    @effectsOf(cmp)
    fn siftDown(s: SliceMut<T>, base: usize, root: usize, n: usize, cmp: borrow mut fn(borrow T, borrow T) -> i32) {
        var parent = root;
        while (2 * parent + 1 < n) {
            var child = 2 * parent + 1;
            if (child + 1 < n && cmp(borrow s[base + child], borrow s[base + child + 1]) < 0) {
                child += 1;
            }
            if (cmp(borrow s[base + parent], borrow s[base + child]) >= 0) {
                return;
            }
            s.swap(base + parent, base + child);
            parent = child;
        }
    }

    /// Calls `visit` on each element, in index order.
    @effectsOf(visit)
    public fn forEach(s: Slice<T>, visit: borrow mut fn(borrow T)) {
        for (i in 0..s.length) { visit(borrow s[i]); }
    }

    /// Does `test` return true for some element? Stops at the first that does.
    @effectsOf(test)
    public fn any(s: Slice<T>, test: borrow mut fn(borrow T) -> bool) -> bool {
        for (i in 0..s.length) {
            if (test(borrow s[i])) { return true; }
        }
        return false;
    }

    /// Does `test` return true for every element? Stops at the first that does not.
    @effectsOf(test)
    public fn all(s: Slice<T>, test: borrow mut fn(borrow T) -> bool) -> bool {
        for (i in 0..s.length) {
            if (!test(borrow s[i])) { return false; }
        }
        return true;
    }

    /// Moves the elements for which `keep` returns true to the front, in order, calling it once on each element in
    /// index order; returns how many there are. `v.retain(keep)` then truncates the vector to that length.
    @effectsOf(keep)
    public fn retain(s: SliceMut<T>, keep: borrow mut fn(borrow T) -> bool) -> usize {
        var kept: usize = 0;
        for (i in 0..s.length) {
            if (keep(borrow s[i])) {
                s.swap(kept, i);
                kept += 1;
            }
        }
        return kept;
    }
}
