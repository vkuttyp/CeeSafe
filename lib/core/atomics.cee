// Atomics (type-system.md §38.3; ADR 0016, ADR 0021), in every profile since ADR 0026: their operations are the
// runtime header's static inline functions (ceesafe/rt.h), so they compile to the machine's atomic instructions and need
// no runtime of their own. Their unsafe code keeps ownership.md T1–T3.

extern "C" {
    @effects()
    fn ceesafe_atomic_load_u64(p: *mut u64) -> u64;
    @effects()
    fn ceesafe_atomic_store_u64(p: *mut u64, v: u64);
    @effects()
    fn ceesafe_atomic_swap_u64(p: *mut u64, v: u64) -> u64;
    @effects()
    fn ceesafe_atomic_cas_u64(p: *mut u64, expected: u64, desired: u64) -> u64;
    @effects()
    fn ceesafe_atomic_add_u64(p: *mut u64, v: u64) -> u64;
    @effects()
    fn ceesafe_atomic_load_u32(p: *mut u32) -> u32;
    @effects()
    fn ceesafe_atomic_store_u32(p: *mut u32, v: u32);
    @effects()
    fn ceesafe_atomic_swap_u32(p: *mut u32, v: u32) -> u32;
    @effects()
    fn ceesafe_atomic_cas_u32(p: *mut u32, expected: u32, desired: u32) -> u32;
    @effects()
    fn ceesafe_atomic_add_u32(p: *mut u32, v: u32) -> u32;
    @effects()
    fn ceesafe_atomic_load_ord_u64(p: *mut u64, order: i32) -> u64;
    @effects()
    fn ceesafe_atomic_store_ord_u64(p: *mut u64, v: u64, order: i32);
    @effects()
    fn ceesafe_atomic_swap_ord_u64(p: *mut u64, v: u64, order: i32) -> u64;
    @effects()
    fn ceesafe_atomic_cas_ord_u64(p: *mut u64, expected: u64, desired: u64, order: i32) -> u64;
    @effects()
    fn ceesafe_atomic_add_ord_u64(p: *mut u64, v: u64, order: i32) -> u64;
    @effects()
    fn ceesafe_atomic_load_ord_u32(p: *mut u32, order: i32) -> u32;
    @effects()
    fn ceesafe_atomic_store_ord_u32(p: *mut u32, v: u32, order: i32);
    @effects()
    fn ceesafe_atomic_swap_ord_u32(p: *mut u32, v: u32, order: i32) -> u32;
    @effects()
    fn ceesafe_atomic_cas_ord_u32(p: *mut u32, expected: u32, desired: u32, order: i32) -> u32;
    @effects()
    fn ceesafe_atomic_add_ord_u32(p: *mut u32, v: u32, order: i32) -> u32;
}

/// The ordering of an atomic load (ADR 0021): C11's memory_order_relaxed, _acquire and _seq_cst.
public enum LoadOrdering { Relaxed, Acquire, SequentiallyConsistent }

/// The ordering of an atomic store: C11's memory_order_relaxed, _release and _seq_cst.
public enum StoreOrdering { Relaxed, Release, SequentiallyConsistent }

/// The ordering of an atomic read-modify-write (swap, compare-exchange, add, subtract): C11's memory_order_relaxed,
/// _acquire, _release, _acq_rel and _seq_cst. A compare-exchange that fails orders as a load: AcquireRelease as
/// Acquire, Release as Relaxed, the others as themselves.
public enum Ordering { Relaxed, Acquire, Release, AcquireRelease, SequentiallyConsistent }

// The runtime's codes (ceesafe/rt.h): 0 relaxed, 1 acquire, 2 release, 3 acquire-release, 4 sequentially
// consistent. A load never passes 2 or 3, and a store never 1 or 3, so no ordering C11 leaves undefined is used.
fn loadCode(order: LoadOrdering) -> i32 => match (order) {
    LoadOrdering.Relaxed => 0,
    LoadOrdering.Acquire => 1,
    LoadOrdering.SequentiallyConsistent => 4,
};

fn storeCode(order: StoreOrdering) -> i32 => match (order) {
    StoreOrdering.Relaxed => 0,
    StoreOrdering.Release => 2,
    StoreOrdering.SequentiallyConsistent => 4,
};

fn code(order: Ordering) -> i32 => match (order) {
    Ordering.Relaxed => 0,
    Ordering.Acquire => 1,
    Ordering.Release => 2,
    Ordering.AcquireRelease => 3,
    Ordering.SequentiallyConsistent => 4,
};

/// A u64 that threads may read and change at once: every operation is atomic and sequentially consistent.
@threadSafe
@noncopy
public struct AtomicU64 {
    private value: u64;

    /// A new atomic holding `value`.
    public fn create(value: u64) -> AtomicU64 => AtomicU64 { value: value };

    /// The same as create, in a static's initialiser (type-system.md §39.4): `static N: AtomicU64 = AtomicU64.constant(0);`.
    @constant
    public fn constant(value: u64) -> AtomicU64 => AtomicU64 { value: value };

    /// Safety: the runtime accesses `value` only atomically, and safe code reaches it only through these methods.
    public fn load(borrow this) -> u64 => unsafe { ceesafe_atomic_load_u64(this.cell()) };

    /// Safety: as load.
    public fn store(borrow this, value: u64) { unsafe { ceesafe_atomic_store_u64(this.cell(), value); } }

    /// Safety: as load.
    public fn swap(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_swap_u64(this.cell(), value) };

    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).
    /// Safety: as load.
    public fn compareExchange(borrow this, expected: u64, desired: u64) -> Result<u64, u64> {
        let old = unsafe { ceesafe_atomic_cas_u64(this.cell(), expected, desired) };
        if (old == expected) {
            return Ok(old);
        }
        return Err(old);
    }

    /// Adds, wrapping; returns the old value.
    /// Safety: as load.
    public fn fetchAdd(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_add_u64(this.cell(), value) };

    /// Subtracts, wrapping; returns the old value.
    /// Safety: as load.
    public fn fetchSub(borrow this, value: u64) -> u64 =>
        unsafe { ceesafe_atomic_add_u64(this.cell(), 0u64.wrappingSub(value)) };

    /// load, with an ordering (ADR 0021).
    /// Safety: as load.
    public fn loadWith(borrow this, order: LoadOrdering) -> u64 =>
        unsafe { ceesafe_atomic_load_ord_u64(this.cell(), loadCode(order)) };

    /// store, with an ordering.
    /// Safety: as load.
    public fn storeWith(borrow this, value: u64, order: StoreOrdering) {
        unsafe { ceesafe_atomic_store_ord_u64(this.cell(), value, storeCode(order)); }
    }

    /// swap, with an ordering.
    /// Safety: as load.
    public fn swapWith(borrow this, value: u64, order: Ordering) -> u64 =>
        unsafe { ceesafe_atomic_swap_ord_u64(this.cell(), value, code(order)) };

    /// compareExchange, with an ordering; a failure orders as Ordering says.
    /// Safety: as load.
    public fn compareExchangeWith(borrow this, expected: u64, desired: u64, order: Ordering) -> Result<u64, u64> {
        let old = unsafe { ceesafe_atomic_cas_ord_u64(this.cell(), expected, desired, code(order)) };
        if (old == expected) {
            return Ok(old);
        }
        return Err(old);
    }

    /// fetchAdd, with an ordering.
    /// Safety: as load.
    public fn fetchAddWith(borrow this, value: u64, order: Ordering) -> u64 =>
        unsafe { ceesafe_atomic_add_ord_u64(this.cell(), value, code(order)) };

    /// fetchSub, with an ordering.
    /// Safety: as load.
    public fn fetchSubWith(borrow this, value: u64, order: Ordering) -> u64 =>
        unsafe { ceesafe_atomic_add_ord_u64(this.cell(), 0u64.wrappingSub(value), code(order)) };

    fn cell(borrow this) -> *mut u64 => borrow this.value as *u64 as *mut u64;
}

/// A u32 that threads may read and change at once, as AtomicU64.
@threadSafe
@noncopy
public struct AtomicU32 {
    private value: u32;

    /// A new atomic holding `value`.
    public fn create(value: u32) -> AtomicU32 => AtomicU32 { value: value };

    /// The same as create, in a static's initialiser (type-system.md §39.4): `static N: AtomicU32 = AtomicU32.constant(0);`.
    @constant
    public fn constant(value: u32) -> AtomicU32 => AtomicU32 { value: value };

    /// Safety: as AtomicU64.load.
    public fn load(borrow this) -> u32 => unsafe { ceesafe_atomic_load_u32(this.cell()) };

    /// Safety: as AtomicU64.load.
    public fn store(borrow this, value: u32) { unsafe { ceesafe_atomic_store_u32(this.cell(), value); } }

    /// Safety: as AtomicU64.load.
    public fn swap(borrow this, value: u32) -> u32 => unsafe { ceesafe_atomic_swap_u32(this.cell(), value) };

    /// Safety: as AtomicU64.load.
    public fn compareExchange(borrow this, expected: u32, desired: u32) -> Result<u32, u32> {
        let old = unsafe { ceesafe_atomic_cas_u32(this.cell(), expected, desired) };
        if (old == expected) {
            return Ok(old);
        }
        return Err(old);
    }

    /// Safety: as AtomicU64.load.
    public fn fetchAdd(borrow this, value: u32) -> u32 => unsafe { ceesafe_atomic_add_u32(this.cell(), value) };

    /// Safety: as AtomicU64.load.
    public fn fetchSub(borrow this, value: u32) -> u32 =>
        unsafe { ceesafe_atomic_add_u32(this.cell(), 0u32.wrappingSub(value)) };

    /// load, with an ordering (ADR 0021).
    /// Safety: as load.
    public fn loadWith(borrow this, order: LoadOrdering) -> u32 =>
        unsafe { ceesafe_atomic_load_ord_u32(this.cell(), loadCode(order)) };

    /// store, with an ordering.
    /// Safety: as load.
    public fn storeWith(borrow this, value: u32, order: StoreOrdering) {
        unsafe { ceesafe_atomic_store_ord_u32(this.cell(), value, storeCode(order)); }
    }

    /// swap, with an ordering.
    /// Safety: as load.
    public fn swapWith(borrow this, value: u32, order: Ordering) -> u32 =>
        unsafe { ceesafe_atomic_swap_ord_u32(this.cell(), value, code(order)) };

    /// compareExchange, with an ordering; a failure orders as Ordering says.
    /// Safety: as load.
    public fn compareExchangeWith(borrow this, expected: u32, desired: u32, order: Ordering) -> Result<u32, u32> {
        let old = unsafe { ceesafe_atomic_cas_ord_u32(this.cell(), expected, desired, code(order)) };
        if (old == expected) {
            return Ok(old);
        }
        return Err(old);
    }

    /// fetchAdd, with an ordering.
    /// Safety: as load.
    public fn fetchAddWith(borrow this, value: u32, order: Ordering) -> u32 =>
        unsafe { ceesafe_atomic_add_ord_u32(this.cell(), value, code(order)) };

    /// fetchSub, with an ordering.
    /// Safety: as load.
    public fn fetchSubWith(borrow this, value: u32, order: Ordering) -> u32 =>
        unsafe { ceesafe_atomic_add_ord_u32(this.cell(), 0u32.wrappingSub(value), code(order)) };

    fn cell(borrow this) -> *mut u32 => borrow this.value as *u32 as *mut u32;
}

/// A usize that threads may read and change at once, as AtomicU64 (usize is 64 bits on every target, §29.3).
@threadSafe
@noncopy
public struct AtomicUSize {
    private inner: AtomicU64;

    /// A new atomic holding `value`.
    public fn create(value: usize) -> AtomicUSize => AtomicUSize { inner: AtomicU64.create(value as u64) };

    /// The same as create, in a static's initialiser (type-system.md §39.4).
    @constant
    public fn constant(value: usize) -> AtomicUSize => AtomicUSize { inner: AtomicU64.constant(value as u64) };

    /// The value, sequentially consistent.
    public fn load(borrow this) -> usize => truncate<usize>(this.inner.load());

    /// Stores `value`, sequentially consistent.
    public fn store(borrow this, value: usize) { this.inner.store(value as u64); }

    /// Stores `value` and returns the old value, sequentially consistent.
    public fn swap(borrow this, value: usize) -> usize => truncate<usize>(this.inner.swap(value as u64));

    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).
    public fn compareExchange(borrow this, expected: usize, desired: usize) -> Result<usize, usize> {
        match (this.inner.compareExchange(expected as u64, desired as u64)) {
            Ok(old) => { return Ok(truncate<usize>(old)); }
            Err(old) => { return Err(truncate<usize>(old)); }
        }
    }

    /// Adds, wrapping; returns the old value.
    public fn fetchAdd(borrow this, value: usize) -> usize => truncate<usize>(this.inner.fetchAdd(value as u64));

    /// Subtracts, wrapping; returns the old value.
    public fn fetchSub(borrow this, value: usize) -> usize => truncate<usize>(this.inner.fetchSub(value as u64));

    /// As load, with `order`.
    public fn loadWith(borrow this, order: LoadOrdering) -> usize => truncate<usize>(this.inner.loadWith(order));

    /// As store, with `order`.
    public fn storeWith(borrow this, value: usize, order: StoreOrdering) { this.inner.storeWith(value as u64, order); }

    /// As swap, with `order`.
    public fn swapWith(borrow this, value: usize, order: Ordering) -> usize =>
        truncate<usize>(this.inner.swapWith(value as u64, order));

    /// As compareExchange, with `order` (a failure orders as a load, §38.3).
    public fn compareExchangeWith(
        borrow this,
        expected: usize,
        desired: usize,
        order: Ordering,
    ) -> Result<usize, usize> {
        match (this.inner.compareExchangeWith(expected as u64, desired as u64, order)) {
            Ok(old) => { return Ok(truncate<usize>(old)); }
            Err(old) => { return Err(truncate<usize>(old)); }
        }
    }

    /// As fetchAdd, with `order`.
    public fn fetchAddWith(borrow this, value: usize, order: Ordering) -> usize =>
        truncate<usize>(this.inner.fetchAddWith(value as u64, order));

    /// As fetchSub, with `order`.
    public fn fetchSubWith(borrow this, value: usize, order: Ordering) -> usize =>
        truncate<usize>(this.inner.fetchSubWith(value as u64, order));
}

/// A bool that threads may read and change at once.
@threadSafe
@noncopy
public struct AtomicBool {
    private inner: AtomicU32;

    /// A new atomic holding `value`.
    public fn create(value: bool) -> AtomicBool => AtomicBool { inner: AtomicU32.create(if (value) 1 else 0) };

    /// The same as create, in a static's initialiser (type-system.md §39.4).
    @constant
    public fn constant(value: bool) -> AtomicBool => AtomicBool { inner: AtomicU32.constant(value as u32) };

    /// The value, sequentially consistent.
    public fn load(borrow this) -> bool => this.inner.load() != 0;

    /// Stores `value`, sequentially consistent.
    public fn store(borrow this, value: bool) { this.inner.store(if (value) 1 else 0); }

    /// Stores `value` and returns the old value, sequentially consistent.
    public fn swap(borrow this, value: bool) -> bool => this.inner.swap(if (value) 1 else 0) != 0;

    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).
    public fn compareExchange(borrow this, expected: bool, desired: bool) -> Result<bool, bool> {
        match (this.inner.compareExchange(if (expected) 1 else 0, if (desired) 1 else 0)) {
            Ok(old) => { return Ok(old != 0); }
            Err(old) => { return Err(old != 0); }
        }
    }

    /// As load, with `order`.
    public fn loadWith(borrow this, order: LoadOrdering) -> bool => this.inner.loadWith(order) != 0;

    /// As store, with `order`.
    public fn storeWith(borrow this, value: bool, order: StoreOrdering) {
        this.inner.storeWith(if (value) 1 else 0, order);
    }

    /// As swap, with `order`.
    public fn swapWith(borrow this, value: bool, order: Ordering) -> bool =>
        this.inner.swapWith(if (value) 1 else 0, order) != 0;

    /// As compareExchange, with `order` (a failure orders as a load, §38.3).
    public fn compareExchangeWith(borrow this, expected: bool, desired: bool, order: Ordering) -> Result<bool, bool> {
        match (this.inner.compareExchangeWith(if (expected) 1 else 0, if (desired) 1 else 0, order)) {
            Ok(old) => { return Ok(old != 0); }
            Err(old) => { return Err(old != 0); }
        }
    }
}
