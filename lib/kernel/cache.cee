// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Typed object caches over CosmoOS's slab caches (ADR 0027; kernel/include/kernel/kmalloc.h:47-53). A cache is a
// static, set up once at start-up, as CosmoOS makes its own (kernel-services/network/mbuf.c); it is never destroyed,
// so its boxes cannot outlive it.

@header("kernel/kmalloc.h")
extern "C" {
    struct kmem_cache;
    // kmem_cache_create allocates its first slab's bookkeeping; like kmalloc it does not sleep (kmalloc.h).
    @effects(alloc)
    fn kmem_cache_create(name: *CChar, objectSize: usize, align: usize) -> *mut kmem_cache;
    @effects()
    fn kmem_cache_destroy(cache: *mut kmem_cache);
    @effects(alloc)
    fn kmem_cache_alloc(cache: *mut kmem_cache, flags: u32) -> *mut void;
    @effects()
    fn kmem_cache_free(cache: *mut kmem_cache, object: *mut void);
}

/// A slab cache of `T`s: `static CONNS: ObjectCache<Conn> = ObjectCache<Conn>.constant();`, then
/// `CONNS.setUp("conn\0".ptr as *CChar)` once at start-up, then `CONNS.alloc(value)`. In v1 `T` holds no C state: a
/// cache box moves its value out to drop it, and C state never moves (type-system.md §27.3).
@threadSafe
@noncopy
public struct ObjectCache<T: Send> {
    /// The kmem_cache's address, 0 until setUp; written once, then only read.
    private cache: AtomicUSize;

    /// An empty cache for a static (type-system.md §39).
    @constant
    public fn constant() -> ObjectCache<T> => ObjectCache { cache: AtomicUSize.constant(0) };

    /// Makes the slab cache, sized and aligned for `T`. `name` is a static string ending in a zero byte, which the cache
    /// keeps. A second call keeps the first cache and returns Ok.
    /// Safety: kmem_cache_create copies nothing and keeps `name`, which the caller keeps alive (a static string), and
    /// its alignment (KMALLOC_MIN_ALIGN for 0) meets `T`'s;
    /// a cache made by a racing call that lost is destroyed at once, before any object was allocated from it.
    public fn setUp(borrow this, name: *CChar) -> Result<void, AllocError> {
        if (this.cache.loadWith(LoadOrdering.Acquire) != 0) {
            return Ok();
        }
        let layout = layoutOf<T>();
        // CosmoOS refuses an alignment below KMALLOC_MIN_ALIGN (16), and 0 asks for it (slab.c cache_setup): its
        // objects are then 16-byte aligned, which meets any smaller alignment.
        let align = if (layout.align <= 16) 0 else layout.align;
        let made = unsafe { kmem_cache_create(name, layout.size, align) };
        if (made.isNull()) {
            return Err(AllocError.OutOfMemory);
        }
        match (this.cache.compareExchangeWith(0, made as usize, Ordering.AcquireRelease)) {
            Ok(previous) => {}
            Err(other) => {
                unsafe { kmem_cache_destroy(made); }
            }
        }
        return Ok();
    }

    /// `value` in an object from this cache, or Err (and `value` dropped) if setUp has not run or the cache is out of
    /// memory.
    /// Safety: kmem_cache_alloc returns NULL or an unused object of the cache's size and alignment, which are `T`'s, so
    /// the write is to valid, unshared storage; the box owns it from then on.
    public fn alloc(borrow this, value: T) -> Result<CacheBox<T>, AllocError> {
        let cache = this.cache.loadWith(LoadOrdering.Acquire) as *mut kmem_cache;
        if (cache.isNull()) {
            return Err(AllocError.OutOfMemory);
        }
        let object = unsafe { kmem_cache_alloc(cache, 0) } as *mut T;
        if (object.isNull()) {
            return Err(AllocError.OutOfMemory);
        }
        unsafe { object.write(value); }
        return Ok(CacheBox { object: object, cache: cache });
    }
}

/// A `T` in an object from an ObjectCache: the box owns it, and dropping the box drops the value and returns the
/// object to its cache. Two pointers; not `Send` in v1, like a KernelHeap box (type-system.md §38.1).
@noncopy
public struct CacheBox<T: Send> {
    private object: *mut T;
    private cache: *mut kmem_cache;

    /// The value.
    /// Safety: `object` holds the box's `T` until the box's drop, and the reference is tied to the box (§13.5).
    public fn get(borrow this) -> borrow T => unsafe { Ptr.toBorrow(this.object as *T) };

    /// The value, for changing it.
    /// Safety: as get; the box is borrowed mutably, so this is the only reference.
    public fn getMut(borrow mut this) -> borrow mut T => unsafe { Ptr.toBorrowMut(this.object) };

    /// Safety: `object` holds a `T` written by alloc and read out only here, once; the object goes back to the cache
    /// it came from, which is never destroyed (setUp's caches live as long as the kernel).
    drop {
        let value = unsafe { this.object.read() };
        unsafe { kmem_cache_free(this.cache, this.object as *mut void); }
    }
}
