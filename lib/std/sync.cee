// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Shared state between threads (type-system.md §38.3, ADR 0016): Arc and Mutex, over the hosted runtime
// (runtime/hosted/ceesafe_rt_thread.c). Their unsafe code keeps ownership.md T1–T3. The atomics are in lib/core (ADR 0026).

extern "C" {
    @effects(alloc)
    fn ceesafe_mutex_create() -> *mut void;
    @effects(sleep)
    fn ceesafe_mutex_lock(m: *mut void);
    @effects()
    fn ceesafe_mutex_unlock(m: *mut void);
    @effects()
    fn ceesafe_mutex_destroy(m: *mut void);
}

/// Mutual exclusion: the data is reached only through a guard, which one thread holds at a time.
@threadSafe
@noncopy
public struct Mutex<T: Send> {
    private raw: *mut void;
    private data: T;

    /// A mutex holding `data`; its platform lock is allocated.
    /// Safety: a null lock is reported, never stored.
    public fn create(data: T) -> Result<Mutex<T>, AllocError> {
        let raw = unsafe { ceesafe_mutex_create() };
        if (raw.isNull()) {
            return Err(AllocError.OutOfMemory);
        }
        return Ok(Mutex { raw: raw, data: data });
    }

    /// Waits for the lock; the guard lends the data until it is dropped.
    /// Safety: `raw` is the lock made in create, destroyed only in drop, when no guard can be live (B-rules).
    public fn lock(borrow this) -> MutexGuard<T> {
        unsafe { ceesafe_mutex_lock(this.raw); }
        return MutexGuard { lock: this };
    }

    /// Safety: no guard is live once the mutex can be dropped, so the lock is free.
    drop {
        unsafe { ceesafe_mutex_destroy(this.raw); }
    }
}

/// Holding a Mutex: `data()` lends the protected value; dropping the guard unlocks.
public struct MutexGuard<region r, T: Send> {
    private lock: borrow(r) Mutex<T>;

    /// Safety: the guard holds the lock, so no other thread reaches the data, and the loan ends before the guard's drop.
    public fn data(borrow mut this) -> borrow mut T =>
        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };

    /// Safety: the guard took the lock in Mutex.lock and releases it once.
    drop {
        unsafe { ceesafe_mutex_unlock(this.lock.raw); }
    }
}

struct ArcInner<T> {
    count: AtomicU64;
    value: T;
}

/// Shared ownership across threads: each clone is an owner, and the last owner's drop destroys the value.
@threadSafe
@noncopy
public struct Arc<T: Share> {
    private inner: *mut ArcInner<T>;

    /// Safety: the pointer comes from Box.intoRaw and is given back once, by the last owner's drop.
    public fn create(value: T) -> Result<Arc<T>, AllocError> {
        let boxed = Box.create(ArcInner { count: AtomicU64.create(1), value: value })?;
        return Ok(Arc { inner: Box.intoRaw(boxed) });
    }

    /// Another owner of the same value.
    /// Safety: this owner keeps the value alive while the count is raised.
    public fn clone(borrow this) -> Arc<T> {
        this.shared().count.fetchAdd(1);
        return Arc { inner: this.inner };
    }

    /// The shared value, for as long as this owner is borrowed.
    /// Safety: the value lives while any owner does; T is Share, so shared references to it may cross threads.
    public fn get(borrow this) -> borrow T => borrow this.shared().value;

    /// Safety: as get.
    fn shared(borrow this) -> borrow ArcInner<T> => unsafe { Ptr.toBorrow(this.inner as *ArcInner<T>) };

    /// Safety: only the owner that brings the count from one to zero gives the box back.
    drop {
        if (this.shared().count.fetchSub(1) == 1) {
            let last: Box<ArcInner<T>> = unsafe { Box.fromRaw(this.inner) };
        }
    }
}

/// Why Thread.spawn failed: the thread, its record or its closure could not be allocated (type-system.md §38.2).
public enum SpawnError {
    Resources,
}
