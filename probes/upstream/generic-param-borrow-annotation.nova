// Upstream imprecision (novac 0.3.1): a method declared `-> borrow(this) T?` whose other reference parameter has a
// type-parameter type (`key: borrow K`) is treated as if its result also borrowed `key`, so a temporary argument
// is rejected with N0243. With a concrete key type (`key: borrow Key`) the same program is accepted. Expected:
// accepted, since the result borrows only `this`. Workaround: bind the key to a local. Found by P1, 2026-10-30.
struct Key {
    v: u64;
}

struct Table<T, K> {
    values: Vector<T>;

    fn get(borrow this, key: borrow K) -> borrow(this) T? {
        if (this.values.length == 0) {
            return null;
        }
        return borrow this.values[0];
    }
}

fn main() {
    var t = Table<u64, Key> { values: Vector<u64>.create() };
    t.values.push(7)!;
    let found = t.get(Key { v: 0 });
    Console.writeLine(found!);
}
