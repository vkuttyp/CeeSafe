// Upstream bug (novac 0.3.1 and 07d561f, native and --interp alike): a temporary that needs drop, created in the
// condition of an `if` or `while`, is not destroyed: "drop 1" is never printed, and the `while` condition makes
// two `make(4)` temporaries but destroys one. `let` and `match` destroy theirs. lifetimes.md: a temporary lives until
// the end of the source statement that created it. Expected output: one "drop 1" (after the condition or the `if`),
// "drop 2", "drop 3" and two "drop 4". Actual: if body / drop 2 / match arm / drop 3 / drop 4 / end. Found by the
// P1 gate (LeakSanitizer on Linux), 2026-10-30. Workaround: bind the value to a local before the condition.
struct Noisy {
    id: u32;

    fn same(borrow this, other: u32) -> bool => this.id == other;

    drop {
        Console.write("drop ");
        Console.writeLine(this.id);
    }
}

fn make(id: u32) -> Noisy => Noisy { id: id };

fn main() {
    if (make(1).same(1)) {
        Console.writeLine("if body");
    }
    let b = make(2).same(2);
    match (make(3).same(3)) {
        true => { Console.writeLine("match arm"); }
        false => {}
    }
    var i = 0;
    while (make(4).same(4) && i < 1) {
        i += 1;
    }
    Console.writeLine("end");
}
