// Filed as https://github.com/vkuttyp/Nova/issues/2 (2026-10-30).
// Upstream bug (novac 0.3.1 and 07d561f): a generic match that rebuilds `Ok(v)` from a `Result<T, E>` crashes the
// compiler when instantiated with T = void: "System.InvalidOperationException: cannot lower HirError; the program has
// errors" (NirBuilder.LowerRvalueCore), with no diagnostic. Expected: accepted (or a diagnostic). Found by P1, 2026-10-30.
fn same<T>(r: Result<T, u8>) -> Result<T, u8> => match (r) {
    Ok(v) => Ok(v),
    Err(e) => Err(e),
};

fn main() {
    let a: Result<void, u8> = Ok();
    let r = same(a);
}
