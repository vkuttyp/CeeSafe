// P1 probe: generic interface implementations and `Self` do not parse yet (type-system §21.1 lists both as future
// work; ROADMAP N3). A key type with type parameters needs one `impl` per instantiation, and an interface names its
// implementing type through a type parameter instead (`interface Key<T>`, bound as `K: Key<K>`; see
// probes/run-pass/generic-map.nova).

interface Key<T> {
    fn same(borrow this, other: borrow T) -> bool;
}

struct Wrap<T> {
    v: u32;
}

impl<T> Key<Wrap<T>> for Wrap<T> { // error[N0105]
    fn same(borrow this, other: borrow Wrap<T>) -> bool => this.v == other.v;
}

interface Hashable {
    fn same(borrow this, other: borrow Self) -> bool; // error[N0105]
}

fn main() {}
