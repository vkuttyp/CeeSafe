// P1 probe: the text operations a compiler could use that Nova does not have (type-system §22.2, §23.2; ROADMAP N1c,
// N1d). Bytes become text with `StringView.fromUtf8` since novac 0.4.0 (N1a), then `String.append`; the rest are
// byte-wise functions in src/support/bytes.nova or `match` tables.

fn main() {
    var bytes = Vector<u8>.create();
    bytes.push('a')!;
    var s = String.create();
    // No appendBytes: bytes go through StringView.fromUtf8 and append, which checks them.
    s.appendBytes(bytes.view())!; // error[N0200]
    // No copy of a `String`; copy the bytes into a new one.
    let copy = s.clone(); // error[N0200]
    // No ordering of text: sorting names for deterministic output needs a byte-wise compare function.
    let less = "a" < "b"; // error[N0207]
    // No number parsing: literals are decoded by hand (and exactly, ROADMAP §3.2).
    let n = "42".parse(); // error[N0200]
    // No searching.
    let i = "abc".find("b"); // error[N0200]
    // Arrays and slices cannot hold views, so keyword and operator tables are matches.
    let names = ["a", "b"]; // error[N0246]
}
