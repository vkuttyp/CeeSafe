// P1 probe: `?` across error types is rejected, since Nova has no `From` conversion (type-system §17.4). The
// accepted form lifts the error with a generic function (probes/run-pass/error-layers.nova).

enum CompileError {
    Read(IoError),
}

fn open(path: StringView) -> Result<File, CompileError> {
    let file = File.open(path)?; // error[N0261]
    return Ok(file);
}

fn main() {}
