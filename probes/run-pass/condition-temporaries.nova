// Regression probe for Nova #1 (fixed in novac 0.4.0, M15 S2): a temporary that needs drop, made in an `if` or
// `while` condition, is destroyed once the condition is evaluated, on every evaluation. Run with --check-leaks.
// expect-stdout: drop 1
// expect-stdout: if body
// expect-stdout: drop 2
// expect-stdout: match arm
// expect-stdout: drop 3
// expect-stdout: drop 4
// expect-stdout: drop 4
// expect-stdout: end

struct Noisy {
    id: u32;

    fn same(borrow this, other: u32) -> bool => this.id == other;

    drop {
        Console.write("drop ");
        Console.writeLine(this.id);
    }
}

fn make(id: u32) -> Noisy => Noisy { id: id };

fn main() {
    if (make(1).same(1)) {
        Console.writeLine("if body");
    }
    let b = make(2).same(2);
    match (make(3).same(3)) {
        true => { Console.writeLine("match arm"); }
        false => {}
    }
    var i = 0;
    while (make(4).same(4) && i < 1) {
        i += 1;
    }
    Console.writeLine("end");
}
