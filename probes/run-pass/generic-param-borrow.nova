// Regression probe for Nova #5 (fixed in novac 0.4.0, M15 S5): a result declared `borrow(this)` borrows only `this`
// when another parameter has a type-parameter type, so the key may be a temporary (src/support/map.nova's `get`).
// expect-stdout: 7

struct Key {
    v: u64;
}

struct Table<T, K> {
    values: Vector<T>;

    fn get(borrow this, key: borrow K) -> borrow(this) T? {
        if (this.values.length == 0) {
            return null;
        }
        return borrow this.values[0];
    }
}

fn main() {
    var t = Table<u64, Key> { values: Vector<u64>.create() };
    t.values.push(7)!;
    let found = t.get(Key { v: 0 });
    Console.writeLine(found!);
}
