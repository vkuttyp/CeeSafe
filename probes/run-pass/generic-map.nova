// P1 probe: a generic hash map written in Nova, as the compiler's symbol tables need (Nova has none built in;
// ROADMAP §2.2). Entries are kept in insertion order, so iteration is deterministic whatever the hashes are; an
// open-addressing index of entry numbers finds them. Keys implement an interface bound on the key type itself
// (`K: Key<K>`), since Nova has no `Self` (type-system §21.1).
// expect-stdout: words 5, slots 8
// expect-stdout: the 3
// expect-stdout: cat 2
// expect-stdout: sat 1
// expect-stdout: on 1
// expect-stdout: mat 1
// expect-stdout: cat? 2, dog? absent
// expect-stdout: numbers 1000, sum of values 499500, slots 2048
// expect-stdout: 777 -> 777

interface Key<T> {
    fn hashCode(borrow this) -> u64;
    fn sameAs(borrow this, other: borrow T) -> bool;
}

struct Map<K: Key<K>, V> {
    keys: Vector<K>;
    values: Vector<V>;
    slots: Vector<u32>; // 0: empty; otherwise the entry's index plus one. The length is 0 or a power of two.

    fn create() -> Map<K, V> =>
        Map { keys: Vector<K>.create(), values: Vector<V>.create(), slots: Vector<u32>.create() };

    fn count(borrow this) -> usize => this.keys.length;

    fn find(borrow this, key: borrow K) -> usize? {
        if (this.slots.length == 0) {
            return null;
        }
        let mask = this.slots.length - 1;
        var i = truncate<usize>(key.hashCode()) & mask;
        loop {
            let slot = this.slots[i];
            if (slot == 0) {
                return null;
            }
            let entry = (slot - 1) as usize;
            if (this.keys[entry].sameAs(key)) {
                return entry;
            }
            i = (i + 1) & mask;
        }
    }

    fn get(borrow this, key: borrow K) -> borrow(this) V? {
        let entry = this.find(key)?;
        return borrow this.values[entry];
    }

    // Adds or replaces; true if the key is new.
    fn put(borrow mut this, key: K, value: V) -> Result<bool, AllocError> {
        match (this.find(key)) {
            Some(entry) => {
                this.values[entry] = value;
                return Ok(false);
            }
            null => {}
        }
        if ((this.keys.length + 1) * 4 > this.slots.length * 3) {
            this.grow()?;
        }
        this.place(this.keys.length, key.hashCode());
        this.keys.push(key)?;
        this.values.push(value)?;
        return Ok(true);
    }

    fn place(borrow mut this, entry: usize, hash: u64) {
        let mask = this.slots.length - 1;
        var i = truncate<usize>(hash) & mask;
        while (this.slots[i] != 0) {
            i = (i + 1) & mask;
        }
        this.slots[i] = truncate<u32>(entry + 1);
    }

    fn grow(borrow mut this) -> Result<void, AllocError> {
        var size: usize = if (this.slots.length == 0) 8 else this.slots.length * 2;
        this.slots.clear();
        for (i in 0..size) {
            this.slots.push(0)?;
        }
        for (entry in 0..this.keys.length) {
            let hash = this.keys[entry].hashCode();
            this.place(entry, hash);
        }
        return Ok();
    }
}

// FNV-1a over bytes.
fn hashBytes(bytes: Slice<u8>) -> u64 {
    var h: u64 = 0xcbf29ce484222325;
    for (b in bytes) {
        h = (h ^ b as u64).wrappingMul(0x100000001b3);
    }
    return h;
}

struct Text {
    bytes: Vector<u8>;

    fn from(text: StringView) -> Result<Text, AllocError> {
        var bytes = Vector<u8>.create();
        for (b in text.bytes()) {
            bytes.push(b)?;
        }
        return Ok(Text { bytes: bytes });
    }
}

impl Key<Text> for Text {
    fn hashCode(borrow this) -> u64 => hashBytes(this.bytes.view());

    fn sameAs(borrow this, other: borrow Text) -> bool {
        if (this.bytes.length != other.bytes.length) {
            return false;
        }
        for (i in 0..this.bytes.length) {
            if (this.bytes[i] != other.bytes[i]) {
                return false;
            }
        }
        return true;
    }
}

struct Number {
    value: u64;
}

impl Key<Number> for Number {
    fn hashCode(borrow this) -> u64 => (this.value ^ (this.value >> 29)).wrappingMul(0xbf58476d1ce4e5b9);
    fn sameAs(borrow this, other: borrow Number) -> bool => this.value == other.value;
}

fn countWords(text: StringView) -> Result<Map<Text, u32>, AllocError> {
    var counts = Map<Text, u32>.create();
    var start: usize = 0;
    for (i in 0..(text.length + 1)) {
        if (i == text.length || text[i] == ' ') {
            if (i > start) {
                let word = Text.from(text[start..i])?;
                let previous: u32 = match (counts.get(word)) {
                    Some(n) => n,
                    null => 0,
                };
                counts.put(word, previous + 1)?;
            }
            start = i + 1;
        }
    }
    return Ok(counts);
}

fn main() {
    let counts = countWords("the cat sat on the mat the cat")!;
    Console.write("words ");
    Console.write(counts.count());
    Console.write(", slots ");
    Console.writeLine(counts.slots.length);
    for (i in 0..counts.count()) {
        Console.writeBytes(counts.keys[i].bytes.view());
        Console.write(" ");
        Console.writeLine(counts.values[i]);
    }
    Console.write("cat? ");
    match (counts.get(Text.from("cat")!)) {
        Some(n) => { Console.write(n); }
        null => { Console.write("absent"); }
    }
    Console.write(", dog? ");
    match (counts.get(Text.from("dog")!)) {
        Some(n) => { Console.write(n); }
        null => { Console.write("absent"); }
    }
    Console.writeLine("");

    var numbers = Map<Number, u64>.create();
    for (i in 0..1000u64) {
        numbers.put(Number { value: i * 7919 % 1000 }, i * 7919 % 1000)!;
    }
    var sum: u64 = 0;
    for (v in numbers.values) {
        sum += v;
    }
    Console.write("numbers ");
    Console.write(numbers.count());
    Console.write(", sum of values ");
    Console.write(sum);
    Console.write(", slots ");
    Console.writeLine(numbers.slots.length);
    Console.write("777 -> ");
    Console.writeLine(numbers.get(Number { value: 777 })!);
}
