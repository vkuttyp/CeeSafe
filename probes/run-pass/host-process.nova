// P1 probe, revised for novac 0.4.0: the host services `ceesafec build` needs (type-system §26, §26.7-§26.10; ADR 0028).
// It works in a private temporary directory: write a C file, find the C compiler (`CC`, else `cc`), run it with an
// argument vector, capture what it writes, check the object with File.kind, list the directory, and clean up.
// Under 0.3.1 output could not be captured and the environment could not be read (ROADMAP N4a, now done).
// expect-stdout: true: 0
// expect-stdout: sh exit 3: 3
// expect-stdout: missing program: No such file or directory
// expect-stdout: cc: 0, object written
// expect-stdout: cc on bad C: failed, error captured
// expect-stdout: listing: probe.c probe.o
// expect-stdout: cleaned up

fn show(label: StringView, result: Result<i32, IoError>) {
    Console.write(label);
    Console.write(": ");
    match (result) {
        Ok(code) => { Console.writeLine(code); }
        Err(e) => { Console.writeLine(e.message()); }
    }
}

fn pathIn(directory: borrow String, name: StringView) -> String {
    var path = String.create();
    path.append(directory.view())!;
    path.append("/")!;
    path.append(name)!;
    return path;
}

fn writeText(path: StringView, text: StringView) {
    var file = File.create(path)!;
    file.write(text.bytes())!;
}

/// Whether `needle` occurs in `bytes`.
fn contains(bytes: Slice<u8>, needle: StringView) -> bool {
    if (needle.length > bytes.length) {
        return false;
    }
    for (i in 0..(bytes.length - needle.length + 1)) {
        var same = true;
        for (k in 0..needle.length) {
            same = same && bytes[i + k] == needle[k];
        }
        if (same) {
            return true;
        }
    }
    return false;
}

fn main() {
    var none = Vector<StringView>.create();
    show("true", Process.run("true", none));
    var shell = Vector<StringView>.create();
    shell.push("-c")!;
    shell.push("exit 3")!;
    show("sh exit 3", Process.run("sh", shell));
    show("missing program", Process.run("ceesafe-probe-no-such-program", none));

    let compiler: StringView = match (Environment.variable("CC")) {
        Some(cc) => cc,
        null => "cc",
    };
    let work = Directory.temporary()!;
    let source = pathIn(work, "probe.c");
    let object = pathIn(work, "probe.o");

    writeText(source.view(), "int probe_answer(void) { return 42; }\n");
    var arguments = Vector<StringView>.create();
    arguments.push("-std=c11")!;
    arguments.push("-c")!;
    arguments.push(source.view())!;
    arguments.push("-o")!;
    arguments.push(object.view())!;
    let built = Process.capture(compiler, arguments, null)!;
    Console.write("cc: ");
    Console.write(built.status);
    Console.writeLine(match (File.kind(object.view())!) {
        Some(PathKind.File) => ", object written",
        _ => ", no object",
    });

    // The compiler's error is captured, so ceesafec can report it in its own diagnostics.
    writeText(source.view(), "int probe_answer(void) { return }\n");
    var check = Vector<StringView>.create();
    check.push("-fsyntax-only")!;
    check.push(source.view())!;
    let bad = Process.capture(compiler, check, null)!;
    Console.write(if (bad.status != 0) "cc on bad C: failed" else "cc on bad C: accepted");
    Console.writeLine(if (contains(bad.stderr.view(), "probe.c")) ", error captured" else ", no error text");

    Console.write("listing:");
    let names = Directory.list(work.view())!;
    for (name in names) {
        Console.write(" ");
        Console.write(name);
    }
    Console.writeLine("");

    File.remove(source.view())!;
    File.remove(object.view())!;
    Directory.remove(work.view())!;
    Console.writeLine(if (File.kind(work.view())! == null) "cleaned up" else "left behind");
}
