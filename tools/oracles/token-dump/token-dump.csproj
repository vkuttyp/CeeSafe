<Project Sdk="Microsoft.NET.Sdk">
  <!-- The reference lexer as an oracle for the token dump of ceesafec parse (docs/p2-frontend.md §3).
       Build it against a clean Nova checkout at the pinned tag, with -p:NovaRoot=PATH. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NovaRoot Condition="'$(NovaRoot)' == ''">$(HOME)/Nova</NovaRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(NovaRoot)/src/Nova.Compiler/Nova.Compiler.csproj" />
  </ItemGroup>
</Project>
