// profile: freestanding
// C8: kernel threads a module owns (kernel/include/kernel/thread.h). A KThread runs its task's `step` again and again
// until it is told to stop; dropping the KThread tells it and joins it, so no thread outlives the value that owns it,
// and a module whose state owns its threads ends them all in shutdown (docs/cosmoos/c8-report.md).

@header("kernel/thread.h")
extern "C" {
    struct thread;
    @effects(alloc)
    fn thread_create(entry: extern "C" fn(*mut void), arg: *mut void, name: *CChar, priority: i32) -> *mut thread;
    @effects(sleep)
    fn thread_join(t: *mut thread) -> i32;
}

/// What a kernel thread does: `step` is called until it returns false or the thread is told to stop. It runs in
/// thread context, so it may sleep.
public interface Task {
    fn step(borrow this) -> bool;
}

/// What the thread and its owner share: the stop request, under a spinlock, and the task.
struct Control<T: Task> {
    stop: Box<SpinLock<bool>, KernelHeap>;
    task: T;
}

/// A running kernel thread and its task.
public struct KThread<T: Task> {
    private handle: *mut thread;
    private control: *mut Control<T>;

    /// Starts a thread (thread_create, default priority) running `task`. `name` is copied by the kernel.
    /// Safety: the thread gets the address of `control`, which stays alive until `drop` has joined the thread.
    public fn start(name: *CChar, task: T) -> Result<KThread<T>, AllocError> {
        match (SpinLock<bool>.create("ceesafe.c8.thread.stop\0".ptr as *CChar, false)) {
            Err(e) => { return Err(e); }
            Ok(stop) => {
                match (Box.createIn(KernelHeap {}, Control { stop: stop, task: task })) {
                    Err(e) => { return Err(e); }
                    Ok(control) => {
                        let raw = Box.intoRaw(control);
                        let handle = unsafe { thread_create(run<T>, raw as *mut void, name, 32) };
                        if (handle.isNull()) {
                            let back: Box<Control<T>, KernelHeap> = unsafe { Box.fromRaw(raw) };
                            return Err(AllocError.OutOfMemory);
                        }
                        return Ok(KThread { handle: handle, control: raw });
                    }
                }
            }
        }
    }

    /// The task, shared with the running thread.
    /// Safety: `control` lives until drop, and the task is only read through it.
    public fn task(borrow this) -> borrow T {
        let control = unsafe { Ptr.toBorrow(this.control as *Control<T>) };
        return borrow control.task;
    }

    /// Safety: after thread_join returns, the thread no longer uses `control`, so its box is taken back and dropped.
    drop {
        let control = unsafe { Ptr.toBorrow(this.control as *Control<T>) };
        {
            var guard = control.stop.lock();
            let stop = guard.data();
            stop = true;
        }
        unsafe { thread_join(this.handle); }
        let back: Box<Control<T>, KernelHeap> = unsafe { Box.fromRaw(this.control) };
    }
}

/// A KThread's body: steps the task until it says no or the owner asks it to stop.
/// Safety: `arg` is the Control<T> that KThread.start made; it lives until the owner has joined this thread.
@callback
unsafe fn run<T: Task>(arg: *mut void) {
    let control = Ptr.toBorrow(arg as *Control<T>);
    loop {
        {
            var guard = control.stop.lock();
            let stop = guard.data();
            if (stop) { return; }
        }
        if (!control.task.step()) { return; }
    }
}
