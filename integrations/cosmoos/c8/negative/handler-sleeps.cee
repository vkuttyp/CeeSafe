// profile: freestanding
// Nor does anything sleep in interrupt context: a handler that takes a mutex is rejected.
// expect-error: N0295 it calls 'Sleepy.fire', which calls 'Mutex<u64>.lock'
struct Sleepy {
    table: Box<Mutex<u64>, KernelHeap>;
}

impl TimerHandler for Sleepy {
    fn fire(borrow this) -> u64 {
        var held = this.table.lock();
        return 0;
    }
}

fn make(table: Box<Mutex<u64>, KernelHeap>) -> bool {
    match (Timer<Sleepy>.create(Sleepy { table: table })) {
        Ok(timer) => { return true; }
        Err(e) => { return false; }
    }
}
