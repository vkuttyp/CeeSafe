// ADR 0027 in lib/kernel: a static Mutex, built at compile time through `here` and MUTEX_INIT_AT, and a static
// ObjectCache whose boxes move their values in and out of slab objects. k3.py compiles it as a module.

struct Table {
    count: u64;
}

static TABLE: Mutex<Table> = Mutex<Table>.constant("ceesafe.k3.table\0".ptr as *CChar, Table { count: 0 });

@export("k3x_bump")
fn bump() -> u64 {
    var guard = TABLE.lock();
    let table = guard.data();
    table.count += 1;
    return table.count;
}
struct Conn {
    id: u64;
    weight: u32;
}

static CONNS: ObjectCache<Conn> = ObjectCache<Conn>.constant();

@export("k3x_setup")
fn setUp() -> bool {
    match (CONNS.setUp("ceesafe.k3.conn\0".ptr as *CChar)) {
        Ok() => { return true; }
        Err(e) => { return false; }
    }
}

@export("k3x_use")
fn useOne(id: u64) -> u64 {
    match (CONNS.alloc(Conn { id: id, weight: 3 })) {
        Ok(conn) => {
            var c = conn;
            let r = c.getMut();
            r.id += 1;
            return c.get().id + c.get().weight as u64;
        }
        Err(e) => { return 0; }
    }
}
