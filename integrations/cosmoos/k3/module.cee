// profile: freestanding
// M14 K3 (ADR 0025): the part of lib/kernel a loadable module may use, checked by k3.py against C4's rules for a
// module: CosmoOS exports spin_lock_irqsave, the mutex API, kmalloc and the kobject API to modules, but not
// arch_irq_save/restore or preempt_enable, so IrqGuard, PreemptGuard and PerCpu are for code built into the kernel.
struct Table {
    count: u64;
}

static TABLE: SpinLock<Table> = SpinLock<Table>.constant("ceesafe.k3.table\0".ptr as *CChar, Table { count: 0 });
static EVENTS: IrqSpinLock<u64> = IrqSpinLock<u64>.constant("ceesafe.k3.events\0".ptr as *CChar, 0);

@export("k3_bump")
fn bump() -> u64 {
    var guard = TABLE.lock();
    let table = guard.data();
    table.count += 1;
    return table.count;
}

@export("k3_event")
fn event() -> u64 {
    var guard = EVENTS.lock();
    let events = guard.data();
    events += 1;
    return events;
}

@export("k3_object")
fn object() -> u32 {
    match (KRef<u64>.create("ceesafe.k3.object\0".ptr as *CChar, 9)) {
        Ok(first) => {
            let second = first.clone();
            return second.count();
        }
        Err(e) => { return 0; }
    }
}
