// Host services in CosmoOS userland (type-system.md §26.7-§26.10, ADR 0028): run by c3.py in a guest, and on the host
// by ProgramTests. It captures itself: started with `child`, it reads its standard input and writes to both streams.
// expect-stdout: PATH is set: true
// expect-stdout: unset variable: null
// expect-stdout: listing: a b
// expect-stdout: kinds: file directory null
// expect-stdout: capture: status 3, out:input, err
// expect-stdout: missing program: NotFound
// expect-stdout: cleaned: null
// expect-stdout: working directory: present

fn join(directory: borrow String, name: StringView) -> String {
    var path = String.create();
    path.append(directory.view())!;
    path.append("/")!;
    path.append(name)!;
    return path;
}

fn kindName(kind: Result<PathKind?, IoError>) -> StringView => match (kind) {
    Ok(Some(PathKind.File)) => "file",
    Ok(Some(PathKind.Directory)) => "directory",
    Ok(Some(PathKind.Other)) => "other",
    Ok(null) => "null",
    Err(_) => "error",
};

fn child() -> i32 {
    var buffer = [0u8; 64];
    let n = Console.read(mut buffer[..])!;
    Console.write("out:");
    Console.writeBytes(buffer[..n]);
    Console.writeError("err");
    return 3;
}

fn main() -> i32 {
    if (Process.argumentCount() > 1) {
        return child();
    }
    Console.write("PATH is set: ");
    Console.writeLine(Environment.variable("PATH") != null);
    Console.write("unset variable: ");
    Console.writeLine(if (Environment.variable("CEESAFE_C3_SURELY_UNSET") == null) "null" else "set");

    let root = Directory.temporary()!;
    let a = join(root, "a");
    let b = join(root, "b");
    {
        // Closed at the block's end: Windows cannot remove an open file.
        var file = File.create(b.view())!;
        file.write("text".bytes())!;
    }
    Directory.create(a.view())!;
    Console.write("listing:");
    let names = Directory.list(root.view())!;
    for (name in names) {
        Console.write(" ");
        Console.write(name);
    }
    Console.writeLine("");
    let missing = join(root, "missing");
    Console.write("kinds: ");
    Console.write(kindName(File.kind(b.view())));
    Console.write(" ");
    Console.write(kindName(File.kind(a.view())));
    Console.write(" ");
    Console.writeLine(kindName(File.kind(missing.view())));

    var arguments = Vector<StringView>.create();
    arguments.push("child")!;
    let output = Process.capture(Process.argument(0)!, arguments, "input".bytes())!;
    Console.write("capture: status ");
    Console.write(output.status);
    Console.write(", ");
    Console.writeBytes(output.stdout.view());
    Console.write(", ");
    Console.writeBytes(output.stderr.view());
    Console.writeLine("");
    var none = Vector<StringView>.create();
    Console.write("missing program: ");
    match (Process.capture("ceesafe-c3-no-such-program", none, null)) {
        Ok(_) => { Console.writeLine("started"); }
        Err(IoError.NotFound) => { Console.writeLine("NotFound"); }
        Err(_) => { Console.writeLine("another error"); }
    }

    File.remove(b.view())!;
    Directory.remove(a.view())!;
    Directory.remove(root.view())!;
    Console.write("cleaned: ");
    Console.writeLine(kindName(File.kind(root.view())));
    Console.write("working directory: ");
    Console.writeLine(if (Directory.current()!.length > 0) "present" else "empty");
    return 0;
}
