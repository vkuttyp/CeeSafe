// Fork-join errors (type-system.md §38.6, ADR 0018): a capture that may not be used from two threads (a `dyn`
// reference, a thread), a captured closure, an argument that is not a literal or an fn() value, and a move literal
// (N0334). The borrow checker's conflicts are in thread-both-borrows.nova.

interface Job {
    fn run(borrow this) -> u64;
}

struct Unit {
    n: u64;
}

impl Job for Unit {
    fn run(borrow this) -> u64 => this.n;
}

fn main() {
    var x: u64 = 0;

    let unit = Unit { n: 1 };
    let job: borrow dyn Job = borrow unit;
    Thread.both(() => { x = job.run(); }, () => {}); // error[N0334]

    let worker = Thread.spawn(move () => 1u64)!;
    let held = borrow worker;
    Thread.both(() => { let w = held; }, () => {}); // error[N0334]

    var count: u64 = 0;
    let bump = () => { count = count + 1; };
    Thread.both(bump, () => {}); // error[N0334]
    Thread.both(() => { bump(); }, () => {}); // error[N0334]
    Thread.both(move () => {}, () => {}); // error[N0334]
}
