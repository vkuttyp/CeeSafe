// M15 S1 (#2): a generic body that binds and rebuilds `Ok(v)` checks for every type argument but `void`, whose
// `Result<void, E>.Ok` has no payload. The use with `void` is N0222 at the call (type-system §20.4); it used to crash
// novac ("cannot lower HirError").
fn same<T>(r: Result<T, u8>) -> Result<T, u8> => match (r) {
    Ok(v) => Ok(v),
    Err(e) => Err(e),
};

fn lift<T>(r: Result<T, u8>) -> Result<T, u16> => match (r) {
    Ok(v) => Ok(v),
    Err(e) => Err(e as u16),
};

fn main() {
    let a: Result<void, u8> = Ok();
    let b = same(a); // error[N0222]
    let c: Result<void, u8> = Err(3);
    let d = lift(c); // error[N0222]
    let e: Result<u32, u8> = Ok(1);
    let f = same(e);
    let g = lift(e);
}
