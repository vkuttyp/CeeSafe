// Overflow checks that overflow-check elimination must remove (optimisations.md §3.3); the .oce snapshot lists each
// one. The unsigned functions combine their values with `^`, which has no check, so every listed operation is one
// to prove.

/// A counter bounded by a length: the increment `i + 1` runs after `i < s.length`.
fn counted(s: Slice<u8>) -> u32 {
    var t: u32 = 0;
    for (i in 0..s.length) { t ^= s[i] as u32; }
    return t;
}

/// A signed counter bounded by a constant.
fn constantBound() -> i32 {
    var t: i32 = 0;
    for (s in 0..100) { t = s; }
    return t;
}

/// A subtraction after a test that the subtrahend is not larger.
fn difference(a: u32, b: u32) -> u32 {
    if (b <= a) { return a - b; }
    return 0;
}

/// Widened operands: two u32 values added, and multiplied, as u64.
fn widened(a: u32, b: u32) -> u64 => (a as u64) + (b as u64);

fn square(x: u32) -> u64 => (x as u64) * (x as u64);

/// An offset plus an index below the remaining length (the LZ4 shape). `out.length - to` keeps its check: nothing tests `to` first.
fn offset(out: SliceMut<u8>, to: usize, n: usize) -> bool {
    if (n > out.length - to) { return false; }
    for (i in 0..n) { out[to + i] = 7; }
    return true;
}

/// A negation of a positive value, and a predecessor of one.
fn negated(x: i32) -> i32 {
    if (x > 0) { return -x; }
    return x;
}

fn predecessor(x: u32) -> u32 {
    if (x > 0) { return x - 1; }
    return 0;
}

/// A loop counting down: `i - 1` after `i > 0`.
fn countdown(s: Slice<u8>) -> u32 {
    var i = s.length;
    var t: u32 = 0;
    while (i > 0) {
        i -= 1;
        t ^= s[i] as u32;
    }
    return t;
}

/// Fields widened before they are added: each operand is in u8's range (fbvalid's shape).
struct Pixel { r: u8; g: u8; }

fn brightness(p: borrow Pixel) -> u32 => p.r as u32 + p.g as u32;

/// Constants: `2 * (W - 1)` with `W` a constant.
const W: i32 = 1000;

fn reflect() -> i32 => 2 * (W - 1);

fn main() {
    var bytes = [5u8, 4, 3, 0, 1, 2];
    Console.writeLine(counted(bytes[..]));
    Console.writeLine(constantBound());
    Console.writeLine(difference(10, 3));
    Console.writeLine(difference(3, 10));
    Console.writeLine(widened(4000000000, 4000000000));
    Console.writeLine(square(4294967295));
    Console.writeLine(offset(mut bytes[..], 2, 4));
    Console.writeLine(offset(mut bytes[..], 3, 4));
    Console.writeLine(negated(5));
    Console.writeLine(negated(-5));
    Console.writeLine(predecessor(7));
    Console.writeLine(predecessor(0));
    Console.writeLine(countdown(bytes[..]));
    Console.writeLine(reflect());
    let p = Pixel { r: 255, g: 255 };
    Console.writeLine(brightness(borrow p));
}

// expect-stdout: 1
// expect-stdout: 99
// expect-stdout: 7
// expect-stdout: 0
// expect-stdout: 8000000000
// expect-stdout: 18446744065119617025
// expect-stdout: true
// expect-stdout: false
// expect-stdout: -5
// expect-stdout: -5
// expect-stdout: 6
// expect-stdout: 0
// expect-stdout: 1
// expect-stdout: 1998
// expect-stdout: 510
