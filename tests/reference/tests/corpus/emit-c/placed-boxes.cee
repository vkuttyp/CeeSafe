// Stack-placed boxes (c-backend.md §2.2; on by default since M9e): a slot per site, reused in every iteration of a
// loop; the drop destroys the contents and frees nothing.
struct Pair { a: u64; b: u64; }

fn sum(n: u64) -> u64 {
    var total: u64 = 0;
    for (i in 0..n) {
        let p = Box.create(Pair { a: i, b: 1 })!;
        total += p.a + p.b;
    }
    return total;
}

fn main() -> i32 {
    Console.writeLine(sum(4));
    return 0;
}
