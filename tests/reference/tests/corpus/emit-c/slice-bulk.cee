// Bulk slice operations (type-system.md §16.5; c-backend.md §2): a length check and nv_slice_copy, a byte fill
// as nv_slice_fill_byte, and a wider fill as an element loop.
struct Point { x: i32; y: i32; }

fn copy(out: SliceMut<u8>, to: usize, src: Slice<u8>, from: usize, n: usize) {
    out[to..to + n].copyFrom(src[from..from + n]);
}

fn main() {
    var bytes = [0u8; 8];
    let ones = [1u8; 8];
    copy(mut bytes[..], 0, ones[..], 4, 4);
    bytes[4..].fill(7);
    var points = [Point { x: 0, y: 0 }; 2];
    points[..].fill(Point { x: 1, y: 2 });
    Console.writeLine(bytes[0] as i32 + bytes[7] as i32 + points[1].y);
}
