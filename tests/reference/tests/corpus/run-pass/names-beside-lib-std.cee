// A program may use any name lib/std's helpers use (M15 S7's lib/std/host.nova kept them as top-level functions in
// novac 0.4.0, so these were N0201 "already defined" there; they are HostServices's own since). Only lib/std's public
// names are reserved (type-system.md §38.5).
// expect-stdout: 8

fn textOf() -> u32 => 1;
fn pathIn() -> u32 => 1;
fn copyText() -> u32 => 1;
fn fromAlloc() -> u32 => 1;
fn stringOrIoError() -> u32 => 1;
fn pushed() -> u32 => 1;
fn readAll() -> u32 => 1;
fn compareText() -> u32 => 1;
fn hostError() -> u32 => 0;

struct HostText {
    value: u32;
}

fn main() {
    let h = HostText { value: 1 };
    Console.writeLine(textOf() + pathIn() + copyText() + fromAlloc() + stringOrIoError() + pushed() + readAll()
        + compareText() + hostError() + h.value - 1);
}
