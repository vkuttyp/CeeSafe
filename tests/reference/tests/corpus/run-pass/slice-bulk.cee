// Bulk slice operations (type-system.md §16.5): copyFrom and fill on every receiver form and element kind,
// empty slices, overlap made by unsafe code, generic elements, and the evaluation order.

struct Point { x: i32; y: i32; }

enum Shade { Dark, Light }

fn copy(out: SliceMut<u8>, to: usize, src: Slice<u8>, from: usize, n: usize) {
    out[to..to + n].copyFrom(src[from..from + n]);
}

fn same(s: SliceMut<u32>) -> SliceMut<u32> => s;

fn fillWith<T: Copy>(s: SliceMut<T>, value: T) { s.fill(value); }

fn at(n: usize, label: StringView) -> usize {
    Console.writeLine(label);
    return n;
}

fn show(s: Slice<u8>) {
    Console.write(s[0]);
    for (i in 1..s.length) {
        Console.write(" ");
        Console.write(s[i]);
    }
    Console.writeLine();
}

/// Safety: the two slices are views of `storage`, which outlives them; they overlap on purpose, which
/// copyFrom allows (it copies as if through a temporary).
fn overlapping() {
    var storage = [1u8, 2, 3, 4, 5, 6];
    let whole = borrow mut storage[..];
    let p = whole.ptr;
    let source = unsafe { Slice.fromRaw(p as *u8, 4) };
    let target = unsafe { SliceMut.fromRaw(p.add(2), 4) };
    target.copyFrom(source);
    show(storage[..]);
    let back = unsafe { SliceMut.fromRaw(p, 4) };
    back.copyFrom(unsafe { Slice.fromRaw(p.add(2) as *u8, 4) });
    show(storage[..]);
}

/// Safety: a null pointer with length 0 is a valid empty slice; nothing is read or written.
fn empties() {
    var a = [7u8, 8];
    let one = [1u8];
    a[1..1].copyFrom(one[..0]);
    a[2..].fill(0);
    let none = unsafe { SliceMut.fromRaw(0 as *mut u8, 0) };
    none.copyFrom(unsafe { Slice.fromRaw(0 as *u8, 0) });
    none.fill(9);
    show(a[..]);
}

fn main() -> i32 {
    var bytes = [1u8, 2, 3, 4, 5, 6, 7, 8];
    let nines = [9u8; 8];
    copy(mut bytes[..], 2, nines[..], 0, 3);
    show(bytes[..]);
    bytes[..4].fill(0);
    let tail = borrow mut bytes[4..];
    tail.fill(255);
    show(bytes[..]);
    bytes[..].copyFrom(nines[..]);
    show(bytes[..]);

    var signed = [0i8; 3];
    signed[..].fill(-3);
    Console.writeLine(signed[2]);
    var flags = [false; 3];
    flags[1..].fill(true);
    Console.writeLine(flags[0]);
    Console.writeLine(flags[2]);

    var words = [0u32; 4];
    same(mut words[..]).fill(70000);
    let pair = [1u32, 2];
    words[..2].copyFrom(pair[..]);
    Console.writeLine(words[0] + words[1] + words[3]);
    var wide = [0u64; 3];
    fillWith(mut wide[..], 18446744073709551615);
    Console.writeLine(wide[1]);

    var points = [Point { x: 0, y: 0 }; 4];
    points[1..3].fill(Point { x: 5, y: 6 });
    let corners = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    points[2..].copyFrom(corners[..]);
    Console.writeLine(points[1].x + points[2].y + points[3].x);
    var shades = [Shade.Dark; 2];
    fillWith(mut shades[..], Shade.Light);
    match (shades[1]) {
        Shade.Dark => { Console.writeLine("dark"); }
        Shade.Light => { Console.writeLine("light"); }
    }

    var v = Vector<u32>.create();
    v.push(1)!;
    v.push(2)!;
    v.push(3)!;
    v.viewMut().fill(42);
    Console.writeLine(v[2]);
    let elements = v.viewMut();
    elements[..].copyFrom(words[1..]);
    Console.writeLine(v[0] + v[2]);

    // The receiver's bounds, then the source's.
    var order = [0u8; 4];
    order[at(0, "receiver low")..at(2, "receiver high")].copyFrom(nines[at(1, "source low")..at(3, "source high")]);

    overlapping();
    empties();
    return 0;
}

// expect-stdout: 1 2 9 9 9 6 7 8
// expect-stdout: 0 0 0 0 255 255 255 255
// expect-stdout: 9 9 9 9 9 9 9 9
// expect-stdout: -3
// expect-stdout: false
// expect-stdout: true
// expect-stdout: 70003
// expect-stdout: 18446744073709551615
// expect-stdout: 10
// expect-stdout: light
// expect-stdout: 42
// expect-stdout: 70002
// expect-stdout: receiver low
// expect-stdout: receiver high
// expect-stdout: source low
// expect-stdout: source high
// expect-stdout: 1 2 1 2 3 4
// expect-stdout: 1 2 3 4 3 4
// expect-stdout: 7 8
