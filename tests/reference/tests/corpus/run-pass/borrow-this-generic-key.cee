// M15 S5 (#5): a result declared `borrow(this)` borrows only `this`, also when another reference parameter has a
// type-parameter type, so a temporary key may end with the call's statement (type-system.md §25.6).
// expect-stdout: 7
// expect-stdout: absent

struct Key {
    v: u64;
}

struct Table<T, K> {
    values: Vector<T>;

    fn get(borrow this, key: borrow K) -> borrow(this) T? {
        if (this.values.length == 0) {
            return null;
        }
        return borrow this.values[0];
    }
}

fn main() {
    var t = Table<u64, Key> { values: Vector<u64>.create() };
    t.values.push(7)!;
    let found = t.get(Key { v: 0 });
    Console.writeLine(found!);
    var empty = Table<u64, Key> { values: Vector<u64>.create() };
    let missing = empty.get(Key { v: 1 });
    Console.writeLine(if (missing == null) "absent" else "present");
}
