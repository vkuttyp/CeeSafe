// The sort benchmark (benchmarks/sort/README.md): 10 rounds of sorting 1,000,000 pseudo-random i64 values with
// `sortBy` and a closure comparator (type-system.md §36.4), then a checksum of the sorted values.
fn main() {
    let n: usize = 1000000;
    var values = Vector<i64>.withCapacity(n)!;
    var x: u64 = 1;
    var sum: i64 = 0;
    var comparisons: i64 = 0;
    for (round in 0..10) {
        values.clear();
        for (i in 0..n) {
            x = x.wrappingMul(6364136223846793005).wrappingAdd(1442695040888963407);
            values.push(truncate<i64>(x >> 33))!;
        }
        values.sortBy((a, b) => { comparisons += 1; return if (a < b) -1 else if (a > b) 1 else 0; });
        var i: usize = 0;
        while (i < n) {
            sum += values[i] * truncate<i64>(i / 16 % 1000);
            i += 16;
        }
    }
    Console.writeLine(sum);
}
