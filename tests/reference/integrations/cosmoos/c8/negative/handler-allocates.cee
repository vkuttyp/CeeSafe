// profile: freestanding
// A timer handler runs in interrupt context, where nothing allocates (KQ-1): one that does is rejected, in the
// instance of the @context(irq) callback fire<T> for its type, with the chain naming the handler.
// expect-error: N0295 it calls 'Greedy.fire', which calls 'SpinLock<u64>.create'
struct Greedy {}

impl TimerHandler for Greedy {
    fn fire(borrow this) -> u64 {
        match (SpinLock<u64>.create("nova.c8.greedy\0".ptr as *CChar, 0)) {
            Ok(lock) => { return 1; }
            Err(e) => { return 0; }
        }
    }
}

fn make() -> bool {
    match (Timer<Greedy>.create(Greedy {})) {
        Ok(timer) => { return true; }
        Err(e) => { return false; }
    }
}
