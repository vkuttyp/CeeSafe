// profile: freestanding
// Dropping a KThread joins it, which sleeps: not under a spin guard.
struct Idle {}

impl Task for Idle {
    fn step(borrow this) -> bool => false;
}

fn stopUnderLock(lock: borrow SpinLock<u64>, thread: KThread<Idle>) {
    var guard = lock.lock();
    let gone = thread;
} // error[N0295]
