// profile: freestanding
// C8: timers a module owns (kernel/include/kernel/timer.h). A Timer holds CosmoOS's struct timer first and its handler
// after it; the kernel calls the handler in interrupt context, so `fire` is @context(irq): a handler that could sleep
// or allocate does not compile (type-system.md §32). Dropping a Timer is timer_cancel_sync: when it returns, the
// callback is not running anywhere, so the timer and its handler can go (docs/cosmoos/c8-report.md).

@header("kernel/timer.h")
extern "C" {
    struct timer;
    @effects()
    fn timer_setup(t: *mut timer, f: extern "C" fn(*mut timer, *mut void), arg: *mut void);
    @effects()
    fn timer_start(t: *mut timer, delay_ns: u64);
    @effects()
    fn timer_cancel_sync(t: *mut timer) -> bool;
}

/// What a timer does when it fires, in interrupt context. The result is the delay until it fires again, in
/// nanoseconds, or 0 to stop.
public interface TimerHandler {
    fn fire(borrow this) -> u64;
}

/// An armable timer and its handler: made in place in a KernelHeap box, never moved (type-system.md §33).
public struct Timer<T: TimerHandler> {
    private raw: timer;
    private handler: T;

    /// Safety: runs once, at the timer's final address, before anyone can arm it. The callback finds the Timer from
    /// its `struct timer *`, the first field (type-system.md §34.3), so it needs no argument.
    @placed
    fn init(borrow mut this) {
        unsafe { timer_setup(borrow mut this.raw as *mut timer, fire<T>, 0 as *mut void); }
    }

    public fn create(handler: T) -> Result<Box<Timer<T>, KernelHeap>, AllocError> =>
        Box.createIn(KernelHeap {}, Timer { handler: handler });

    /// Arms the timer on this CPU: `fire` runs after `delay_ns`.
    /// Safety: the timer was set up by `init`; timer_start re-arms a pending timer.
    public fn start(borrow this, delay_ns: u64) {
        unsafe { timer_start(this.cTimer(), delay_ns); }
    }

    public fn get(borrow this) -> borrow T => borrow this.handler;

    fn cTimer(borrow this) -> *mut timer => borrow this.raw as *timer as *mut timer;

    /// Safety: timer_cancel_sync waits until the callback runs nowhere, re-cancelling if it re-armed itself; it is
    /// never called from this timer's own callback (the callback never drops its timer).
    drop {
        unsafe { timer_cancel_sync(this.cTimer()); }
    }
}

/// The C callback of every Timer<T>: calls the handler and re-arms if it asks to.
/// Safety: `t` is the first field of the Timer<T> that `init` registered, which lives until its drop has cancelled it
/// synchronously.
@callback
@context(irq)
unsafe fn fire<T: TimerHandler>(t: *mut timer, arg: *mut void) {
    let timer = Ptr.toBorrow(t as *Timer<T>);
    let next = timer.handler.fire();
    if (next != 0) { timer.start(next); }
}
