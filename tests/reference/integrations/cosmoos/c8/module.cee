// profile: freestanding
// C8: a kernel module written in Nova (docs/cosmoos/c8-report.md). Its whole state is one Nova value, made by init and
// dropped by shutdown: dropping it ends everything the module started, field by field in declaration order (the
// timer, then the thread, then the kernel object both of them share), so nothing it registered outlives shutdown.
// The C entry glue (COSMO_MODULE) is generated by c8.py; it calls the two exports below.

extern "C" {
    /// Logs a module event (the generated glue's c8_log, through klog).
    @effects()
    fn c8_log(event: *CChar, value: u64);
    @effects(sleep)
    fn thread_sleep_ns(ns: u64);
    /// C8b's zombie control: with the glue built with leak=true, the thread makes an object no one puts.
    @effects()
    fn c8_leak_requested() -> bool;
}

const TICK_NS: u64 = 4000000;
const STEP_NS: u64 = 1000000;
/// The thread and the timer stop by themselves after this many steps and ticks, so a module that stays loaded
/// does not keep a CPU busy (CosmoOS's scheduler selftests run later in the same boot).
const MAX_STEPS: u64 = 200;
const MAX_TICKS: u64 = 400;
/// In the zombie control, the thread makes the leaked object at this step: init has long returned by then, so the
/// kernel attributes it to this module (an object made while init runs is attributed to none; c8-report.md).
const LATE_STEP: u64 = 10;

/// What the timer and the thread share: the tick count, under an irqsave lock (the timer writes it in interrupt context).
struct Ticks {
    count: Box<IrqSpinLock<u64>, KernelHeap>;
}

fn ticksOf(ticks: borrow KRef<Ticks>) -> u64 {
    let shared = ticks.get();
    var guard = shared.count.lock();
    return guard.data();
}

/// The timer's handler: counts a tick and fires again after TICK_NS.
struct Ticker {
    ticks: KRef<Ticks>;
}

impl TimerHandler for Ticker {
    fn fire(borrow this) -> u64 {
        let shared = this.ticks.get();
        var guard = shared.count.lock();
        let count = guard.data();
        count += 1;
        if (count >= MAX_TICKS) { return 0; }
        return TICK_NS;
    }
}

/// The thread's task: sleeps a millisecond a step, counts its steps, and reports once what the timer has done.
struct Watcher {
    ticks: KRef<Ticks>;
    steps: Box<SpinLock<u64>, KernelHeap>;
    /// The zombie control: set once the thread has made (and leaked) its object.
    late: Box<SpinLock<bool>, KernelHeap>;
}

impl Task for Watcher {
    /// Safety: thread_sleep_ns may sleep, which a thread's step may do.
    fn step(borrow this) -> bool {
        unsafe { thread_sleep_ns(STEP_NS); }
        var n: u64 = 0;
        {
            var guard = this.steps.lock();
            let steps = guard.data();
            steps += 1;
            n = steps;
        }
        if (n == 100) {
            unsafe { c8_log("watcher: ticks seen after 100 steps\0".ptr as *CChar, ticksOf(borrow this.ticks)); }
        }
        if (n == LATE_STEP && unsafe { c8_leak_requested() }) {
            // The control: an object no one will put, so it outlives shutdown and its release code (this module's)
            // stays needed.
            match (KRef<u64>.create("nova.c8.late\0".ptr as *CChar, 0)) {
                Ok(object) => {
                    match (Box.createIn(KernelHeap {}, object)) {
                        Ok(holder) => { let leaked = Box.intoRaw(holder); }
                        Err(e) => {}
                    }
                }
                Err(e) => {}
            }
            var guard = this.late.lock();
            let late = guard.data();
            late = true;
        }
        return n < MAX_STEPS;
    }
}

/// The module's state, torn down in declaration order when dropped.
struct State {
    timer: Box<Timer<Ticker>, KernelHeap>;
    watcher: KThread<Watcher>;
    ticks: KRef<Ticks>;
}

const ENOMEM: i32 = -12;

fn makeState() -> Result<Box<State, KernelHeap>, AllocError> {
    let count = IrqSpinLock<u64>.create("nova.c8.ticks\0".ptr as *CChar, 0)?;
    let ticks = KRef<Ticks>.create("nova.c8.ticks\0".ptr as *CChar, Ticks { count: count })?;
    let steps = SpinLock<u64>.create("nova.c8.steps\0".ptr as *CChar, 0)?;
    let late = SpinLock<bool>.create("nova.c8.late\0".ptr as *CChar, false)?;
    let timer = Timer<Ticker>.create(Ticker { ticks: ticks.clone() })?;
    let watcher = KThread<Watcher>.start(
        "nova.c8.watcher\0".ptr as *CChar,
        Watcher { ticks: ticks.clone(), steps: steps, late: late },
    )?;
    timer.start(TICK_NS);
    return Box.createIn(KernelHeap {}, State { timer: timer, watcher: watcher, ticks: ticks });
}

/// The module's init: makes the state and hands it to the glue, which keeps it until shutdown. On failure, whatever
/// was made is dropped again before this returns (a thread started is stopped, a timer armed is cancelled).
/// Safety: the glue passes a valid place for one pointer.
@export("novamod_init")
fn moduleInit(out: *mut *mut void) -> i32 {
    match (makeState()) {
        Err(e) => {
            unsafe { c8_log("init: out of memory\0".ptr as *CChar, 0); }
            return ENOMEM;
        }
        Ok(state) => {
            unsafe { out.write(Box.intoRaw(state) as *mut void); }
            unsafe { c8_log("init: timer and thread started\0".ptr as *CChar, 0); }
            return 0;
        }
    }
}

/// The zombie control's shutdown waits (at most 5 s) until the thread has made its object.
/// Safety: thread_sleep_ns may sleep, and shutdown runs in thread context.
fn waitForLate(watcher: borrow KThread<Watcher>) {
    for (i in 0..5000) {
        {
            let task = watcher.task();
            var guard = task.late.lock();
            if (guard.data()) { return; }
        }
        unsafe { thread_sleep_ns(STEP_NS); }
    }
}

/// The module's shutdown: takes the state back and drops it, which ends the timer and the thread and puts the
/// kernel object's last reference.
/// Safety: `state` is what moduleInit handed out, given back once.
@export("novamod_shutdown")
unsafe fn moduleShutdown(state: *mut void) {
    {
        let owned: Box<State, KernelHeap> = Box.fromRaw(state as *mut State);
        c8_log("shutdown: ticks counted\0".ptr as *CChar, ticksOf(borrow owned.ticks));
        if (c8_leak_requested()) {
            waitForLate(borrow owned.watcher);
        }
    }
    c8_log("shutdown: timer cancelled, thread joined, object released\0".ptr as *CChar, 0);
}
