// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Every atomic operation in freestanding code (ADR 0026): k3.py compiles it with CosmoOS's flags on both
// architectures and requires that it calls nothing, so each operation is the machine's own instructions.

static C64: AtomicU64 = AtomicU64.constant(0);
static C32: AtomicU32 = AtomicU32.constant(0);
static CSIZE: AtomicUSize = AtomicUSize.constant(0);
static FLAG: AtomicBool = AtomicBool.constant(false);

fn ok64(r: Result<u64, u64>) -> u64 => match (r) {
    Ok(v) => v,
    Err(v) => v,
};

fn ok32(r: Result<u32, u32>) -> u32 => match (r) {
    Ok(v) => v,
    Err(v) => v,
};

fn okSize(r: Result<usize, usize>) -> usize => match (r) {
    Ok(v) => v,
    Err(v) => v,
};

fn okBool(r: Result<bool, bool>) -> bool => match (r) {
    Ok(v) => v,
    Err(v) => v,
};

@export("k3_atomics_u64")
fn atomics64(v: u64) -> u64 {
    C64.store(v);
    var sum = C64.load() + C64.swap(v) + ok64(C64.compareExchange(v, 1)) + C64.fetchAdd(1) + C64.fetchSub(1);
    C64.storeWith(v, StoreOrdering.Release);
    C64.storeWith(v, StoreOrdering.Relaxed);
    sum = sum + C64.loadWith(LoadOrdering.Acquire) + C64.loadWith(LoadOrdering.Relaxed);
    sum = sum + C64.swapWith(v, Ordering.AcquireRelease) + C64.fetchAddWith(1, Ordering.Relaxed);
    sum = sum + C64.fetchSubWith(1, Ordering.Release) + ok64(C64.compareExchangeWith(v, 2, Ordering.Acquire));
    return sum;
}

@export("k3_atomics_u32")
fn atomics32(v: u32) -> u32 {
    C32.store(v);
    var sum = C32.load() + C32.swap(v) + ok32(C32.compareExchange(v, 1)) + C32.fetchAdd(1) + C32.fetchSub(1);
    C32.storeWith(v, StoreOrdering.Release);
    sum = sum + C32.loadWith(LoadOrdering.Acquire) + C32.swapWith(v, Ordering.Acquire);
    sum = sum + C32.fetchAddWith(1, Ordering.AcquireRelease) + C32.fetchSubWith(1, Ordering.Relaxed);
    return sum + ok32(C32.compareExchangeWith(v, 2, Ordering.Release));
}

@export("k3_atomics_usize")
fn atomicsSize(v: usize) -> usize {
    CSIZE.store(v);
    var sum = CSIZE.load() + CSIZE.swap(v) + okSize(CSIZE.compareExchange(v, 1)) + CSIZE.fetchAdd(1);
    sum = sum + CSIZE.fetchSub(1) + CSIZE.loadWith(LoadOrdering.Acquire) + CSIZE.swapWith(v, Ordering.Release);
    CSIZE.storeWith(v, StoreOrdering.Release);
    sum = sum + CSIZE.fetchAddWith(1, Ordering.Relaxed) + CSIZE.fetchSubWith(1, Ordering.AcquireRelease);
    return sum + okSize(CSIZE.compareExchangeWith(v, 2, Ordering.SequentiallyConsistent));
}

@export("k3_atomics_bool")
fn atomicsBool(v: bool) -> bool {
    FLAG.store(v);
    FLAG.storeWith(v, StoreOrdering.Release);
    let a = FLAG.load() && FLAG.loadWith(LoadOrdering.Acquire);
    let b = FLAG.swap(v) || FLAG.swapWith(v, Ordering.AcquireRelease);
    return a && b && okBool(FLAG.compareExchange(v, !v)) && okBool(FLAG.compareExchangeWith(v, !v, Ordering.Acquire));
}
