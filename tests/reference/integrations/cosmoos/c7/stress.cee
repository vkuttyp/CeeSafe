// profile: freestanding
// C7e: the bindings under CosmoOS's real concurrency rules (docs/cosmoos/c7-report.md). Kernel threads, on several
// CPUs, run `worker` against shared state: a spin-locked counter, an irqsave-locked counter, a mutex-locked table
// with a spinlock nested inside it, a kernel object whose references they take and drop, and values they free after
// grace periods, which some of them wait for meanwhile. The module (c7/module.c) runs `stress` from its init, in
// CosmoOS's debug build, where lockdep checks every acquisition and might_sleep every sleeping call; the totals must
// come out exact. A counter they increment without a lock is the control that shows the threads really overlap.

@header("kernel/thread.h")
extern "C" {
    struct thread;
    @effects(alloc)
    fn thread_create(entry: extern "C" fn(*mut void), arg: *mut void, name: *CChar, priority: i32) -> *mut thread;
    @effects(sleep)
    fn thread_join(t: *mut thread) -> i32;
}

extern "C" {
    /// Logs one result (c7/module.c).
    @effects()
    fn c7_report(name: *CChar, passed: bool, detail: i64);
    /// Adds one to a counter with no lock: the control.
    @effects()
    fn c7_racy_increment();
    @effects()
    fn c7_racy_burst(n: u64);
    @effects()
    fn c7_racy_value() -> u64;
    /// A worker starts and ends its loop: C records how many overlap and on which CPUs they run.
    @effects()
    fn c7_enter();
    @effects()
    fn c7_leave();
    @effects()
    fn c7_max_active() -> u32;
    @effects()
    fn c7_cpus() -> u32;
}

const SCHED_PRIO_DEFAULT: i32 = 32;
const MAX_THREADS: usize = 8;
/// Every this many iterations, a worker frees a value after a grace period, and waits for one.
const DEFER_EVERY: u64 = 32;
const SYNC_EVERY: u64 = 256;
/// The control's burst of unlocked increments per worker, after its locked rounds.
const RACY_BURST: u64 = 100000;

struct Ledger {
    entries: u64;
    inner: Box<SpinLock<u64>, KernelHeap>;
}

/// What the workers share. They get a pointer to it, and `stress` joins them all before it is dropped.
struct Shared {
    iterations: u64;
    spin: Box<SpinLock<u64>, KernelHeap>;
    irq: Box<IrqSpinLock<u64>, KernelHeap>;
    table: Box<Mutex<Ledger>, KernelHeap>;
    object: KRef<Tracked>;
    /// Problems the workers saw (a lock-free count would need atomics: they report under this lock).
    failures: Box<SpinLock<u64>, KernelHeap>;
}

/// One worker: `iterations` rounds over every kind of shared state.
/// Safety: `arg` is the Shared that `stress` made; it outlives every worker, since `stress` joins them before dropping
/// it, and workers only read it except through its locks and kernel objects.
@callback
unsafe fn worker(arg: *mut void) {
    let shared = Ptr.toBorrow(arg as *Shared);
    var bad: u64 = 0;
    c7_enter();
    for (i in 0..shared.iterations) {
        {
            var guard = shared.spin.lock();
            let count = guard.data();
            count += 1;
        }
        {
            var guard = shared.irq.lock();
            let count = guard.data();
            count += 1;
        }
        {
            // A mutex, and a spinlock under it: the order lockdep learns is table -> inner, always.
            var held = shared.table.lock();
            let table = held.data();
            table.entries += 1;
            var inner = table.inner.lock();
            let count = inner.data();
            count += 1;
        }
        {
            // A reference of its own, dropped (kobject_put) outside every spin guard.
            let mine = shared.object.clone();
            if (mine.get().tag != 7) { bad += 1; }
        }
        if (i % DEFER_EVERY == 0) {
            match (Deferred<Tracked>.create(Tracked { tag: 1 })) {
                Ok(value) => { deferDrop(value); }
                Err(e) => { bad += 1; }
            }
        }
        if (i % SYNC_EVERY == SYNC_EVERY - 1) {
            Quiesce.synchronize();
        }
    }
    // The control: the same kind of increment with no lock, many in a row, while the other workers do the same.
    c7_racy_burst(RACY_BURST);
    c7_leave();
    if (bad != 0) {
        var guard = shared.failures.lock();
        let failures = guard.data();
        failures += bad;
    }
}

/// Safety: every name passed here is a literal ending in a zero byte, which c7_report prints as a C string.
fn report(name: StringView, passed: bool, detail: u64) {
    unsafe { c7_report(name.ptr as *CChar, passed, truncate<i64>(detail)); }
}

/// Runs `threads` workers of `iterations` rounds each and checks every total. Returns the number of failed checks.
/// Safety: every worker is joined before the state they share is dropped.
@export("c7_stress")
fn stress(threads: usize, iterations: u64) -> u32 {
    let n = if_smaller(threads, MAX_THREADS);
    let drops = unsafe { c7_drops() };
    let racy = unsafe { c7_racy_value() };
    let spin = SpinLock<u64>.create("nova.c7.spin\0".ptr as *CChar, 0);
    let irq = IrqSpinLock<u64>.create("nova.c7.irq\0".ptr as *CChar, 0);
    let inner = SpinLock<u64>.create("nova.c7.inner\0".ptr as *CChar, 0);
    let failures = SpinLock<u64>.create("nova.c7.failures\0".ptr as *CChar, 0);
    let object = KRef<Tracked>.create("nova.c7.object\0".ptr as *CChar, Tracked { tag: 7 });
    match (spin) {
        Err(e) => { report("setup\0", false, 0); return 1; }
        Ok(spinBox) => {
            match (irq) {
                Err(e) => { report("setup\0", false, 1); return 1; }
                Ok(irqBox) => {
                    match (inner) {
                        Err(e) => { report("setup\0", false, 2); return 1; }
                        Ok(innerBox) => {
                            match (failures) {
                                Err(e) => { report("setup\0", false, 3); return 1; }
                                Ok(failureBox) => {
                                    match (object) {
                                        Err(e) => { report("setup\0", false, 4); return 1; }
                                        Ok(kref) => {
                                            match (Mutex<Ledger>.create(
                                                "nova.c7.ledger\0".ptr as *CChar,
                                                Ledger { entries: 0, inner: innerBox },
                                            )) {
                                                Err(e) => { report("setup\0", false, 5); return 1; }
                                                Ok(table) => {
                                                    match (Box.createIn(
                                                        KernelHeap {},
                                                        Shared {
                                                            iterations: iterations,
                                                            spin: spinBox,
                                                            irq: irqBox,
                                                            table: table,
                                                            object: kref,
                                                            failures: failureBox,
                                                        },
                                                    )) {
                                                        Err(e) => { report("setup\0", false, 6); return 1; }
                                                        Ok(shared) => {
                                                            return run(shared, n, iterations, drops, racy);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn if_smaller(a: usize, b: usize) -> usize {
    if (a < b) { return a; }
    return b;
}

/// Starts the workers, joins them, and checks.
/// Safety: the workers get the address of `shared`'s contents, handed over with Box.intoRaw; the box is taken back
/// with Box.fromRaw only after every worker has been joined.
fn run(boxed: Box<Shared, KernelHeap>, threads: usize, iterations: u64, drops: u32, racy: u64) -> u32 {
    let raw = Box.intoRaw(boxed);
    var handles = [0 as *mut thread; 8];
    var started: u64 = 0;
    for (t in 0..threads) {
        let handle = unsafe { thread_create(
            worker,
            raw as *mut void,
            "nova.c7.worker\0".ptr as *CChar,
            SCHED_PRIO_DEFAULT,
        ) };
        if (!handle.isNull()) {
            handles[t] = handle;
            started += 1;
        }
    }
    var exits: u64 = 0;
    for (t in 0..threads) {
        if (!handles[t].isNull()) {
            if (unsafe { thread_join(handles[t]) } != 0) { exits += 1; }
        }
    }
    let shared: Box<Shared, KernelHeap> = unsafe { Box.fromRaw(raw) };
    var failed: u32 = 0;
    let expected = started * iterations;
    if (!check("threads\0", started == threads as u64 && exits == 0, started)) { failed += 1; }
    {
        var guard = shared.spin.lock();
        if (!check("spinlock-counter\0", guard.data() == expected, guard.data())) { failed += 1; }
    }
    {
        var guard = shared.irq.lock();
        if (!check("irqsave-counter\0", guard.data() == expected, guard.data())) { failed += 1; }
    }
    {
        var held = shared.table.lock();
        let table = held.data();
        let entries = table.entries;
        var inner = table.inner.lock();
        if (!check("mutex-table\0", entries == expected, entries)) { failed += 1; }
        if (!check("nested-spinlock\0", inner.data() == expected, inner.data())) { failed += 1; }
    }
    if (!check("kobject-count\0", shared.object.count() == 1, shared.object.count() as u64)) { failed += 1; }
    {
        var guard = shared.failures.lock();
        if (!check("worker-checks\0", guard.data() == 0, guard.data())) { failed += 1; }
    }
    // Every deferred free has run once its grace period is over.
    Quiesce.synchronize();
    let deferred = started * ((iterations + DEFER_EVERY - 1) / DEFER_EVERY);
    let freed = (unsafe { c7_drops() } - drops) as u64;
    if (!check("deferred-frees\0", freed == deferred, freed)) { failed += 1; }
    // The workers really ran at once: several were inside their loops together, on several CPUs.
    let overlap = unsafe { c7_max_active() };
    if (!check("workers-overlapped\0", overlap >= 2, overlap as u64)) { failed += 1; }
    let cpus = unsafe { c7_cpus() };
    if (!check("cpus-used\0", cpus >= 2, cpus as u64)) { failed += 1; }
    // The control: the same increments without a lock lose updates, so the totals above are the locks' doing.
    let unlocked = unsafe { c7_racy_value() } - racy;
    if (!check("control-unlocked-counter-loses-updates\0", unlocked < started * RACY_BURST, unlocked)) { failed += 1; }
    return failed;
}

fn check(name: StringView, passed: bool, detail: u64) -> bool {
    report(name, passed, detail);
    return passed;
}

/// The negative control of a separate boot: two spinlocks taken in one order, then in the other. Nova does not check
/// lock order; lockdep does, and must report the inversion (it panics, so this never returns in a lockdep build).
@export("c7_inversion")
fn inversion() -> u32 {
    let first = SpinLock<u64>.create("nova.c7.order.a\0".ptr as *CChar, 0);
    let second = SpinLock<u64>.create("nova.c7.order.b\0".ptr as *CChar, 0);
    match (first) {
        Err(e) => { return 1; }
        Ok(a) => {
            match (second) {
                Err(e) => { return 1; }
                Ok(b) => {
                    {
                        var ga = a.lock();
                        var gb = b.lock();
                    }
                    {
                        var gb = b.lock();
                        var ga = a.lock();
                    }
                    return 0;
                }
            }
        }
    }
}
