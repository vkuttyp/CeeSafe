// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Host services (type-system.md §26.7-§26.10, ADR 0028): running a program with its output captured, the kind of a
// path, directories, a fresh temporary directory, the working directory and the environment. Hosted only, over
// runtime/hosted/nova_rt_io.c, whose calls return a value or a negated errno. `Process.capture` and `File.kind` are
// the checker's names for HostServices.capture and HostServices.kind.

extern "C" {
    @effects()
    fn nova_host_env(name: *u8, length: u64, value: *mut (*u8), valueLength: *mut u64) -> i64;
    @effects(sleep)
    fn nova_host_path_kind(path: *u8, length: u64) -> i64;
    @effects(sleep)
    fn nova_host_dir_create(path: *u8, length: u64) -> i64;
    @effects(sleep)
    fn nova_host_dir_remove(path: *u8, length: u64) -> i64;
    @effects(sleep, alloc)
    fn nova_host_dir_open(path: *u8, length: u64, error: *mut i32) -> *mut void;
    @effects(sleep)
    fn nova_host_dir_next(dir: *mut void, name: *mut (*u8), length: *mut u64) -> i64;
    @effects(sleep)
    fn nova_host_dir_close(dir: *mut void);
    @effects(sleep)
    fn nova_host_temporary(buffer: *mut u8, capacity: u64) -> i64;
    @effects(sleep)
    fn nova_host_current(buffer: *mut u8, capacity: u64) -> i64;
    @effects(sleep, alloc)
    fn nova_host_spawn(
        arguments: *void,
        count: u64,
        input: *u8,
        inputLength: u64,
        output: *u8,
        outputLength: u64,
        errors: *u8,
        errorsLength: u64,
    ) -> i64;
    @effects()
    fn nova_io_kind(error: i32) -> u32;
}

/// What is at a path (`File.kind`, type-system.md §26.8).
public enum PathKind {
    File,
    Directory,
    Other,
}

/// A finished program's exit status and what it wrote (`Process.capture`, type-system.md §26.7).
public struct ProcessOutput {
    /// The exit status, or 128 plus the signal that ended it, as `Process.run` reports it.
    public status: i32;
    public stdout: Vector<u8>;
    public stderr: Vector<u8>;
}

/// The environment the program started with (type-system.md §26.9).
public struct Environment {
    /// The value of the variable `name` as static text, or null if it is not set or not valid UTF-8.
    /// Safety: the runtime returns getenv's text, which stays valid and unchanged: Nova has no way to change the
    /// environment (C code that calls setenv breaks this, as it does in C).
    public fn variable(name: StringView) -> StringView? {
        var value = 0 as *u8;
        var length: u64 = 0;
        let found = unsafe { nova_host_env(
            name.ptr,
            name.length as u64,
            borrow mut value as *mut (*u8),
            borrow mut length as *mut u64,
        ) };
        if (found != 1) {
            return null;
        }
        let bytes = unsafe { Slice.fromRaw(value, truncate<usize>(length)) };
        return StringView.fromUtf8(bytes);
    }
}

/// Directories (type-system.md §26.10).
public struct Directory {
    /// Makes one directory; `AlreadyExists` if something is there already.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn create(path: StringView) -> Result<void, IoError> {
        let result = unsafe { nova_host_dir_create(path.ptr, path.length as u64) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// Removes an empty directory.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn remove(path: StringView) -> Result<void, IoError> {
        let result = unsafe { nova_host_dir_remove(path.ptr, path.length as u64) };
        return if (result < 0) Err(HostServices.hostError(result)) else Ok();
    }

    /// The names in a directory, without `.` and `..`, sorted by byte value so programs stay deterministic. A name
    /// that is not valid UTF-8 is `InvalidInput`: skipping it could make a program miss a file without a word.
    /// Safety: the listing is closed on every path out (`defer`), and each name is copied before the next call
    /// reuses the runtime's buffer.
    public fn list(path: StringView) -> Result<Vector<String>, IoError> {
        var error: i32 = 0;
        let listing = unsafe { nova_host_dir_open(path.ptr, path.length as u64, borrow mut error as *mut i32) };
        if (listing.isNull()) {
            return Err(HostServices.hostError(0 - (error as i64)));
        }
        defer {
            unsafe { nova_host_dir_close(listing); }
        }
        var names = Vector<String>.create();
        loop {
            var name = 0 as *u8;
            var length: u64 = 0;
            let next = unsafe { nova_host_dir_next(
                listing,
                borrow mut name as *mut (*u8),
                borrow mut length as *mut u64,
            ) };
            if (next == 0) {
                break;
            }
            if (next < 0) {
                return Err(HostServices.hostError(next));
            }
            let bytes = unsafe { Slice.fromRaw(name, truncate<usize>(length)) };
            let text = match (StringView.fromUtf8(bytes)) {
                Some(t) => t,
                null => { return Err(IoError.InvalidInput); }
            };
            let copy = HostServices.stringOrIoError(HostServices.copyText(text))?;
            HostServices.pushed(names.push(copy))?;
        }
        // An insertion sort rather than sortBy: an instance of lib/core's generic sort made here would be emitted in every
        // hosted program, used or not.
        for (i in 1..names.length) {
            var j = i;
            while (j > 0 && HostServices.compareText(names[j - 1], names[j]) > 0) {
                names.swap(j - 1, j);
                j -= 1;
            }
        }
        return Ok(names);
    }

    /// A new, empty directory that only this user can enter, under the platform's temporary directory. The caller
    /// removes it.
    /// Safety: the runtime writes at most the buffer's length.
    public fn temporary() -> Result<String, IoError> {
        var buffer = [0u8; 4096];
        let length = unsafe { nova_host_temporary(borrow mut buffer[0] as *mut u8, 4096) };
        return HostServices.textOf(buffer, length);
    }

    /// The working directory.
    /// Safety: the runtime writes at most the buffer's length.
    public fn current() -> Result<String, IoError> {
        var buffer = [0u8; 4096];
        let length = unsafe { nova_host_current(borrow mut buffer[0] as *mut u8, 4096) };
        return HostServices.textOf(buffer, length);
    }
}

/// A program's argument as the runtime's `nv_str` (a struct is laid out by C's rules, type-system §12; not @repr(C), which would put it in every program's nova_exports.h).
struct HostServicesText {
    ptr: *u8;
    len: u64;
}

/// The functions behind `Process.capture` and `File.kind`.
public struct HostServices {
    /// `Process.capture(program, arguments, input)` (type-system.md §26.7): runs `program`, found on `PATH`, with
    /// `arguments`, `input` as its standard input (empty if null), and returns its exit status and what it wrote to
    /// standard output and standard error. The streams go through files in a private temporary directory, removed
    /// before this returns, so a program that writes much to both cannot block (ADR 0028).
    public fn capture(
        program: StringView,
        arguments: borrow Vector<StringView>,
        input: Slice<u8>?,
    ) -> Result<ProcessOutput, IoError> {
        let directory = Directory.temporary()?;
        let result = HostServices.captureIn(directory.view(), program, arguments, input);
        HostServices.clean(directory.view());
        return result;
    }

    /// `File.kind(path)` (type-system.md §26.8): what is at `path`, following symbolic links, or null if nothing is.
    /// Safety: the runtime reads the path's bytes during the call only.
    public fn kind(path: StringView) -> Result<PathKind?, IoError> {
        let kind = unsafe { nova_host_path_kind(path.ptr, path.length as u64) };
        return match (kind) {
            0 => Ok(null),
            1 => Ok(PathKind.File),
            2 => Ok(PathKind.Directory),
            _ => if (kind < 0) Err(HostServices.hostError(kind)) else Ok(PathKind.Other),
        };
    }

    /// Safety: `texts` holds a view per argument and outlives the call; the runtime reads it and the paths during
    /// the call only.
    fn captureIn(
        directory: StringView,
        program: StringView,
        arguments: borrow Vector<StringView>,
        input: Slice<u8>?,
    ) -> Result<ProcessOutput, IoError> {
        let inPath = HostServices.stringOrIoError(HostServices.pathIn(directory, "in"))?;
        let outPath = HostServices.stringOrIoError(HostServices.pathIn(directory, "out"))?;
        let errPath = HostServices.stringOrIoError(HostServices.pathIn(directory, "err"))?;
        var file = File.create(inPath.view())?;
        match (input) {
            Some(bytes) => { file.write(bytes)?; }
            null => {}
        }
        var texts = Vector<HostServicesText>.create();
        HostServices.pushed(texts.push(unsafe { HostServicesText { ptr: program.ptr, len: program.length as u64 } }))?;
        for (argument in arguments) {
            HostServices.pushed(
                texts.push(unsafe { HostServicesText { ptr: argument.ptr, len: argument.length as u64 } }),
            )?;
        }
        let status = unsafe { nova_host_spawn(
            texts.view().ptr as *void,
            texts.length as u64,
            inPath.view().ptr,
            inPath.length as u64,
            outPath.view().ptr,
            outPath.length as u64,
            errPath.view().ptr,
            errPath.length as u64,
        ) };
        if (status < 0) {
            return Err(HostServices.hostError(status));
        }
        return Ok(
            ProcessOutput {
                status: truncate<i32>(status),
                stdout: HostServices.readAll(outPath.view())?,
                stderr: HostServices.readAll(errPath.view())?,
            },
        );
    }

    /// Removes the three files and the directory, ignoring what is not there.
    fn clean(directory: StringView) {
        for (k in 0..3) {
            let name: StringView = match (k) {
                0 => "in",
                1 => "out",
                _ => "err",
            };
            match (HostServices.pathIn(directory, name)) {
                Ok(path) => { let removed = File.remove(path.view()); }
                Err(_) => {}
            }
        }
        let removed = Directory.remove(directory);
    }

    // The helpers below are this struct's, not lib/std's top-level names: every hosted package shares those, so a
    // top-level `pathIn` or `readAll` here would clash with a program's own (N0201; fixed after 0.4.0).

    /// The text of a runtime call that wrote `length` bytes into `buffer`, or its error.
    fn textOf(buffer: [u8; 4096], length: i64) -> Result<String, IoError> {
        if (length < 0) {
            return Err(HostServices.hostError(length));
        }
        let bytes = buffer;
        let text = match (StringView.fromUtf8(bytes[..truncate<usize>(length)])) {
            Some(t) => t,
            null => { return Err(IoError.InvalidInput); }
        };
        return HostServices.stringOrIoError(HostServices.copyText(text));
    }

    /// `directory/name`.
    fn pathIn(directory: StringView, name: StringView) -> Result<String, AllocError> {
        var path = String.create();
        path.append(directory)?;
        path.append("/")?;
        path.append(name)?;
        return Ok(path);
    }

    fn copyText(text: StringView) -> Result<String, AllocError> {
        var copy = String.create();
        copy.append(text)?;
        return Ok(copy);
    }

    fn stringOrIoError(result: Result<String, AllocError>) -> Result<String, IoError> => match (result) {
        Ok(value) => Ok(value),
        Err(_) => Err(IoError.OutOfMemory),
    };

    /// As stringOrIoError, for `void` results (a generic copy with T = void does not check, type-system.md §20.4).
    fn pushed(result: Result<void, AllocError>) -> Result<void, IoError> => match (result) {
        Ok() => Ok(),
        Err(_) => Err(IoError.OutOfMemory),
    };

    /// The whole file's bytes.
    fn readAll(path: StringView) -> Result<Vector<u8>, IoError> {
        var file = File.open(path)?;
        var bytes = Vector<u8>.create();
        var buffer = [0u8; 65536];
        loop {
            let n = file.read(mut buffer[..])?;
            if (n == 0) {
                break;
            }
            for (i in 0..n) {
                match (bytes.push(buffer[i])) {
                    Ok() => {}
                    Err(_) => { return Err(IoError.OutOfMemory); }
                }
            }
        }
        return Ok(bytes);
    }

    /// Byte-wise order of two strings: negative, zero or positive.
    fn compareText(a: borrow String, b: borrow String) -> i32 {
        let n = if (a.length < b.length) a.length else b.length;
        for (i in 0..n) {
            if (a[i] != b[i]) {
                return if (a[i] < b[i]) -1 else 1;
            }
        }
        return if (a.length < b.length) -1 else if (a.length > b.length) 1 else 0;
    }

    /// The IoError for a negated errno from the runtime (its kinds are NV_IO_* in rt.h, in IoError's variant order).
    /// Safety: nova_io_kind only classifies the number.
    fn hostError(code: i64) -> IoError {
        let error = truncate<i32>(0 - code);
        return match (unsafe { nova_io_kind(error) }) {
            0 => IoError.NotFound,
            1 => IoError.PermissionDenied,
            2 => IoError.AlreadyExists,
            3 => IoError.IsDirectory,
            4 => IoError.NotDirectory,
            5 => IoError.InvalidInput,
            6 => IoError.BrokenPipe,
            7 => IoError.ConnectionRefused,
            8 => IoError.AddressInUse,
            9 => IoError.OutOfMemory,
            _ => IoError.Other(error),
        };
    }
}
