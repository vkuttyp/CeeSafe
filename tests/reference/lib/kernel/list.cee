// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Intrusive lists (ADR 0030): CosmoOS's struct list_node (kernel/include/kernel/list.h), a circular doubly linked
// list whose head and nodes are embedded in other structs. Its helpers are list.h's static inline functions, which an
// extern declaration may call (type-system.md §28.2). A node's struct is recovered with containerOf over offsetOf.
//
// A walk that may remove the node it is on reads the next node first, as list_for_each_entry_safe does:
//
//     var node = List.first(head);
//     while (!node.isNull()) {
//         let after = List.next(head, node);
//         let entry = containerOf(node, offsetOf<wait_entry>(link)) as *mut wait_entry;
//         ...                                  // may List.remove(node)
//         node = after;
//     }

@header("kernel/list.h")
extern "C" {
    struct list_node {
        next: *mut list_node;
        prev: *mut list_node;
    }
    @effects()
    fn list_init(head: *mut list_node);
    @effects()
    fn list_empty(head: *list_node) -> bool;
    @effects()
    fn list_push_back(head: *mut list_node, node: *mut list_node);
    @effects()
    fn list_push_front(head: *mut list_node, node: *mut list_node);
    @effects()
    fn list_remove(node: *mut list_node);
}

/// The operations on an intrusive list. Every one is unsafe: the nodes are raw C state that other code links and
/// unlinks, so the caller holds whatever lock protects the list and keeps every node alive while it is linked.
public struct List {
    /// Makes `head` an empty list (it points to itself).
    /// Safety: `head` is writable and on no list.
    @effects()
    public unsafe fn init(head: *mut list_node) => list_init(head);

    /// Safety: `head` is an initialised list.
    @effects()
    public unsafe fn isEmpty(head: *list_node) -> bool => list_empty(head);

    /// Safety: `head` is an initialised list and `node` is on none.
    @effects()
    public unsafe fn pushBack(head: *mut list_node, node: *mut list_node) => list_push_back(head, node);

    /// Safety: `head` is an initialised list and `node` is on none.
    @effects()
    public unsafe fn pushFront(head: *mut list_node, node: *mut list_node) => list_push_front(head, node);

    /// Unlinks `node` from its list (list.h leaves it pointing to itself).
    /// Safety: `node` is on a list.
    @effects()
    public unsafe fn remove(node: *mut list_node) => list_remove(node);

    /// The first node after `head`, or null when the list is empty.
    /// Safety: `head` is an initialised list.
    @effects()
    public unsafe fn first(head: *list_node) -> *mut list_node {
        let n = Ptr.toBorrow(head).next;
        return if (n as *list_node == head) 0 as *mut list_node else n;
    }

    /// The node after `node` on the list `head`, or null when `node` is the last.
    /// Safety: `head` is an initialised list and `node` is on it.
    @effects()
    public unsafe fn next(head: *list_node, node: *mut list_node) -> *mut list_node {
        let n = Ptr.toBorrow(node as *list_node).next;
        return if (n as *list_node == head) 0 as *mut list_node else n;
    }
}

/// The address of the struct whose field at `offset` (offsetOf<T>(field)) is `node`: C's container_of, cast by the
/// caller to `*mut T`. Not generic, since `T` is usually C-laid-out (it embeds the node), which no type argument may be
/// (type-system.md §33.1).
/// Safety: `node` is that field of a live struct.
@effects()
public unsafe fn containerOf(node: *mut list_node, offset: usize) -> *mut void =>
    (node as *mut u8).sub(offset) as *mut void;
