// SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0
// Locks, guards and per-CPU data (ADR 0025; the locks from C7c). CosmoOS's spinlocks and mutexes as Nova types that hold the data they protect (docs/cosmoos/c7-report.md;
// ADR 0009; type-system.md §32-§33). The lock is CosmoOS's own C state, imported from its headers and embedded by
// value, so the C compiler lays it out and it never moves; the data is reachable only through a guard; holding a
// spin guard is an atomic context, so Nova code that could sleep there does not compile.
//
// CosmoOS's rules these follow (kernel/include/kernel/spinlock.h, mutex.h; audit in c7-report.md):
// - spinlock_init(lock, name) before first use; `name` is the lockdep class name and is kept, so it is static;
// - spin_lock disables preemption until spin_unlock; re-acquiring a held lock on the same CPU panics;
// - spin_lock_irqsave also disables interrupts and returns the state that spin_unlock_irqrestore puts back;
//   nested irqsave locks are released in the reverse order (guards in locals are dropped in that order);
// - mutex_lock sleeps (it calls might_sleep), so it is forbidden with a spinlock held or in an interrupt;
// - an initialised struct mutex points into itself (its wait queue's list heads), so it must never move.

@header("kernel/spinlock.h", "kernel/mutex.h", "kernel/percpu.h", "arch/irq.h", "arch/cpu.h")
extern "C" {
    @ctype("spinlock_t")
    struct spinlock_t;
    struct mutex;
    // Static initialisers (type-system.md §39.4): C macros that expand to a lock as spinlock_init and mutex_init
    // would leave it. A mutex points into itself (its wait queue's and pi_link's list heads), so MUTEX_INIT_AT takes its
    // own address, `here` (ADR 0027); CosmoOS's mutex.h defines it.
    @constant
    fn SPINLOCK_INIT(name: *CChar) -> spinlock_t;
    @constant
    fn MUTEX_INIT_AT(at: *mut mutex, name: *CChar) -> mutex;
    @effects()
    fn preempt_disable();
    @effects()
    fn preempt_enable();
    // arch_irq_state_t is `unsigned long`, which is `size_t` on every CosmoOS target.
    @effects()
    fn arch_irq_save() -> usize;
    @effects()
    fn arch_irq_restore(state: usize);
    @effects()
    fn arch_cpu_id() -> u32;
    @effects()
    fn spinlock_init(lock: *mut spinlock_t, name: *CChar);
    @effects()
    fn spin_lock(lock: *mut spinlock_t);
    @effects()
    fn spin_unlock(lock: *mut spinlock_t);
    // arch_irq_state_t is `unsigned long`, which is `size_t` on every CosmoOS target (and on the hosts).
    @effects()
    fn spin_lock_irqsave(lock: *mut spinlock_t) -> usize;
    @effects()
    fn spin_unlock_irqrestore(lock: *mut spinlock_t, state: usize);
    @effects()
    fn mutex_init(m: *mut mutex, name: *CChar);
    @effects(sleep)
    fn mutex_lock(m: *mut mutex);
    @effects()
    fn mutex_unlock(m: *mut mutex);
}

/// A spinlock and the data it protects. Make one with `SpinLock<T>.create(name, data)`: it holds C state, so it lives
/// in its box and never moves (type-system.md §33). Its fields are private (type-system.md §12), so the data is
/// reached only through a guard, and a guard exists only while the lock is held.
@threadSafe
@noncopy
public struct SpinLock<T: Send> {
    private raw: spinlock_t;
    /// The lockdep class name: a static string ending in a zero byte (spinlock_init keeps the pointer).
    private name: *CChar;
    private data: T;

    /// A lock for a static (type-system.md §39): `static TABLE: SpinLock<Table> = SpinLock.constant("table\0".ptr as
    /// *CChar, Table.empty());`. SPINLOCK_INIT leaves it as `init` would.
    @constant
    public fn constant(name: *CChar, data: T) -> SpinLock<T> =>
        SpinLock { raw: SPINLOCK_INIT(name), name: name, data: data };

    /// Makes one in a KernelHeap box, initialised in place before this returns (type-system.md §33.3). `name` is its
    /// lockdep class name: a static string ending in a zero byte.
    public fn create(name: *CChar, data: T) -> Result<Box<SpinLock<T>, KernelHeap>, AllocError> =>
        Box.createIn(KernelHeap {}, SpinLock { name: name, data: data });

    /// Safety: runs once, at the lock's final address, before anything else can see it (type-system.md §33.3).
    @placed
    fn init(borrow mut this) {
        unsafe { spinlock_init(borrow mut this.raw as *mut spinlock_t, this.name); }
    }

    /// Takes the lock, spinning; preemption is off until the guard is dropped.
    /// Safety: `raw` was initialised by `init`, and spin_lock needs nothing else.
    public fn lock(borrow this) -> SpinGuard<T> {
        unsafe { spin_lock(this.cLock()); }
        return SpinGuard { lock: this };
    }

    /// The C lock. Locking mutates it through a shared reference: the C code synchronises that itself.
    fn cLock(borrow this) -> *mut spinlock_t => borrow this.raw as *spinlock_t as *mut spinlock_t;
}

/// Holding the lock. An atomic context while it is live (type-system.md §32.3); unlocks when dropped.
@context(atomic)
public struct SpinGuard<region r, T: Send> {
    private lock: borrow(r) SpinLock<T>;

    /// The protected data, for as long as the guard is borrowed.
    /// Safety: the lock is held, so this guard is the only way to the data until it is dropped: every access goes
    /// through a guard, and a second guard cannot exist meanwhile (spin_lock does not return, and panics on the
    /// same CPU).
    public fn data(borrow mut this) -> borrow mut T =>
        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };

    /// Safety: the guard holds the lock, which it took in `lock`.
    drop {
        unsafe { spin_unlock(this.lock.cLock()); }
    }
}

/// A spinlock that also disables interrupts while held, for data an interrupt handler shares.
@threadSafe
@noncopy
public struct IrqSpinLock<T: Send> {
    private raw: spinlock_t;
    private name: *CChar;
    private data: T;

    /// A lock for a static, as SpinLock.constant.
    @constant
    public fn constant(name: *CChar, data: T) -> IrqSpinLock<T> =>
        IrqSpinLock { raw: SPINLOCK_INIT(name), name: name, data: data };

    /// Makes one in a KernelHeap box, initialised in place before this returns (type-system.md §33.3). `name` is its
    /// lockdep class name: a static string ending in a zero byte.
    public fn create(name: *CChar, data: T) -> Result<Box<IrqSpinLock<T>, KernelHeap>, AllocError> =>
        Box.createIn(KernelHeap {}, IrqSpinLock { name: name, data: data });

    /// Safety: as SpinLock.init.
    @placed
    fn init(borrow mut this) {
        unsafe { spinlock_init(borrow mut this.raw as *mut spinlock_t, this.name); }
    }

    /// Takes the lock with interrupts disabled; the guard restores them.
    /// Safety: as SpinLock.lock.
    public fn lock(borrow this) -> IrqSpinGuard<T> {
        let state = unsafe { spin_lock_irqsave(this.cLock()) };
        return IrqSpinGuard { lock: this, state: state };
    }

    fn cLock(borrow this) -> *mut spinlock_t => borrow this.raw as *spinlock_t as *mut spinlock_t;
}

@context(atomic)
public struct IrqSpinGuard<region r, T: Send> {
    private lock: borrow(r) IrqSpinLock<T>;
    private state: usize;

    /// Safety: as SpinGuard.data.
    public fn data(borrow mut this) -> borrow mut T =>
        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };

    /// Safety: the guard holds the lock and the interrupt state spin_lock_irqsave returned.
    drop {
        unsafe { spin_unlock_irqrestore(this.lock.cLock(), this.state); }
    }
}

/// A sleeping lock and the data it protects. Its C state points into itself once initialised, which is why it is
/// made in place and never moved.
@threadSafe
@noncopy
public struct Mutex<T: Send> {
    private raw: mutex;
    private name: *CChar;
    private data: T;

    /// A mutex for a static (type-system.md §39): `static TABLE: Mutex<Table> = Mutex.constant("table\0".ptr as *CChar,
    /// Table.empty());`. MUTEX_INIT_AT, given the mutex's own address, leaves it as `init` would (ADR 0027).
    @constant
    public fn constant(name: *CChar, data: T) -> Mutex<T> =>
        Mutex { raw: MUTEX_INIT_AT(here, name), name: name, data: data };

    /// Makes one in a KernelHeap box, initialised in place before this returns (type-system.md §33.3). `name` is its
    /// lockdep class name: a static string ending in a zero byte.
    public fn create(name: *CChar, data: T) -> Result<Box<Mutex<T>, KernelHeap>, AllocError> =>
        Box.createIn(KernelHeap {}, Mutex { name: name, data: data });

    /// Safety: as SpinLock.init.
    @placed
    fn init(borrow mut this) {
        unsafe { mutex_init(borrow mut this.raw as *mut mutex, this.name); }
    }

    /// Takes the mutex, sleeping until it is free: forbidden in atomic contexts (its effect is `sleep`).
    /// Safety: `raw` was initialised by `init`.
    public fn lock(borrow this) -> MutexGuard<T> {
        unsafe { mutex_lock(this.cLock()); }
        return MutexGuard { lock: this };
    }

    fn cLock(borrow this) -> *mut mutex => borrow this.raw as *mutex as *mut mutex;
}

/// Holding the mutex. Not an atomic context: code under a mutex may sleep.
public struct MutexGuard<region r, T: Send> {
    private lock: borrow(r) Mutex<T>;

    /// Safety: as SpinGuard.data, for the mutex.
    public fn data(borrow mut this) -> borrow mut T =>
        unsafe { Ptr.toBorrowMut(borrow this.lock.data as *T as *mut T) };

    /// Safety: the guard holds the mutex, which it took in `lock`.
    drop {
        unsafe { mutex_unlock(this.lock.cLock()); }
    }
}

/// Preemption off on this CPU until dropped (CosmoOS's preempt_disable, nestable): an atomic context, so nothing
/// under it may sleep. The thread stays on this CPU, but its interrupt handlers still run.
@context(atomic)
@noncopy
public struct PreemptGuard {
    private unused: u8;

    /// Safety: preempt_disable needs nothing; the guard's drop is its matching preempt_enable.
    public fn enter() -> PreemptGuard {
        unsafe { preempt_disable(); }
        return PreemptGuard { unused: 0 };
    }

    /// Safety: the guard disabled preemption in `enter`, once.
    drop {
        unsafe { preempt_enable(); }
    }
}

/// Interrupts off on this CPU until dropped (arch_irq_save, nestable): an atomic context, in which this CPU's thread
/// cannot be preempted and its interrupt handlers cannot run.
@context(atomic)
@noncopy
public struct IrqGuard {
    private state: usize;

    /// Safety: arch_irq_save needs nothing and nests; the guard's drop restores the state it returned.
    public fn enter() -> IrqGuard => IrqGuard { state: unsafe { arch_irq_save() } };

    /// Safety: the state is the one arch_irq_save returned in `enter`, restored once.
    drop {
        unsafe { arch_irq_restore(this.state); }
    }
}

/// The number of CPUs a PerCpu<T> holds a value for: CosmoOS's CONFIG_MAX_CPUS (kernel/include/kernel/percpu.h).
public const MAX_CPUS: usize = 64;

/// One value of `T` per CPU (ADR 0024 §3.3, ADR 0025 §3.3). `p.local(borrow guard)` lends the calling CPU's value
/// while interrupts are off, so neither another thread nor an interrupt handler on this CPU can reach it meanwhile, and
/// no other CPU ever does. A second `local` of the same value on the same CPU, while the first is lent, panics.
@threadSafe
@noncopy
public struct PerCpu<T: Copy + Send> {
    private values: [T; 64];
    private lent: [bool; 64];

    /// A per-CPU value for a static: `v` on every CPU.
    @constant
    public fn constant(v: T) -> PerCpu<T> => PerCpu { values: [v; 64], lent: [false; 64] };

    /// This CPU's value, lent until the PerCpuRef drops, which also drops `guard` and so turns interrupts back on:
    /// `TICKS.local(IrqGuard.enter())`.
    /// Safety: with interrupts off on this CPU, the code that runs here until the guard drops is this thread's; the
    /// value is this CPU's, which no other CPU's code reaches; `lent` makes a second loan on this CPU panic. So the
    /// PerCpuRef this returns is the only way to the value while it lives.
    public fn local(borrow this, guard: IrqGuard) -> PerCpuRef<T> {
        let cpu = unsafe { arch_cpu_id() } as usize;
        let lent = unsafe { Ptr.toBorrowMut(borrow this.lent[cpu] as *bool as *mut bool) };
        if (lent) {
            alreadyLent();
        }
        lent = true;
        return PerCpuRef { owner: this, guard: guard, cpu: cpu };
    }
}

/// A loan of one CPU's value of a PerCpu<T>, made by PerCpu.local; dropping it ends the loan.
@noncopy
public struct PerCpuRef<region r, T: Copy + Send> {
    private owner: borrow(r) PerCpu<T>;
    private guard: IrqGuard;
    private cpu: usize;

    /// The value, for as long as this is borrowed.
    /// Safety: as PerCpu.local: this loan is the only way to the value while it lives.
    public fn get(borrow mut this) -> borrow mut T =>
        unsafe { Ptr.toBorrowMut(borrow this.owner.values[this.cpu] as *T as *mut T) };

    /// Safety: this loan set `lent` in PerCpu.local and is its only holder.
    drop {
        let lent = unsafe { Ptr.toBorrowMut(borrow this.owner.lent[this.cpu] as *bool as *mut bool) };
        lent = false;
    }
}

/// A second loan of one CPU's value of a PerCpu: a panic, through the runtime's nova_panic (the kernel's), as an
/// empty optional's unwrap is (type-system.md §22).
fn alreadyLent() {
    let none: u8? = null;
    let unreachable = none!;
}
