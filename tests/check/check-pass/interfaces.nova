interface Shape { fn area(borrow this) -> i64; fn grow(borrow mut this, by: i64); }
interface Compare<T> { fn less(borrow this, other: borrow T) -> bool; }
interface Describe { fn code(this) -> u32; }
struct Square { side: i64; }
enum Color { Red, Blue }

impl Shape for Square {
    fn area(borrow this) -> i64 => this.side * this.side;
    fn grow(borrow mut this, by: i64) {
        this.side += by;
    }
}
impl Compare<Square> for Square { fn less(borrow this, other: borrow Square) -> bool => this.side < other.side; }
impl Describe for Color {
    fn code(this) -> u32 => match (this) {
        Color.Red => 1,
        Color.Blue => 2,
    };
}
impl Describe for u8 { fn code(this) -> u32 => this as u32; }

fn total<S: Shape>(s: borrow S) -> i64 => s.area();
fn enlarge<S: Shape>(s: borrow mut S) {
    s.grow(1);
}
fn smaller<T: Compare<T>>(a: T, b: T) -> bool => a.less(b);
fn describe<D: Describe + Copy>(d: D) -> u32 => d.code();

fn main() {
    var s = Square { side: 2 };
    let a = s.area() + total(s);
    enlarge(mut s);
    let small = smaller(Square { side: 1 }, Square { side: 3 });
    let c = Color.Red.code() + describe(Color.Blue) + describe(7u8);
    let x: u8 = 3;
    let y = x.code();
}
