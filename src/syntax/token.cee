fn intSuffixName(suffix: IntSuffix) -> StringView => match (suffix) {
    IntSuffix.None => "None",
    IntSuffix.I8 => "I8",
    IntSuffix.I16 => "I16",
    IntSuffix.I32 => "I32",
    IntSuffix.I64 => "I64",
    IntSuffix.ISize => "ISize",
    IntSuffix.U8 => "U8",
    IntSuffix.U16 => "U16",
    IntSuffix.U32 => "U32",
    IntSuffix.U64 => "U64",
    IntSuffix.USize => "USize",
};

fn floatSuffixName(suffix: FloatSuffix) -> StringView => match (suffix) {
    FloatSuffix.None => "None",
    FloatSuffix.F32 => "F32",
    FloatSuffix.F64 => "F64",
};
