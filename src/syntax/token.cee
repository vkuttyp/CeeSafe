// Tokens (the reference's Syntax/Token.cs; grammar.md §1). Spans are byte offsets into the source text; positions in
// dumps and diagnostics are converted to the reference's UTF-16 columns by SourceText (src/support/source.nova).

enum TokenKind {
    EndOfFile,

    Identifier,
    IntLiteral,
    FloatLiteral,
    StringLiteral,
    CharLiteral,
    Underscore,

    // Keywords (grammar.md §1.3), in the reference's order. Keep in step with keywordOf and keywordText.
    AsKeyword,
    AsyncKeyword,
    AwaitKeyword,
    BorrowKeyword,
    BreakKeyword,
    ClassKeyword,
    ConstKeyword,
    ContinueKeyword,
    DeferKeyword,
    DropKeyword,
    ElseKeyword,
    EnumKeyword,
    ExternKeyword,
    FalseKeyword,
    FnKeyword,
    ForKeyword,
    IfKeyword,
    ImplKeyword,
    ImportKeyword,
    InKeyword,
    InterfaceKeyword,
    InternalKeyword,
    LetKeyword,
    LoopKeyword,
    MacroKeyword,
    MatchKeyword,
    MoveKeyword,
    MutKeyword,
    NamespaceKeyword,
    NullKeyword,
    OwnKeyword,
    PrivateKeyword,
    PublicKeyword,
    ReturnKeyword,
    SelfTypeKeyword,
    StaticKeyword,
    StructKeyword,
    ThisKeyword,
    TrueKeyword,
    TypeKeyword,
    UnsafeKeyword,
    UsingKeyword,
    VarKeyword,
    WhereKeyword,
    WhileKeyword,
    YieldKeyword,

    // Punctuation
    OpenParen,
    CloseParen,
    OpenBrace,
    CloseBrace,
    OpenBracket,
    CloseBracket,
    Comma,
    Semicolon,
    Colon,
    Dot,
    DotDot,
    At,
    Question,
    Arrow,
    FatArrow,

    // Operators
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Bang,
    Amp,
    Pipe,
    Caret,
    Tilde,
    AmpAmp,
    PipePipe,
    LessLess,
    Equals,
    EqualsEquals,
    BangEquals,
    Less,
    LessEquals,
    Greater,
    GreaterEquals,
    PlusEquals,
    MinusEquals,
    StarEquals,
    SlashEquals,
    PercentEquals,
    AmpEquals,
    PipeEquals,
    CaretEquals,
    LessLessEquals,
}

/// The kind's position in the declaration (enums have no `==`; the parser compares kinds by this).
fn kindIndex(kind: TokenKind) -> u32 => match (kind) {
    TokenKind.EndOfFile => 0,
    TokenKind.Identifier => 1,
    TokenKind.IntLiteral => 2,
    TokenKind.FloatLiteral => 3,
    TokenKind.StringLiteral => 4,
    TokenKind.CharLiteral => 5,
    TokenKind.Underscore => 6,
    TokenKind.AsKeyword => 7,
    TokenKind.AsyncKeyword => 8,
    TokenKind.AwaitKeyword => 9,
    TokenKind.BorrowKeyword => 10,
    TokenKind.BreakKeyword => 11,
    TokenKind.ClassKeyword => 12,
    TokenKind.ConstKeyword => 13,
    TokenKind.ContinueKeyword => 14,
    TokenKind.DeferKeyword => 15,
    TokenKind.DropKeyword => 16,
    TokenKind.ElseKeyword => 17,
    TokenKind.EnumKeyword => 18,
    TokenKind.ExternKeyword => 19,
    TokenKind.FalseKeyword => 20,
    TokenKind.FnKeyword => 21,
    TokenKind.ForKeyword => 22,
    TokenKind.IfKeyword => 23,
    TokenKind.ImplKeyword => 24,
    TokenKind.ImportKeyword => 25,
    TokenKind.InKeyword => 26,
    TokenKind.InterfaceKeyword => 27,
    TokenKind.InternalKeyword => 28,
    TokenKind.LetKeyword => 29,
    TokenKind.LoopKeyword => 30,
    TokenKind.MacroKeyword => 31,
    TokenKind.MatchKeyword => 32,
    TokenKind.MoveKeyword => 33,
    TokenKind.MutKeyword => 34,
    TokenKind.NamespaceKeyword => 35,
    TokenKind.NullKeyword => 36,
    TokenKind.OwnKeyword => 37,
    TokenKind.PrivateKeyword => 38,
    TokenKind.PublicKeyword => 39,
    TokenKind.ReturnKeyword => 40,
    TokenKind.SelfTypeKeyword => 41,
    TokenKind.StaticKeyword => 42,
    TokenKind.StructKeyword => 43,
    TokenKind.ThisKeyword => 44,
    TokenKind.TrueKeyword => 45,
    TokenKind.TypeKeyword => 46,
    TokenKind.UnsafeKeyword => 47,
    TokenKind.UsingKeyword => 48,
    TokenKind.VarKeyword => 49,
    TokenKind.WhereKeyword => 50,
    TokenKind.WhileKeyword => 51,
    TokenKind.YieldKeyword => 52,
    TokenKind.OpenParen => 53,
    TokenKind.CloseParen => 54,
    TokenKind.OpenBrace => 55,
    TokenKind.CloseBrace => 56,
    TokenKind.OpenBracket => 57,
    TokenKind.CloseBracket => 58,
    TokenKind.Comma => 59,
    TokenKind.Semicolon => 60,
    TokenKind.Colon => 61,
    TokenKind.Dot => 62,
    TokenKind.DotDot => 63,
    TokenKind.At => 64,
    TokenKind.Question => 65,
    TokenKind.Arrow => 66,
    TokenKind.FatArrow => 67,
    TokenKind.Plus => 68,
    TokenKind.Minus => 69,
    TokenKind.Star => 70,
    TokenKind.Slash => 71,
    TokenKind.Percent => 72,
    TokenKind.Bang => 73,
    TokenKind.Amp => 74,
    TokenKind.Pipe => 75,
    TokenKind.Caret => 76,
    TokenKind.Tilde => 77,
    TokenKind.AmpAmp => 78,
    TokenKind.PipePipe => 79,
    TokenKind.LessLess => 80,
    TokenKind.Equals => 81,
    TokenKind.EqualsEquals => 82,
    TokenKind.BangEquals => 83,
    TokenKind.Less => 84,
    TokenKind.LessEquals => 85,
    TokenKind.Greater => 86,
    TokenKind.GreaterEquals => 87,
    TokenKind.PlusEquals => 88,
    TokenKind.MinusEquals => 89,
    TokenKind.StarEquals => 90,
    TokenKind.SlashEquals => 91,
    TokenKind.PercentEquals => 92,
    TokenKind.AmpEquals => 93,
    TokenKind.PipeEquals => 94,
    TokenKind.CaretEquals => 95,
    TokenKind.LessLessEquals => 96,
};

fn sameKind(a: TokenKind, b: TokenKind) -> bool => kindIndex(a) == kindIndex(b);

enum IntSuffix {
    None,
    I8,
    I16,
    I32,
    I64,
    ISize,
    U8,
    U16,
    U32,
    U64,
    USize,
}

enum FloatSuffix {
    None,
    F32,
    F64,
}

/// A token. `data` depends on the kind: the symbol id for identifiers, or the index into the matching literal table of
/// `Lexed` for literals. `start` and `end` are byte offsets.
struct Token {
    kind: TokenKind;
    start: u32;
    end: u32;
    data: u32;
}

struct IntLiteral {
    value: u64;
    suffix: IntSuffix;
}

/// A float literal's text without digit separators, kept as text so the type checker can round it exactly once.
struct FloatLiteral {
    digits: Vector<u8>;
    suffix: FloatSuffix;
}

/// The keyword spelled by `text`, or null (Keywords.Table).
fn keywordOf(text: Slice<u8>) -> TokenKind? {
    if (text.length < 2 || text.length > 9) {
        return null;
    }
    for (k in 0..46usize) {
        let kind = keywordAt(k);
        if (sameText(text, keywordText(kind))) {
            return kind;
        }
    }
    return null;
}

/// The k-th keyword, in the reference's order.
fn keywordAt(k: usize) -> TokenKind => match (k) {
    0 => TokenKind.AsKeyword,
    1 => TokenKind.AsyncKeyword,
    2 => TokenKind.AwaitKeyword,
    3 => TokenKind.BorrowKeyword,
    4 => TokenKind.BreakKeyword,
    5 => TokenKind.ClassKeyword,
    6 => TokenKind.ConstKeyword,
    7 => TokenKind.ContinueKeyword,
    8 => TokenKind.DeferKeyword,
    9 => TokenKind.DropKeyword,
    10 => TokenKind.ElseKeyword,
    11 => TokenKind.EnumKeyword,
    12 => TokenKind.ExternKeyword,
    13 => TokenKind.FalseKeyword,
    14 => TokenKind.FnKeyword,
    15 => TokenKind.ForKeyword,
    16 => TokenKind.IfKeyword,
    17 => TokenKind.ImplKeyword,
    18 => TokenKind.ImportKeyword,
    19 => TokenKind.InKeyword,
    20 => TokenKind.InterfaceKeyword,
    21 => TokenKind.InternalKeyword,
    22 => TokenKind.LetKeyword,
    23 => TokenKind.LoopKeyword,
    24 => TokenKind.MacroKeyword,
    25 => TokenKind.MatchKeyword,
    26 => TokenKind.MoveKeyword,
    27 => TokenKind.MutKeyword,
    28 => TokenKind.NamespaceKeyword,
    29 => TokenKind.NullKeyword,
    30 => TokenKind.OwnKeyword,
    31 => TokenKind.PrivateKeyword,
    32 => TokenKind.PublicKeyword,
    33 => TokenKind.ReturnKeyword,
    34 => TokenKind.SelfTypeKeyword,
    35 => TokenKind.StaticKeyword,
    36 => TokenKind.StructKeyword,
    37 => TokenKind.ThisKeyword,
    38 => TokenKind.TrueKeyword,
    39 => TokenKind.TypeKeyword,
    40 => TokenKind.UnsafeKeyword,
    41 => TokenKind.UsingKeyword,
    42 => TokenKind.VarKeyword,
    43 => TokenKind.WhereKeyword,
    44 => TokenKind.WhileKeyword,
    _ => TokenKind.YieldKeyword,
};

/// A keyword's spelling, or "" for any other kind.
fn keywordText(kind: TokenKind) -> StringView => match (kind) {
    TokenKind.AsKeyword => "as",
    TokenKind.AsyncKeyword => "async",
    TokenKind.AwaitKeyword => "await",
    TokenKind.BorrowKeyword => "borrow",
    TokenKind.BreakKeyword => "break",
    TokenKind.ClassKeyword => "class",
    TokenKind.ConstKeyword => "const",
    TokenKind.ContinueKeyword => "continue",
    TokenKind.DeferKeyword => "defer",
    TokenKind.DropKeyword => "drop",
    TokenKind.ElseKeyword => "else",
    TokenKind.EnumKeyword => "enum",
    TokenKind.ExternKeyword => "extern",
    TokenKind.FalseKeyword => "false",
    TokenKind.FnKeyword => "fn",
    TokenKind.ForKeyword => "for",
    TokenKind.IfKeyword => "if",
    TokenKind.ImplKeyword => "impl",
    TokenKind.ImportKeyword => "import",
    TokenKind.InKeyword => "in",
    TokenKind.InterfaceKeyword => "interface",
    TokenKind.InternalKeyword => "internal",
    TokenKind.LetKeyword => "let",
    TokenKind.LoopKeyword => "loop",
    TokenKind.MacroKeyword => "macro",
    TokenKind.MatchKeyword => "match",
    TokenKind.MoveKeyword => "move",
    TokenKind.MutKeyword => "mut",
    TokenKind.NamespaceKeyword => "namespace",
    TokenKind.NullKeyword => "null",
    TokenKind.OwnKeyword => "own",
    TokenKind.PrivateKeyword => "private",
    TokenKind.PublicKeyword => "public",
    TokenKind.ReturnKeyword => "return",
    TokenKind.SelfTypeKeyword => "Self",
    TokenKind.StaticKeyword => "static",
    TokenKind.StructKeyword => "struct",
    TokenKind.ThisKeyword => "this",
    TokenKind.TrueKeyword => "true",
    TokenKind.TypeKeyword => "type",
    TokenKind.UnsafeKeyword => "unsafe",
    TokenKind.UsingKeyword => "using",
    TokenKind.VarKeyword => "var",
    TokenKind.WhereKeyword => "where",
    TokenKind.WhileKeyword => "while",
    TokenKind.YieldKeyword => "yield",
    _ => "",
};

fn isKeyword(kind: TokenKind) -> bool => keywordText(kind).length > 0;

/// A punctuation or operator token's spelling (TokenFacts.Text), "_" for Underscore, a keyword's spelling, else the
/// kind's name as the reference's enum prints it.
fn tokenText(kind: TokenKind) -> StringView => match (kind) {
    TokenKind.Underscore => "_",
    TokenKind.OpenParen => "(",
    TokenKind.CloseParen => ")",
    TokenKind.OpenBrace => "{",
    TokenKind.CloseBrace => "}",
    TokenKind.OpenBracket => "[",
    TokenKind.CloseBracket => "]",
    TokenKind.Comma => ",",
    TokenKind.Semicolon => ";",
    TokenKind.Colon => ":",
    TokenKind.Dot => ".",
    TokenKind.DotDot => "..",
    TokenKind.At => "@",
    TokenKind.Question => "?",
    TokenKind.Arrow => "->",
    TokenKind.FatArrow => "=>",
    TokenKind.Plus => "+",
    TokenKind.Minus => "-",
    TokenKind.Star => "*",
    TokenKind.Slash => "/",
    TokenKind.Percent => "%",
    TokenKind.Bang => "!",
    TokenKind.Amp => "&",
    TokenKind.Pipe => "|",
    TokenKind.Caret => "^",
    TokenKind.Tilde => "~",
    TokenKind.AmpAmp => "&&",
    TokenKind.PipePipe => "||",
    TokenKind.LessLess => "<<",
    TokenKind.Equals => "=",
    TokenKind.EqualsEquals => "==",
    TokenKind.BangEquals => "!=",
    TokenKind.Less => "<",
    TokenKind.LessEquals => "<=",
    TokenKind.Greater => ">",
    TokenKind.GreaterEquals => ">=",
    TokenKind.PlusEquals => "+=",
    TokenKind.MinusEquals => "-=",
    TokenKind.StarEquals => "*=",
    TokenKind.SlashEquals => "/=",
    TokenKind.PercentEquals => "%=",
    TokenKind.AmpEquals => "&=",
    TokenKind.PipeEquals => "|=",
    TokenKind.CaretEquals => "^=",
    TokenKind.LessLessEquals => "<<=",
    TokenKind.EndOfFile => "EndOfFile",
    TokenKind.Identifier => "Identifier",
    TokenKind.IntLiteral => "IntLiteral",
    TokenKind.FloatLiteral => "FloatLiteral",
    TokenKind.StringLiteral => "StringLiteral",
    TokenKind.CharLiteral => "CharLiteral",
    _ => keywordText(kind),
};

/// How a token kind is named in diagnostics ("expected ';', found identifier"; TokenFacts.Describe). The quoted forms
/// are built by the caller from tokenText, since a view cannot be built here.
fn describeWord(kind: TokenKind) -> StringView? => match (kind) {
    TokenKind.EndOfFile => "end of file",
    TokenKind.Identifier => "identifier",
    TokenKind.IntLiteral => "integer literal",
    TokenKind.FloatLiteral => "float literal",
    TokenKind.StringLiteral => "string literal",
    TokenKind.CharLiteral => "char literal",
    _ => null,
};

