// The C emitter (the reference's Backend.C/CEmitter.cs): every operation that can be undefined in C a call of a
// checked helper from nova/rt.h (c-backend.md), function bodies structured by c_structurer.cee or, with --flat-c or an
// irreducible graph, flat (one label per NIR block, terminators as goto, switch and return). Closure variants,
// placement and check elimination are on by default, as in novac.
//
// The program is emitted twice, as by the reference: the first (trial) emission collects the helpers' location
// constants and the boxes built in place, which the second writes before the code that uses them.

/// One output file: main.c, or in split mode a unit (ADR 0022).
struct CFile {
    name: Vector<u8>;
    text: Vector<u8>;
}

/// A location a checked helper may panic with (`nvL_<n>`): its file id, line and column.
struct CSite {
    file: u32;
    line: u32;
    column: u32;
}

/// A Box.create built in place (InPlaceSites): the site's statement and the construction before it.
struct InPlacePair {
    site: u32;         // NirProgram.statements
    construction: u32; // NirProgram.statements
}

struct CEmitter {
    split: bool;
    lineDirectives: bool;
    programName: Vector<u8>;
    exportsHeader: Vector<u8>;
    trial: bool;
    files: Vector<CFile>;
    current: usize;                        // the file being written
    buf: Vector<u8>;                       // the line being built
    fileIds: Vector<u32>;                  // by source: its `nv_file_<id>`, or none
    fileOrder: Vector<u32>;                // the sources named, in id order
    sites: Map<PairKey, u32>;              // (file << 32 | line, column) → id
    siteList: Vector<CSite>;               // by id
    usedLibrary: Vector<bool>;             // by HIR function: library code that compiled code reaches (§29.2)
    usedVariants: Vector<u64>;             // the library (function, variant) pairs reached (variantKey)
    placements: Vector<FunctionPlacement>; // by NIR function: its stack-placed boxes (empty with --no-placement)
    checks: CheckResults;                  // index and overflow checks proved not to fail (optimisations.md §2–§3)
    bce: bool;                             // off: --no-bce
    oce: bool;                             // off: --no-oce
    usedTypes: Vector<bool>;               // by type: mentioned by emitted code
    inPlaceResults: Vector<bool>;          // by type: Box.create results some site builds in place (nvBA_)
    zeroedResults: Vector<bool>;           // by type: Box.create results some site builds from all-zero bytes (ceeBZ_)
    headerStructs: Vector<u32>;            // defined by the exports header (ADR 0030)
    compiled: Vector<u32>;                 // the NIR functions compiled to C (CompiledFunctions)
    composites: Vector<u32>;               // Composites
    aggregates: Vector<u32>;               // Aggregates
    staticStrings: Vector<Vector<u8>>;     // the C strings statics point to, in first-use order
    splitData: Vector<Vector<u8>>;         // C data split mode renames (sorted)
    function: u32;                         // the NIR function being emitted, or none
    inPlace: Vector<InPlacePair>;
    cLines: u64;
    mappedFile: u32; // the Nova line the next C line is attributed to by the last #line, or none
    mappedLine: u32;
    wantedFile: u32; // the line the current statement wants, or none
    wantedLine: u32;
    pendingLabel: Vector<u8>;      // with directives, a label shares the next statement's line
    paths: Vector<Vector<u8>>;     // by source: its path, as #line names it
    unitNames: Vector<Vector<u8>>; // split mode: by source, its unit's name, or empty
    hasPendingLabel: bool;
    structured: bool; // c-backend.md §3 (off: --flat-c)
    capturing: bool;  // structured form: statement lines are collected for the tree
    capture: Vector<Vector<u8>>;

    fn create(trial: bool) -> CEmitter => CEmitter {
        split: false,
        lineDirectives: false,
        programName: Vector<u8>.create(),
        exportsHeader: Vector<u8>.create(),
        trial: trial,
        files: Vector<CFile>.create(),
        current: 0,
        buf: Vector<u8>.create(),
        fileIds: Vector<u32>.create(),
        fileOrder: Vector<u32>.create(),
        sites: Map<PairKey, u32>.create(),
        siteList: Vector<CSite>.create(),
        usedLibrary: Vector<bool>.create(),
        usedVariants: Vector<u64>.create(),
        placements: Vector<FunctionPlacement>.create(),
        checks: CheckResults {
            removed: Vector<bool>.create(),
            noOverflow: Vector<bool>.create(),
            ascii: Vector<bool>.create(),
        },
        bce: false,
        oce: false,
        usedTypes: Vector<bool>.create(),
        inPlaceResults: Vector<bool>.create(),
        zeroedResults: Vector<bool>.create(),
        headerStructs: Vector<u32>.create(),
        compiled: Vector<u32>.create(),
        composites: Vector<u32>.create(),
        aggregates: Vector<u32>.create(),
        staticStrings: Vector<Vector<u8>>.create(),
        splitData: Vector<Vector<u8>>.create(),
        function: none(),
        inPlace: Vector<InPlacePair>.create(),
        cLines: 0,
        mappedFile: none(),
        mappedLine: 0,
        wantedFile: none(),
        wantedLine: 0,
        pendingLabel: Vector<u8>.create(),
        paths: Vector<Vector<u8>>.create(),
        unitNames: Vector<Vector<u8>>.create(),
        hasPendingLabel: false,
        structured: false,
        capturing: false,
        capture: Vector<Vector<u8>>.create(),
    };

    /// Starts writing the named file (Into, split mode); a file named twice is continued.
    fn into(borrow mut this, name: Slice<u8>) -> Result<void, AllocError> {
        if (!this.split) {
            return Ok();
        }
        var found = this.files.length;
        for (k in 0..this.files.length) {
            if (found == this.files.length && sameBytes(this.files[k].name.view(), name)) {
                found = k;
            }
        }
        if (found == this.files.length) {
            this.files.push(CFile { name: copyBytes(name)?, text: Vector<u8>.create() })?;
        }
        this.current = found;
        this.mappedFile = none(); // each file maps its own lines (§7)
        return Ok();
    }

    /// The linkage of a function defined in a unit or in nova_instances.c (Fn): external when split.
    fn fnPrefix(borrow mut this) -> Result<void, AllocError> =>
        if (this.split) Ok() else appendText(mut this.buf, "static ");

    /// The same for a prototype (FnProto).
    fn fnProto(borrow mut this) -> Result<void, AllocError> =>
        appendText(mut this.buf, if (this.split) "CEE_UNUSED " else "static CEE_UNUSED ");

    /// The linkage of a per-type helper (Helper): `static inline` in the header when split (ADR 0022 §3.2).
    fn helper(borrow mut this) -> Result<void, AllocError> =>
        appendText(mut this.buf, if (this.split) "static inline " else "static ");

    /// The same for a prototype (HelperProto).
    fn helperProto(borrow mut this) -> Result<void, AllocError> =>
        appendText(mut this.buf, if (this.split) "static inline CEE_UNUSED " else "static CEE_UNUSED ");

    /// Appends text to the line being built.
    fn t(borrow mut this, text: StringView) -> Result<void, AllocError> => appendText(mut this.buf, text);

    fn b(borrow mut this, bytes: Slice<u8>) -> Result<void, AllocError> => appendBytes(mut this.buf, bytes);

    fn d(borrow mut this, value: u64) -> Result<void, AllocError> => appendDecimal(mut this.buf, value);

    /// Writes the line built (Line): with directives on, inside a function each code line is attributed to the wanted
    /// Nova line, a `#line` first whenever it would otherwise map elsewhere.
    fn emit(borrow mut this) -> Result<void, AllocError> => this.emitLine(true);

    /// The same for a line that generates no code (a brace, `else`): it needs no directive of its own.
    fn emitNoCode(borrow mut this) -> Result<void, AllocError> => this.emitLine(false);

    fn emitLine(borrow mut this, code: bool) -> Result<void, AllocError> {
        let text = copyBytes(this.buf.view())?;
        this.buf.clear();
        return this.writeLine(text.view(), code);
    }

    fn line(borrow mut this, text: StringView) -> Result<void, AllocError> => this.writeLine(text.bytes(), true);

    fn writeLine(borrow mut this, text: Slice<u8>, code: bool) -> Result<void, AllocError> {
        if (this.capturing) {
            return this.capture.push(copyBytes(text)?);
        }
        if (this.files.length == 0) {
            this.files.push(CFile { name: copyBytes("main.c".bytes())?, text: Vector<u8>.create() })?;
        }
        let k = this.current;
        if (code && this.wantedFile != none() &&
            (this.mappedFile != this.wantedFile || this.mappedLine != this.wantedLine)) {
            appendText(mut this.files[k].text, "#line ")?;
            appendDecimal(mut this.files[k].text, this.wantedLine as u64)?;
            this.files[k].text.push(' ')?;
            appendCStringLiteral(mut this.files[k].text, this.paths[this.wantedFile as usize].view())?;
            this.files[k].text.push('\n')?;
            this.cLines += 1;
            this.mappedFile = this.wantedFile;
            this.mappedLine = this.wantedLine;
        }
        var start: usize = 0;
        if (this.hasPendingLabel) {
            appendBytes(mut this.files[k].text, this.pendingLabel.view())?;
            this.hasPendingLabel = false;
            while (start < text.length && (text[start] == ' ' || text[start] == '\t' || text[start] == '\n' ||
                text[start] == '\r')) {
                start += 1;
            }
        }
        appendBytes(mut this.files[k].text, text[start..])?;
        this.files[k].text.push('\n')?;
        var lines: u32 = 1;
        for (ch in text[start..]) {
            if (ch == '\n') {
                lines += 1;
            }
        }
        this.cLines += lines as u64;
        if (this.mappedFile != none()) {
            this.mappedLine += lines;
        }
        return Ok();
    }
}
