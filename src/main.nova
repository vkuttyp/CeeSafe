/// ceesafec: the CeeSafe compiler, being ported from Nova's C# novac (ROADMAP.md).
/// P2 in progress: `parse` lexes and parses its files and reports their diagnostics (text, or the reference's JSON
/// with `--diagnostics-format=json`); `--dump-ast` prints the tree as the reference does, and `--dump-tokens` the
/// lexer's output for the token-dump oracle. Every other command says which phase implements it.
fn usage() {
    Console.writeLine("usage: ceesafec <command> [options] <file.nova>...");
    Console.writeLine("");
    Console.writeLine("Commands are novac's (docs/reference-inventory.md §2). Implemented so far:");
    Console.writeLine("  parse <file.nova>...   parse the files and report their diagnostics");
    Console.writeLine("    --dump-ast                  print each file's syntax tree");
    Console.writeLine("    --diagnostics-format=json   diagnostics as the reference's JSON document, on stdout");
    Console.writeLine(
        "    --dump-tokens               print the lexer's output (CeeSafe only; docs/p2-frontend.md §3)",
    );
    Console.writeLine("  --version    print the version");
    Console.writeLine("  -h, --help   print this text");
}

/// The roadmap phase that brings a command to parity, or null if novac has no such command.
fn phaseOf(command: StringView) -> StringView? {
    if (command == "parse") {
        return "P2";
    }
    if (command == "check") {
        return "P4";
    }
    if (command == "build") {
        return "P5";
    }
    if (command == "run" || command == "fmt" || command == "new" || command == "agents" || command == "fetch" ||
        command == "publish" || command == "index-check" || command == "lsp" || command == "mcp" || command == "fix" ||
        command == "explain" || command == "doc") {
        return "P8";
    }
    return null;
}

/// The options of a file command, after `--diagnostics-format` is taken out (Program.cs's TakeDiagnosticsFormat and
/// ParseOptions).
struct Options {
    json: bool;
    dumpTokens: bool;
    dumpAst: bool;
    dumpHir: bool;
    noFloat: bool;
    libraryDiagnostics: bool;  // report diagnostics in the libraries' files too (porting gaps there; novac has none)
    freestanding: bool;        // --profile freestanding (cosmoos/profiles.md §4)
    kernel: bool;              // --kernel cosmoos: lib/kernel, in the freestanding profile (ADR 0025)
    profileGiven: bool;        // --profile was given: package mode keeps it over the manifest's
    building: bool;            // `build`: until P5, only `--dump-nir`, which prints the NIR and stops
    dumpNir: bool;             // --dump-nir (build)
    emit: Vector<u8>;          // --emit c|exe|obj (build)
    output: Vector<u8>;        // -o (build), or empty
    exportsHeader: Vector<u8>; // --exports-header (build)
    emitGiven: bool;
    lineDirectives: bool;       // --line-directives or -g (build)
    debug: bool;                // -g (build)
    split: bool;                // --split (build)
    programName: Vector<u8>;    // --program (build), or the package's name
    cc: Vector<u8>;             // --cc, else $CC (build)
    cflags: Vector<Vector<u8>>; // --cflag (build)
    linker: Vector<u8>;         // --ld (build --emit obj)
    cNames: Vector<Vector<u8>>; // C files given or the manifest's (type-system.md §28.6): names
    cTexts: Vector<Vector<u8>>; // and texts
    defaultOutput: Vector<u8>;  // package mode: <package>/out/<name>
    files: Vector<String>;
}

fn fail(message: StringView) -> i32 {
    Console.writeError("novac: ");
    Console.writeErrorLine(message);
    return 2;
}

fn copyText(text: StringView) -> String {
    var s = String.create();
    s.append(text)!;
    return s;
}

/// Reads the arguments after the command, or returns the exit status of a usage error.
fn readOptions(options: borrow mut Options) -> i32 {
    var a: usize = 2;
    while (a < Process.argumentCount()) {
        let arg = Process.argument(a)!;
        a += 1;
        if (arg == "--diagnostics-format=json") {
            options.json = true;
        } else if (arg == "--diagnostics-format=text") {
            options.json = false;
        } else if (arg == "--diagnostics-format") {
            let value = match (Process.argument(a)) {
                Some(v) => v,
                null => { return fail("option '--diagnostics-format' needs a value"); }
            };
            a += 1;
            if (value == "json") {
                options.json = true;
            } else if (value == "text") {
                options.json = false;
            } else {
                return fail("--diagnostics-format must be 'text' or 'json'");
            }
        } else if (arg == "--dump-ast") {
            options.dumpAst = true;
        } else if (arg == "--dump-hir") {
            options.dumpHir = true;
        } else if (options.building && arg == "--dump-nir") {
            options.dumpNir = true;
        } else if (options.building && arg == "--line-directives") {
            options.lineDirectives = true;
        } else if (options.building && arg == "-g") {
            options.lineDirectives = true;
            options.debug = true;
        } else if (options.building && arg == "--split") {
            options.split = true;
        } else if (options.building && (arg == "--emit" || arg == "-o" || arg == "--exports-header" || arg == "--cc" ||
            arg == "--cflag" || arg == "--ld" || arg == "--program")) {
            let value = match (Process.argument(a)) {
                Some(v) => v,
                null => {
                    var message = String.create();
                    message.append("option '")!;
                    message.append(arg)!;
                    message.append("' needs a value")!;
                    return fail(message.view());
                }
            };
            a += 1;
            if (arg == "--emit") {
                if (value != "c" && value != "exe" && value != "obj") {
                    var message = String.create();
                    message.append("--emit must be 'c', 'exe' or 'obj', not '")!;
                    message.append(value)!;
                    message.append("'")!;
                    return fail(message.view());
                }
                options.emit = copyBytes(value.bytes())!;
                options.emitGiven = true;
            } else if (arg == "-o") {
                options.output = copyBytes(value.bytes())!;
            } else if (arg == "--cc") {
                options.cc = copyBytes(value.bytes())!;
            } else if (arg == "--cflag") {
                options.cflags.push(copyBytes(value.bytes())!)!;
            } else if (arg == "--ld") {
                options.linker = copyBytes(value.bytes())!;
            } else if (arg == "--program") {
                options.programName = copyBytes(value.bytes())!;
            } else {
                options.exportsHeader = copyBytes(value.bytes())!;
            }
        } else if (options.building && (arg == "--no-closure-specialisation" || arg == "--no-placement" ||
            arg == "--no-bce" || arg == "--no-oce" || arg == "--flat-c")) {
            // The optimisations and the structured form are P7's: ceesafec always emits as novac does with these.
        } else if (arg == "--no-float") {
            options.noFloat = true;
        } else if (arg == "--library-diagnostics") {
            options.libraryDiagnostics = true;
        } else if (arg == "--profile" || arg == "--kernel") {
            let value = match (Process.argument(a)) {
                Some(v) => v,
                null => {
                    var message = String.create();
                    message.append("option '")!;
                    message.append(arg)!;
                    message.append("' needs a value")!;
                    return fail(message.view());
                }
            };
            a += 1;
            if (arg == "--kernel") {
                // lib/kernel, for a kernel with CosmoOS's C API (ADR 0025); the only kernel so far.
                if (value != "cosmoos") {
                    var message = String.create();
                    message.append("--kernel must be 'cosmoos', not '")!;
                    message.append(value)!;
                    message.append("'")!;
                    return fail(message.view());
                }
                options.kernel = true;
            } else if (value == "hosted") {
                options.freestanding = false;
                options.profileGiven = true;
            } else if (value == "freestanding") {
                options.freestanding = true;
                options.profileGiven = true;
            } else {
                var message = String.create();
                message.append("--profile must be 'hosted' or 'freestanding', not '")!;
                message.append(value)!;
                message.append("'")!;
                return fail(message.view());
            }
        } else if (arg == "--dump-tokens") {
            options.dumpTokens = true;
        } else if (arg.length > 0 && arg[0] == '-') {
            var message = String.create();
            message.append("unknown option '")!;
            message.append(arg)!;
            message.append("'")!;
            return fail(message.view());
        } else {
            options.files.push(copyText(arg))!;
        }
    }
    return 0;
}

/// The path diagnostics name (SourceText.SourcePath, c-backend.md §7): `/` separators; an absolute path under the
/// working directory becomes relative to it, and any other absolute path is reduced to its file name.
fn sourcePath(path: StringView) -> Vector<u8> {
    var result = Vector<u8>.create();
    let bytes = path.bytes();
    if (bytes.length > 0 && bytes[0] == '/') {
        match (Directory.current()) {
            Ok(cwd) => {
                let base = cwd.view().bytes();
                if (bytes.length > base.length + 1 && sameBytes(
                    bytes[..base.length],
                    base,
                ) && bytes[base.length] == '/') {
                    appendBytes(mut result, bytes[(base.length + 1)..])!;
                    return result;
                }
            }
            Err(_) => {}
        }
        var name = bytes.length;
        while (name > 0 && bytes[name - 1] != '/') {
            name -= 1;
        }
        appendBytes(mut result, bytes[name..])!;
        return result;
    }
    for (b in bytes) {
        result.push(if (b == '\\') '/' else b)!;
    }
    return result;
}

/// Loads each file into a source text, or returns the exit status after an error.
fn loadFiles(files: borrow Vector<String>, sources: borrow mut Vector<SourceText>) -> i32 {
    for (i in 0..files.length) {
        let path = files[i].view();
        let bytes = match (readFile(path)) {
            Ok(b) => b,
            Err(ReadError.Io(e)) => {
                var message = String.create();
                message.append("cannot read '")!;
                message.append(path)!;
                message.append("': ")!;
                message.append(e.message())!;
                Console.writeError("novac: ");
                Console.writeErrorLine(message.view());
                return 2;
            }
            Err(ReadError.Memory) => { return fail("out of memory"); }
        };
        let name = sourcePath(path);
        sources.push(SourceText.create(name.view(), bytes.view())!)!;
    }
    return 0;
}

/// A diagnostic as text with a source excerpt and caret (DiagnosticRenderer.Render).
fn render(out: borrow mut Vector<u8>, d: borrow Diagnostic, source: borrow SourceText) -> Result<void, AllocError> {
    let position = source.position(d.start as usize);
    appendBytes(out, source.path.view())?;
    out.push(':')?;
    appendDecimal(out, position.line as u64)?;
    out.push(':')?;
    appendDecimal(out, position.column as u64)?;
    appendText(out, if (d.isError) ": error[" else ": warning[")?;
    appendCode(out, d.code)?;
    appendText(out, "]: ")?;
    appendBytes(out, d.message.view())?;
    out.push('\n')?;

    var gutter = Vector<u8>.create();
    appendDecimal(mut gutter, position.line as u64)?;
    let line = source.lineText(position.line as usize);
    for (k in 0..gutter.length) {
        out.push(' ')?;
    }
    appendText(out, " |\n")?;
    appendBytes(out, gutter.view())?;
    appendText(out, " | ")?;
    var shown = Vector<u8>.create();
    appendDecoded(mut shown, line)?;
    for (b in shown) {
        out.push(if (b == '\t') ' ' else b)?;
    }
    out.push('\n')?;

    // Underline the span, clipped to the first line it touches; at least one caret. Lengths are UTF-16 units.
    let lineStart = source.lineStarts[(position.line - 1) as usize] as usize;
    let lineUnits = source.utf16Length(lineStart, lineStart + line.length) as i64;
    let spanUnits = source.utf16Length(d.start as usize, d.end as usize) as i64;
    let room = lineUnits - position.column as i64 + 1;
    var underline: i64 = if (spanUnits < room) spanUnits else room;
    if (underline < 1) {
        underline = 1;
    }
    for (k in 0..gutter.length) {
        out.push(' ')?;
    }
    appendText(out, " | ")?;
    for (k in 1..position.column) {
        out.push(' ')?;
    }
    for (k in 0..underline) {
        out.push('^')?;
    }
    out.push('\n')?;
    for (note in d.notes.view()) {
        for (k in 0..gutter.length) {
            out.push(' ')?;
        }
        appendText(out, " = note: ")?;
        appendBytes(out, note.message.view())?;
        appendText(out, " (")?;
        let at = source.position(note.start as usize);
        appendDecimal(out, at.line as u64)?;
        out.push(':')?;
        appendDecimal(out, at.column as u64)?;
        appendText(out, ")\n")?;
    }
    return Ok();
}

fn parseCommand() -> i32 {
    var options = Options {
        json: false,
        dumpTokens: false,
        dumpAst: false,
        dumpHir: false,
        noFloat: false,
        libraryDiagnostics: false,
        freestanding: false,
        kernel: false,
        profileGiven: false,
        building: false,
        dumpNir: false,
        emit: copyBytes("exe".bytes())!,
        output: Vector<u8>.create(),
        exportsHeader: copyBytes("nova_exports.h".bytes())!,
        emitGiven: false,
        lineDirectives: false,
        debug: false,
        split: false,
        programName: Vector<u8>.create(),
        cc: match (Environment.variable("CC")) {
            Some(v) => copyBytes(v.bytes())!,
            null => Vector<u8>.create(),
        },
        cflags: Vector<Vector<u8>>.create(),
        linker: Vector<u8>.create(),
        cNames: Vector<Vector<u8>>.create(),
        cTexts: Vector<Vector<u8>>.create(),
        defaultOutput: Vector<u8>.create(),
        files: Vector<String>.create(),
    };
    let status = readOptions(mut options);
    if (status != 0) {
        return status;
    }
    if (options.files.length == 0) {
        return fail("package mode is not implemented yet (ROADMAP P8); name the files");
    }
    var sources = Vector<SourceText>.create();
    let loaded = loadFiles(options.files, mut sources);
    if (loaded != 0) {
        return loaded;
    }

    var front = Frontend.create();
    var dump = Vector<u8>.create();
    for (i in 0..sources.length) {
        let source = borrow sources[i];
        let file = truncate<u32>(i);
        let lexed = lex(source.text.view(), file, mut front.symbols, mut front.diagnostics)!;
        if (options.dumpTokens) {
            dumpTokens(mut dump, source, lexed, front.symbols)!;
            dumpDiagnostics(mut dump, source, file, front.diagnostics)!;
        }
        front = parseFile(file, lexed, front)!;
        if (options.dumpAst) {
            var printer = AstPrinter.create();
            printer.printUnit(front.ast, front.symbols, front.ast.units[i])!;
            appendBytes(mut dump, printer.out.view())!;
        }
    }
    Console.writeBytes(dump.view());

    let diagnostics = borrow front.diagnostics;
    if (options.json) {
        let json = diagnosticsJson(diagnostics, sources)!;
        Console.writeBytes(json.view());
        Console.writeLine("");
    } else {
        var text = Vector<u8>.create();
        for (i in 0..diagnostics.items.length) {
            let d = borrow diagnostics.items[i];
            render(mut text, d, sources[d.file as usize])!;
        }
        // Valid UTF-8: paths come from arguments, and source lines are decoded with U+FFFD.
        Console.writeError(StringView.fromUtf8(text.view())!);
    }
    return if (diagnostics.hasErrors()) 1 else 0;
}

/// Prints the diagnostics as text on stderr or as the JSON document on stdout, and returns the exit status (Report).
fn report(json: bool, diagnostics: borrow Diagnostics, sources: borrow Vector<SourceText>) -> i32 {
    if (json) {
        let document = diagnosticsJson(diagnostics, sources)!;
        Console.writeBytes(document.view());
        Console.writeLine("");
    } else {
        var text = Vector<u8>.create();
        for (i in 0..diagnostics.items.length) {
            let d = borrow diagnostics.items[i];
            render(mut text, d, sources[d.file as usize])!;
        }
        // Valid UTF-8: paths come from arguments, and source lines are decoded with U+FFFD.
        Console.writeError(StringView.fromUtf8(text.view())!);
    }
    return if (diagnostics.hasErrors()) 1 else 0;
}

/// `check`: the hosted libraries and the files, parsed; then checked if they parse (Compilation.Create, P3).
/// Package mode's loading (Program.LoadPackage): the packages, root first, and their files; the root manifest's
/// profile, float and kernel where the command line does not say otherwise. Returns the exit status of a failure.
fn loadPackage(
    options: borrow mut Options,
    packages: borrow mut Vector<PackageInfo>,
    files: borrow mut Vector<Vector<Vector<u8>>>,
) -> i32 {
    let cwd = match (Directory.current()) {
        Ok(d) => d,
        Err(_) => { return fail("cannot read the current directory"); }
    };
    let directory = match (findManifestDirectory(cwd.view().bytes())!) {
        Some(d) => d,
        null => { return fail("no Nova input files, and no ceesafe.toml or nova.toml here or above"); }
    };
    var problem = Vector<u8>.create();
    var loaded = Vector<LoadedPackage>.create();
    match (readManifest(directory.view(), mut problem)!) {
        Some(root) => {
            let manifestPath = joinPath(directory.view(), manifestName(root.legacy).bytes())!;
            let lock = joinPath(directory.view(), lockName(root.legacy).bytes())!;
            if (root.dependencies.length > 0 && !fileExists(lock.view())) {
                // The manifest is the file the error names (Workspace.Resolve, N0324).
                let text = readFile(StringView.fromUtf8(manifestPath.view())!)!;
                let name = sourcePath(StringView.fromUtf8(manifestPath.view())!);
                var sources = Vector<SourceText>.create();
                sources.push(SourceText.create(name.view(), text.view())!)!;
                var diagnostics = Diagnostics.create();
                var message = Vector<u8>.create();
                appendText(
                    mut message,
                    if (root.legacy) "there is no nova.lock: run 'novac fetch'" else "there is no ceesafe.lock: run 'ceesafec fetch'",
                )!;
                diagnostics.error(324, 0, 0, 0, message)!;
                return report(options.json, diagnostics, sources);
            }
        }
        null => { return fail(StringView.fromUtf8(problem.view())!); }
    }
    if (!resolvePackages(directory.view(), mut loaded, mut problem)!) {
        return fail(StringView.fromUtf8(problem.view())!);
    }
    if (loaded[0].files.length == 0) {
        var message = String.create();
        message.append("package '")!;
        message.append(StringView.fromUtf8(loaded[0].manifest.name.view())!)!;
        message.append(if (loaded[0].manifest.legacy) "' has no .nova files under " else "' has no .cee files under ")!;
        for (k in 0..loaded[0].manifest.sources.length) {
            if (k > 0) {
                message.append(", ")!;
            }
            message.append(StringView.fromUtf8(loaded[0].manifest.sources[k].view())!)!;
        }
        return fail(message.view());
    }
    if (!options.profileGiven) {
        options.freestanding = loaded[0].manifest.freestanding;
    }
    if (!loaded[0].manifest.floatAllowed) {
        options.noFloat = true;
    }
    if (loaded[0].manifest.kernel) {
        options.kernel = true;
    }
    if (!options.emitGiven && loaded[0].manifest.object) {
        options.emit = copyBytes("obj".bytes())!;
    }
    options.defaultOutput = joinPath(loaded[0].manifest.directory.view(), "out".bytes())!;
    options.defaultOutput.push('/')!;
    appendBytes(mut options.defaultOutput, loaded[0].manifest.name.view())!;
    if (options.programName.length == 0) {
        options.programName = copyBytes(loaded[0].manifest.name.view())!;
    }
    for (p in loaded.view()) {
        for (c in p.manifest.cFiles.view()) {
            let path = joinPath(p.manifest.directory.view(), c.view())!;
            let status = addCFile(mut options, path.view());
            if (status != 0) {
                return status;
            }
        }
    }
    for (p in loaded.view()) {
        var dependencies = Vector<Vector<u8>>.create();
        for (d in p.manifest.dependencies.view()) {
            dependencies.push(copyBytes(d.name.view())!)!;
        }
        packages.push(
            PackageInfo {
                name: copyBytes(p.manifest.name.view())!,
                dependencies: dependencies,
                trusted: p.manifest.trusted,
            },
        )!;
        var paths = Vector<Vector<u8>>.create();
        for (f in p.files.view()) {
            paths.push(copyBytes(f.view())!)!;
        }
        files.push(paths)!;
    }
    return 0;
}

fn checkCommand() -> i32 => fileCommand(false);

/// `build --dump-nir` (P4): the checks, then the NIR after drop elaboration, printed as novac prints it with the
/// optimisations turned off. Building C is P5.
fn buildCommand() -> i32 => fileCommand(true);

fn fileCommand(building: bool) -> i32 {
    var options = Options {
        json: false,
        dumpTokens: false,
        dumpAst: false,
        dumpHir: false,
        noFloat: false,
        libraryDiagnostics: false,
        freestanding: false,
        kernel: false,
        profileGiven: false,
        building: building,
        dumpNir: false,
        emit: copyBytes("exe".bytes())!,
        output: Vector<u8>.create(),
        exportsHeader: copyBytes("nova_exports.h".bytes())!,
        emitGiven: false,
        lineDirectives: false,
        debug: false,
        split: false,
        programName: Vector<u8>.create(),
        cc: match (Environment.variable("CC")) {
            Some(v) => copyBytes(v.bytes())!,
            null => Vector<u8>.create(),
        },
        cflags: Vector<Vector<u8>>.create(),
        linker: Vector<u8>.create(),
        cNames: Vector<Vector<u8>>.create(),
        cTexts: Vector<Vector<u8>>.create(),
        defaultOutput: Vector<u8>.create(),
        files: Vector<String>.create(),
    };
    let status = readOptions(mut options);
    if (status != 0) {
        return status;
    }
    // C sources go to the C compiler with the generated code (type-system.md §28.6).
    var novaFiles = Vector<String>.create();
    for (k in 0..options.files.length) {
        let file = copyText(options.files[k].view());
        let bytes = file.view().bytes();
        if (bytes.length > 2 && bytes[bytes.length - 2] == '.' && bytes[bytes.length - 1] == 'c') {
            let added = addCFile(mut options, bytes);
            if (added != 0) {
                return added;
            }
        } else {
            novaFiles.push(file)!;
        }
    }
    if (options.files.length > 0 && novaFiles.length == 0) {
        return fail("no Nova input files");
    }
    var sources = Vector<SourceText>.create();
    var fileIsLibrary = Vector<bool>.create();
    var packages = Vector<PackageInfo>.create();
    var packageFiles = Vector<Vector<Vector<u8>>>.create();
    if (options.files.length == 0) {
        // Package mode (tooling.md §4.4): the nearest manifest's package and its path dependencies.
        let loaded = loadPackage(mut options, mut packages, mut packageFiles);
        if (loaded != 0) {
            return loaded;
        }
    } else {
        packages.push(
            PackageInfo { name: Vector<u8>.create(), dependencies: Vector<Vector<u8>>.create(), trusted: false },
        )!;
    }
    // lib/core, then lib/std (hosted) or lib/kernel (freestanding with --kernel): library files come first
    // (CoreLibrary.SourcesFor).
    for (k in 0..libraryFileCount()) {
        let group = libraryGroup(k);
        if (group == 0 || (group == 1 && !options.freestanding) ||
            (group == 2 && options.freestanding && options.kernel)) {
            let text = libraryText(k)!;
            sources.push(SourceText.create(libraryPath(k).bytes(), text.view())!)!;
            fileIsLibrary.push(true)!;
        }
    }
    var filePackage = Vector<u32>.create();
    while (filePackage.length < sources.length) {
        filePackage.push(0xFFFFFFFF)!;
    }
    if (options.files.length > 0) {
        let loaded = loadFiles(novaFiles, mut sources);
        if (loaded != 0) {
            return loaded;
        }
        while (filePackage.length < sources.length) {
            filePackage.push(0)!;
        }
    } else {
        for (p in 0..packageFiles.length) {
            for (f in packageFiles[p].view()) {
                let path = StringView.fromUtf8(f.view())!;
                let bytes = match (readFile(path)) {
                    Ok(b) => b,
                    Err(_) => {
                        var message = String.create();
                        message.append("cannot read '")!;
                        message.append(path)!;
                        message.append("'")!;
                        return fail(message.view());
                    }
                };
                let name = sourcePath(path);
                sources.push(SourceText.create(name.view(), bytes.view())!)!;
                filePackage.push(truncate<u32>(p))!;
            }
        }
    }
    while (fileIsLibrary.length < sources.length) {
        fileIsLibrary.push(false)!;
    }
    var front = Frontend.create();
    for (i in 0..sources.length) {
        let source = borrow sources[i];
        let file = truncate<u32>(i);
        let lexed = lex(source.text.view(), file, mut front.symbols, mut front.diagnostics)!;
        let marks = astMarks(front);
        front = parseFile(file, lexed, front)!;
        // PackageNames.Rewrite: a package file, rewritten while nothing has failed yet.
        if (!fileIsLibrary[i] && !front.diagnostics.hasErrors()) {
            let unit = truncate<u32>(front.ast.units.length - 1);
            rewritePackageNames(mut front, unit, packages[filePackage[i] as usize].dependencies, marks)!;
        }
    }
    if (front.diagnostics.hasErrors()) {
        return report(options.json, front.diagnostics, sources);
    }
    var texts = Vector<Vector<u8>>.create();
    var paths = Vector<Vector<u8>>.create();
    for (i in 0..sources.length) {
        texts.push(copyBytes(sources[i].text.view())!)!;
        paths.push(copyBytes(sources[i].path.view())!)!;
    }
    var checker = checkProgram(
        front,
        fileIsLibrary,
        texts,
        paths,
        options.noFloat,
        options.freestanding,
        packages,
        filePackage,
    )!;
    if (!options.libraryDiagnostics) {
        // The reference's libraries check cleanly: what is reported in them here is a porting gap (docs/p3-plan.md S5).
        checker.front.diagnostics.removeFiles(checker.fileIsLibrary.view());
    }
    // The ownership analyses run on NIR, after type checking succeeded (lifetimes.md).
    var nir = NirProgram.create();
    if (!checker.front.diagnostics.hasErrors()) {
        nir = analyzeProgram(mut checker)!;
    }
    if (options.dumpHir && !building) {
        var printer = HirPrinter.create();
        printer.printProgram(checker.hir, checker.types, checker.front.symbols)!;
        Console.writeBytes(printer.out.view());
    }
    if (building) {
        if (checker.front.diagnostics.hasErrors()) {
            return report(options.json, checker.front.diagnostics, sources);
        }
        if (options.dumpNir) {
            var out = Vector<u8>.create();
            printNir(checker, nir, mut out)!;
            Console.writeBytes(out.view());
        }
        // The name split mode's external C names carry: --program, the package's, or the first file's.
        var programName = copyBytes(options.programName.view())!;
        if (programName.length == 0) {
            if (options.files.length > 0) {
                appendStem(mut programName, options.files[0].view().bytes())!;
            } else {
                appendText(mut programName, "program")!;
            }
        }
        // With C files, `main` may be in C (type-system.md §28.6).
        let requireMain = sameText(options.emit.view(), "exe") && options.cNames.length == 0 && !options.freestanding;
        var files = Vector<CFile>.create();
        if (!generateC(
            mut checker,
            nir,
            sources,
            requireMain,
            options.freestanding,
            options.lineDirectives,
            options.split,
            programName.view(),
            options.exportsHeader.view(),
            mut files,
        )!) {
            return report(options.json, checker.front.diagnostics, sources);
        }
        for (k in 0..options.cNames.length) {
            var name = copyBytes("c/".bytes())!;
            appendBytes(mut name, options.cNames[k].view())!;
            files.push(CFile { name: name, text: copyBytes(options.cTexts[k].view())! })!;
        }
        var user: usize = 0;
        while (user + 1 < sources.length && checker.fileIsLibrary[user]) {
            user += 1;
        }
        return buildFiles(options, files, sources[user].path.view());
    }
    return report(options.json, checker.front.diagnostics, sources);
}

fn main() -> i32 {
    let argument = Process.argument(1);
    if (argument == null) {
        usage();
        return 2;
    }
    let command = argument!;
    if (command == "--version") {
        Console.writeLine("ceesafec 0.0.0-dev");
        return 0;
    }
    if (command == "-h" || command == "--help") {
        usage();
        return 0;
    }
    if (command == "parse") {
        return parseCommand();
    }
    if (command == "check") {
        return checkCommand();
    }
    if (command == "build") {
        return buildCommand();
    }
    match (phaseOf(command)) {
        Some(phase) => {
            var message = String.create();
            message.append("'")!;
            message.append(command)!;
            message.append("' is not implemented yet (ROADMAP ")!;
            message.append(phase)!;
            message.append(")")!;
            return fail(message.view());
        }
        null => {
            var message = String.create();
            message.append("unknown command '")!;
            message.append(command)!;
            message.append("'")!;
            return fail(message.view());
        }
    }
}

/// A C file for the C compiler: its name and text; two files may not share a name.
fn addCFile(options: borrow mut Options, path: Slice<u8>) -> i32 {
    var name = Vector<u8>.create();
    var start = path.length;
    while (start > 0 && path[start - 1] != '/') {
        start -= 1;
    }
    appendBytes(mut name, path[start..])!;
    for (other in options.cNames.view()) {
        if (sameBytes(other.view(), name.view())) {
            var message = copyBytes("two C files are named '".bytes())!;
            appendBytes(mut message, name.view())!;
            message.push('\'')!;
            return failBytes(message.view());
        }
    }
    let text = match (readFile(StringView.fromUtf8(path)!)) {
        Ok(t) => t,
        Err(_) => {
            var message = copyBytes("cannot read '".bytes())!;
            appendBytes(mut message, path)!;
            message.push('\'')!;
            return failBytes(message.view());
        }
    };
    options.cNames.push(name)!;
    options.cTexts.push(text)!;
    return 0;
}
