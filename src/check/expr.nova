// Expressions and calls (the reference's CheckExpr, Synth, Coerce, CheckIntLiteral, SynthName, SynthUnary,
// SynthBinary, CheckOperatorApplies, CheckShiftAmount, SynthCall, CheckUserCall, CheckArgument and
// CheckBuiltinMemberCall), for what S1a supports; every other form is N0216 "not ported yet" (src/check/checker.nova).

fn appendQuotedType(message: borrow mut Vector<u8>, c: borrow Checker, typ: u32) -> Result<void, AllocError> {
    appendText(message, "'")?;
    appendBytes(message, c.typeName(typ))?;
    return appendText(message, "'");
}

fn appendQuotedName(message: borrow mut Vector<u8>, c: borrow Checker, symbol: u32) -> Result<void, AllocError> {
    appendText(message, "'")?;
    appendBytes(message, c.name(symbol))?;
    return appendText(message, "'");
}

fn isArithmetic(op: BinaryOp) -> bool => binaryIndex(op) >= 13;

fn isBitwise(op: BinaryOp) -> bool => binaryIndex(op) >= 8 && binaryIndex(op) <= 10;

fn isShift(op: BinaryOp) -> bool => binaryIndex(op) == 11 || binaryIndex(op) == 12;

fn isComparison(op: BinaryOp) -> bool => binaryIndex(op) >= 2 && binaryIndex(op) <= 7;

/// Only unsuffixed literals combined by -, (), and arithmetic, bitwise or shift operators (IsFlexible, §5).
fn isFlexible(c: borrow Checker, e: u32) -> bool => match (c.front.ast.exprs[e as usize]) {
    ExprNode.IntLiteral(_, suffix) => match (suffix) {
        IntSuffix.None => true,
        _ => false,
    },
    ExprNode.CharLiteral(_) => true,
    ExprNode.FloatLiteral(_, suffix) => match (suffix) {
        FloatSuffix.None => true,
        _ => false,
    },
    ExprNode.Paren(inner) => isFlexible(c, inner),
    ExprNode.Unary(op, operand) => match (op) {
        UnaryOp.Negate => isFlexible(c, operand),
        UnaryOp.Not => false,
    },
    ExprNode.Binary(left, op, right) => (isArithmetic(op) || isBitwise(op) || isShift(op)) && isFlexible(c, left) &&
        isFlexible(c, right),
    ExprNode.If(_, _, _) => flexibleBranches(c, e), // M11: when their value branches are all flexible (§15.3)
    ExprNode.Match(_, _) => flexibleBranches(c, e),
    _ => false,
};

/// The integer type a literal takes from `expected`, looking through an optional (IntegerHint).
fn integerHint(c: borrow Checker, expected: u32) -> u32 {
    if (expected == none()) {
        return none();
    }
    let option = c.types.optionType(expected);
    let t = if (option != none()) option else expected;
    return if (c.types.is(t, TypeKind.Integer)) t else none();
}

/// The integer or float type an operand takes from `expected` (NumericHint).
fn numericHint(c: borrow Checker, expected: u32) -> u32 {
    if (expected == none()) {
        return none();
    }
    let option = c.types.optionType(expected);
    let t = if (option != none()) option else expected;
    return if (c.types.is(t, TypeKind.Integer) || c.types.is(t, TypeKind.Float)) t else none();
}

/// CheckExpr: checks against an optional expected type (§5).
fn checkExpr(c: borrow mut Checker, e: u32, expected: u32) -> Result<u32, AllocError> {
    let span = c.front.ast.exprSpans[e as usize];
    if (isHere(c, e)?) {
        return checkHere(c, expected, span);
    }
    match (c.front.ast.exprs[e as usize]) {
        ExprNode.If(_, _, _) => { return checkBranching(c, e, expected); }
        ExprNode.Match(_, _) => { return checkBranching(c, e, expected); }
        ExprNode.Closure(closure) => {
            if (c.front.ast.closures[closure as usize].isMove) {
                return misplacedMoveLiteral(c, span);
            }
            let value = checkClosure(c, closure, expected, span)?;
            return coerce(c, value, expected, span);
        }
        _ => {}
    }
    var synthExpected = expected;
    if (expected != none()) {
        let t = c.types.info(expected);
        let keep = c.types.is(
            expected,
            TypeKind.Vector,
        ) || c.types.is(expected, TypeKind.StableVector) || c.types.isDynBox(expected) ||
            (c.types.is(expected, TypeKind.Box) && isBoxFromRaw(c, e)?);
        if (!keep && t.pointee != none()) {
            synthExpected = t.pointee;
        }
    }
    let value = synth(c, e, synthExpected)?;
    return coerce(c, value, expected, span);
}

/// The instance of generic function `g` that `name<A, B>` names (the explicit type arguments; none after an error).
fn genericInstanceNamed(
    c: borrow mut Checker,
    g: u32,
    symbol: u32,
    typeArguments: Range,
    span: Span,
) -> Result<u32, AllocError> {
    let generic = c.genericFunctions[g as usize];
    var parameterTypes = Vector<u32>.create();
    listTypes(c, generic.parameters, mut parameterTypes)?;
    var text = Vector<u8>.create();
    appendBytes(mut text, c.name(symbol))?;
    let pairs = Vector<InferencePair>.create();
    var found = Vector<u32>.create();
    let ok = typeArgumentsFor(
        c,
        text.view(),
        parameterTypes.view(),
        typeArguments,
        emptyRange(),
        false,
        pairs.view(),
        span,
        mut found,
    )?;
    return if (ok) instantiateFunction(c, g, found.view(), span) else Ok(none());
}

fn synth(c: borrow mut Checker, e: u32, expected: u32) -> Result<u32, AllocError> {
    let span = c.front.ast.exprSpans[e as usize];
    if (c.freestanding && hostedOnlyCall(c, e)?) {
        return c.errorResult(span.start, span.end);
    }
    match (c.front.ast.exprs[e as usize]) {
        ExprNode.IntLiteral(value, suffix) => { return checkIntLiteral(c, value, suffix, false, expected, span); }
        ExprNode.BoolLiteral(value) => {
            let b = c.types.boolType;
            return c.expr(HirExpr.BoolConst(value), b, span.start, span.end);
        }
        ExprNode.StringLiteral(text) => {
            let value = c.hir.addText(c.front.ast.textOf(text))?;
            let view = c.types.stringView;
            return c.expr(HirExpr.StringConst(value), view, span.start, span.end); // static bytes: no loans (§22.2)
        }
        ExprNode.Paren(inner) => {
            let value = synth(c, inner, expected)?;
            c.hir.exprSpans[value as usize] = span;
            return Ok(value);
        }
        ExprNode.Name(name, typeArguments) => {
            if (expected != none() && c.types.is(expected, TypeKind.FunctionPointer)) {
                let symbol = c.front.ast.idents[name as usize].symbol;
                match (c.lookup(symbol)?) {
                    Entity.Function(function) => {
                        if (typeArguments.count == 0) {
                            return functionAddress(c, function, expected, span);
                        }
                    }
                    Entity.GenericFunction(g) => {
                        if (typeArguments.count > 0) {
                            // An instance of a generic callback, named with its type arguments (§34.1).
                            let instance = genericInstanceNamed(c, g, symbol, typeArguments, span)?;
                            if (instance == none()) {
                                return c.errorResult(span.start, span.end);
                            }
                            return functionAddress(c, instance, expected, span);
                        }
                    }
                    _ => {}
                }
            }
            if (typeArguments.count > 0) {
                let symbol = c.front.ast.idents[name as usize].symbol;
                match (c.lookup(symbol)?) {
                    Entity.GenericFunction(g) => {
                        // An instance of a generic function as a value, named with its type arguments (§36.1).
                        let instance = genericInstanceNamed(c, g, symbol, typeArguments, span)?;
                        if (instance == none()) {
                            return c.errorResult(span.start, span.end);
                        }
                        return functionValue(c, instance, span);
                    }
                    _ => {}
                }
                var message = Vector<u8>.create();
                appendText(
                    mut message,
                    "type arguments go on a call ('f<T>(…)'), a type or a static function ('S<T>.f(…)')",
                )?;
                c.error(unsupported(), span.start, span.end, message)?;
                return c.errorResult(span.start, span.end);
            }
            return synthName(c, name, span);
        }
        ExprNode.Unary(op, operand) => { return synthUnary(c, op, operand, expected, span); }
        ExprNode.Binary(left, op, right) => { return synthBinary(c, left, op, right, expected, span); }
        ExprNode.Call(callee, arguments) => {
            match (c.front.ast.exprs[callee as usize]) {
                ExprNode.Name(name, typeArguments) => {
                    let symbol = c.front.ast.idents[name as usize].symbol;
                    let undeclared = match (c.lookup(symbol)?) {
                        Entity.None => true,
                        _ => false,
                    };
                    if (typeArguments.count == 0 && undeclared) {
                        let text = c.name(symbol);
                        if (sameText(text, "Ok") || sameText(text, "Err")) {
                            return checkResultValue(c, symbol, arguments, expected, span);
                        }
                        if (sameText(text, "Some")) {
                            return checkSomeValue(c, arguments, expected, span);
                        }
                    }
                }
                _ => {}
            }
            return synthCall(c, callee, arguments, expected, span);
        }
        ExprNode.NullLiteral => { return checkNull(c, expected, span); }
        ExprNode.Closure(closure) => {
            if (c.front.ast.closures[closure as usize].isMove) {
                return misplacedMoveLiteral(c, span);
            }
            return checkClosure(c, closure, none(), span);
        }
        ExprNode.Borrow(mutable, operand) => { return synthBorrow(c, mutable, operand, span); }
        ExprNode.Move(operand) => { return synthMove(c, operand, span); }
        ExprNode.ArrayLiteral(elements) => { return synthArrayLiteral(c, elements, expected, span); }
        ExprNode.ArrayRepeat(value, count) => { return synthArrayRepeat(c, value, count, expected, span); }
        ExprNode.Index(target, index) => { return synthIndex(c, target, index, span); }
        ExprNode.Slice(target, low, high) => { return synthSlice(c, target, low, high, false, span); }
        ExprNode.MutArg(_) => { return misplacedMutArgument(c, span); }
        ExprNode.Try(operand) => { return checkTry(c, operand, expected, span); }
        ExprNode.Unwrap(operand) => { return checkUnwrap(c, operand, expected, span); }
        ExprNode.If(_, _, _) => { return checkBranching(c, e, none()); }
        ExprNode.Match(_, _) => { return checkBranching(c, e, none()); }
        ExprNode.This => {
            let thisSymbol = c.thisSymbol;
            let receiver = c.lookupLocal(thisSymbol)?;
            if (receiver != none()) {
                let t = c.hir.locals[receiver as usize].typ;
                return c.expr(HirExpr.LocalRef(receiver), t, span.start, span.end);
            }
            var message = Vector<u8>.create();
            appendText(mut message, "'this' can only be used inside a method")?;
            c.error(thisOutsideMethod(), span.start, span.end, message)?;
            return c.errorResult(span.start, span.end);
        }
        ExprNode.Error => { return c.errorResult(span.start, span.end); }
        ExprNode.Member(target, member) => { return synthMember(c, target, member, span, expected); }
        ExprNode.StructLiteral(typeName, fields, typeArguments) => {
            return synthStructLiteral(c, typeName, fields, typeArguments, span, expected);
        }
        ExprNode.FloatLiteral(digits, suffix) => { return checkFloatLiteral(c, digits, suffix, expected, span); }
        ExprNode.CharLiteral(value) => { return checkCharLiteral(c, value, expected, span); }
        ExprNode.Cast(operand, typ) => { return synthCast(c, operand, typ, span); }
        ExprNode.Block(_) => {
            var message = Vector<u8>.create();
            appendText(mut message, "a block is an expression only as a branch of an 'if' or 'match' expression")?;
            c.error(branchCompletes(), span.start, span.end, message)?;
            return c.errorResult(span.start, span.end);
        }
        ExprNode.Unsafe(inner) => {
            c.usedUnsafe = true;
            c.unsafeDepth += 1;
            let value = synth(c, inner, expected)?;
            c.unsafeDepth -= 1;
            c.hir.exprSpans[value as usize] = span;
            return Ok(value);
        }
    }
    return c.errorResult(span.start, span.end);
}

/// CheckIntLiteral: the literal's type is its suffix's, else the expected integer type, else i32.
fn checkIntLiteral(
    c: borrow mut Checker,
    literal: u64,
    suffix: IntSuffix,
    negative: bool,
    expected: u32,
    span: Span,
) -> Result<u32, AllocError> {
    var typ = c.types.forSuffix(suffix);
    if (typ == none()) {
        typ = integerHint(c, expected);
    }
    if (typ == none()) {
        typ = c.types.i32;
    }
    let t = c.types.info(typ);
    if (negative && !t.signed) {
        var message = Vector<u8>.create();
        appendText(mut message, "cannot negate a value of unsigned type ")?;
        appendQuotedType(mut message, c, typ)?;
        c.error(invalidOperandTypes(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let value = IntValue { negative: negative && literal != 0, magnitude: literal };
    if (!c.types.fits(typ, bigOf(value)?)) {
        var message = Vector<u8>.create();
        appendText(mut message, "integer literal ")?;
        appendIntValue(mut message, value)?;
        appendText(mut message, " does not fit in ")?;
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " (range ")?;
        appendTypeBound(mut message, t, false)?;
        appendText(mut message, "..")?;
        appendTypeBound(mut message, t, true)?;
        appendText(mut message, ")")?;
        c.error(literalOutOfRange(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    return c.expr(HirExpr.IntConst(value), typ, span.start, span.end);
}

/// An integer type's Min (max: false) or Max.
fn appendTypeBound(out: borrow mut Vector<u8>, t: TypeInfo, max: bool) -> Result<void, AllocError> {
    if (!t.signed) {
        if (!max) {
            return appendText(out, "0");
        }
        let m: u64 = if (t.bits >= 64) 0xFFFFFFFFFFFFFFFF else (1u64 << t.bits) - 1;
        return appendDecimal(out, m);
    }
    let half: u64 = 1u64 << (t.bits - 1);
    if (max) {
        return appendDecimal(out, half - 1);
    }
    out.push('-')?;
    return appendDecimal(out, half);
}

fn synthName(c: borrow mut Checker, name: u32, span: Span) -> Result<u32, AllocError> {
    let symbol = c.front.ast.idents[name as usize].symbol;
    match (c.lookup(symbol)?) {
        Entity.Local(local) => {
            let t = c.hir.locals[local as usize].typ;
            return c.expr(HirExpr.LocalRef(local), t, span.start, span.end);
        }
        Entity.Constant(k) => {
            let value = evaluateConstant(c, k)?;
            let isArray = match (c.hir.exprs[value as usize]) {
                HirExpr.ArrayLiteral(_) => true,
                HirExpr.ArrayRepeat(_) => true,
                _ => false,
            };
            if (isArray) {
                return constantArrayAt(c, value, span); // the whole array's value (§10)
            }
            let t = c.hir.constants[c.constants[k as usize].hir as usize].typ;
            match (c.hir.exprs[value as usize]) {
                HirExpr.IntConst(i) => { return c.expr(HirExpr.IntConst(i), t, span.start, span.end); }
                HirExpr.BoolConst(b) => { return c.expr(HirExpr.BoolConst(b), t, span.start, span.end); }
                HirExpr.FloatConst(f) => { return c.expr(HirExpr.FloatConst(f), t, span.start, span.end); }
                _ => { return c.errorResult(span.start, span.end); }
            }
        }
        Entity.Function(function) => { return functionValue(c, function, span); }
        Entity.GenericFunction(_) => {
            var message = Vector<u8>.create();
            appendText(mut message, "generic function ")?;
            appendQuotedName(mut message, c, symbol)?;
            appendText(mut message, " is a value only with its type arguments: '")?;
            appendBytes(mut message, c.name(symbol))?;
            appendText(mut message, "<T>' (type-system.md §36.1)")?;
            c.error(notCallable(), span.start, span.end, message)?;
        }
        Entity.Static(entry) => { return staticUse(c, entry, span); }
        Entity.Struct(_) => {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, symbol)?;
            appendText(mut message, " is a type, not a value")?;
            c.error(notCallable(), span.start, span.end, message)?;
        }
        Entity.Enum(_) => {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, symbol)?;
            appendText(mut message, " is a type, not a value")?;
            c.error(notCallable(), span.start, span.end, message)?;
        }
        Entity.Builtin(_) => {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, symbol)?;
            appendText(mut message, " is not a value")?;
            c.error(notCallable(), span.start, span.end, message)?;
        }
        Entity.None => { cannotFind(c, symbol, span)?; }
        Entity.Interface(_) => { cannotFind(c, symbol, span)?; }
    }
    return c.errorResult(span.start, span.end);
}

/// Reads through references, boxes and vectors (AutoDeref); a closure's callable object is never read.
fn autoDeref(c: borrow mut Checker, e: u32) -> Result<u32, AllocError> {
    var value = e;
    loop {
        let t = c.typeOf(value);
        let readThrough = (c.types.is(t, TypeKind.Reference) && !c.types.isClosure(t)) || c.types.is(t, TypeKind.Box) ||
            c.types.is(t, TypeKind.Vector) || c.types.is(t, TypeKind.StableVector);
        if (!readThrough) {
            return Ok(value);
        }
        let span = c.spanOf(value);
        let pointee = c.types.info(t).pointee;
        value = c.expr(HirExpr.Deref(value), pointee, span.start, span.end)?;
    }
}

/// The StringView an auto-dereferenced value reads, if it is the text of one (ViewOf).
fn viewOf(c: borrow Checker, e: u32) -> u32 {
    if (c.types.info(c.typeOf(e)).isStr) {
        match (c.hir.exprs[e as usize]) {
            HirExpr.Deref(reference) => { return reference; }
            _ => {}
        }
    }
    return e;
}

fn synthUnary(c: borrow mut Checker, op: UnaryOp, operand: u32, expected: u32, span: Span) -> Result<u32, AllocError> {
    match (op) {
        UnaryOp.Not => {
            let b = c.types.boolType;
            let value = checkExpr(c, operand, b)?;
            return c.expr(HirExpr.Unary(UnaryOp.Not, value), b, span.start, span.end);
        }
        UnaryOp.Negate => {}
    }
    // A literal directly under '-' is checked as one negative literal (§4).
    match (c.front.ast.exprs[operand as usize]) {
        ExprNode.IntLiteral(literal, suffix) => { return checkIntLiteral(c, literal, suffix, true, expected, span); }
        _ => {}
    }
    let operandHint = numericHint(c, expected);
    let synthesized = synth(c, operand, operandHint)?;
    let value = autoDeref(c, synthesized)?;
    let t = c.typeOf(value);
    if (c.types.isBottom(t)) {
        return Ok(value);
    }
    let info = c.types.info(t);
    if (c.types.is(t, TypeKind.Float)) {
        return c.expr(HirExpr.Unary(UnaryOp.Negate, value), t, span.start, span.end); // flips the sign (§35.3)
    }
    if (!c.types.is(t, TypeKind.Integer) || !info.signed) {
        var message = Vector<u8>.create();
        if (c.types.is(t, TypeKind.Integer)) {
            appendText(mut message, "cannot negate a value of unsigned type ")?;
        } else {
            appendText(mut message, "operator '-' cannot be applied to type ")?;
        }
        appendQuotedType(mut message, c, t)?;
        c.error(invalidOperandTypes(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    return c.expr(HirExpr.Unary(UnaryOp.Negate, value), t, span.start, span.end);
}

fn synthBinary(
    c: borrow mut Checker,
    leftSyntax: u32,
    op: BinaryOp,
    rightSyntax: u32,
    expected: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let index = binaryIndex(op);
    let isNullLeft = match (c.front.ast.exprs[leftSyntax as usize]) {
        ExprNode.NullLiteral => true,
        _ => false,
    };
    let isNullRight = match (c.front.ast.exprs[rightSyntax as usize]) {
        ExprNode.NullLiteral => true,
        _ => false,
    };
    if ((index == 2 || index == 3) && (isNullLeft || isNullRight)) {
        return synthNullTest(c, leftSyntax, rightSyntax, index == 2, isNullLeft, span);
    }
    let boolType = c.types.boolType;
    if (index == 0 || index == 1) {
        let l = checkExpr(c, leftSyntax, boolType)?;
        let r = checkExpr(c, rightSyntax, boolType)?;
        return c.expr(HirExpr.Binary(op, l, r), boolType, span.start, span.end);
    }
    if (isShift(op)) {
        let leftHint = integerHint(c, expected);
        let leftSynth = synth(c, leftSyntax, leftHint)?;
        let left = autoDeref(c, leftSynth)?;
        let amount = checkShiftAmount(c, rightSyntax)?;
        if (c.isBottom(left) || c.isBottom(amount)) {
            return c.errorResult(span.start, span.end);
        }
        let lt = c.typeOf(left);
        if (!checkOperatorApplies(c, op, lt, span)?) {
            return c.errorResult(span.start, span.end);
        }
        return c.expr(HirExpr.Binary(op, left, amount), lt, span.start, span.end);
    }
    let hint = if (isArithmetic(op) || isBitwise(op)) numericHint(c, expected) else none();
    var leftHir: u32 = 0;
    var rightHir: u32 = 0;
    if (hint != none()) {
        leftHir = checkExpr(c, leftSyntax, hint)?;
        rightHir = checkExpr(c, rightSyntax, hint)?;
    } else if (!isFlexible(c, leftSyntax) && isFlexible(c, rightSyntax)) {
        let l = synth(c, leftSyntax, none())?;
        leftHir = autoDeref(c, l)?;
        let leftHint = numericHint(c, c.typeOf(leftHir));
        rightHir = checkExpr(c, rightSyntax, leftHint)?;
    } else if (isFlexible(c, leftSyntax) && !isFlexible(c, rightSyntax)) {
        let r = synth(c, rightSyntax, none())?;
        rightHir = autoDeref(c, r)?;
        let rightHint = numericHint(c, c.typeOf(rightHir));
        leftHir = checkExpr(c, leftSyntax, rightHint)?;
    } else {
        let l = synth(c, leftSyntax, none())?;
        leftHir = autoDeref(c, l)?;
        let r = synth(c, rightSyntax, none())?;
        rightHir = autoDeref(c, r)?;
    }
    if (c.isBottom(leftHir) || c.isBottom(rightHir)) {
        return c.errorResult(span.start, span.end);
    }
    leftHir = viewOf(c, leftHir);
    rightHir = viewOf(c, rightHir);
    var lt = c.typeOf(leftHir);
    var rt = c.typeOf(rightHir);
    if (c.types.isStringView(lt) && c.types.isStringView(rt)) {
        if (index != 2 && index != 3) {
            var message = Vector<u8>.create();
            appendText(mut message, "operator '")?;
            appendText(mut message, binaryOpText(op))?;
            appendText(mut message, "' cannot be applied to type 'StringView'; views compare with '==' and '!='")?;
            c.error(invalidOperandTypes(), span.start, span.end, message)?;
            return c.errorResult(span.start, span.end);
        }
        return c.expr(HirExpr.Binary(op, leftHir, rightHir), boolType, span.start, span.end); // compares the bytes
    }
    if (c.types.is(lt, TypeKind.RawPointer) && c.types.is(rt, TypeKind.RawPointer) &&
        c.types.info(lt).pointee == c.types.info(rt).pointee) {
        // `*mut T` coerces to `*T` (§27.1).
        let shared = c.types.pointerTo(c.types.info(lt).pointee, false)?;
        if (c.types.info(lt).mutablePointer) {
            let s = c.spanOf(leftHir);
            leftHir = c.expr(HirExpr.Cast(leftHir), shared, s.start, s.end)?;
        }
        if (c.types.info(rt).mutablePointer) {
            let s = c.spanOf(rightHir);
            rightHir = c.expr(HirExpr.Cast(rightHir), shared, s.start, s.end)?;
        }
        lt = shared;
        rt = shared;
    }
    if (lt != rt) {
        var message = Vector<u8>.create();
        appendText(mut message, "operator '")?;
        appendText(mut message, binaryOpText(op))?;
        appendText(mut message, "' requires operands of the same type, found ")?;
        appendQuotedType(mut message, c, lt)?;
        appendText(mut message, " and ")?;
        appendQuotedType(mut message, c, rt)?;
        c.error(invalidOperandTypes(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (!checkOperatorApplies(c, op, lt, span)?) {
        return c.errorResult(span.start, span.end);
    }
    let resultType = if (isComparison(op)) boolType else lt;
    return c.expr(HirExpr.Binary(op, leftHir, rightHir), resultType, span.start, span.end);
}

/// A shift amount: any integer type; a flexible literal is typed as u32 (§6).
fn checkShiftAmount(c: borrow mut Checker, amount: u32) -> Result<u32, AllocError> {
    if (isFlexible(c, amount)) {
        let u32Type = c.types.u32;
        return checkExpr(c, amount, u32Type);
    }
    let synthesized = synth(c, amount, none())?;
    let value = autoDeref(c, synthesized)?;
    let t = c.typeOf(value);
    if (!c.types.isBottom(t) && !c.types.is(t, TypeKind.Integer)) {
        let span = c.front.ast.exprSpans[amount as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "a shift amount must be an integer, found ")?;
        appendQuotedType(mut message, c, t)?;
        c.error(invalidOperandTypes(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    return Ok(value);
}

/// Reports N0207 unless `op` accepts operands of `typ` (CheckOperatorApplies, §6).
fn checkOperatorApplies(c: borrow mut Checker, op: BinaryOp, typ: u32, span: Span) -> Result<bool, AllocError> {
    let t = c.types.info(typ);
    let integer = c.types.is(typ, TypeKind.Integer);
    let float = c.types.is(typ, TypeKind.Float);
    let index = binaryIndex(op);
    let ok = if (index == 17) integer else if (isArithmetic(
        op,
    )) integer || float else if (isBitwise(
        op,
    ) || isShift(op)) integer && !t.signed else if (index == 2 || index == 3) integer || float || c.types.is(
        typ,
        TypeKind.Bool,
    ) ||
        c.types.is(typ, TypeKind.Handle) || c.types.is(typ, TypeKind.RawPointer) ||
        c.types.is(
            typ,
            TypeKind.FunctionPointer,
        ) else if (isComparison(op)) integer || float else c.types.is(typ, TypeKind.Bool);
    if (!ok) {
        var message = Vector<u8>.create();
        appendText(mut message, "operator '")?;
        appendText(mut message, binaryOpText(op))?;
        appendText(mut message, "' cannot be applied to type ")?;
        appendQuotedType(mut message, c, typ)?;
        if ((isBitwise(op) || isShift(op)) && integer) {
            appendText(
                mut message,
                "; bitwise operators and shifts require unsigned operands (reinterpret with truncate<uN>(x))",
            )?;
        }
        c.error(invalidOperandTypes(), span.start, span.end, message)?;
    }
    return Ok(ok);
}

/// Coerce: the conversions S1a's programs need (identity, reborrows, reading through references); every other
/// mismatch is N0205.
fn coerce(c: borrow mut Checker, e: u32, expected: u32, span: Span) -> Result<u32, AllocError> {
    let t = c.typeOf(e);
    if (expected == none() || expected == c.types.error || c.types.isBottom(t)) {
        return Ok(e);
    }
    let x = c.types.info(expected);
    if (t == expected) {
        let isLocalRef = match (c.hir.exprs[e as usize]) {
            HirExpr.LocalRef(_) => true,
            _ => false,
        };
        let isField = match (c.hir.exprs[e as usize]) {
            HirExpr.FieldAccess(_, _) => true,
            _ => false,
        };
        if (x.mutableReference && isField) {
            let field = toPlace(c, e)?;
            if (field != none()) {
                // A `borrow mut` or `SliceMut` field is reborrowed like a variable (§13.3, §16): a mutable use of the
                // field's root, so a closure captures that mutably. Its referent must be mutable from here (§13.2).
                let referent = project(c, field, derefProjection())?;
                var reason = Vector<u8>.create();
                mutabilityError(c, referent, mut reason)?;
                if (reason.length > 0) {
                    var message = Vector<u8>.create();
                    appendText(mut message, "cannot use ")?;
                    describePlace(c, field, mut message)?;
                    appendText(mut message, " as a 'borrow mut': ")?;
                    appendBytes(mut message, reason.view())?;
                    c.error(borrowMutOfImmutable(), span.start, span.end, message)?;
                    return c.errorResult(span.start, span.end);
                }
                let fieldRoot = c.hir.places[field as usize].root;
                noteMutableUse(c, fieldRoot);
                return c.expr(HirExpr.Reborrow(true, e), expected, span.start, span.end);
            }
        }
        if (x.mutableReference && isLocalRef) {
            return c.expr(HirExpr.Reborrow(true, e), expected, span.start, span.end);
        }
        return Ok(e);
    }
    if (c.types.isClosure(expected)) {
        return coerceToClosure(c, e, expected, span);
    }
    if (c.types.isDynReference(expected) || c.types.isDynBox(expected)) {
        let converted = coerceToDyn(c, e, expected, span)?;
        if (converted != none()) {
            return Ok(converted);
        }
    }
    if (c.types.isClosure(t)) {
        var message = Vector<u8>.create();
        appendText(mut message, "expected ")?;
        appendQuotedType(mut message, c, expected)?;
        appendText(mut message, ", found the closure type ")?;
        appendQuotedType(mut message, c, t)?;
        c.error(typeMismatch(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (c.types.is(expected, TypeKind.Function) && c.types.is(t, TypeKind.Function) && sameSignature(c, t, expected)) {
        // Function types that differ only in their effect lists (§36.3): a named function takes the expected list,
        // and the effect checker holds it to it; any other value needs its own list to be within the expected one.
        let named = match (c.hir.exprs[e as usize]) {
            HirExpr.FunctionAddress(_) => true,
            _ => false,
        };
        if (named) {
            c.hir.exprTypes[e as usize] = expected;
            return Ok(e);
        }
        if (!effectsAllowed(c, t, expected, expected, t, span)?) {
            return c.errorResult(span.start, span.end);
        }
        return c.expr(HirExpr.Cast(e), expected, span.start, span.end);
    }
    let h = c.types.info(t);
    if (c.types.is(
        expected,
        TypeKind.Reference,
    ) && h.mutableReference && !x.mutableReference && h.pointee == x.pointee) {
        return c.expr(HirExpr.Reborrow(false, e), expected, span.start, span.end);
    }
    if (c.types.is(expected, TypeKind.RawPointer) && c.types.is(t, TypeKind.RawPointer) && h.mutablePointer &&
        !x.mutablePointer && h.pointee == x.pointee) {
        return c.expr(HirExpr.Cast(e), expected, span.start, span.end); // `*mut T` to `*T` (§27.1)
    }
    // `borrow Box<T>` to `borrow T` (and mut to mut or shared): a reborrow of the box's contents (§18.2).
    if (c.types.is(expected, TypeKind.Reference) && h.pointee != none() && c.types.is(h.pointee, TypeKind.Box) &&
        c.types.info(h.pointee).pointee == x.pointee && (h.mutableReference || !x.mutableReference)) {
        let contents = c.expr(HirExpr.Deref(e), h.pointee, span.start, span.end)?;
        return c.expr(HirExpr.Reborrow(x.mutableReference, contents), expected, span.start, span.end);
    }
    if (!c.types.is(
        expected,
        TypeKind.Reference,
    ) && (c.types.is(t, TypeKind.Reference) || c.types.is(t, TypeKind.Box))) {
        var read = e;
        loop {
            let rt = c.typeOf(read);
            if (rt == expected || !(c.types.is(rt, TypeKind.Reference) || c.types.is(rt, TypeKind.Box))) {
                break;
            }
            let pointee = c.types.info(rt).pointee;
            read = c.expr(HirExpr.Deref(read), pointee, span.start, span.end)?;
        }
        if (c.typeOf(read) == expected) {
            return Ok(read);
        }
    }
    let wrapped = c.types.optionType(expected);
    if (wrapped != none()) {
        // A `T` where a `T?` is expected is `Some(value)` (§22.1), tried quietly.
        let saved = c.front.diagnostics.items.length;
        let inner = coerce(c, e, wrapped, span)?;
        c.front.diagnostics.items.truncate(saved);
        if (!c.isBottom(inner)) {
            let some = variantAt(c, expected, 1);
            return enumValue(c, some, inner, expected, span);
        }
    }
    var message = Vector<u8>.create();
    appendText(mut message, "expected ")?;
    appendQuotedType(mut message, c, expected)?;
    appendText(mut message, ", found ")?;
    appendQuotedType(mut message, c, t)?;
    c.error(typeMismatch(), span.start, span.end, message)?;
    return c.errorResult(span.start, span.end);
}

/// CheckArgumentsLoosely: the call is already rejected; its arguments are still checked.
fn checkArgumentsLoosely(c: borrow mut Checker, arguments: Range) -> Result<void, AllocError> {
    for (k in 0..arguments.count) {
        var argument = c.front.ast.at(arguments, k);
        // The call is already rejected. A closure whose parameter types would have come from it is checked quietly:
        // without an expected type it could only add N0236 (§36.2).
        let quiet = match (c.front.ast.exprs[argument as usize]) {
            ExprNode.Closure(closure) => closureNeedsTypes(c, closure),
            _ => false,
        };
        if (quiet) {
            let mark = diagnosticsMark(c);
            synth(c, argument, none())?;
            dropDiagnosticsSince(c, mark);
            continue;
        }
        match (c.front.ast.exprs[argument as usize]) {
            ExprNode.MutArg(operand) => { argument = operand; }
            _ => {}
        }
        synth(c, argument, none())?;
    }
    return Ok();
}

fn synthCall(
    c: borrow mut Checker,
    callee: u32,
    arguments: Range,
    expected: u32,
    span: Span,
) -> Result<u32, AllocError> {
    let calleeSpan = c.front.ast.exprSpans[callee as usize];
    match (c.front.ast.exprs[callee as usize]) {
        ExprNode.Name(name, typeArguments) => {
            let id = c.front.ast.idents[name as usize];
            match (c.lookup(id.symbol)?) {
                Entity.Function(function) => {
                    if (typeArguments.count == 0) {
                        return checkUserCall(c, function, arguments, span);
                    }
                    var message = Vector<u8>.create();
                    appendText(mut message, "generic arguments are only supported in calls to truncate<T>(...)")?;
                    c.error(unsupported(), calleeSpan.start, calleeSpan.end, message)?;
                    return c.errorResult(span.start, span.end);
                }
                Entity.None => {
                    var message = Vector<u8>.create();
                    appendText(mut message, "cannot find function ")?;
                    appendQuotedName(mut message, c, id.symbol)?;
                    appendText(mut message, " in this scope")?;
                    c.error(undefinedName(), calleeSpan.start, calleeSpan.end, message)?;
                    checkArgumentsLoosely(c, arguments)?;
                    return c.errorResult(span.start, span.end);
                }
                Entity.Local(local) => {
                    let t = c.hir.locals[local as usize].typ;
                    if (c.types.is(t, TypeKind.Function)) {
                        let value = c.expr(HirExpr.LocalRef(local), t, calleeSpan.start, calleeSpan.end)?;
                        return checkFunctionValueCall(c, value, arguments, span);
                    }
                    if (c.types.isClosure(t)) {
                        let value = c.expr(HirExpr.LocalRef(local), t, calleeSpan.start, calleeSpan.end)?;
                        return checkClosureCall(c, value, arguments, span);
                    }
                    if (c.types.is(t, TypeKind.FunctionPointer)) {
                        let value = c.expr(HirExpr.LocalRef(local), t, calleeSpan.start, calleeSpan.end)?;
                        return checkPointerCall(c, value, arguments, span);
                    }
                    if (dynFunctionBehind(c, t) != none()) {
                        let value = c.expr(HirExpr.LocalRef(local), t, calleeSpan.start, calleeSpan.end)?;
                        return checkDynFunctionCall(c, value, arguments, span); // §36.5
                    }
                }
                Entity.Builtin(b) => {
                    if (b == 2) {
                        return checkTruncate(c, name, typeArguments, arguments, calleeSpan, span);
                    }
                    if (b == 4 || b == 5 || b == 6) {
                        return checkFloatConversion(c, b, name, typeArguments, arguments, calleeSpan, span);
                    }
                    if (b == 3) {
                        return checkLayoutOf(c, typeArguments, arguments, span);
                    }
                    // Other built-in names are not functions (SynthCall's last case).
                    var message = Vector<u8>.create();
                    appendText(mut message, "this expression cannot be called")?;
                    c.error(notCallable(), calleeSpan.start, calleeSpan.end, message)?;
                    checkArgumentsLoosely(c, arguments)?;
                    return c.errorResult(span.start, span.end);
                }
                Entity.GenericFunction(g) => {
                    return checkGenericCall(c, g, id.symbol, typeArguments, arguments, span);
                }
                _ => {}
            }
        }
        ExprNode.Member(target, member) => {
            match (c.front.ast.exprs[target as usize]) {
                ExprNode.Name(targetName, typeArguments) => {
                    let targetSymbol = c.front.ast.idents[targetName as usize].symbol;
                    match (c.lookup(targetSymbol)?) {
                        Entity.Builtin(b) => {
                            if (b == builtinVector() || b == builtinString()) {
                                let isString = b == builtinString();
                                return checkVectorCreate(
                                    c,
                                    member,
                                    target,
                                    typeArguments,
                                    isString,
                                    arguments,
                                    expected,
                                    span,
                                );
                            }
                            if (b == builtinSlotMap() || b == builtinStableVector()) {
                                let isMap = b == builtinSlotMap();
                                return checkContainerCreate(
                                    c,
                                    member,
                                    target,
                                    typeArguments,
                                    isMap,
                                    arguments,
                                    expected,
                                    span,
                                );
                            }
                            if ((b == builtinPtr() || b == builtinSlice() || b == builtinSliceMut()) &&
                                typeArguments.count == 0) {
                                return checkRawConstructor(c, b, member, arguments, span);
                            }
                            if (b == builtinStringView() && typeArguments.count == 0) {
                                return checkStringViewFunction(c, member, arguments, span);
                            }
                        }
                        Entity.Struct(index) => {
                            let nameSymbol = c.front.ast.idents[targetName as usize].symbol;
                            let owner = staticOwner(c, index, target, nameSymbol, typeArguments)?;
                            if (owner == none()) {
                                checkArgumentsLoosely(c, arguments)?;
                                return c.errorResult(span.start, span.end);
                            }
                            return checkStaticCall(c, owner, member, arguments, calleeSpan, span);
                        }
                        Entity.Enum(index) => {
                            let targetSpan = c.front.ast.exprSpans[target as usize];
                            return checkEnumValue(
                                c,
                                index,
                                member,
                                arguments,
                                typeArguments,
                                targetSpan,
                                span,
                                expected,
                            );
                        }
                        _ => {}
                    }
                    if (typeArguments.count == 0) {
                        let symbol = c.front.ast.idents[targetName as usize].symbol;
                        let entity = c.lookup(symbol)?;
                        let floatType = c.types.lookup(c.name(symbol));
                        let isNone = match (entity) {
                            Entity.None => true,
                            _ => false,
                        };
                        if (isNone && floatType != none() && c.types.is(floatType, TypeKind.Float)) {
                            return checkFromBits(c, floatType, member, arguments, span);
                        }
                        match (entity) {
                            Entity.Builtin(b) => {
                                if (b == builtinBox()) {
                                    return checkBoxCreate(c, member, arguments, expected, span);
                                }
                                if (b == builtinThread()) {
                                    return checkThreadSpawn(c, member, arguments, expected, span);
                                }
                                if (b == builtinFile() || b == builtinTcpListener() || b == builtinTcpStream()) {
                                    return checkResourceFunction(c, b, member, arguments, span);
                                }
                                if (b == builtinArena()) {
                                    return checkArenaCreate(c, member, arguments, span);
                                }
                                if (b == builtinPool()) {
                                    return checkPoolCreate(c, member, arguments, expected, span);
                                }
                                if (b == builtinFixedBufferAllocator() || b == builtinScratch()) {
                                    let isScratch = b == builtinScratch();
                                    return checkRegionConstructor(c, member, arguments, isScratch, span);
                                }
                                if (b == builtinConsole() || b == builtinProcess() || b == 23 || b == 24) {
                                    return checkBuiltinMemberCall(c, b, targetName, member, arguments, span);
                                }
                                // Any other built-in is a receiver like any value (CheckMethodCall).
                            }
                            _ => {}
                        }
                    }
                }
                _ => {}
            }
            return checkMethodCall(c, target, member, arguments, span);
        }
        _ => {}
    }
    var message = Vector<u8>.create();
    appendText(mut message, "this expression cannot be called")?;
    c.error(notCallable(), calleeSpan.start, calleeSpan.end, message)?;
    checkArgumentsLoosely(c, arguments)?;
    return c.errorResult(span.start, span.end);
}

/// CheckUserCall for a top-level function.
fn checkUserCall(c: borrow mut Checker, function: u32, arguments: Range, span: Span) -> Result<u32, AllocError> =>
    checkUserCallWith(c, function, arguments, span, none());

/// CheckUserCall: for a method, `receiver` is the already-checked `this` argument, before the explicit ones.
fn checkUserCallWith(
    c: borrow mut Checker,
    function: u32,
    arguments: Range,
    span: Span,
    receiver: u32,
) -> Result<u32, AllocError> {
    let f = borrow c.hir.functions[function as usize];
    let skip: usize = if (receiver == none()) 0 else 1;
    let parameterCount = f.parameters.length - skip;
    let returnType = f.returnType;
    let name = f.name;
    let owner = f.owner;
    let syntaxIndex = f.syntax;
    let syntax = c.front.ast.functions[syntaxIndex as usize];
    var displayName = Vector<u8>.create();
    if (owner != none()) {
        appendBytes(mut displayName, c.typeName(owner))?;
        appendText(mut displayName, ".")?;
    }
    appendBytes(mut displayName, c.name(name))?;
    let isConstant = hasAttributeNamed(c, syntax.attributes, "constant");
    let current = c.function;
    let currentConstant = current != none() &&
        containsU32(c.constantFunctions, c.hir.functions[current as usize].syntax);
    if (syntax.isUnsafe) {
        var what = Vector<u8>.create();
        appendText(mut what, "calling unsafe function '")?;
        appendBytes(mut what, displayName.view())?;
        appendText(mut what, "'")?;
        requireUnsafe(c, span, what.view())?;
    } else if (isConstant && !syntax.isExtern && c.types.isCLaidOut(returnType, 0) && !inStaticConstruction(c)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, displayName.view())?;
        appendText(
            mut message,
            "' builds C state at compile time: call it only in a static initialiser or a '@constant' function (type-system.md §39.4)",
        )?;
        c.error(notStaticInitializer(), span.start, span.end, message)?;
    } else if (syntax.isExtern && containsU32(c.constantFunctions, syntaxIndex)) {
        // A C constant macro (§39.4): only in a static initialiser or a @constant function, and safe there.
        if (!c.inStaticInitializer && !currentConstant) {
            var message = Vector<u8>.create();
            appendText(mut message, "'")?;
            appendBytes(mut message, displayName.view())?;
            appendText(
                mut message,
                "' is a C constant macro: call it only in a static initialiser or a '@constant' function (type-system.md §39.4)",
            )?;
            c.error(notStaticInitializer(), span.start, span.end, message)?;
        }
    } else if (syntax.isExtern) {
        var what = Vector<u8>.create();
        appendText(mut what, "calling C function '")?;
        appendBytes(mut what, displayName.view())?;
        appendText(mut what, "'")?;
        requireUnsafe(c, span, what.view())?;
    }
    if (arguments.count as usize != parameterCount) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        if (owner != none()) {
            appendBytes(mut message, c.typeName(owner))?;
            appendText(mut message, ".")?;
        }
        appendBytes(mut message, c.name(name))?;
        appendText(mut message, "' takes ")?;
        appendDecimal(mut message, parameterCount as u64)?;
        appendText(mut message, " argument(s) but ")?;
        appendDecimal(mut message, arguments.count as u64)?;
        appendText(mut message, " were supplied")?;
        c.error(argumentCount(), span.start, span.end, message)?;
    }
    var values = Vector<u32>.create();
    if (receiver != none()) {
        values.push(receiver)?;
    }
    for (k in 0..arguments.count) {
        let parameterType =
            if ((k as usize) <
                parameterCount) c.hir.locals[c.hir.functions[function as usize].parameters[k as usize +
                skip] as usize].typ else none();
        let argument = c.front.ast.at(arguments, k);
        values.push(checkArgument(c, argument, parameterType)?)?;
    }
    if (arguments.count as usize != parameterCount) {
        return c.errorResult(span.start, span.end);
    }
    let list = c.hir.list(values.view())?;
    return c.expr(HirExpr.Call(function, list), returnType, span.start, span.end);
}

/// CheckBuiltinMemberCall: Console, Process, Cpu and Target.
fn checkBuiltinMemberCall(
    c: borrow mut Checker,
    owner: u32,
    targetName: u32,
    member: u32,
    arguments: Range,
    span: Span,
) -> Result<u32, AllocError> {
    let targetSymbol = c.front.ast.idents[targetName as usize].symbol;
    let memberIdent = c.front.ast.idents[member as usize];
    var memberText = Vector<u8>.create();
    appendBytes(mut memberText, c.name(memberIdent.symbol))?;
    let m = memberText.view();
    if (owner == builtinProcess() && sameText(m, "capture") && !c.freestanding) {
        return checkHostService(c, member, arguments, span); // lib/std's HostServices.capture (§26.7, ADR 0028)
    }
    var function = none();
    var minArgs: u32 = 0;
    var maxArgs: u32 = 0;
    if (owner == builtinConsole() && sameText(m, "write")) {
        function = bfConsoleWrite();
        minArgs = 1;
        maxArgs = 1;
    } else if (owner == builtinConsole() && sameText(m, "writeLine")) {
        function = bfConsoleWriteLine();
        maxArgs = 1;
    } else if (owner == builtinProcess() && sameText(m, "exit")) {
        function = bfProcessExit();
        minArgs = 1;
        maxArgs = 1;
    } else if (owner == builtinProcess() && sameText(m, "argumentCount")) {
        function = bfArgumentCount();
    } else if (owner == builtinProcess() && sameText(m, "argument")) {
        function = bfArgument();
        minArgs = 1;
        maxArgs = 1;
    } else if (owner == builtinProcess() && sameText(m, "run")) {
        function = bfProcessRun();
        minArgs = 2;
        maxArgs = 2;
    } else if (owner == builtinConsole() && sameText(m, "read")) {
        function = bfConsoleRead();
        minArgs = 1;
        maxArgs = 1;
    } else if (owner == builtinConsole() && sameText(m, "writeBytes")) {
        function = bfConsoleWriteBytes();
        minArgs = 1;
        maxArgs = 1;
    } else if (owner == builtinConsole() && sameText(m, "writeError")) {
        function = bfConsoleWriteError();
        minArgs = 1;
        maxArgs = 1;
    } else if (owner == builtinConsole() && sameText(m, "writeErrorLine")) {
        function = bfConsoleWriteErrorLine();
        maxArgs = 1;
    } else if (owner == 23 && sameText(m, "spinHint")) {
        function = bfSpinHint();
    } else if (owner == 24 && sameText(m, "isX86_64")) {
        function = bfTargetIsX8664();
    } else if (owner == 24 && sameText(m, "isAArch64")) {
        function = bfTargetIsAArch64();
    } else if (owner == 24 && sameText(m, "pointerBits")) {
        function = bfTargetPointerBits();
    }
    if (function == none()) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, targetSymbol)?;
        appendText(mut message, " has no member '")?;
        appendBytes(mut message, m)?;
        appendText(mut message, "'")?;
        c.error(undefinedName(), memberIdent.start, memberIdent.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let count = arguments.count;
    if (count < minArgs || count > maxArgs) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, c.name(targetSymbol))?;
        appendText(mut message, ".")?;
        appendBytes(mut message, m)?;
        appendText(mut message, "' takes ")?;
        appendDecimal(mut message, minArgs as u64)?;
        if (minArgs != maxArgs) {
            appendText(mut message, " or ")?;
            appendDecimal(mut message, maxArgs as u64)?;
        }
        appendText(mut message, " argument(s) but ")?;
        appendDecimal(mut message, count as u64)?;
        appendText(mut message, " were supplied")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    if (function == bfProcessExit()) {
        let i32Type = c.types.i32;
        let codeSyntax = c.front.ast.at(arguments, 0);
        let code = checkExpr(c, codeSyntax, i32Type)?;
        let codes = [code];
        let list = c.hir.list(codes[..])?;
        let never = c.types.never;
        return c.expr(HirExpr.BuiltinCall(function, list), never, span.start, span.end);
    }
    if (function == bfSpinHint()) {
        let voidType = c.types.voidType;
        return c.expr(HirExpr.BuiltinCall(function, emptyRange()), voidType, span.start, span.end);
    }
    if (function == bfTargetIsX8664() || function == bfTargetIsAArch64()) {
        let boolType = c.types.boolType; // decided by the C compiler (§29.3)
        return c.expr(HirExpr.BuiltinCall(function, emptyRange()), boolType, span.start, span.end);
    }
    if (function == bfTargetPointerBits()) {
        let u32Type = c.types.u32;
        let bits = c.types.info(c.types.usize).bits;
        return c.expr(
            HirExpr.IntConst(IntValue { negative: false, magnitude: bits as u64 }),
            u32Type,
            span.start,
            span.end,
        );
    }
    if (function == bfArgumentCount()) {
        let usize = c.types.usize;
        return c.expr(HirExpr.BuiltinCall(function, emptyRange()), usize, span.start, span.end);
    }
    if (function == bfArgument()) {
        let usize = c.types.usize;
        let indexSyntax = c.front.ast.at(arguments, 0);
        let index = checkExpr(c, indexSyntax, usize)?;
        let values = [index];
        let list = c.hir.list(values[..])?;
        let view = c.types.stringView;
        let option = optionOf(c, view)?;
        return c.expr(HirExpr.BuiltinCall(function, list), option, span.start, span.end);
    }
    if (function == bfProcessRun()) {
        let view = c.types.stringView;
        let programSyntax = c.front.ast.at(arguments, 0);
        let program = checkArgument(c, programSyntax, view)?;
        let systemHeap = c.systemHeapType;
        let vector = vectorType(c, view, systemHeap)?;
        let views = c.types.referenceTo(vector, false)?;
        let listSyntax = c.front.ast.at(arguments, 1);
        let argumentList = checkArgument(c, listSyntax, views)?;
        if (c.isBottom(program) || c.isBottom(argumentList)) {
            return c.errorResult(span.start, span.end);
        }
        let i32Type = c.types.i32;
        let result = ioResult(c, i32Type)?;
        let values = [program, argumentList];
        let list = c.hir.list(values[..])?;
        return c.expr(HirExpr.BuiltinCall(function, list), result, span.start, span.end);
    }
    if (function == bfConsoleRead() || function == bfConsoleWriteBytes()) {
        let read = function == bfConsoleRead();
        let u8Type = c.types.u8;
        let bytes = c.types.sliceOf(u8Type, read)?;
        let bytesSyntax = c.front.ast.at(arguments, 0);
        let argument = checkArgument(c, bytesSyntax, bytes)?;
        let values = [argument];
        let list = c.hir.list(values[..])?;
        if (read) {
            let usize = c.types.usize;
            let result = ioResult(c, usize)?;
            return c.expr(HirExpr.BuiltinCall(function, list), result, span.start, span.end);
        }
        let voidType = c.types.voidType;
        return c.expr(HirExpr.BuiltinCall(function, list), voidType, span.start, span.end);
    }
    if (function == bfConsoleWriteError() || function == bfConsoleWriteErrorLine()) {
        var texts = Vector<u32>.create();
        let view = c.types.stringView;
        for (k in 0..count) {
            let argument = c.front.ast.at(arguments, k);
            texts.push(checkArgument(c, argument, view)?)?;
        }
        let list = c.hir.list(texts.view())?;
        let voidType = c.types.voidType;
        return c.expr(HirExpr.BuiltinCall(function, list), voidType, span.start, span.end);
    }
    var values = Vector<u32>.create();
    for (k in 0..count) {
        let argument = c.front.ast.at(arguments, k);
        let synthesized = synth(c, argument, none())?;
        let read = autoDeref(c, synthesized)?;
        var value = printableView(c, read)?;
        let t = c.typeOf(value);
        if (!c.types.isBottom(t) && !c.types.is(t, TypeKind.Integer) && !c.types.is(t, TypeKind.Float) &&
            !c.types.is(t, TypeKind.Bool) && !c.types.isStringView(t)) {
            let argumentSpan = c.front.ast.exprSpans[argument as usize];
            var message = Vector<u8>.create();
            appendText(mut message, "'Console.")?;
            appendBytes(mut message, m)?;
            appendText(mut message, "' can print integers, floats, bools and string views, not ")?;
            appendQuotedType(mut message, c, t)?;
            c.error(invalidOperandTypes(), argumentSpan.start, argumentSpan.end, message)?;
            value = c.errorResult(argumentSpan.start, argumentSpan.end)?;
        }
        values.push(value)?;
    }
    let list = c.hir.list(values.view())?;
    let voidType = c.types.voidType;
    return c.expr(HirExpr.BuiltinCall(function, list), voidType, span.start, span.end);
}

/// ViewOf, and a String place as a view of its text (PrintableView, §23.2).
fn printableView(c: borrow mut Checker, e: u32) -> Result<u32, AllocError> {
    let isStringText = c.types.info(c.typeOf(e)).isStr && match (c.hir.exprs[e as usize]) {
        HirExpr.Deref(r) => c.types.isString(c.typeOf(r)),
        _ => false,
    };
    if (isStringText) {
        let place = toPlace(c, e)?;
        if (place != none()) {
            let span = c.spanOf(e);
            let view = c.types.stringView;
            return c.expr(HirExpr.Borrow(false, place), view, span.start, span.end);
        }
    }
    return Ok(viewOf(c, e));
}

/// Does a flexible expression hold a float literal (HasFloatLiteral)?
fn hasFloatLiteral(c: borrow Checker, e: u32) -> bool => match (c.front.ast.exprs[e as usize]) {
    ExprNode.FloatLiteral(_, _) => true,
    ExprNode.Paren(inner) => hasFloatLiteral(c, inner),
    ExprNode.Unary(_, operand) => hasFloatLiteral(c, operand),
    ExprNode.Binary(left, _, right) => hasFloatLiteral(c, left) || hasFloatLiteral(c, right),
    ExprNode.If(_, then, otherwise) => hasFloatLiteral(c, then) || hasFloatLiteral(c, otherwise),
    ExprNode.Match(_, arms) => anyArmHasFloatLiteral(c, arms),
    _ => false,
};

fn anyArmHasFloatLiteral(c: borrow Checker, arms: Range) -> bool {
    for (k in 0..arms.count) {
        if (hasFloatLiteral(c, c.front.ast.valueArms[c.front.ast.at(arms, k) as usize].value)) {
            return true;
        }
    }
    return false;
}

/// `e as T` (SynthCast): only conversions that never lose information (§7).
fn synthCast(c: borrow mut Checker, operandSyntax: u32, typeSyntax: u32, span: Span) -> Result<u32, AllocError> {
    let target = c.resolveType(typeSyntax, false)?;
    if (c.types.isBottom(target)) {
        synth(c, operandSyntax, none())?;
        return c.errorResult(span.start, span.end);
    }
    let pointerTarget = c.types.is(target, TypeKind.RawPointer) || c.types.is(target, TypeKind.FunctionPointer);
    if (pointerTarget && isFlexible(c, operandSyntax)) {
        // `0 as *mut T`: a literal address (§27.2, §29.5).
        let usize = c.types.usize;
        let address = checkExpr(c, operandSyntax, usize)?;
        if (c.isBottom(address)) {
            return Ok(address);
        }
        return c.expr(HirExpr.Cast(address), target, span.start, span.end);
    }
    // `5 as u64`, `1.5 as f32`: a flexible literal simply takes the target type, if it is of the same kind.
    if (isFlexible(c, operandSyntax) && hasFloatLiteral(c, operandSyntax) == c.types.is(target, TypeKind.Float)) {
        let value = checkExpr(c, operandSyntax, target)?;
        c.hir.exprSpans[value as usize] = span;
        return Ok(value);
    }
    let synthesized = synth(c, operandSyntax, none())?;
    let synthesizedType = c.typeOf(synthesized);
    if (pointerTarget || c.types.is(
        synthesizedType,
        TypeKind.RawPointer,
    ) || c.types.is(synthesizedType, TypeKind.FunctionPointer)) {
        return checkPointerCast(c, synthesized, target, span);
    }
    let operand = autoDeref(c, synthesized)?;
    let operandType = c.typeOf(operand);
    if (c.types.isBottom(operandType)) {
        return Ok(operand);
    }
    if (!c.types.isLosslessCast(operandType, target)) {
        let integers = c.types.is(operandType, TypeKind.Integer) && c.types.is(target, TypeKind.Integer);
        var message = Vector<u8>.create();
        appendText(mut message, "cannot convert ")?;
        appendQuotedType(mut message, c, operandType)?;
        appendText(mut message, " to ")?;
        appendQuotedType(mut message, c, target)?;
        appendText(mut message, " with 'as': 'as' only allows conversions that never lose information")?;
        if (integers) {
            appendText(mut message, "; use truncate<")?;
            appendBytes(mut message, c.typeName(target))?;
            appendText(mut message, ">(...) to convert with wrap-around")?;
            // `(a + b) as u8` → `truncate<u8>(a + b)`: the operand's text, without its parentheses.
            let inner = match (c.front.ast.exprs[operandSyntax as usize]) {
                ExprNode.Paren(i) => i,
                _ => operandSyntax,
            };
            let innerSpan = c.front.ast.exprSpans[inner as usize];
            var title = Vector<u8>.create();
            appendText(mut title, "use truncate<")?;
            appendBytes(mut title, c.typeName(target))?;
            appendText(mut title, ">(…)")?;
            var text = Vector<u8>.create();
            appendText(mut text, "truncate<")?;
            appendBytes(mut text, c.typeName(target))?;
            appendText(mut text, ">(")?;
            appendBytes(mut text, c.fileTexts[c.file as usize][(innerSpan.start as usize)..(innerSpan.end as usize)])?;
            appendText(mut text, ")")?;
            c.errorWithFix(invalidCast(), span.start, span.end, message, title, span.start, span.end, text)?;
        } else {
            c.error(invalidCast(), span.start, span.end, message)?;
        }
        return c.errorResult(span.start, span.end);
    }
    if (operandType == target) {
        c.hir.exprSpans[operand as usize] = span;
        return Ok(operand);
    }
    return c.expr(HirExpr.Cast(operand), target, span.start, span.end);
}

/// `truncate<T>(e)` (CheckTruncate): an integer reduced modulo 2^bits(T); a float rounds toward zero (§35.4).
fn checkTruncate(
    c: borrow mut Checker,
    name: u32,
    typeArguments: Range,
    arguments: Range,
    nameSpan: Span,
    span: Span,
) -> Result<u32, AllocError> {
    if (typeArguments.count != 1) {
        var message = Vector<u8>.create();
        appendText(mut message, "truncate needs exactly one type argument: truncate<T>(value)")?;
        c.error(unsupported(), nameSpan.start, nameSpan.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let typeSyntax = c.front.ast.at(typeArguments, 0);
    var target = c.resolveType(typeSyntax, false)?;
    if (!c.types.isBottom(target) && !c.types.is(target, TypeKind.Integer)) {
        let typeSpan = c.front.ast.typeSpans[typeSyntax as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "truncate<T> requires an integer type, found ")?;
        appendQuotedType(mut message, c, target)?;
        if (c.types.is(target, TypeKind.Float)) {
            appendText(mut message, "; use round<")?;
            appendBytes(mut message, c.typeName(target))?;
            appendText(mut message, ">(...) to convert to a float")?;
        }
        c.error(invalidOperandTypes(), typeSpan.start, typeSpan.end, message)?;
        target = c.types.error;
    }
    if (arguments.count != 1) {
        var message = Vector<u8>.create();
        appendText(mut message, "truncate takes 1 argument but ")?;
        appendDecimal(mut message, arguments.count as u64)?;
        appendText(mut message, " were supplied")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let argument = c.front.ast.at(arguments, 0);
    let synthesized = synth(c, argument, none())?;
    let operand = autoDeref(c, synthesized)?;
    let operandType = c.typeOf(operand);
    if (!c.types.isBottom(operandType) && !c.types.is(
        operandType,
        TypeKind.Integer,
    ) && !c.types.is(operandType, TypeKind.Float)) {
        let argumentSpan = c.front.ast.exprSpans[argument as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "truncate requires an integer or float value, found ")?;
        appendQuotedType(mut message, c, operandType)?;
        c.error(invalidOperandTypes(), argumentSpan.start, argumentSpan.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (c.types.isBottom(target) || c.types.isBottom(operandType)) {
        return c.errorResult(span.start, span.end);
    }
    if (c.types.is(operandType, TypeKind.Float)) {
        return c.expr(HirExpr.FloatToInt(operand, FloatToIntMode.Panic), target, span.start, span.end);
    }
    return c.expr(HirExpr.Truncate(operand), target, span.start, span.end);
}

fn invalidCast() -> u32 => 208;

/// SynthMember: so far only `Console.writeLine` without a call (N0210); field access and enum variants come with S2.
fn synthMember(c: borrow mut Checker, target: u32, member: u32, span: Span, expected: u32) -> Result<u32, AllocError> {
    match (c.front.ast.exprs[target as usize]) {
        ExprNode.Name(name, typeArguments) => {
            let symbol = c.front.ast.idents[name as usize].symbol;
            match (c.lookup(symbol)?) {
                Entity.Enum(index) => {
                    // `Shape.Empty`: a variant without payload.
                    let targetSpan = c.front.ast.exprSpans[target as usize];
                    return checkEnumValue(c, index, member, emptyRange(), typeArguments, targetSpan, span, expected);
                }
                _ => {}
            }
            if (typeArguments.count == 0) {
                match (c.lookup(symbol)?) {
                    Entity.Builtin(_) => {
                        return notAValue(c, symbol, member, span);
                    }
                    Entity.Struct(_) => {
                        return notAValue(c, symbol, member, span);
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    let synthesized = synth(c, target, none())?;
    var through = synthesized;
    while (c.types.is(c.typeOf(through), TypeKind.Reference)) {
        let s = c.spanOf(through);
        let pointee = c.types.info(c.typeOf(through)).pointee;
        through = c.expr(HirExpr.Deref(through), pointee, s.start, s.end)?;
    }
    let throughType = c.typeOf(through);
    if (c.types.is(throughType, TypeKind.SlotMap)) {
        let targetSpan = c.front.ast.exprSpans[target as usize];
        return slotMapMember(c, through, member, targetSpan, span);
    }
    if (c.types.is(throughType, TypeKind.Vector) && sameText(
        c.name(c.front.ast.idents[member as usize].symbol),
        "capacity",
    )) {
        let targetSpan = c.front.ast.exprSpans[target as usize];
        return vectorCapacity(c, through, targetSpan, span);
    }
    let value = autoDeref(c, synthesized)?;
    let valueType = c.typeOf(value);
    let arrayValue = arrayMember(c, value, through, member, span)?;
    if (arrayValue != none()) {
        return Ok(arrayValue);
    }
    let field = resolveField(c, valueType, member)?;
    if (field == none()) {
        return c.errorResult(span.start, span.end);
    }
    let fieldType = c.types.fields[field as usize].typ;
    return c.expr(HirExpr.FieldAccess(value, field), fieldType, span.start, span.end);
}

/// `Console.writeLine` or `Point.origin` without a call: N0210.
fn notAValue(c: borrow mut Checker, symbol: u32, member: u32, span: Span) -> Result<u32, AllocError> {
    var message = Vector<u8>.create();
    appendText(mut message, "'")?;
    appendBytes(mut message, c.name(symbol))?;
    appendText(mut message, ".")?;
    appendBytes(mut message, c.name(c.front.ast.idents[member as usize].symbol))?;
    appendText(mut message, "' is not a value; call it with '(...)'")?;
    c.error(notCallable(), span.start, span.end, message)?;
    return c.errorResult(span.start, span.end);
}

fn cannotFind(c: borrow mut Checker, symbol: u32, span: Span) -> Result<void, AllocError> {
    var message = Vector<u8>.create();
    appendText(mut message, "cannot find ")?;
    appendQuotedName(mut message, c, symbol)?;
    appendText(mut message, " in this scope")?;
    return c.error(undefinedName(), span.start, span.end, message);
}
