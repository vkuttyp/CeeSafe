// `dyn I` (the reference's ResolveDynType, DynMethod and CoerceToDyn, and CheckArgument's dyn cases): P3 S4d
// (type-system.md §37). `dyn fn` comes with closures (S6); the program's list of dyn signatures (DynSignatures) and
// its tables are only read by the C backend (P5), which builds the list.

fn dynNotBehindPointer() -> u32 => 330;
fn dynIncompatible() -> u32 => 331;

/// The table of one implementation of a dyn type (DynTable): its methods in the interface's order.
struct DynTable {
    implementation: u32;
    dynType: u32;
    methods: Range; // HIR functions, in Hir.lists
}

/// `dyn I` or `dyn I + Send` (ResolveDynType, §37.1): only behind a reference or in a box (`allowed`).
fn resolveDynType(
    c: borrow mut Checker,
    interfaceSyntax: u32,
    mutable: bool,
    send: bool,
    span: Span,
    allowed: bool,
) -> Result<u32, AllocError> {
    match (c.front.ast.types[interfaceSyntax as usize]) {
        TypeNode.Function(attributes, parameters, result) => {
            // `dyn fn(…) -> R` / `dyn mut fn(…) -> R` (§36.5).
            let functionSpan = c.front.ast.typeSpans[interfaceSyntax as usize];
            let callable = c.resolveFunctionType(attributes, parameters, result, functionSpan)?;
            if (c.types.isBottom(callable)) {
                return Ok(c.types.error);
            }
            var types = Vector<u32>.create();
            listTypes(c, c.types.info(callable).parameters, mut types)?;
            let callableResult = c.types.info(callable).result;
            let callableEffects = c.types.info(callable).effects;
            let dynFunction = c.types.dynFunctionOf(types.view(), callableResult, callableEffects, mutable, send)?;
            if (!allowed) {
                var message = Vector<u8>.create();
                appendQuotedType(mut message, c, dynFunction)?;
                appendText(mut message, " has no size the compiler knows: use it in a box, 'Box<")?;
                appendBytes(mut message, c.typeName(dynFunction))?;
                appendText(mut message, ">' (type-system.md §36.5)")?;
                c.error(dynNotBehindPointer(), span.start, span.end, message)?;
                return Ok(c.types.error);
            }
            return Ok(dynFunction);
        }
        _ => {}
    }
    if (mutable) {
        var message = Vector<u8>.create();
        appendText(mut message, "'dyn mut' is only for closure types: 'dyn mut fn(…) -> R' (type-system.md §36.5)")?;
        c.error(unknownType(), span.start, span.end, message)?;
        return Ok(c.types.error);
    }
    let bound = resolveInterface(c, interfaceSyntax)?;
    if (bound == none()) {
        return Ok(c.types.error);
    }
    if (!allowed) {
        var message = Vector<u8>.create();
        appendText(mut message, "'dyn ")?;
        boundText(mut message, c, bound)?;
        appendText(mut message, "' has no size the compiler knows: use it behind a reference or a box ('borrow dyn ")?;
        boundText(mut message, c, bound)?;
        appendText(mut message, "', 'Box<dyn ")?;
        boundText(mut message, c, bound)?;
        appendText(mut message, ">'; type-system.md §37.1)")?;
        c.error(dynNotBehindPointer(), span.start, span.end, message)?;
        return Ok(c.types.error);
    }
    let entry = c.types.bounds[bound as usize].interfaceEntry;
    let methods = interfaceMethods(c, entry);
    for (k in 0..methods.count) {
        let m = c.front.ast.functions[c.front.ast.at(methods, k) as usize];
        if (receiverIndex(m.receiver) == 1) {
            var message = Vector<u8>.create();
            quotedBound(mut message, c, bound)?;
            appendText(mut message, " cannot be used as 'dyn ")?;
            boundText(mut message, c, bound)?;
            appendText(mut message, "': its method ")?;
            appendQuotedName(mut message, c, c.front.ast.idents[m.name as usize].symbol)?;
            appendText(
                mut message,
                " takes 'this' by value, which a call through a table cannot pass (type-system.md §37.1)",
            )?;
            c.error(dynIncompatible(), span.start, span.end, message)?;
            return Ok(c.types.error);
        }
    }
    return c.types.dynOf(bound, send);
}

/// A reference's pointee or a box's contents (ResolvePointee): the only types that may be a `dyn I` (§37.1).
fn resolvePointee(c: borrow mut Checker, syntax: u32) -> Result<u32, AllocError> {
    c.dynAllowed = true;
    c.allowImported = true;
    let t = c.resolveType(syntax, false)?;
    c.dynAllowed = false;
    return Ok(t);
}

/// The method `name` of `dyn I` (DynMethod, §37.3): the interface's signature with the dyn type as its receiver's,
/// no body. None if `I` has no such method, and for a `dyn fn`, which has no methods (the reference crashes there).
fn dynMethod(c: borrow mut Checker, dynType: u32, name: u32) -> Result<u32, AllocError> {
    let bound = c.types.info(dynType).dynInterface;
    if (bound == none()) {
        return Ok(none());
    }
    let b = c.types.bounds[bound as usize];
    let methods = interfaceMethods(c, b.interfaceEntry);
    var slot = none();
    for (k in 0..methods.count) {
        let m = c.front.ast.functions[c.front.ast.at(methods, k) as usize];
        if (slot == none() && c.front.ast.idents[m.name as usize].symbol == name) {
            slot = k;
        }
    }
    if (slot == none()) {
        return Ok(none());
    }
    for (m in c.boundMethods.view()) {
        if (m.typ == dynType && m.bound == none() && m.name == name) {
            return Ok(m.function);
        }
    }
    let entry = c.interfaces[b.interfaceEntry as usize];
    let interfaceParameters = match (c.front.ast.items[entry.item as usize].kind) {
        ItemKind.Interface(_, t) => t,
        _ => emptyRange(),
    };
    var arguments = Vector<u32>.create();
    listTypes(c, b.arguments, mut arguments)?;
    var pairs = Vector<EnvPair>.create();
    zipEnvironment(c, interfaceParameters, arguments.view(), mut pairs)?;
    let environment = storeEnvironment(c, pairs.view())?;
    let savedFile = c.file;
    c.file = entry.file;
    let signature = c.front.ast.at(methods, slot);
    let function = declareSignature(c, signature, dynType, environment)?;
    c.file = savedFile;
    c.hir.functions[function as usize].isDynMethod = true;
    c.hir.functions[function as usize].dynSlot = slot;
    let attributes = effectAttributesOf(c, signature);
    c.hir.functions[function as usize].declaredEffects =
        if (attributes == none()) none() else c.effectAttributes[attributes as usize].declared;
    c.boundMethods.push(BoundMethod { typ: dynType, bound: none(), name: name, function: function })?;
    return Ok(function);
}

/// `e` (a `borrow T`, `borrow mut T` or `Box<T, A>`) as the dyn type `expected` (CoerceToDyn, §37.2): `T` must implement
/// the interface (N0268). Records the table of the pair. None if `e` is not such a value.
fn coerceToDyn(c: borrow mut Checker, e: u32, expected: u32, span: Span) -> Result<u32, AllocError> {
    let x = c.types.info(expected);
    let dynType = x.pointee;
    let expectsReference = c.types.isDynReference(expected);
    var value = e;
    var actual = c.typeOf(e);
    if (expectsReference && c.types.is(actual, TypeKind.Reference)) {
        let box = c.types.info(actual).pointee;
        if (c.types.is(box, TypeKind.Box) && !isPoolBox(c, box)) {
            if (c.types.isDyn(c.types.info(box).pointee)) {
                return Ok(none()); // `borrow Box<dyn I>` to `borrow dyn I`: a reborrow of the box's contents (§18.2)
            }
            // `borrow Box<T>` lends its contents, a `T` (§18.2), which then coerces.
            let mutable = c.types.info(actual).mutableReference && x.mutableReference;
            let contents = c.types.info(box).pointee;
            let deref = c.expr(HirExpr.Deref(value), box, span.start, span.end)?;
            let lent = c.types.referenceTo(contents, mutable)?;
            value = c.expr(HirExpr.Reborrow(mutable, deref), lent, span.start, span.end)?;
            actual = lent;
        }
    }
    let a = c.types.info(actual);
    let fits = if (expectsReference) c.types.is(
        actual,
        TypeKind.Reference,
    ) && (a.mutableReference || !x.mutableReference) else c.types.is(
        actual,
        TypeKind.Box,
    ) && a.allocator == x.allocator;
    let pointee = a.pointee;
    if (fits && c.types.isDyn(pointee) && c.types.info(pointee).sendDyn && !c.types.info(dynType).sendDyn &&
        sameDyn(c, pointee, dynType)) {
        return c.expr(HirExpr.Cast(value), expected, span.start, span.end); // forgetting `+ Send` (§38.4)
    }
    if (!fits || c.types.isDyn(pointee) || c.types.isUnsized(pointee) || c.types.info(pointee).isStr ||
        c.types.isClosure(pointee)) {
        return Ok(none());
    }
    let implementation = pointee;
    if (c.types.info(dynType).sendDyn && !c.types.isSendType(implementation)?) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, implementation)?;
        appendText(mut message, " is not Send, so it cannot be a ")?;
        appendQuotedType(mut message, c, dynType)?;
        appendText(mut message, " (type-system.md §38.4)")?;
        c.error(notSend(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let bound = c.types.info(dynType).dynInterface;
    if (bound == none()) {
        return coerceToDynFunction(c, value, implementation, dynType, expected, span);
    }
    if (!implements(c, implementation, bound)) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, implementation)?;
        appendText(mut message, " does not implement ")?;
        quotedBound(mut message, c, bound)?;
        appendText(mut message, ", so it cannot be a ")?;
        appendQuotedType(mut message, c, dynType)?;
        appendText(mut message, " (type-system.md §37.2)")?;
        c.error(boundNotSatisfied(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    var recorded = false;
    for (t in c.dynTables.view()) {
        if (t.implementation == implementation && t.dynType == dynType) {
            recorded = true;
        }
    }
    if (!recorded) {
        let methods = interfaceMethods(c, c.types.bounds[bound as usize].interfaceEntry);
        var functions = Vector<u32>.create();
        for (k in 0..methods.count) {
            let m = c.front.ast.functions[c.front.ast.at(methods, k) as usize];
            functions.push(implMethodFor(c, implementation, c.front.ast.idents[m.name as usize].symbol))?;
        }
        let list = c.hir.list(functions.view())?;
        c.dynTables.push(DynTable { implementation: implementation, dynType: dynType, methods: list })?;
    }
    return c.expr(HirExpr.Cast(value), expected, span.start, span.end);
}

/// A boxed move literal's environment as a `dyn fn` (CoerceToDynFunction, §36.5): the same signature, and a changing
/// body only for `dyn mut fn`. Its table's one entry is the body. None if `environment` is no move literal's.
fn coerceToDynFunction(
    c: borrow mut Checker,
    e: u32,
    environment: u32,
    dynType: u32,
    expected: u32,
    span: Span,
) -> Result<u32, AllocError> {
    var body = none();
    for (m in c.moveBodies.view()) {
        if (m.environment == environment) {
            body = m.function;
        }
    }
    if (body == none()) {
        return Ok(none());
    }
    let parameters = c.hir.functions[body as usize].parameters.length;
    let d = c.types.info(dynType);
    var same = (parameters - 1) == (d.parameters.count as usize) &&
        c.hir.functions[body as usize].returnType == d.result;
    if (same) {
        for (k in 1..parameters) {
            let local = c.hir.functions[body as usize].parameters[k];
            if (c.hir.locals[local as usize].typ != c.types.listAt(d.parameters, truncate<u32>(k - 1))) {
                same = false;
            }
        }
    }
    if (!same) {
        return Ok(none());
    }
    if (!d.mutableDynFunction) {
        let captures = c.hir.functions[body as usize].closureCaptures;
        for (k in 0..captures.count) {
            if (isMutableCapture(c.hir.captures[(captures.start + k) as usize].mode)) {
                var message = Vector<u8>.create();
                appendText(mut message, "expected ")?;
                appendQuotedType(mut message, c, expected)?;
                appendText(
                    mut message,
                    ", but this closure changes what it captured, so it is a 'dyn mut fn' (type-system.md §36.5)",
                )?;
                c.error(closureKind(), span.start, span.end, message)?;
                return c.errorResult(span.start, span.end);
            }
        }
    }
    var recorded = false;
    for (t in c.dynTables.view()) {
        if (t.implementation == environment && t.dynType == dynType) {
            recorded = true;
        }
    }
    if (!recorded) {
        let functions = [body];
        let list = c.hir.list(functions[..])?;
        c.dynTables.push(DynTable { implementation: environment, dynType: dynType, methods: list })?;
    }
    return c.expr(HirExpr.Cast(e), expected, span.start, span.end);
}

/// Two dyn types that differ at most in `+ Send` (SameDyn, §38.4).
fn sameDyn(c: borrow Checker, a: u32, b: u32) -> bool {
    let x = c.types.info(a);
    let y = c.types.info(b);
    if (x.dynInterface == none()) {
        return y.dynInterface == none() && x.mutableDynFunction == y.mutableDynFunction && x.effects == y.effects &&
            sameLists(c, x.parameters, y.parameters) && x.result == y.result;
    }
    return y.dynInterface != none() && sameBound(c, x.dynInterface, y.dynInterface);
}

/// The method `call` of a `dyn fn` type (DynFunctionMethod, §36.5): a bodiless dyn method taking the closure (shared,
/// or mutable for `dyn mut fn`) and the parameters, with the type's effect list.
fn dynFunctionMethod(c: borrow mut Checker, dynType: u32) -> Result<u32, AllocError> {
    let callSymbol = c.intern("call")?;
    for (m in c.boundMethods.view()) {
        if (m.typ == dynType && m.bound == none() && m.name == callSymbol) {
            return Ok(m.function);
        }
    }
    let d = c.types.info(dynType);
    let nameIdent = c.front.ast.addIdent(Ident { symbol: callSymbol, start: 0, end: 0, missing: false })?;
    c.front.ast.functions.push(Function {
        visibility: Visibility.Default,
        name: nameIdent,
        receiver: if (d.mutableDynFunction) ReceiverKind.BorrowMut else ReceiverKind.Borrow,
        receiverStart: 0,
        receiverEnd: 0,
        parameters: emptyRange(),
        returnType: none(),
        body: none(),
        expressionBody: none(),
        typeParameters: emptyRange(),
        regionParameters: emptyRange(),
        isUnsafe: false,
        hasDoc: false,
        doc: emptyRange(),
        isExtern: false,
        attributes: emptyRange(),
        start: 0,
        end: 0,
    })?;
    let syntax = truncate<u32>(c.front.ast.functions.length - 1);
    let library = isLibraryFile(c);
    let function = c.hir.addFunction(callSymbol, dynType, d.result, c.file, syntax, library, false)?;
    c.hir.functions[function as usize].isDynMethod = true;
    c.hir.functions[function as usize].dynSlot = 0;
    c.hir.functions[function as usize].declaredEffects = boundOf(c, dynType);
    let thisType = c.types.referenceTo(dynType, d.mutableDynFunction)?;
    let thisSymbol = c.thisSymbol;
    let receiver = c.hir.addLocal(function, thisSymbol, thisType, false, true, 0, 0)?;
    c.hir.functions[function as usize].parameters.push(receiver)?;
    for (k in 0..d.parameters.count) {
        var text = Vector<u8>.create();
        text.push('a')?;
        appendDecimal(mut text, k as u64)?;
        let name = c.front.symbols.intern(text.view())?.id;
        let t = c.types.listAt(d.parameters, k);
        let local = c.hir.addLocal(function, name, t, false, true, 0, 0)?;
        c.hir.functions[function as usize].parameters.push(local)?;
    }
    c.boundMethods.push(BoundMethod { typ: dynType, bound: none(), name: callSymbol, function: function })?;
    return Ok(function);
}

/// `f(args)` where `f` reaches a `dyn fn` through references and boxes (CheckDynFunctionCall, §36.5): a call of its
/// `call` method on a borrow of the closure, mutable for `dyn mut fn`.
fn checkDynFunctionCall(c: borrow mut Checker, callee: u32, arguments: Range, span: Span) -> Result<u32, AllocError> {
    let calleeSpan = c.hir.exprSpans[callee as usize];
    var target = callee;
    while (!c.types.isDyn(c.typeOf(target))) {
        let pointee = c.types.info(c.typeOf(target)).pointee;
        target = c.expr(HirExpr.Deref(target), pointee, calleeSpan.start, calleeSpan.end)?;
    }
    let dynType = c.typeOf(target);
    let d = c.types.info(dynType);
    if (arguments.count != d.parameters.count) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, dynType)?;
        appendText(mut message, " takes ")?;
        appendDecimal(mut message, d.parameters.count as u64)?;
        appendText(mut message, " argument(s) but ")?;
        appendDecimal(mut message, arguments.count as u64)?;
        appendText(mut message, " were supplied")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    if (d.mutableDynFunction && !canMutateThrough(c, target)) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, dynType)?;
        appendText(
            mut message,
            " changes what it captured, so calling it needs mutable access, but this closure is behind a shared reference or in a 'let' (type-system.md §36.5)",
        )?;
        c.error(borrowMutOfImmutable(), calleeSpan.start, calleeSpan.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let method = dynFunctionMethod(c, dynType)?;
    var values = Vector<u32>.create();
    values.push(borrowPlace(c, target, d.mutableDynFunction, calleeSpan)?)?;
    var bottom = false;
    for (k in 0..arguments.count) {
        let syntax = c.front.ast.at(arguments, k);
        let parameter = c.types.listAt(d.parameters, k);
        let argument = checkArgument(c, syntax, parameter)?;
        if (c.isBottom(argument)) {
            bottom = true;
        }
        values.push(argument)?;
    }
    if (bottom || c.isBottom(values[0])) {
        return c.errorResult(span.start, span.end);
    }
    let list = c.hir.list(values.view())?;
    return c.expr(HirExpr.Call(method, list), d.result, span.start, span.end);
}

/// Does a place allow a mutable borrow: no shared reference on its path, and a `var` (or mutable reference) at its
/// root (CanMutateThrough)?
fn canMutateThrough(c: borrow Checker, place: u32) -> bool {
    match (c.hir.exprs[place as usize]) {
        HirExpr.Deref(reference) => {
            let t = c.typeOf(reference);
            return if (c.types.is(t, TypeKind.Reference)) c.types.info(t).mutableReference else canMutateThrough(
                c,
                reference,
            );
        }
        HirExpr.FieldAccess(target, _) => {
            let t = c.typeOf(target);
            return if (c.types.is(t, TypeKind.Reference)) c.types.info(t).mutableReference else canMutateThrough(
                c,
                target,
            );
        }
        HirExpr.LocalRef(local) => { return c.hir.locals[local as usize].mutable; }
        _ => { return true; }
    }
}

/// Two bounds of the same interface with the same arguments (SameDyn for interface dyns).
fn sameBound(c: borrow Checker, a: u32, b: u32) -> bool {
    let x = c.types.bounds[a as usize];
    let y = c.types.bounds[b as usize];
    return x.interfaceEntry == y.interfaceEntry && sameLists(c, x.arguments, y.arguments);
}

/// A pool's box (`PoolBox<T>`): a box whose allocator is a pool.
fn isPoolBox(c: borrow Checker, box: u32) -> bool => regionIndex(c.types.info(c.types.info(box).allocator).region) == 4;
