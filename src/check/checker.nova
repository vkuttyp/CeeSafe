// The type checker (the reference's Semantics/TypeChecker.cs), ported slice by slice (docs/p3-plan.md). It turns the
// AST into the HIR and reports the checker's diagnostics in the reference's order.
//
// S1a (this file): the built-in items, the library's item names, functions without type parameters, function bodies
// (blocks, locals, assignment, if, while, loop, break, continue, return, expression statements), literals, names,
// unary and binary operators, calls of functions, Console and Process, CheckMain and FlowAnalysis. Everything else
// is reported as N0216 "not ported yet (P3 …)" so that a gap is never a silent difference from the reference.
// Library bodies are not checked until S5: library HIR is never printed, and function IDs print only for closures.

/// What a name denotes (the reference's `object` items and builtins).
enum Entity {
    None,
    Local(u32),           // HirProgram.locals
    Function(u32),        // HirProgram.functions
    Constant(u32),        // Checker.constants
    LibraryItem(u32),     // a library item not yet ported (S5): its AST item
    Struct(u32),          // Checker.structs
    Enum(u32),            // Checker.enums
    Builtin(u32),         // Console, Process, ... (the reference's Builtin enum, by declaration index)
    GenericFunction(u32), // Checker.genericFunctions
    Interface(u32),       // Checker.interfaces
    Static(u32),          // Checker.statics
}

/// The reference's Builtin enum members S1 uses, by declaration index.
fn builtinConsole() -> u32 => 0;
fn builtinProcess() -> u32 => 1;
fn builtinThread() -> u32 => 25;
fn builtinPtr() -> u32 => 19;
fn builtinSlice() -> u32 => 20;
fn builtinSliceMut() -> u32 => 21;

// BuiltinFunction members are in src/hir/builtins.nova (generated); only ConsoleWrite (0) and ConsoleWriteLine (1)
// print by name (HirPrinter.BuiltinName).

struct ScopeEntry {
    symbol: u32;
    local: u32;
}

/// The `let` keyword of a `let` local, for the fix that makes it a `var` (the reference's _letKeywords).
struct LetKeyword {
    local: u32;
    start: u32;
}

struct ConstEntry {
    item: u32; // Ast.items
    file: u32;
    hir: u32;   // HirProgram.constants
    state: u32; // 0 not evaluated, 1 evaluating, 2 done
}

struct Checker {
    front: Frontend;
    types: TypeTable;
    hir: HirProgram;
    fileIsLibrary: Vector<bool>;
    fileTexts: Vector<Vector<u8>>; // each file's bytes, for fixes that quote source text
    filePaths: Vector<Vector<u8>>; // each file's path, as messages name it
    noFloat: bool;                 // --no-float (type-system.md §35.9)
    rootItems: Map<Word, Entity>;
    coreItems: Map<Word, Entity>;
    builtins: Map<Word, u32>;
    builtinNames: Vector<u32>; // the symbols of AllocError, IoError, SystemHeap, FailingAllocator
    structs: Vector<StructEntry>;
    enums: Vector<EnumEntry>;
    membersResolved: bool;
    allocErrorType: u32;
    ioErrorType: u32;
    systemHeapType: u32;
    constants: Vector<ConstEntry>;
    reserved: Vector<u32>; // symbols of the reserved names (s_reservedNames)
    thisSymbol: u32;
    // The body being checked.
    file: u32;
    function: u32;
    scopes: Vector<ScopeEntry>;
    scopeStarts: Vector<usize>;
    loopDepth: u32;
    deferDepth: u32;
    copyKnown: bool;
    regions: Vector<u32>; // the region names in scope (the reference's _regions)
    frameMemory: u32;     // a scratch frame's region parts, as fields
    frameAllocation: u32;
    flowNames: Vector<Vector<u64>>;   // ResolveFlows' per-parameter names, while it runs
    typeEnvironment: Vector<EnvPair>; // the type parameters in scope (the reference's _typeEnvironment)
    envPairs: Vector<EnvPair>;        // stored environments, by range
    genericFunctions: Vector<GenericFunctionEntry>;
    scopedInstanceReports: Vector<SpanIn>;
    instantiating: u32;
    recursionState: Vector<u8>; // by type id: 0 new, 1 on the stack, 2 done (kept across runs)
    copyDone: Vector<bool>;     // by type id (kept across runs)
    interfaces: Vector<InterfaceEntry>;
    impls: Vector<ImplRef>; // every impl, processed once every item is declared (§21.1)
    implsReady: bool;
    registerNext: bool; // false while declaring a signature only
    dynAllowed: bool;   // set by resolvePointee for the next type resolved (the reference's _dynAllowed)
    dynTables: Vector<DynTable>;
    closureContexts: Vector<ClosureContext>; // the closures being checked, outermost first
    environments: Vector<EnvironmentRecord>;
    implementations: Vector<Implementation>;
    implMethods: Vector<ImplMethod>;
    boundMethods: Vector<BoundMethod>;
    pendingBounds: Vector<PendingBounds>;
    pendingAllocators: Vector<PendingAllocator>;
    pendingElements: Vector<PendingElement>;
    letKeywords: Vector<LetKeyword>;
    effectAttributes: Vector<EffectAttributes>;      // `@effects`/`@context` by declaration (_effectAttributes)
    effectsOfAttributes: Vector<EffectsOfAttribute>; // `@effectsOf` by declaration
    constantFunctions: Vector<u32>;                  // Ast.functions declared `@constant`
    callbacks: Vector<u32>;                          // Ast.functions declared `@callback`
    placedMethods: Vector<u32>;                      // Ast.functions declared `@placed`
    moveBodies: Vector<MoveBody>;                    // move literals' environments and bodies (§36.5)
    unsafeDepth: u32;                                // > 0 in an unsafe context (§27.4)
    usedUnsafe: bool;                                // the body has an `unsafe` block or expression
    allowCChar: bool;                                // the next resolution is a pointer's pointee (§28.3)
    inStaticInitializer: bool;                       // checking a static's initialiser (S7c)
    atomicStructs: Vector<u32>;                      // Ast.items of structs declared `@context(atomic)`
    allowImported: bool;                             // the next resolution may be an imported C type (§31.2)
    coreAllowImported: bool;                         // resolveTypeWith's allowImported, for resolveTypeCore
    layoutUses: Vector<LayoutUse>;                   // struct types used by value before members are known
    headers: Vector<Vector<u8>>;                     // `@header`s of extern blocks, each once, in order (§31.3)
    statics: Vector<StaticEntry>;
    staticLocals: Vector<StaticLocal>; // each function's static-address locals (§39.2)
    freestanding: bool;                // --profile freestanding (cosmoos/profiles.md §4)
    profileReports: Vector<LayoutUse>;
    reportedQualified: Vector<LayoutUse>; // where a qualified name was reported unknown (N0310, N0311): file and start // the places N0293 was reported, once each

    fn letKeywordOf(borrow this, local: u32) -> u32 {
        for (k in this.letKeywords.view()) {
            if (k.local == local) {
                return k.start;
            }
        }
        return none();
    }

    // ---- Diagnostics ----

    fn error(borrow mut this, code: u32, start: u32, end: u32, message: Vector<u8>) -> Result<void, AllocError> {
        // A qualified name already reported as unknown (N0310, N0311) is not reported again as not found.
        if ((code == 200 || code == 204 || code == 234) && reportedQualified(this, start)) {
            return Ok();
        }
        return this.front.diagnostics.error(code, this.file, start, end, message);
    }

    fn errorWithFix(
        borrow mut this,
        code: u32,
        start: u32,
        end: u32,
        message: Vector<u8>,
        title: Vector<u8>,
        fixStart: u32,
        fixEnd: u32,
        text: Vector<u8>,
    ) -> Result<void, AllocError> {
        this.front.diagnostics.errorWithEdit(code, this.file, start, end, message, title, fixStart, fixEnd, text)?;
        return Ok();
    }

    /// An S1a gap: N0216 with a message naming the slice that ports it.
    fn notPorted(
        borrow mut this,
        start: u32,
        end: u32,
        what: StringView,
        slice: StringView,
    ) -> Result<void, AllocError> {
        var message = Vector<u8>.create();
        appendText(mut message, "ceesafec: ")?;
        appendText(mut message, what)?;
        appendText(mut message, " is not ported yet (docs/p3-plan.md ")?;
        appendText(mut message, slice)?;
        appendText(mut message, ")")?;
        return this.error(unsupported(), start, end, message);
    }

    fn name(borrow this, symbol: u32) -> Slice<u8> => this.front.symbols.name(Symbol { id: symbol });

    fn typeName(borrow this, typ: u32) -> Slice<u8> => this.types.name(typ);

    fn intern(borrow mut this, text: StringView) -> Result<u32, AllocError> {
        let s = this.front.symbols.intern(text.bytes())?;
        return Ok(s.id);
    }

    // ---- Expressions in the HIR ----

    fn expr(borrow mut this, node: HirExpr, typ: u32, start: u32, end: u32) -> Result<u32, AllocError> =>
        this.hir.addExpr(node, typ, start, end);

    fn errorResult(borrow mut this, start: u32, end: u32) -> Result<u32, AllocError> {
        let error = this.types.error;
        return this.hir.addExpr(HirExpr.Error, error, start, end);
    }

    fn typeOf(borrow this, e: u32) -> u32 => this.hir.exprTypes[e as usize];

    fn spanOf(borrow this, e: u32) -> Span => this.hir.exprSpans[e as usize];

    fn isBottom(borrow this, e: u32) -> bool => this.types.isBottom(this.typeOf(e));

    // ---- Names ----

    /// A local in scope, without recording a capture (FindLocal).
    fn findLocal(borrow this, symbol: u32) -> u32 {
        var i = this.scopes.length;
        while (i > 0) {
            i -= 1;
            if (this.scopes[i].symbol == symbol) {
                return this.scopes[i].local;
            }
        }
        return none();
    }

    /// A local in scope (LookupLocal): one outside a closure being checked is captured by it (§36.2).
    fn lookupLocal(borrow mut this, symbol: u32) -> Result<u32, AllocError> {
        var i = this.scopes.length;
        while (i > 0) {
            i -= 1;
            if (this.scopes[i].symbol == symbol) {
                let local = this.scopes[i].local;
                recordCaptures(this, i, local)?;
                return Ok(local);
            }
        }
        return Ok(none());
    }

    fn item(borrow this, symbol: u32) -> Entity {
        let key = Word { value: symbol as u64 };
        let library = this.fileIsLibrary[this.file as usize];
        if (!library) {
            match (this.rootItems.get(key)) {
                Some(e) => { return e; }
                null => {}
            }
        }
        match (this.coreItems.get(key)) {
            Some(e) => { return e; }
            null => { return Entity.None; }
        }
    }

    /// Locals (innermost first), then package items, then built-ins (Lookup).
    fn lookup(borrow mut this, symbol: u32) -> Result<Entity, AllocError> {
        let local = this.lookupLocal(symbol)?;
        if (local != none()) {
            return Ok(Entity.Local(local));
        }
        let found = this.item(symbol);
        match (found) {
            Entity.None => {}
            _ => { return Ok(found); }
        }
        match (this.builtins.get(Word { value: symbol as u64 })) {
            Some(b) => { return Ok(Entity.Builtin(b)); }
            null => { return Ok(Entity.None); }
        }
    }

    fn pushScope(borrow mut this) -> Result<void, AllocError> {
        this.scopeStarts.push(this.scopes.length)?;
        return Ok();
    }

    fn popScope(borrow mut this) {
        let start = this.scopeStarts[this.scopeStarts.length - 1];
        this.scopeStarts.truncate(this.scopeStarts.length - 1);
        this.scopes.truncate(start);
    }

    fn bind(borrow mut this, symbol: u32, local: u32) -> Result<void, AllocError> {
        this.scopes.push(ScopeEntry { symbol: symbol, local: local })?;
        return Ok();
    }

    // ---- Types ----

    /// N0297: floats are disabled (FloatsDisabled).
    fn floatsDisabled(borrow mut this, start: u32, end: u32, what: borrow Vector<u8>) -> Result<void, AllocError> {
        var message = Vector<u8>.create();
        appendBytes(mut message, what.view())?;
        appendText(mut message, ": floats are disabled in this build (--no-float, type-system.md §35.9)")?;
        return this.error(floatsDisabled(), start, end, message);
    }

    /// ResolveType: the core, then the checks every resolution makes (here, --no-float).
    fn resolveType(borrow mut this, typ: u32, allowVoid: bool) -> Result<u32, AllocError> =>
        this.resolveTypeWith(typ, allowVoid, false);

    /// ResolveType with `allowSources`: a source list `borrow(a, b) T` is allowed (a function's return type).
    fn resolveTypeWith(borrow mut this, typ: u32, allowVoid: bool, allowSources: bool) -> Result<u32, AllocError> {
        let allowImported = this.allowImported;
        this.allowImported = false;
        this.coreAllowImported = allowImported;
        let resolved = this.resolveTypeCore(typ, allowVoid, allowSources)?;
        let structDef = this.types.info(resolved).structDef;
        if (structDef != none() && this.types.structs[structDef as usize].isImported && !allowImported) {
            let span = this.front.ast.typeSpans[typ as usize];
            var name = Vector<u8>.create();
            appendBytes(mut name, this.types.name(resolved))?;
            var message = Vector<u8>.create();
            appendQuotedType(mut message, this, resolved)?;
            appendText(
                mut message,
                " is a C type imported from a header, whose size only the C compiler knows: use it behind a pointer or a reference ('*",
            )?;
            appendBytes(mut message, name.view())?;
            appendText(mut message, "', 'borrow ")?;
            appendBytes(mut message, name.view())?;
            appendText(mut message, "'; type-system.md §31.2)")?;
            this.error(importedTypeByValue(), span.start, span.end, message)?;
            return Ok(this.types.error);
        }
        if (!allowImported && (this.types.is(resolved, TypeKind.Struct) || this.types.is(resolved, TypeKind.Array))) {
            // Whether a struct holds C state is known once every struct's fields are (§33.1).
            let span = this.front.ast.typeSpans[typ as usize];
            if (this.membersResolved) {
                checkLayoutUse(this, resolved, span)?;
            } else {
                let file = this.file;
                this.layoutUses.push(LayoutUse { typ: resolved, start: span.start, end: span.end, file: file })?;
            }
        }
        if (this.freestanding && isHostedOnlyType(this, resolved)) {
            let span = this.front.ast.typeSpans[typ as usize];
            var what = Vector<u8>.create();
            appendQuotedType(mut what, this, resolved)?;
            hostedOnly(this, span, what.view())?;
            return Ok(this.types.error);
        }
        if (this.noFloat && this.types.is(resolved, TypeKind.Float)) {
            let span = this.front.ast.typeSpans[typ as usize];
            var what = Vector<u8>.create();
            appendText(mut what, "type '")?;
            appendBytes(mut what, this.types.name(resolved))?;
            appendText(mut what, "'")?;
            this.floatsDisabled(span.start, span.end, what)?;
            return Ok(this.types.error);
        }
        return Ok(resolved);
    }

    /// ResolveFunctionType: `fn(A, B) -> R`, with the effect list of an `@effects(…)` before it (§36.3).
    fn resolveFunctionType(
        borrow mut this,
        attributes: Range,
        parameters: Range,
        result: u32,
        span: Span,
    ) -> Result<u32, AllocError> {
        let effects = functionTypeEffects(this, attributes)?;
        var types = Vector<u32>.create();
        var bottom = false;
        for (k in 0..parameters.count) {
            let p = this.front.ast.at(parameters, k);
            let t = this.resolveType(p, false)?;
            if (this.types.isBottom(t)) {
                bottom = true;
            }
            types.push(t)?;
        }
        let resultType = if (result == none()) this.types.voidType else this.resolveType(result, true)?;
        if (bottom || this.types.isBottom(resultType)) {
            return Ok(this.types.error);
        }
        var scopedParameters = 0;
        for (t in types.view()) {
            if (this.types.isScoped(t)) {
                scopedParameters += 1;
            }
        }
        if (this.types.isScoped(resultType) && scopedParameters != 1) {
            let resultSpan = this.front.ast.typeSpans[result as usize];
            var message = Vector<u8>.create();
            appendText(mut message, "a function type returning ")?;
            appendQuotedType(mut message, this, resultType)?;
            appendText(
                mut message,
                " needs exactly one reference or scoped parameter for the result to come from; a function type has no names for a source list (type-system.md §36.1)",
            )?;
            this.error(returnSourceMismatch(), resultSpan.start, resultSpan.end, message)?;
            return Ok(this.types.error);
        }
        return this.types.functionTo(types.view(), resultType, effects);
    }

    /// ResolveTypeCore for what S1 supports: built-in named types and function types. Other forms are N0216
    /// "not ported yet".
    fn resolveTypeCore(borrow mut this, typ: u32, allowVoid: bool, allowSources: bool) -> Result<u32, AllocError> {
        let span = this.front.ast.typeSpans[typ as usize];
        let dynAllowed = this.dynAllowed;
        this.dynAllowed = false;
        let allowCChar = this.allowCChar;
        this.allowCChar = false;
        let allowImported = this.coreAllowImported;
        this.coreAllowImported = false;
        match (this.front.ast.types[typ as usize]) {
            TypeNode.Named(q) => {
                if (q.parts.count > 1) {
                    var message = Vector<u8>.create();
                    appendText(mut message, "qualified type names are not supported yet")?;
                    this.error(unsupported(), span.start, span.end, message)?;
                    return Ok(this.types.error);
                }
                let ident = this.front.ast.idents[this.front.ast.at(q.parts, 0) as usize];
                let parameter = environmentType(this, ident.symbol);
                if (parameter != none()) {
                    return Ok(parameter); // a type parameter in scope, or what it is instantiated with (§20)
                }
                var text = Vector<u8>.create();
                appendBytes(mut text, this.name(ident.symbol))?;
                let undeclared = match (this.item(ident.symbol)) {
                    Entity.None => true,
                    _ => false,
                };
                if (isBareContainerName(text.view()) && undeclared) {
                    return resolveBareContainer(this, text.view(), span);
                }
                let genericItem = match (this.item(ident.symbol)) {
                    Entity.Struct(s) => isGenericItem(this, this.structs[s as usize].item),
                    Entity.Enum(e) => isGenericItem(this, this.enums[e as usize].item),
                    _ => false,
                };
                if (genericItem) {
                    var message = Vector<u8>.create();
                    appendText(mut message, "'")?;
                    appendBytes(mut message, text.view())?;
                    appendText(mut message, "' is generic: give its type arguments, e.g. '")?;
                    appendBytes(mut message, text.view())?;
                    appendText(mut message, "<i32>'")?;
                    this.error(unknownType(), span.start, span.end, message)?;
                    return Ok(this.types.error);
                }
                var found = this.types.lookup(text.view());
                if (found == none()) {
                    match (this.item(ident.symbol)) {
                        Entity.Struct(s) => { found = this.structs[s as usize].typ; }
                        Entity.Enum(e) => { found = this.enums[e as usize].typ; }
                        _ => {}
                    }
                }
                if (found == none()) {
                    match (this.item(ident.symbol)) {
                        Entity.None => {
                            var message = Vector<u8>.create();
                            appendText(mut message, "unknown type '")?;
                            appendBytes(mut message, text.view())?;
                            appendText(mut message, "'")?;
                            this.error(unknownType(), span.start, span.end, message)?;
                            return Ok(this.types.error);
                        }
                        _ => {
                            this.notPorted(span.start, span.end, "a struct, enum or library type", "S2/S5")?;
                            return Ok(this.types.error);
                        }
                    }
                }
                if (this.types.is(found, TypeKind.Void) && !allowVoid) {
                    var message = Vector<u8>.create();
                    appendText(mut message, "'void' can only be used as a function return type")?;
                    this.error(voidNotAllowed(), span.start, span.end, message)?;
                    return Ok(this.types.error);
                }
                if (this.types.is(found, TypeKind.CChar) && !allowCChar) {
                    var message = Vector<u8>.create();
                    appendText(
                        mut message,
                        "'CChar' is C's 'char' and can only be pointed to: use '*CChar' (type-system.md §28.3)",
                    )?;
                    this.error(invalidPointee(), span.start, span.end, message)?;
                    return Ok(this.types.error);
                }
                return Ok(found);
            }
            TypeNode.Missing => { return Ok(this.types.error); }
            TypeNode.Function(attributes, parameters, result) => {
                return this.resolveFunctionType(attributes, parameters, result, span);
            }
            TypeNode.Dyn(interfaceType, mutable, send) => {
                return resolveDynType(this, interfaceType, mutable, send, span, dynAllowed);
            }
            TypeNode.Optional(inner) => { return resolveOptionalType(this, inner, allowSources); }
            TypeNode.Array(element, length) => { return resolveArrayType(this, element, length, allowImported); }
            TypeNode.FunctionPointer(abi, parameters, result) => {
                return resolveFunctionPointerType(this, abi, parameters, result, span);
            }
            TypeNode.Reference(mutable, hasSources, sources, pointee) => {
                return resolveReferenceType(this, mutable, hasSources, sources, pointee, allowSources, span);
            }
            TypeNode.Generic(name, arguments) => { return resolveGenericType(this, name, arguments, span); }
            TypeNode.Pointer(mutable, pointeeSyntax) => {
                this.allowCChar = true;
                this.allowImported = true;
                let pointee = this.resolveType(pointeeSyntax, true)?;
                this.allowCChar = false;
                if (this.types.isBottom(pointee)) {
                    return Ok(this.types.error);
                }
                if (this.types.isScoped(pointee) || this.types.isUnsized(pointee)) {
                    let pointeeSpan = this.front.ast.typeSpans[pointeeSyntax as usize];
                    var message = Vector<u8>.create();
                    appendText(mut message, "a raw pointer cannot point to ")?;
                    appendQuotedType(mut message, this, pointee)?;
                    appendText(
                        mut message,
                        ", which holds loans; point to the referenced type instead (type-system.md §27.1)",
                    )?;
                    this.error(invalidPointee(), pointeeSpan.start, pointeeSpan.end, message)?;
                    return Ok(this.types.error);
                }
                return this.types.pointerTo(pointee, mutable);
            }
            _ => {
                this.notPorted(span.start, span.end, "this kind of type", "S2-S7")?;
                return Ok(this.types.error);
            }
        }
    }
}

fn unknownType() -> u32 => 204;
fn typeMismatch() -> u32 => 205;
fn literalOutOfRange() -> u32 => 206;
fn invalidOperandTypes() -> u32 => 207;
fn argumentCount() -> u32 => 209;
fn notCallable() -> u32 => 210;
fn assignToImmutable() -> u32 => 211;
fn missingReturn() -> u32 => 213;
fn loopControlOutsideLoop() -> u32 => 214;
fn returnValueMismatch() -> u32 => 215;
fn invalidMain() -> u32 => 219;
fn letWithoutInitializer() -> u32 => 220;
fn localNeedsType() -> u32 => 221;
fn voidValue() -> u32 => 224;
fn statementNotCall() -> u32 => 225;
fn voidNotAllowed() -> u32 => 226;
fn thisOutsideMethod() -> u32 => 232;
fn undefinedName() -> u32 => 200;
fn duplicateItem() -> u32 => 201;
fn duplicateParameter() -> u32 => 202;
fn localRedeclared() -> u32 => 203;
fn referenceNotAllowed() -> u32 => 246;
fn invalidPointee() -> u32 => 281;
fn floatsDisabled() -> u32 => 297;
fn notAFunctionValue() -> u32 => 298;
