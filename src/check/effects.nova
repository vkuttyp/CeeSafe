// Effect lists and function attributes (the reference's KnownAttributes, EffectList, ReadEffectAttributes,
// InheritEffects, ProcessFunctionAttributes and EffectsOfParameters): P3 S6b (type-system.md §32, §36.3). The
// attributes for C interop (`@export`, `@callback`, `@constant`, `@placed`) are validated and recorded here; S7 uses
// them. The effect checker itself (N0295 on bodies) runs after the type checker, in P4.

fn effectViolation() -> u32 => 295;
fn effectsOfParameter() -> u32 => 336;

fn noContext() -> u32 => 0;
fn atomicContext() -> u32 => 1;
fn irqContext() -> u32 => 2;

/// `@effects` and `@context` of one function declaration (the reference's _effectAttributes entry).
struct EffectAttributes {
    syntax: u32;   // Ast.functions
    declared: u32; // effect bits, or none when not declared
    context: u32;  // noContext, atomicContext or irqContext
}

/// `@effectsOf(…)` of one function declaration, resolved per HIR function at the end (_effectsOfAttributes).
struct EffectsOfAttribute {
    syntax: u32;
    attribute: u32; // Ast.attributes
}

fn attributeName(c: borrow Checker, attribute: u32) -> Slice<u8> =>
    c.name(c.front.ast.idents[c.front.ast.attributes[attribute as usize].name as usize].symbol);

fn attributeError(c: borrow mut Checker, attribute: u32, message: StringView) -> Result<void, AllocError> {
    let a = c.front.ast.attributes[attribute as usize];
    var text = Vector<u8>.create();
    appendText(mut text, message)?;
    appendText(mut text, " (type-system.md §28.1)")?;
    return c.error(invalidAttribute(), a.start, a.end, text);
}

/// Whether `name` is one of the space-separated words of `words`.
fn hasWord(words: StringView, name: Slice<u8>) -> bool {
    let bytes = words.bytes();
    var start: usize = 0;
    for (k in 0..(bytes.length + 1)) {
        if (k == bytes.length || bytes[k] == ' ') {
            if (sameBytes(bytes[start..k], name)) {
                return true;
            }
            start = k + 1;
        }
    }
    return false;
}

fn isAttributeWord(name: Slice<u8>) -> bool =>
    sameText(name, "export") || sameText(name, "repr") || sameText(name, "effects") || sameText(name, "effectsOf") ||
        sameText(
            name,
            "constant",
        ) || sameText(name, "context") || sameText(name, "header") || sameText(name, "ctype") ||
        sameText(name, "align") || sameText(name, "noncopy") || sameText(name, "placed") || sameText(name, "callback");

/// Reports repeated attributes and unknown ones (N0290), and returns those named in `known` (KnownAttributes).
fn knownAttributes(
    c: borrow mut Checker,
    attributes: Range,
    place: StringView,
    known: StringView, // the attribute names allowed, separated by spaces
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    var seen = Vector<Vector<u8>>.create();
    for (k in 0..attributes.count) {
        let attribute = c.front.ast.at(attributes, k);
        var name = Vector<u8>.create();
        appendBytes(mut name, attributeName(c, attribute))?;
        var repeated = false;
        for (s in 0..seen.length) {
            if (sameBytes(seen[s].view(), name.view())) {
                repeated = true;
            }
        }
        let isKnown = hasWord(known, name.view());
        if (repeated) {
            var message = Vector<u8>.create();
            appendText(mut message, "'@")?;
            appendBytes(mut message, name.view())?;
            appendText(mut message, "' is given twice (type-system.md §28.1)")?;
            let a = c.front.ast.attributes[attribute as usize];
            c.error(invalidAttribute(), a.start, a.end, message)?;
        } else {
            seen.push(copyBytes(name.view())?)?;
            if (!isKnown) {
                var message = Vector<u8>.create();
                if (isAttributeWord(name.view())) {
                    appendText(mut message, "'@")?;
                    appendBytes(mut message, name.view())?;
                    appendText(mut message, "' cannot be used on ")?;
                    appendText(mut message, place)?;
                } else {
                    appendText(mut message, "unknown attribute '@")?;
                    appendBytes(mut message, name.view())?;
                    appendText(mut message, "'")?;
                }
                appendText(mut message, " (type-system.md §28.1)")?;
                let a = c.front.ast.attributes[attribute as usize];
                c.error(invalidAttribute(), a.start, a.end, message)?;
            } else {
                out.push(attribute)?;
            }
        }
    }
    return Ok();
}

/// The effects an `@effects(…)` attribute lists (EffectList): `sleep` and `alloc`, or none.
fn effectList(c: borrow mut Checker, attribute: u32) -> Result<u32, AllocError> {
    let a = c.front.ast.attributes[attribute as usize];
    var effects: u32 = 0;
    var valid = a.hasParentheses;
    for (k in 0..a.arguments.count) {
        let argument = c.front.ast.at(a.arguments, k);
        var effect: u32 = 0;
        match (c.front.ast.exprs[argument as usize]) {
            ExprNode.Name(name, _) => {
                let text = c.name(c.front.ast.idents[name as usize].symbol);
                if (sameText(text, "sleep")) {
                    effect = sleepEffect();
                } else if (sameText(text, "alloc")) {
                    effect = allocEffect();
                }
            }
            _ => {}
        }
        if (effect == 0) {
            valid = false;
        }
        effects = effects | effect;
    }
    if (!valid) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "'@effects' takes the effects as names, 'sleep' and 'alloc', or none: '@effects(sleep)', '@effects()' (type-system.md §32.2)",
        )?;
        c.error(invalidAttribute(), a.start, a.end, message)?;
    }
    return Ok(effects);
}

/// A callable type's effect list as a declared bound (BoundOf): none for the default, every effect.
fn boundOf(c: borrow Checker, callable: u32) -> u32 {
    let effects = c.types.info(callable).effects;
    return if (effects == allEffects()) none() else effects;
}

/// The effect list of a function type's attributes (ResolveFunctionType's loop), or allEffects without one.
fn functionTypeEffects(c: borrow mut Checker, attributes: Range) -> Result<u32, AllocError> {
    var known = Vector<u32>.create();
    let words = "effects";
    knownAttributes(c, attributes, "a function type", words, mut known)?;
    var effects = allEffects();
    for (attribute in known.view()) {
        effects = effectList(c, attribute)?;
    }
    return Ok(effects);
}

/// `@effects`, `@context`, `@constant` and `@effectsOf` of a function declaration (ReadEffectAttributes).
fn readEffectAttributes(c: borrow mut Checker, f: u32, attributes: Slice<u32>) -> Result<void, AllocError> {
    var declared = none();
    var context = noContext();
    for (attribute in attributes) {
        let a = c.front.ast.attributes[attribute as usize];
        let name = attributeName(c, attribute);
        if (sameText(name, "effects")) {
            declared = effectList(c, attribute)?;
        } else if (sameText(name, "constant")) {
            if (a.hasParentheses) {
                var message = Vector<u8>.create();
                appendText(mut message, "'@constant' takes no arguments (type-system.md §39.4)")?;
                c.error(invalidAttribute(), a.start, a.end, message)?;
            }
            if (!containsU32(c.constantFunctions, f)) {
                c.constantFunctions.push(f)?;
            }
        } else if (sameText(name, "effectsOf")) {
            // Names, resolved against each function's parameters once its types are known (§32.5).
            var allNames = a.arguments.count > 0;
            for (k in 0..a.arguments.count) {
                let isName = match (c.front.ast.exprs[c.front.ast.at(a.arguments, k) as usize]) {
                    ExprNode.Name(_, _) => true,
                    _ => false,
                };
                if (!isName) {
                    allNames = false;
                }
            }
            if (!a.hasParentheses || !allNames) {
                var message = Vector<u8>.create();
                appendText(
                    mut message,
                    "'@effectsOf' takes the names of the function's closure parameters: '@effectsOf(cmp)' (type-system.md §32.5)",
                )?;
                c.error(effectsOfParameter(), a.start, a.end, message)?;
            } else {
                setEffectsOf(c, f, attribute)?;
            }
        } else if (sameText(name, "context")) {
            context = noContext();
            if (a.arguments.count == 1) {
                match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
                    ExprNode.Name(n, _) => {
                        let text = c.name(c.front.ast.idents[n as usize].symbol);
                        if (sameText(text, "atomic")) {
                            context = atomicContext();
                        } else if (sameText(text, "irq")) {
                            context = irqContext();
                        }
                    }
                    _ => {}
                }
            }
            if (context == noContext()) {
                var message = Vector<u8>.create();
                appendText(
                    mut message,
                    "'@context' takes 'atomic' or 'irq': '@context(atomic)' (type-system.md §32.3)",
                )?;
                c.error(invalidAttribute(), a.start, a.end, message)?;
            }
        }
    }
    if (declared != none() || context != noContext()) {
        setEffectAttributes(c, f, declared, context)?;
    }
    return Ok();
}

fn setEffectsOf(c: borrow mut Checker, f: u32, attribute: u32) -> Result<void, AllocError> {
    for (k in 0..c.effectsOfAttributes.length) {
        if (c.effectsOfAttributes[k].syntax == f) {
            c.effectsOfAttributes[k].attribute = attribute;
            return Ok();
        }
    }
    return c.effectsOfAttributes.push(EffectsOfAttribute { syntax: f, attribute: attribute });
}

fn setEffectAttributes(c: borrow mut Checker, f: u32, declared: u32, context: u32) -> Result<void, AllocError> {
    for (k in 0..c.effectAttributes.length) {
        if (c.effectAttributes[k].syntax == f) {
            c.effectAttributes[k].declared = declared;
            c.effectAttributes[k].context = context;
            return Ok();
        }
    }
    return c.effectAttributes.push(EffectAttributes { syntax: f, declared: declared, context: context });
}

fn effectAttributesOf(c: borrow Checker, f: u32) -> u32 {
    for (k in 0..c.effectAttributes.length) {
        if (c.effectAttributes[k].syntax == f) {
            return truncate<u32>(k);
        }
    }
    return none();
}

/// An interface method's effect list bounds every impl of it (InheritEffects, §37.3): an impl method without its own
/// list takes the interface's, and one with a wider list is N0295.
fn inheritEffects(c: borrow mut Checker, signature: u32, function: u32) -> Result<void, AllocError> {
    let bound = effectAttributesOf(c, signature);
    if (bound == none() || c.effectAttributes[bound as usize].declared == none()) {
        return Ok();
    }
    let allowed = c.effectAttributes[bound as usize].declared;
    let mine = effectAttributesOf(c, function);
    let ownDeclared = if (mine == none()) none() else c.effectAttributes[mine as usize].declared;
    let ownContext = if (mine == none()) noContext() else c.effectAttributes[mine as usize].context;
    if (ownDeclared != none() && (ownDeclared & (0xFFFFFFFF ^ allowed)) != 0) {
        let decl = c.front.ast.functions[function as usize];
        let id = c.front.ast.idents[decl.name as usize];
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, id.symbol)?;
        appendText(
            mut message,
            " declares effects its interface method does not allow: the interface's list is '@effects(",
        )?;
        appendEffectNames(mut message, allowed)?;
        appendText(mut message, ")' (type-system.md §37.3)")?;
        return c.error(effectViolation(), id.start, id.end, message);
    }
    return setEffectAttributes(c, function, if (ownDeclared != none()) ownDeclared else allowed, ownContext);
}

fn appendEffectNames(out: borrow mut Vector<u8>, effects: u32) -> Result<void, AllocError> {
    var first = true;
    if ((effects & sleepEffect()) != 0) {
        appendText(out, "sleep")?;
        first = false;
    }
    if ((effects & allocEffect()) != 0) {
        if (!first) {
            appendText(out, ", ")?;
        }
        appendText(out, "alloc")?;
    }
    return Ok();
}

/// The attributes of every function, constant and method (ProcessFunctionAttributes), unit by unit.
fn processFunctionAttributes(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    for (u in 0..c.front.ast.units.length) {
        {
            let fileToSet = c.front.ast.units[u].file;
            c.setFile(fileToSet);
        }
        let items = c.front.ast.units[u].items;
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Function(f) => { processFunctionAttributesOf(c, f)?; }
                _ => {}
            }
        }
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Const(_, _) => { processConstantAttributes(c, item)?; }
                _ => {}
            }
        }
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Struct(s) => { processMethodAttributes(c, s)?; }
                _ => {}
            }
        }
    }
    c.setFile(saved);
    return Ok();
}

fn processFunctionAttributesOf(c: borrow mut Checker, f: u32) -> Result<void, AllocError> {
    let words = "export effects effectsOf context callback constant";
    var known = Vector<u32>.create();
    let attributes = c.front.ast.functions[f as usize].attributes;
    knownAttributes(c, attributes, "a function", words, mut known)?;
    readEffectAttributes(c, f, known.view())?;
    var hasExport = false;
    for (attribute in known.view()) {
        if (sameText(attributeName(c, attribute), "export")) {
            hasExport = true;
        }
    }
    for (attribute in known.view()) {
        if (!sameText(attributeName(c, attribute), "callback")) {
            continue;
        }
        let a = c.front.ast.attributes[attribute as usize];
        if (a.hasParentheses) {
            var message = Vector<u8>.create();
            appendText(mut message, "'@callback' takes no arguments (type-system.md §34.1)")?;
            c.error(invalidAttribute(), a.start, a.end, message)?;
        } else if (hasExport) {
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "an exported function has a C address already: leave out '@callback' (type-system.md §34.1)",
            )?;
            c.error(invalidAttribute(), a.start, a.end, message)?;
        } else if (!containsU32(c.callbacks, f)) {
            c.callbacks.push(f)?;
        }
    }
    let name = c.front.ast.idents[c.front.ast.functions[f as usize].name as usize].symbol;
    for (attribute in known.view()) {
        if (!sameText(attributeName(c, attribute), "export")) {
            continue;
        }
        let symbol = exportSymbol(c, attribute, name)?;
        var kind: u32 = 0;
        var exported = none();
        match (ownEntity(c, name)) {
            Entity.GenericFunction(_) => { kind = 1; }
            Entity.Function(function) => {
                if (c.hir.functions[function as usize].syntax == f) {
                    kind = 2;
                    exported = function;
                }
            }
            _ => {}
        }
        if (symbol.count == 0xFFFFFFFF) {
            attributeError(c, attribute, "'@export' takes nothing or the C symbol as a string: '@export(\"name\")'")?;
        } else if (sameText(c.name(name), "main")) {
            attributeError(c, attribute, "'main' cannot be exported; the generated C 'main' calls it")?;
        } else if (kind == 1) {
            attributeError(c, attribute, "a generic function cannot be exported")?;
        } else if (kind == 2) {
            c.hir.functions[exported as usize].exported = true;
            c.hir.functions[exported as usize].exportName = symbol;
        }
    }
    return Ok();
}

/// The current package's own item `symbol` (the reference's Own): lib/core's in a library file, else the program's.
fn ownEntity(c: borrow Checker, symbol: u32) -> Entity {
    let key = Word { value: symbol as u64 };
    return if (isLibraryFile(c)) foundEntity(c.coreItems, key) else foundEntity(
        c.packageItems,
        packageKey(currentPackage(c), symbol),
    );
}

/// The C symbol `@export` gives: the item's name, or the string argument; count 0xFFFFFFFF when invalid.
fn exportSymbol(c: borrow mut Checker, attribute: u32, name: u32) -> Result<Range, AllocError> {
    let a = c.front.ast.attributes[attribute as usize];
    if (a.arguments.count == 0) {
        var text = Vector<u8>.create();
        appendBytes(mut text, c.name(name))?;
        return c.hir.addText(text.view());
    }
    if (a.arguments.count == 1) {
        match (c.front.ast.exprs[c.front.ast.at(a.arguments, 0) as usize]) {
            ExprNode.StringLiteral(text) => {
                var bytes = Vector<u8>.create();
                appendBytes(mut bytes, c.front.ast.textOf(text))?;
                return c.hir.addText(bytes.view());
            }
            _ => {}
        }
    }
    return Ok(Range { start: 0, count: 0xFFFFFFFF });
}

fn processConstantAttributes(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let words = "export";
    var known = Vector<u32>.create();
    let attributes = c.front.ast.items[item as usize].attributes;
    knownAttributes(c, attributes, "a constant", words, mut known)?;
    let name = c.front.ast.idents[c.front.ast.items[item as usize].name as usize].symbol;
    for (attribute in known.view()) {
        let symbol = exportSymbol(c, attribute, name)?;
        if (symbol.count == 0xFFFFFFFF) {
            attributeError(c, attribute, "'@export' takes nothing or the C symbol as a string: '@export(\"name\")'")?;
            continue;
        }
        match (ownEntity(c, name)) {
            Entity.Constant(k) => {
                if (c.constants[k as usize].item == item) {
                    let hir = c.constants[k as usize].hir;
                    c.hir.constants[hir as usize].exported = true;
                    c.hir.constants[hir as usize].exportName = symbol;
                }
            }
            _ => {}
        }
    }
    return Ok();
}

fn processMethodAttributes(c: borrow mut Checker, s: u32) -> Result<void, AllocError> {
    let functions = c.front.ast.structs[s as usize].functions;
    var placedCount: u32 = 0;
    for (k in 0..functions.count) {
        let member = c.front.ast.at(functions, k);
        let words = "effects effectsOf context placed constant";
        var known = Vector<u32>.create();
        let attributes = c.front.ast.functions[member as usize].attributes;
        knownAttributes(c, attributes, "a method", words, mut known)?;
        readEffectAttributes(c, member, known.view())?;
        for (attribute in known.view()) {
            if (!sameText(attributeName(c, attribute), "placed")) {
                continue;
            }
            let a = c.front.ast.attributes[attribute as usize];
            let decl = c.front.ast.functions[member as usize];
            var problem: u32 = 0;
            if (a.hasParentheses) {
                problem = 1;
            } else if (receiverIndex(decl.receiver) != 3 || decl.parameters.count != 0 || decl.returnType != none() ||
                decl.typeParameters.count != 0) {
                problem = 2;
            } else {
                placedCount += 1;
                if (placedCount > 1) {
                    problem = 3;
                }
            }
            if (problem != 0) {
                var message = Vector<u8>.create();
                appendText(mut message, "'@placed' ")?;
                appendText(
                    mut message,
                    match (problem) {
                        1 => "takes no arguments",
                        2 => "needs the form 'fn name(borrow mut this)', with no other parameters and no result",
                        _ => "is given to a second method; a struct has one placement initialiser",
                    },
                )?;
                appendText(mut message, " (type-system.md §33.3)")?;
                c.error(invalidAttribute(), a.start, a.end, message)?;
            } else {
                c.placedMethods.push(member)?;
            }
        }
    }
    return Ok();
}

/// The parameters an `@effectsOf(…)` names (EffectsOfParameters, §32.5), as indices into the function's parameters;
/// each must be a parameter of function or closure type (N0336, reported for the first function of a declaration).
fn effectsOfParameters(
    c: borrow mut Checker,
    function: u32,
    attribute: u32,
    report: bool,
    out: borrow mut Vector<u32>,
) -> Result<void, AllocError> {
    let a = c.front.ast.attributes[attribute as usize];
    for (k in 0..a.arguments.count) {
        let argument = c.front.ast.at(a.arguments, k);
        let nameIdent = match (c.front.ast.exprs[argument as usize]) {
            ExprNode.Name(n, _) => n,
            _ => none(),
        };
        if (nameIdent == none()) {
            continue;
        }
        let id = c.front.ast.idents[nameIdent as usize];
        var index = none();
        let parameters = c.hir.functions[function as usize].parameters.length;
        for (i in 0..parameters) {
            let p = c.hir.functions[function as usize].parameters[i];
            if (index == none() && sameBytes(c.name(c.hir.locals[p as usize].name), c.name(id.symbol))) {
                index = truncate<u32>(i);
            }
        }
        var callable = false;
        if (index != none()) {
            let t = c.hir.locals[c.hir.functions[function as usize].parameters[index as usize] as usize].typ;
            callable = c.types.is(t, TypeKind.Function) || c.types.isClosure(t);
        }
        if (index == none() || !callable) {
            if (report) {
                var message = Vector<u8>.create();
                appendQuotedName(mut message, c, id.symbol)?;
                if (index == none()) {
                    appendText(mut message, " is not a parameter of ")?;
                    let syntax = c.hir.functions[function as usize].syntax;
                    appendQuotedName(
                        mut message,
                        c,
                        c.front.ast.idents[c.front.ast.functions[syntax as usize].name as usize].symbol,
                    )?;
                    appendText(mut message, " (type-system.md §32.5)")?;
                } else {
                    let t = c.hir.locals[c.hir.functions[function as usize].parameters[index as usize] as usize].typ;
                    appendText(mut message, " is a ")?;
                    appendQuotedType(mut message, c, t)?;
                    appendText(
                        mut message,
                        ", not a function or closure: '@effectsOf' names parameters such as 'cmp: borrow fn(i32) -> bool' (type-system.md §32.5)",
                    )?;
                }
                c.error(effectsOfParameter(), id.start, id.end, message)?;
            }
        } else if (!containsU32(out, index)) {
            out.push(index)?;
        }
    }
    return Ok();
}

/// The end of Check(): each function's callback, effect and constant facts, and `@effectsOf` resolved.
fn finishFunctionFacts(c: borrow mut Checker) -> Result<void, AllocError> {
    var reported = Vector<u32>.create();
    let saved = c.file;
    for (f in 0..c.hir.functions.length) {
        if (!c.hir.functions[f].registered) {
            continue;
        }
        let function = truncate<u32>(f);
        let syntax = c.hir.functions[f].syntax;
        c.hir.functions[f].isCallback = containsU32(c.callbacks, syntax);
        let attributes = effectAttributesOf(c, syntax);
        if (attributes != none()) {
            c.hir.functions[f].declaredEffects = c.effectAttributes[attributes as usize].declared;
            c.hir.functions[f].context = c.effectAttributes[attributes as usize].context;
        }
        c.hir.functions[f].isConstant = containsU32(c.constantFunctions, syntax);
        for (k in 0..c.effectsOfAttributes.length) {
            if (c.effectsOfAttributes[k].syntax == syntax) {
                let attribute = c.effectsOfAttributes[k].attribute;
                {
                    let fileToSet = c.hir.functions[f].file;
                    c.setFile(fileToSet);
                }
                let report = !containsU32(reported, syntax);
                if (report) {
                    reported.push(syntax)?;
                }
                var indices = Vector<u32>.create();
                effectsOfParameters(c, function, attribute, report, mut indices)?;
                c.hir.functions[f].effectsOfParameters = indices;
            }
        }
    }
    c.setFile(saved);
    return Ok();
}
