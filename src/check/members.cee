// Struct members in expressions (the reference's ResolveField, CheckPrivate, SynthStructLiteral, StaticOwner,
// CheckStaticCall, FindMethod and CheckMethodCall): P3 S2a. Methods of built-in types (integers, floats, views,
// vectors, resources, regions) come with S3; impl and bound methods with S4.

fn unknownField() -> u32 => 230;
fn missingField() -> u32 => 229;
fn duplicateFieldInit() -> u32 => 231;
fn methodCallKind() -> u32 => 233;
fn notAStruct() -> u32 => 234;
fn privateField() -> u32 => 296;

/// N0296 if a private field is reached from another file (CheckPrivate; NotPublic across packages comes with S8).
fn checkPrivate(c: borrow mut Checker, definition: u32, field: u32, span: Span) -> Result<void, AllocError> {
    let d = borrow c.types.structs[definition as usize];
    if (c.types.fields[field as usize].isPrivate && d.file != c.file) {
        let item = c.front.ast.items[d.item as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "field ")?;
        appendQuotedName(mut message, c, c.types.fields[field as usize].name)?;
        appendText(mut message, " of ")?;
        appendQuotedName(mut message, c, c.front.ast.idents[item.name as usize].symbol)?;
        appendText(mut message, " is private to ")?;
        appendBytes(mut message, c.filePaths[d.file as usize].view())?;
        appendText(mut message, ": only code there can reach it (type-system.md §12)")?;
        c.error(privateField(), span.start, span.end, message)?;
    } else if (!c.types.fields[field as usize].isPublic && isOtherPackage(c, d.file)) {
        let item = c.front.ast.items[d.item as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "field ")?;
        appendQuotedName(mut message, c, c.types.fields[field as usize].name)?;
        appendText(mut message, " of '")?;
        qualifiedName(c, d.file, c.name(c.front.ast.idents[item.name as usize].symbol), mut message)?;
        appendText(mut message, "' is not public: only its own package can reach it (type-system.md §2)")?;
        c.error(notPublic(), span.start, span.end, message)?;
    }
    return Ok();
}

/// ResolveField: the field `name` of a value of `typ`, or none after N0230/N0234.
fn resolveField(c: borrow mut Checker, typ: u32, name: u32) -> Result<u32, AllocError> {
    if (c.types.isBottom(typ)) {
        return Ok(none());
    }
    let ident = c.front.ast.idents[name as usize];
    let span = Span { start: ident.start, end: ident.end };
    let definition = c.types.info(typ).structDef;
    if (definition == none()) {
        var message = Vector<u8>.create();
        appendText(mut message, "type ")?;
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " has no fields; ")?;
        appendQuotedName(mut message, c, ident.symbol)?;
        appendText(mut message, " cannot be accessed")?;
        c.error(notAStruct(), span.start, span.end, message)?;
        return Ok(none());
    }
    let field = findField(c, definition, ident.symbol);
    if (field != none()) {
        checkPrivate(c, definition, field, span)?;
        return Ok(field);
    }
    var message = Vector<u8>.create();
    if (findStructFunction(c, definition, ident.symbol) != none()) {
        appendText(mut message, "'")?;
        appendBytes(mut message, c.typeName(typ))?;
        appendText(mut message, ".")?;
        appendBytes(mut message, c.name(ident.symbol))?;
        appendText(mut message, "' is a function; call it with '(...)'")?;
    } else {
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " has no field named ")?;
        appendQuotedName(mut message, c, ident.symbol)?;
    }
    c.error(unknownField(), span.start, span.end, message)?;
    return Ok(none());
}

/// SynthStructLiteral for a struct without type parameters.
fn synthStructLiteral(
    c: borrow mut Checker,
    typeName: u32,
    fields: Range,
    typeArguments: Range,
    span: Span,
    expected: u32,
) -> Result<u32, AllocError> {
    let nameIdent = c.front.ast.idents[typeName as usize];
    let nameSpan = Span { start: nameIdent.start, end: nameIdent.end };
    let index = match (c.item(nameIdent.symbol)) {
        Entity.Struct(s) => s,
        _ => none(),
    };
    if (index == none()) {
        var text = Vector<u8>.create();
        appendBytes(mut text, c.name(nameIdent.symbol))?;
        let unknown = c.types.lookup(text.view()) == none() && isNone(c.lookup(nameIdent.symbol)?);
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, nameIdent.symbol)?;
        appendText(mut message, " is not a struct type")?;
        c.error(if (unknown) unknownType() else notAStruct(), nameSpan.start, nameSpan.end, message)?;
        for (k in 0..fields.count) {
            let init = c.front.ast.fieldInits[c.front.ast.at(fields, k) as usize];
            synth(c, init.value, none())?;
        }
        return c.errorResult(span.start, span.end);
    }
    let declared = c.types.info(c.structs[index as usize].typ).structDef;
    let declaredType = useStructEntry(c, index);
    if (!c.types.structs[declared as usize].isImported && c.freestanding && isAllocatorType(c, declaredType)) {
        var what = Vector<u8>.create();
        appendQuotedName(mut what, c, nameIdent.symbol)?;
        hostedOnly(c, nameSpan, what.view())?;
        return c.errorResult(span.start, span.end);
    }
    if (c.types.structs[declared as usize].isImported) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, nameIdent.symbol)?;
        appendText(
            mut message,
            " is a C type imported from a header: CeeSafe cannot make one, only point to one (type-system.md §31.2)",
        )?;
        c.error(importedTypeByValue(), nameSpan.start, nameSpan.end, message)?;
        for (k in 0..fields.count) {
            let init = c.front.ast.fieldInits[c.front.ast.at(fields, k) as usize];
            synth(c, init.value, none())?;
        }
        return c.errorResult(span.start, span.end);
    }
    var entry = index;
    let templateItem = c.structs[index as usize].item;
    if (isGenericItem(c, templateItem)) {
        // `Pair { first: 1, … }` infers T from the fields; `Pair<u8> { … }` gives it (§20.2).
        let template = c.types.info(c.structs[index as usize].typ).structDef;
        var pairs = Vector<InferencePair>.create();
        for (k in 0..fields.count) {
            let init = c.front.ast.fieldInits[c.front.ast.at(fields, k) as usize];
            let field = findField(c, template, c.front.ast.idents[init.name as usize].symbol);
            if (field != none()) {
                pairs.push(InferencePair { declared: c.types.fields[field as usize].typ, value: init.value })?;
            }
        }
        var expectedArguments = emptyRange();
        var hasExpected = false;
        if (expected != none() && c.types.is(expected, TypeKind.Struct)) {
            let expectedDefinition = c.types.info(expected).structDef;
            if (c.types.structs[expectedDefinition as usize].item == templateItem) {
                expectedArguments = c.types.structs[expectedDefinition as usize].typeArguments;
                hasExpected = true;
            }
        }
        var parameters = Vector<u32>.create();
        listTypes(c, c.types.structs[template as usize].typeArguments, mut parameters)?;
        var text = Vector<u8>.create();
        appendBytes(mut text, c.name(nameIdent.symbol))?;
        var found = Vector<u32>.create();
        if (!typeArgumentsFor(
            c,
            text.view(),
            parameters.view(),
            typeArguments,
            expectedArguments,
            hasExpected,
            pairs.view(),
            span,
            mut found,
        )?) {
            for (k in 0..fields.count) {
                let init = c.front.ast.fieldInits[c.front.ast.at(fields, k) as usize];
                synth(c, init.value, none())?;
            }
            return c.errorResult(span.start, span.end);
        }
        entry = instantiateStruct(c, index, found.view(), span)?;
    } else if (typeArguments.count > 0) {
        var message = Vector<u8>.create();
        appendQuotedName(mut message, c, nameIdent.symbol)?;
        appendText(mut message, " is not generic; write it without type arguments")?;
        c.error(unknownType(), nameSpan.start, nameSpan.end, message)?;
    }
    let typ = c.structs[entry as usize].typ;
    let definition = c.types.info(typ).structDef;
    var values = Vector<HirFieldValue>.create();
    var seen = Vector<u32>.create();
    var ok = true;
    for (k in 0..fields.count) {
        let init = c.front.ast.fieldInits[c.front.ast.at(fields, k) as usize];
        let id = c.front.ast.idents[init.name as usize];
        let idSpan = Span { start: id.start, end: id.end };
        let field = findField(c, definition, id.symbol);
        if (field != none()) {
            checkPrivate(c, definition, field, idSpan)?;
        }
        if (field == none()) {
            var message = Vector<u8>.create();
            appendQuotedName(mut message, c, nameIdent.symbol)?;
            appendText(mut message, " has no field named ")?;
            appendQuotedName(mut message, c, id.symbol)?;
            c.error(unknownField(), idSpan.start, idSpan.end, message)?;
            synth(c, init.value, none())?;
            ok = false;
            continue;
        }
        if (containsSymbol(seen, field)) {
            var message = Vector<u8>.create();
            appendText(mut message, "field ")?;
            appendQuotedName(mut message, c, c.types.fields[field as usize].name)?;
            appendText(mut message, " is initialized more than once")?;
            c.error(duplicateFieldInit(), idSpan.start, idSpan.end, message)?;
            ok = false;
            continue;
        }
        seen.push(field)?;
        let fieldType = c.types.fields[field as usize].typ;
        let fieldDef = c.types.info(fieldType).structDef;
        if (fieldDef != none() && c.types.structs[fieldDef as usize].isImported && !inStaticConstruction(c)) {
            var message = Vector<u8>.create();
            appendText(mut message, "field ")?;
            appendQuotedName(mut message, c, c.types.fields[field as usize].name)?;
            appendText(mut message, " holds C state of type ")?;
            appendQuotedType(mut message, c, fieldType)?;
            appendText(
                mut message,
                ", which is zero-filled when the value is made: leave it out (type-system.md §33.2)",
            )?;
            c.error(importedTypeByValue(), idSpan.start, idSpan.end, message)?;
            synth(c, init.value, none())?;
            ok = false;
            continue;
        }
        let value = checkExpr(c, init.value, fieldType)?;
        values.push(HirFieldValue { field: field, value: value })?;
    }
    var missing = Vector<u8>.create();
    var missingCount: u32 = 0;
    for (f in c.types.structs[definition as usize].fields.view()) {
        let missingDef = c.types.info(c.types.fields[f as usize].typ).structDef;
        let cState = missingDef != none() && c.types.structs[missingDef as usize].isImported; // zero-filled (§33.2)
        if (!containsSymbol(seen, f) && !cState) {
            if (missingCount > 0) {
                appendText(mut missing, ", ")?;
            }
            appendQuotedName(mut missing, c, c.types.fields[f as usize].name)?;
            missingCount += 1;
        }
    }
    if (missingCount > 0 && ok) {
        var message = Vector<u8>.create();
        appendText(mut message, if (missingCount == 1) "missing field " else "missing fields ")?;
        appendBytes(mut message, missing.view())?;
        appendText(mut message, " in ")?;
        appendQuotedName(mut message, c, nameIdent.symbol)?;
        appendText(mut message, " literal")?;
        c.error(missingField(), nameSpan.start, nameSpan.end, message)?;
        ok = false;
    }
    if (!ok) {
        return c.errorResult(span.start, span.end);
    }
    let start = truncate<u32>(c.hir.fieldValues.length);
    for (v in values.view()) {
        c.hir.fieldValues.push(v)?;
    }
    let range = Range { start: start, count: truncate<u32>(values.length) };
    return c.expr(HirExpr.StructLiteral(range), typ, span.start, span.end);
}

fn isNone(e: Entity) -> bool => match (e) {
    Entity.None => true,
    _ => false,
};

/// `S.f(args)`: a static function of struct S (CheckStaticCall).
fn checkStaticCall(
    c: borrow mut Checker,
    index: u32,
    member: u32,
    arguments: Range,
    calleeSpan: Span,
    span: Span,
) -> Result<u32, AllocError> {
    let typ = useStructEntry(c, index);
    let memberIdent = c.front.ast.idents[member as usize];
    if (index == 1 && (sameText(
        c.name(memberIdent.symbol),
        "failAfter",
    ) || sameText(c.name(memberIdent.symbol), "reset"))) {
        let failAfter = sameText(c.name(memberIdent.symbol), "failAfter");
        return checkFailingAllocatorCall(c, failAfter, arguments, span);
    }
    let definition = c.types.info(typ).structDef;
    let function = findStructFunction(c, definition, memberIdent.symbol);
    if (function == none()) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, typ)?;
        appendText(mut message, " has no function named ")?;
        appendQuotedName(mut message, c, memberIdent.symbol)?;
        c.error(undefinedName(), memberIdent.start, memberIdent.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    checkMethodVisible(c, function, Span { start: memberIdent.start, end: memberIdent.end })?;
    if (isMethod(c, function)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, c.typeName(typ))?;
        appendText(mut message, ".")?;
        appendBytes(mut message, c.name(memberIdent.symbol))?;
        appendText(mut message, "' is a method; call it on a value: value.")?;
        appendBytes(mut message, c.name(memberIdent.symbol))?;
        appendText(mut message, "(...)")?;
        c.error(methodCallKind(), calleeSpan.start, calleeSpan.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    return checkUserCall(c, function, arguments, span);
}

/// A method: declared with a `this` receiver, inside a struct (HirFunction.IsMethod).
fn isMethod(c: borrow Checker, function: u32) -> bool {
    let f = borrow c.hir.functions[function as usize];
    return f.owner != none() && receiverIndex(c.front.ast.functions[f.syntax as usize].receiver) != 0;
}

/// CheckMethodCall for methods of structs.
fn checkMethodCall(
    c: borrow mut Checker,
    target: u32,
    member: u32,
    arguments: Range,
    span: Span,
) -> Result<u32, AllocError> {
    let targetSpan = c.front.ast.exprSpans[target as usize];
    let memberIdent = c.front.ast.idents[member as usize];
    match (c.front.ast.exprs[target as usize]) {
        ExprNode.Slice(sliced, low, high) => {
            let name = c.name(memberIdent.symbol);
            if (isSliceMethodName(name)) {
                // `a[lo..hi].copyFrom(s)`: the receiver is `borrow mut a[lo..hi]` (§16.5), or `borrow a[lo..hi]` for a
                // method that only reads (§36.4).
                let mutable = !(sameText(name, "forEach") || sameText(name, "any") || sameText(name, "all") ||
                    sameText(name, "splitAt"));
                let slice = synthSlice(c, sliced, low, high, mutable, targetSpan)?;
                return checkSliceMethod(c, member, arguments, slice, targetSpan, span);
            }
        }
        _ => {}
    }
    var receiver = synth(c, target, none())?;
    if (c.isBottom(receiver)) {
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let read = autoDeref(c, receiver)?;
    let readType = c.typeOf(read);
    if (c.types.is(readType, TypeKind.RawPointer)) {
        return checkPointerMethod(c, member, arguments, read, span);
    }
    if (c.types.is(readType, TypeKind.FunctionPointer)) {
        if (!sameText(c.name(memberIdent.symbol), "isNull") || arguments.count != 0) {
            var message = Vector<u8>.create();
            appendQuotedType(mut message, c, readType)?;
            appendText(mut message, " has only 'isNull()'; call it as f(…) (type-system.md §29.5)")?;
            c.error(notAStruct(), memberIdent.start, memberIdent.end, message)?;
            checkArgumentsLoosely(c, arguments)?;
            return c.errorResult(span.start, span.end);
        }
        let values = [read];
        let list = c.hir.list(values[..])?;
        let boolType = c.types.boolType;
        return c.expr(HirExpr.BuiltinCall(bfPtrIsNull(), list), boolType, span.start, span.end);
    }
    let holder = c.types.info(readType).structDef;
    if (holder != none()) {
        // A function value or closure stored in a field (§36.1, §36.2), unless a method has the name.
        let field = findField(c, holder, memberIdent.symbol);
        if (field != none()) {
            let fieldType = c.types.fields[field as usize].typ;
            let fieldHidden =
                c.types.fields[field as usize].isPrivate && c.types.structs[holder as usize].file != c.file;
            let fieldSpan = Span { start: memberIdent.start, end: memberIdent.end };
            if (c.types.is(fieldType, TypeKind.FunctionPointer) && !fieldHidden &&
                findMethod(c, readType, memberIdent.symbol, fieldSpan)? == none()) {
                // A callback stored in a field.
                let callee = c.expr(HirExpr.FieldAccess(read, field), fieldType, targetSpan.start, memberIdent.end)?;
                return checkPointerCall(c, callee, arguments, span);
            }
            let callable = c.types.is(fieldType, TypeKind.Function) || c.types.isClosure(fieldType) ||
                dynFunctionBehind(c, fieldType) != none();
            let hidden = c.types.fields[field as usize].isPrivate && c.types.structs[holder as usize].file != c.file;
            let memberSpan = Span { start: memberIdent.start, end: memberIdent.end };
            if (callable && !hidden && findMethod(c, readType, memberIdent.symbol, memberSpan)? == none()) {
                let callee = c.expr(HirExpr.FieldAccess(read, field), fieldType, targetSpan.start, memberIdent.end)?;
                if (c.types.is(fieldType, TypeKind.Function)) {
                    return checkFunctionValueCall(c, callee, arguments, span);
                }
                if (!c.types.isClosure(fieldType)) {
                    return checkDynFunctionCall(c, callee, arguments, span); // §36.5
                }
                return checkClosureCall(c, callee, arguments, span);
            }
        }
    }
    if (c.types.isUnsized(readType)) {
        match (c.hir.exprs[read as usize]) {
            HirExpr.Deref(reference) => {
                let sliceType = c.typeOf(reference);
                if (c.types.isSlice(sliceType) && !c.types.isStringView(sliceType)) {
                    let slice = coerce(c, reference, sliceType, targetSpan)?; // a SliceMut is reborrowed
                    return checkSliceMethod(c, member, arguments, slice, targetSpan, span);
                }
            }
            _ => {}
        }
    }
    var vector = receiver;
    loop {
        let t = c.typeOf(vector);
        if (!c.types.is(t, TypeKind.Reference)) {
            break;
        }
        let s = c.spanOf(vector);
        vector = c.expr(HirExpr.Deref(vector), c.types.info(t).pointee, s.start, s.end)?;
    }
    if (c.types.is(c.typeOf(vector), TypeKind.Thread)) {
        return checkThreadMethod(c, member, arguments, vector, span);
    }
    if (c.types.is(c.typeOf(vector), TypeKind.Vector)) {
        return checkVectorMethod(c, member, arguments, vector, targetSpan, span);
    }
    if (c.types.is(c.typeOf(vector), TypeKind.SlotMap) || c.types.is(c.typeOf(vector), TypeKind.StableVector)) {
        return checkContainerMethod(c, member, arguments, vector, targetSpan, span);
    }
    if (c.types.is(c.typeOf(vector), TypeKind.Resource)) {
        return checkResourceMethod(c, member, arguments, vector, targetSpan, span);
    }
    if (c.typeOf(vector) == c.ioErrorType && sameText(c.name(memberIdent.symbol), "message") && arguments.count == 0) {
        return checkIoErrorMessage(c, receiver, span); // static text for the variant (§26.2)
    }
    let receiverType = c.typeOf(receiver);
    let receiverPointee = c.types.info(receiverType).pointee;
    if (c.types.is(
        receiverType,
        TypeKind.Box,
    ) || (receiverPointee != none() && c.types.is(receiverPointee, TypeKind.Box))) {
        receiver = read; // the method receives the box's contents (§18.2)
    }
    let readAgain = autoDeref(c, receiver)?;
    let view = viewOf(c, readAgain);
    if (c.types.isStringView(c.typeOf(view))) {
        return checkViewMethod(c, member, arguments, view, span);
    }
    let ownType = c.typeOf(receiver);
    let ownPointee = c.types.info(ownType).pointee;
    let regionCandidate = if (ownPointee != none()) ownPointee else ownType;
    if (regionIndex(c.types.info(regionCandidate).region) == 4) {
        return checkPoolTake(c, member, arguments, receiver, regionCandidate, targetSpan, span);
    }
    if (c.types.is(regionCandidate, TypeKind.Region)) {
        return checkArenaMethod(c, member, arguments, receiver, targetSpan, span);
    }
    if (c.types.is(regionCandidate, TypeKind.Integer)) {
        let function = integerMethod(c.name(memberIdent.symbol));
        if (function != none()) {
            let number = autoDeref(c, receiver)?;
            return checkIntegerMethod(c, member, arguments, number, function, span);
        }
    }
    if (c.types.is(regionCandidate, TypeKind.Float)) {
        let function = floatMethod(c.name(memberIdent.symbol));
        if (function != none()) {
            let number = autoDeref(c, receiver)?;
            return checkFloatMethod(c, member, arguments, number, function, span);
        }
    }
    let currentType = c.typeOf(receiver);
    let structType = if (c.types.is(
        currentType,
        TypeKind.Reference,
    )) c.types.info(currentType).pointee else currentType;
    // Own methods, impl methods, or a type parameter's bound methods (§21).
    let memberSpan = Span { start: memberIdent.start, end: memberIdent.end };
    let function = findMethod(c, structType, memberIdent.symbol, memberSpan)?;
    let definition = c.types.info(structType).structDef;
    if (function == none() && (!c.types.is(readType, TypeKind.Struct) || c.types.info(readType).structDef == none())) {
        return checkNonStructMethod(c, receiver, readType, member, arguments, span);
    }
    if (function == none()) {
        var message = Vector<u8>.create();
        if (definition != none() && findField(c, definition, memberIdent.symbol) != none()) {
            appendText(mut message, "'")?;
            appendBytes(mut message, c.typeName(currentType))?;
            appendText(mut message, ".")?;
            appendBytes(mut message, c.name(memberIdent.symbol))?;
            appendText(mut message, "' is a field, not a function")?;
        } else {
            appendQuotedType(mut message, c, currentType)?;
            appendText(mut message, " has no method named ")?;
            appendQuotedName(mut message, c, memberIdent.symbol)?;
        }
        c.error(undefinedName(), memberIdent.start, memberIdent.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    if (!isMethod(c, function)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, c.typeName(structType))?;
        appendText(mut message, ".")?;
        appendBytes(mut message, c.name(memberIdent.symbol))?;
        appendText(mut message, "' is a static function; call it as ")?;
        appendBytes(mut message, c.typeName(structType))?;
        appendText(mut message, ".")?;
        appendBytes(mut message, c.name(memberIdent.symbol))?;
        appendText(mut message, "(...)")?;
        c.error(methodCallKind(), memberIdent.start, memberIdent.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    // The receiver is passed as `this` by value, by shared borrow, or by mutable borrow (§13.2).
    let syntax = c.front.ast.functions[c.hir.functions[function as usize].syntax as usize];
    var argument: u32 = 0;
    match (syntax.receiver) {
        ReceiverKind.Borrow => {
            let shared = c.types.referenceTo(structType, false)?;
            if (c.types.is(currentType, TypeKind.Reference)) {
                argument = coerce(c, receiver, shared, targetSpan)?;
            } else {
                let place = toPlace(c, receiver)?;
                if (place != none()) {
                    argument = c.expr(HirExpr.Borrow(false, place), shared, targetSpan.start, targetSpan.end)?;
                } else if (isPathThroughReference(c, receiver, false)?) {
                    argument = c.expr(HirExpr.BorrowPath(false, receiver), shared, targetSpan.start, targetSpan.end)?;
                } else {
                    argument = c.expr(HirExpr.BorrowTemp(false, receiver), shared, targetSpan.start, targetSpan.end)?;
                }
            }
        }
        ReceiverKind.BorrowMut => {
            if (c.types.info(currentType).mutableReference) {
                argument = coerce(c, receiver, currentType, targetSpan)?;
            } else if (c.types.is(currentType, TypeKind.Reference)) {
                var message = Vector<u8>.create();
                appendQuotedName(mut message, c, memberIdent.symbol)?;
                appendText(mut message, " takes 'borrow mut this', but this value is behind a shared reference")?;
                c.error(borrowMutOfImmutable(), targetSpan.start, targetSpan.end, message)?;
                argument = c.errorResult(targetSpan.start, targetSpan.end)?;
            } else {
                argument = borrowPlace(c, receiver, true, targetSpan)?;
            }
        }
        _ => { argument = autoDeref(c, receiver)?; }
    }
    if (c.isBottom(argument)) {
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    return checkUserCallWith(c, function, arguments, span, argument);
}

fn isIntegerMethodName(name: Slice<u8>) -> bool =>
    sameText(name, "wrappingAdd") || sameText(name, "wrappingSub") || sameText(name, "wrappingMul") ||
        sameText(name, "checkedAdd") || sameText(name, "checkedSub") || sameText(name, "checkedMul") ||
        sameText(name, "saturatingAdd") || sameText(name, "saturatingSub") || sameText(name, "saturatingMul");

fn isFloatMethodName(name: Slice<u8>) -> bool =>
    sameText(name, "bits") || sameText(name, "sqrt") || sameText(name, "abs") || sameText(name, "floor") ||
        sameText(name, "ceil") || sameText(name, "min") || sameText(name, "max");

/// A method call on a value that is not a struct: the built-in methods of S3 and S4, else N0234.
fn checkNonStructMethod(
    c: borrow mut Checker,
    receiver: u32,
    readType: u32,
    member: u32,
    arguments: Range,
    span: Span,
) -> Result<u32, AllocError> {
    let memberIdent = c.front.ast.idents[member as usize];
    var name = Vector<u8>.create();
    appendBytes(mut name, c.name(memberIdent.symbol))?;
    let receiverType = c.typeOf(receiver);
    let structType = if (c.types.is(
        receiverType,
        TypeKind.Reference,
    )) c.types.info(receiverType).pointee else receiverType;
    let isParameter = c.types.is(structType, TypeKind.TypeParameter);
    // A `dyn fn` has no methods (§36.5): the general message below. The reference crashes here (novac 0.5.0's
    // DynMethod dereferences the absent interface); docs/p3-plan.md records the divergence.
    if (c.types.is(structType, TypeKind.Dyn) && c.types.info(structType).dynInterface != none()) {
        let bound = c.types.info(structType).dynInterface;
        var message = Vector<u8>.create();
        quotedBound(mut message, c, bound)?;
        appendText(mut message, " has no method ")?;
        appendQuotedName(mut message, c, memberIdent.symbol)?;
        appendText(mut message, ": through a ")?;
        appendQuotedType(mut message, c, structType)?;
        appendText(mut message, ", only the interface's methods can be called (type-system.md §37.3)")?;
        c.error(notAStruct(), memberIdent.start, memberIdent.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    var message = Vector<u8>.create();
    appendText(mut message, "type ")?;
    appendQuotedType(mut message, c, structType)?;
    appendText(mut message, " has no methods; ")?;
    appendQuotedName(mut message, c, memberIdent.symbol)?;
    if (isParameter) {
        appendText(mut message, " needs a bound that declares it ('")?;
        appendBytes(mut message, c.typeName(structType))?;
        appendText(mut message, ": Interface')")?;
    } else {
        appendText(mut message, " cannot be called on it")?;
    }
    c.error(notAStruct(), memberIdent.start, memberIdent.end, message)?;
    checkArgumentsLoosely(c, arguments)?;
    return c.errorResult(span.start, span.end);
}

fn isSliceMethodName(name: Slice<u8>) -> bool =>
    sameText(name, "copyFrom") || sameText(name, "fill") || sameText(name, "swap") || sameText(name, "sortBy") ||
        sameText(name, "forEach") || sameText(name, "any") || sameText(name, "all") || sameText(name, "splitAt") ||
        sameText(name, "splitAtMut");
