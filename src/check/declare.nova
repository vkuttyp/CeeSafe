// The checker's driver and declarations (the reference's TypeChecker constructor, Check(), DeclareAllocError,
// Declare, DeclareFunction and CheckMain). See src/check/checker.nova for what S1a covers.

/// The reference's s_reservedNames: names no item may take (N0201).
fn reservedNameCount() -> usize => 20;

fn reservedName(k: usize) -> StringView => match (k) {
    0 => "Result",
    1 => "Ok",
    2 => "Err",
    3 => "Box",
    4 => "Scratch",
    5 => "Pool",
    6 => "PoolBox",
    7 => "Vector",
    8 => "String",
    9 => "SlotMap",
    10 => "StableVector",
    11 => "Handle",
    12 => "File",
    13 => "TcpListener",
    14 => "TcpStream",
    15 => "Ptr",
    16 => "Slice",
    17 => "SliceMut",
    18 => "Cpu",
    _ => "Target",
};

/// The reference's Builtin names, in its declaration order (the constructor's _builtins).
fn builtinName(k: u32) -> StringView => match (k) {
    0 => "Console",
    1 => "Process",
    2 => "truncate",
    3 => "layoutOf",
    4 => "offsetOf",
    5 => "callerAddress",
    6 => "checkedTruncate",
    7 => "saturatingTruncate",
    8 => "round",
    9 => "Box",
    10 => "Arena",
    11 => "FixedBufferAllocator",
    12 => "Scratch",
    13 => "Pool",
    14 => "Vector",
    15 => "String",
    16 => "SlotMap",
    17 => "StableVector",
    18 => "File",
    19 => "TcpListener",
    20 => "TcpStream",
    21 => "Ptr",
    22 => "Slice",
    23 => "SliceMut",
    24 => "StringView",
    25 => "Cpu",
    26 => "Target",
    _ => "Thread",
};

/// The names the reference interns while declaring the built-in items (DeclareAllocError, DeclareIoError,
/// DeclareAllocatorType), in its order, so symbol ids match.
fn builtinItemSymbol(k: usize) -> StringView => match (k) {
    0 => "AllocError",
    1 => "OutOfMemory",
    2 => "IoError",
    3 => "NotFound",
    4 => "PermissionDenied",
    5 => "AlreadyExists",
    6 => "IsDirectory",
    7 => "NotDirectory",
    8 => "InvalidInput",
    9 => "BrokenPipe",
    10 => "ConnectionRefused",
    11 => "AddressInUse",
    12 => "Other",
    13 => "i32",
    14 => "SystemHeap",
    _ => "FailingAllocator",
};

/// Checks the program: `units` are the parsed files, library files first (TypeChecker.Check). The returned
/// checker holds the HIR, the types and the front end (symbols, diagnostics, tree).
fn checkProgram(
    front: Frontend,
    fileIsLibrary: Vector<bool>,
    fileTexts: Vector<Vector<u8>>,
    filePaths: Vector<Vector<u8>>,
    noFloat: bool,
    freestanding: bool,
    packages: Vector<PackageInfo>,
    filePackage: Vector<u32>,
) -> Result<Checker, AllocError> {
    var c = Checker {
        front: front,
        types: TypeTable.create(lp64())?,
        hir: HirProgram.create(),
        fileIsLibrary: fileIsLibrary,
        fileTexts: fileTexts,
        filePaths: filePaths,
        noFloat: noFloat,
        packageItems: Map<Word, Entity>.create(),
        coreItems: Map<Word, Entity>.create(),
        builtins: Map<Word, u32>.create(),
        builtinNames: Vector<u32>.create(),
        structs: Vector<StructEntry>.create(),
        enums: Vector<EnumEntry>.create(),
        membersResolved: false,
        allocErrorType: none(),
        ioErrorType: none(),
        systemHeapType: none(),
        constants: Vector<ConstEntry>.create(),
        reserved: Vector<u32>.create(),
        thisSymbol: 0,
        file: 0,
        function: none(),
        scopes: Vector<ScopeEntry>.create(),
        scopeStarts: Vector<usize>.create(),
        loopDepth: 0,
        deferDepth: 0,
        copyKnown: false,
        regions: Vector<u32>.create(),
        frameMemory: none(),
        frameAllocation: none(),
        flowNames: Vector<Vector<u64>>.create(),
        flowTypeParameters: Vector<u32>.create(),
        typeEnvironment: Vector<EnvPair>.create(),
        envPairs: Vector<EnvPair>.create(),
        genericFunctions: Vector<GenericFunctionEntry>.create(),
        scopedInstanceReports: Vector<SpanIn>.create(),
        instantiating: 0,
        recursionState: Vector<u8>.create(),
        copyDone: Vector<bool>.create(),
        interfaces: Vector<InterfaceEntry>.create(),
        impls: Vector<ImplRef>.create(),
        implsReady: false,
        registerNext: true,
        dynAllowed: false,
        dynTables: Vector<DynTable>.create(),
        closureContexts: Vector<ClosureContext>.create(),
        environments: Vector<EnvironmentRecord>.create(),
        implementations: Vector<Implementation>.create(),
        implMethods: Vector<ImplMethod>.create(),
        boundMethods: Vector<BoundMethod>.create(),
        pendingBounds: Vector<PendingBounds>.create(),
        pendingAllocators: Vector<PendingAllocator>.create(),
        pendingElements: Vector<PendingElement>.create(),
        letKeywords: Vector<LetKeyword>.create(),
        effectAttributes: Vector<EffectAttributes>.create(),
        effectsOfAttributes: Vector<EffectsOfAttribute>.create(),
        constantFunctions: Vector<u32>.create(),
        callbacks: Vector<u32>.create(),
        placedMethods: Vector<u32>.create(),
        moveBodies: Vector<MoveBody>.create(),
        unsafeDepth: 0,
        usedUnsafe: false,
        allowCChar: false,
        inStaticInitializer: false,
        atomicStructs: Vector<u32>.create(),
        allowImported: false,
        coreAllowImported: false,
        layoutUses: Vector<LayoutUse>.create(),
        headers: Vector<Vector<u8>>.create(),
        statics: Vector<StaticEntry>.create(),
        staticLocals: Vector<StaticLocal>.create(),
        freestanding: freestanding,
        profileReports: Vector<LayoutUse>.create(),
        reportedQualified: Vector<LayoutUse>.create(),
        packages: packages,
        filePackage: filePackage,
        packageDeclared: Map<Word, Word>.create(),
        declaredOrder: Vector<DeclaredEntry>.create(),
        fileImports: Vector<FileImport>.create(),
    };
    // The constructor: the builtins' names, `this`, and a scratch frame's two parts.
    for (k in 0..builtinCount()) {
        let symbol = c.intern(builtinName(k))?;
        c.builtins.put(Word { value: symbol as u64 }, k)?;
    }
    c.thisSymbol = c.intern("this")?;
    c.intern("memory")?;
    c.intern("allocation")?;
    for (k in 0..reservedNameCount()) {
        let symbol = c.intern(reservedName(k))?;
        c.reserved.push(symbol)?;
    }
    declarePackageNames(mut c)?;
    declareFrameFields(mut c)?;
    declareBuiltinItems(mut c)?;
    checkQualifiedNames(mut c)?;

    // Interfaces, then structs and enums, then every other item, unit by unit (Check()).
    for (u in 0..c.front.ast.units.length) {
        c.file = c.front.ast.units[u].file;
        let items = c.front.ast.units[u].items;
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Interface(_, _) => { declareInterface(mut c, item)?; }
                _ => {}
            }
        }
    }
    for (u in 0..c.front.ast.units.length) {
        c.file = c.front.ast.units[u].file;
        let items = c.front.ast.units[u].items;
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Struct(_) => { declareStruct(mut c, item)?; }
                ItemKind.Enum(_, _, _) => { declareEnum(mut c, item)?; }
                ItemKind.Extern(abi, _, structs) => {
                    if (sameText(c.front.ast.textOf(abi), "C")) {
                        for (s in 0..structs.count) {
                            let imported = c.front.ast.at(structs, s);
                            declareImportedStruct(mut c, imported)?;
                        }
                    }
                }
                _ => {}
            }
        }
    }
    processTypeAttributes(mut c)?;
    for (u in 0..c.front.ast.units.length) {
        c.file = c.front.ast.units[u].file;
        let items = c.front.ast.units[u].items;
        for (k in 0..items.count) {
            let item = c.front.ast.at(items, k);
            match (c.front.ast.items[item as usize].kind) {
                ItemKind.Interface(_, _) => {}
                ItemKind.Struct(_) => {}
                ItemKind.Enum(_, _, _) => {}
                _ => { declare(mut c, item)?; }
            }
        }
    }

    processFunctionAttributes(mut c)?;
    processImpls(mut c)?;
    resolveAllMembers(mut c)?;
    checkLayoutUses(mut c)?;
    checkStructRecursion(mut c)?;
    computeCopyAndDrop(mut c)?;
    checkForeignInterfaces(mut c)?;
    checkPublicSignatures(mut c)?;
    checkPendingElements(mut c)?;

    for (k in 0..c.constants.length) {
        evaluateConstant(mut c, truncate<u32>(k))?;
    }
    checkStaticInitializers(mut c)?; // before the bodies, so the instances its calls make are checked with them

    // The body pass: every function in creation order, the libraries' included.
    var f: usize = 0;
    while (f < c.hir.functions.length) {
        // A closure's body is checked where its literal is (§36.2).
        // A C function is defined in C (§28.2).
        let isExtern = c.front.ast.functions[c.hir.functions[f].syntax as usize].isExtern;
        if (c.hir.functions[f].registered && !c.hir.functions[f].isClosure && !isExtern) {
            let function = truncate<u32>(f);
            if (functionIsInstantiation(c, function)) {
                // Its generic version reports (§20.3); a scoped type argument the body cannot take is N0274.
                var arguments = Vector<u32>.create();
                listTypes(c, c.hir.functions[f].typeArguments, mut arguments)?;
                var name = Vector<u8>.create();
                appendBytes(mut name, c.name(c.hir.functions[f].name))?;
                var siteFile = c.hir.functions[f].siteFile;
                var siteSpan = Span { start: c.hir.functions[f].siteStart, end: c.hir.functions[f].siteEnd };
                if (siteFile == none()) {
                    // A method of a struct instance: its declaration's name (the reference's Syntax.Name.Span).
                    siteFile = c.hir.functions[f].file;
                    let syntax = c.front.ast.functions[c.hir.functions[f].syntax as usize];
                    let id = c.front.ast.idents[syntax.name as usize];
                    siteSpan = Span { start: id.start, end: id.end };
                }
                let mark = diagnosticsMark(c);
                checkFunctionBody(mut c, function)?;
                endInstance(mut c, mark, arguments.view(), name.view(), siteFile, siteSpan, function)?;
            } else {
                checkFunctionBody(mut c, function)?;
            }
        }
        f += 1;
    }
    checkMain(mut c)?;
    foldStatics(mut c)?;
    finishFunctionFacts(mut c)?;
    finishAtomicStructs(mut c);
    return Ok(c);
}

fn declareBuiltinItems(c: borrow mut Checker) -> Result<void, AllocError> {
    for (k in 0..16usize) {
        let symbol = c.intern(builtinItemSymbol(k))?;
        let index: u32 = match (k) {
            0 => 0,
            2 => 1,
            14 => 2,
            15 => 3,
            _ => none(),
        };
        if (index != none()) {
            c.builtinNames.push(symbol)?;
        }
    }
    return declareBuiltinTypes(c);
}

fn isLibraryFile(c: borrow Checker) -> bool => c.fileIsLibrary[c.file as usize];

/// N0201 if the name is reserved or a built-in item's (IsReservedName).
fn isReservedName(c: borrow mut Checker, ident: u32) -> Result<bool, AllocError> {
    let id = c.front.ast.idents[ident as usize];
    var reserved = false;
    for (r in c.reserved.view()) {
        if (r == id.symbol) {
            reserved = true;
        }
    }
    for (b in c.builtinNames.view()) {
        if (b == id.symbol) {
            reserved = true;
        }
    }
    if (!reserved) {
        return Ok(false);
    }
    var message = Vector<u8>.create();
    appendText(mut message, "'")?;
    appendBytes(mut message, c.name(id.symbol))?;
    appendText(mut message, "' is a built-in name")?;
    c.error(duplicateItem(), id.start, id.end, message)?;
    return Ok(true);
}

/// Own.ContainsKey(name) || (not lib/core && _core.Items.ContainsKey(name)) (IsDeclared).
fn isDeclared(c: borrow Checker, symbol: u32) -> bool {
    let key = Word { value: symbol as u64 };
    if (isLibraryFile(c)) {
        return c.coreItems.find(key) != null;
    }
    return c.packageItems.find(packageKey(currentPackage(c), symbol)) != null || c.coreItems.find(key) != null;
}

fn ownItem(c: borrow mut Checker, symbol: u32, entity: Entity) -> Result<void, AllocError> {
    let key = Word { value: symbol as u64 };
    if (isLibraryFile(c)) {
        c.coreItems.put(key, entity)?;
    } else {
        c.packageItems.put(packageKey(currentPackage(c), symbol), entity)?;
    }
    return Ok();
}

/// Declare(item), for user and library units alike; unported items are gaps.
fn declare(c: borrow mut Checker, item: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    match (entry.kind) {
        ItemKind.Impl(_, _, _) => {
            c.impls.push(ImplRef { item: item, file: c.file })?; // processed once every item is declared (§21.1)
            return Ok();
        }
        ItemKind.Extern(_, _, _) => { return declareExternBlock(c, item); }
        _ => {}
    }
    let id = c.front.ast.idents[entry.name as usize];
    if (isReservedName(c, entry.name)?) {
        return Ok();
    }
    if (isDeclared(c, id.symbol)) {
        var message = Vector<u8>.create();
        appendText(mut message, "'")?;
        appendBytes(mut message, c.name(id.symbol))?;
        appendText(mut message, "' is already defined")?;
        c.error(duplicateItem(), id.start, id.end, message)?;
        return Ok();
    }
    match (entry.kind) {
        ItemKind.Function(f) => {
            let decl = c.front.ast.functions[f as usize];
            if (receiverIndex(decl.receiver) != 0) {
                var message = Vector<u8>.create();
                appendText(mut message, "'this' parameters are only allowed in functions declared inside a struct")?;
                c.error(thisOutsideMethod(), decl.receiverStart, decl.receiverEnd, message)?;
            }
            if (decl.typeParameters.count > 0) {
                // Checked once with opaque type parameters; instantiated on use (§20).
                var parameters = Vector<u32>.create();
                var pairs = Vector<EnvPair>.create();
                declareTypeParameters(c, decl.typeParameters, mut parameters, mut pairs)?;
                let env = storeEnvironment(c, pairs.view())?;
                let list = c.types.addList(parameters.view())?;
                let generic = declareFunctionIn(c, f, none(), env)?;
                c.genericFunctions.push(
                    GenericFunctionEntry { syntax: f, file: c.file, generic: generic, parameters: list },
                )?;
                let index = truncate<u32>(c.genericFunctions.length - 1);
                ownItem(c, id.symbol, Entity.GenericFunction(index))?;
                return Ok();
            }
            let function = declareFunction(c, f, none())?;
            ownItem(c, id.symbol, Entity.Function(function))?;
        }
        ItemKind.Const(typ, _) => {
            var t = c.resolveType(typ, false)?;
            let span = c.front.ast.typeSpans[typ as usize];
            if (c.types.is(t, TypeKind.Struct) || (c.types.is(t, TypeKind.Array) && !constElementOk(c, t))) {
                var message = Vector<u8>.create();
                appendText(
                    mut message,
                    if (c.types.is(
                        t,
                        TypeKind.Array,
                    )) "constant arrays hold integers or bools (type-system.md §10)" else "constants of struct type are not supported yet",
                )?;
                c.error(unsupported(), span.start, span.end, message)?;
                t = c.types.error;
            } else if (c.types.isScoped(t)) {
                var message = Vector<u8>.create();
                appendText(mut message, "constants cannot be references")?;
                c.error(referenceNotAllowed(), span.start, span.end, message)?;
                t = c.types.error;
            }
            c.hir.constants.push(HirConstant {
                name: qualifiedSymbol(c, id.symbol)?,
                typ: t,
                file: c.file,
                start: entry.start,
                end: entry.end,
                value: none(),
                exported: false,
                exportName: emptyRange(),
            })?;
            c.constants.push(ConstEntry {
                item: item,
                file: c.file,
                hir: truncate<u32>(c.hir.constants.length - 1),
                state: 0,
            })?;
            let constant = truncate<u32>(c.constants.length - 1);
            ownItem(c, id.symbol, Entity.Constant(constant))?;
        }
        ItemKind.Static(mutable, typ, _) => { declareStatic(c, item, mutable, typ)?; }
        _ => {}
    }
    return Ok();
}

fn constElementOk(c: borrow Checker, t: u32) -> bool {
    let element = c.types.info(t).element;
    return c.types.is(
        element,
        TypeKind.Integer,
    ) || c.types.is(element, TypeKind.Bool) || c.types.is(element, TypeKind.Error);
}

fn receiverIndex(kind: ReceiverKind) -> u32 => match (kind) {
    ReceiverKind.None => 0,
    ReceiverKind.Value => 1,
    ReceiverKind.Borrow => 2,
    ReceiverKind.BorrowMut => 3,
};

/// DeclareFunction for a top-level function without type parameters: its signature, and its parameters as locals.
fn declareFunction(c: borrow mut Checker, f: u32, owner: u32) -> Result<u32, AllocError> =>
    declareFunctionIn(c, f, owner, emptyRange());

/// A signature only (an interface method's, DeclareFunction with `register: false`): checked, never compiled, not
/// printed, and not counted in function ids.
fn declareSignature(c: borrow mut Checker, f: u32, owner: u32, environment: Range) -> Result<u32, AllocError> {
    c.registerNext = false;
    let function = declareFunctionIn(c, f, owner, environment)?;
    c.registerNext = true;
    return Ok(function);
}

/// DeclareFunction with a type environment (Checker.envPairs): a generic version's or an instance's.
fn declareFunctionIn(c: borrow mut Checker, f: u32, owner: u32, environment: Range) -> Result<u32, AllocError> {
    var scope = Vector<u32>.create();
    regionScope(c, f, owner, mut scope)?;
    let saved = swapRegions(c, scope)?;
    let savedEnvironment = enterEnvironment(c, environment)?;
    let function = declareFunctionCore(c, f, owner, environment)?;
    restoreEnvironment(c, savedEnvironment);
    swapRegions(c, saved)?;
    return Ok(function);
}

fn declareFunctionCore(c: borrow mut Checker, f: u32, owner: u32, environment: Range) -> Result<u32, AllocError> {
    let decl = c.front.ast.functions[f as usize];
    if (owner != none() && decl.regionParameters.count > 0) {
        let first = c.front.ast.typeParameters[c.front.ast.at(decl.regionParameters, 0) as usize];
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "methods cannot declare region parameters of their own; use the struct's regions (type-system.md §25.1)",
        )?;
        c.error(unsupported(), first.start, first.end, message)?;
    }
    checkRegionParameters(c, decl.regionParameters, decl.typeParameters)?;
    var env = environment;
    if (owner != none() && decl.typeParameters.count > 0) {
        let tp = c.front.ast.typeParameters[c.front.ast.at(decl.typeParameters, 0) as usize];
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "methods cannot declare type parameters of their own in v0; use the struct's, or a top-level generic function",
        )?;
        c.error(unsupported(), tp.start, tp.end, message)?;
        // Declared anyway, so their names resolve (no cascade of unknown types).
        var parameters = Vector<u32>.create();
        var pairs = Vector<EnvPair>.create();
        for (p in c.typeEnvironment.view()) {
            pairs.push(p)?;
        }
        declareTypeParameters(c, decl.typeParameters, mut parameters, mut pairs)?;
        enterEnvironmentPairs(c, pairs.view())?;
        env = storeEnvironment(c, pairs.view())?;
    }
    // A @constant function's result, and a C constant macro's, may hold C state: it is built at compile time (§39.4).
    var returnType = c.types.voidType;
    if (decl.returnType != none()) {
        c.allowImported = hasAttributeNamed(c, decl.attributes, "constant");
        returnType = c.resolveTypeWith(decl.returnType, true, true)?;
    }
    // A dependency's top-level function is named with its package (c-backend.md §2.1); a C function keeps its own name.
    let declaredName = c.front.ast.idents[decl.name as usize].symbol;
    let name = if (owner == none() && !decl.isExtern) qualifiedSymbol(c, declaredName)? else declaredName;
    let library = isLibraryFile(c);
    let function = c.hir.addFunction(name, owner, returnType, c.file, f, library, c.registerNext)?;
    c.hir.functions[function as usize].environment = env;
    if (owner != none() && receiverIndex(decl.receiver) != 0) {
        // `this` is an immutable binding: the struct by value, or a reference to it (§12, §13.2).
        let thisType = match (decl.receiver) {
            ReceiverKind.Borrow => c.types.referenceTo(owner, false)?,
            ReceiverKind.BorrowMut => c.types.referenceTo(owner, true)?,
            _ => owner,
        };
        let thisSymbol = c.thisSymbol;
        let local = c.hir.addLocal(function, thisSymbol, thisType, false, true, decl.receiverStart, decl.receiverEnd)?;
        c.hir.functions[function as usize].parameters.push(local)?;
    }
    var seen = Vector<u32>.create();
    for (k in 0..decl.parameters.count) {
        let p = c.front.ast.parameters[c.front.ast.at(decl.parameters, k) as usize];
        let t = c.resolveType(p.typ, false)?;
        let id = c.front.ast.idents[p.name as usize];
        var duplicate = false;
        for (s in seen.view()) {
            if (s == id.symbol) {
                duplicate = true;
            }
        }
        if (duplicate) {
            var message = Vector<u8>.create();
            appendText(mut message, "parameter '")?;
            appendBytes(mut message, c.name(id.symbol))?;
            appendText(mut message, "' is declared more than once")?;
            c.error(duplicateParameter(), id.start, id.end, message)?;
        } else {
            seen.push(id.symbol)?;
        }
        let local = c.hir.addLocal(function, id.symbol, t, false, true, id.start, id.end)?;
        c.hir.functions[function as usize].parameters.push(local)?;
    }
    resolveFlows(c, f, function, owner)?;
    return Ok(function);
}

/// CheckMain: `main` takes no parameters and returns i32 or void (hosted).
fn checkMain(c: borrow mut Checker) -> Result<void, AllocError> {
    let symbol = c.front.symbols.find("main".bytes());
    let mainSymbol = match (symbol) {
        Some(s) => s.id,
        null => { return Ok(); }
    };
    let entity = foundEntity(c.packageItems, packageKey(0, mainSymbol));
    match (entity) {
        Entity.GenericFunction(g) => {
            let entry = c.genericFunctions[g as usize];
            c.file = entry.file;
            let id = c.front.ast.idents[c.front.ast.functions[entry.syntax as usize].name as usize];
            var message = Vector<u8>.create();
            appendText(mut message, "'main' cannot be generic")?;
            return c.error(invalidMain(), id.start, id.end, message);
        }
        _ => {}
    }
    let function = match (entity) {
        Entity.Function(f) => f,
        _ => { return Ok(); }
    };
    let f = borrow c.hir.functions[function as usize];
    let returnType = f.returnType;
    let parameterCount = f.parameters.length;
    let syntax = c.front.ast.functions[f.syntax as usize];
    let file = f.file;
    let id = c.front.ast.idents[syntax.name as usize];
    let okReturn = returnType == c.types.i32 || returnType == c.types.voidType;
    c.file = file;
    if (c.freestanding) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "a freestanding package has no 'main': nothing calls it; enter it through @export functions (cosmoos/profiles.md §4.1)",
        )?;
        return c.error(hostedOnlyCode(), id.start, id.end, message);
    }
    if (parameterCount != 0 || !okReturn) {
        var message = Vector<u8>.create();
        appendText(mut message, "'main' must take no parameters and return 'i32' or 'void'")?;
        c.error(invalidMain(), id.start, id.end, message)?;
    } else if (syntax.isUnsafe) {
        var message = Vector<u8>.create();
        appendText(mut message, "'main' cannot be unsafe; put the unsafe code in an 'unsafe { ... }' block")?;
        c.error(invalidMain(), id.start, id.end, message)?;
    }
    return Ok();
}

/// The entity `map` holds for `key`, or Entity.None (a copy, so no borrow of the map outlives the call).
fn foundEntity(map: borrow Map<Word, Entity>, key: Word) -> Entity {
    match (map.get(key)) {
        Some(e) => { return e; }
        null => { return Entity.None; }
    }
}
