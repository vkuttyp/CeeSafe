// Statics, `here`, `layoutOf` and the freestanding profile's checks (the reference's StaticUse, DeclareStaticLocals,
// CheckStaticInitializers, FoldStatics, ConstantBody, StaticFold, Operators, IsHere, CheckHere, CheckLayoutOf,
// HasLayout, IsHostedOnly and HostedOnly): P3 S7c (type-system.md §39, §30.1; cosmoos/profiles.md §4.1).

fn hostedOnlyCode() -> u32 => 293;
fn staticNotAllowed() -> u32 => 337;

/// A `static` item (StaticEntry): its HIR static and its checked initialiser.
struct StaticEntry {
    item: u32; // Ast.items
    file: u32;
    hir: u32;     // Hir.statics
    checked: u32; // the checked initialiser, or none until CheckStaticInitializers
}

/// The hidden local of a function that holds a static's address (the reference's _staticLocals).
struct StaticLocal {
    function: u32;
    staticIndex: u32; // Hir.statics
    local: u32;
}

/// A static's value to bind a `@constant` function's parameter to while folding (StaticFold's parameters).
struct FoldBinding {
    local: u32;
    value: u32;
}

/// `static NAME: T = value;` and `static mut …` (Declare's StaticDecl case): it may hold C state, made in place by C's
/// initialiser (§39.4).
fn declareStatic(c: borrow mut Checker, item: u32, mutable: bool, typeSyntax: u32) -> Result<void, AllocError> {
    let entry = c.front.ast.items[item as usize];
    let id = c.front.ast.idents[entry.name as usize];
    c.allowImported = true;
    let typ = c.resolveType(typeSyntax, false)?;
    let file = c.file;
    let qualified = qualifiedSymbol(c, id.symbol)?;
    c.hir.statics.push(
        HirStatic {
            name: qualified,
            typ: typ,
            mutable: mutable,
            file: file,
            start: entry.start,
            end: entry.end,
            value: none(),
        },
    )?;
    let hir = truncate<u32>(c.hir.statics.length - 1);
    c.statics.push(StaticEntry { item: item, file: file, hir: hir, checked: none() })?;
    let index = truncate<u32>(c.statics.length - 1);
    return ownItem(c, id.symbol, Entity.Static(index));
}

/// A static's name in an expression (StaticUse, §39.2): `*S`, with `S` a hidden local of the current function holding
/// the static's address, a `borrow(static) T`, declared at the function's start.
fn staticUse(c: borrow mut Checker, entry: u32, span: Span) -> Result<u32, AllocError> {
    let hir = c.statics[entry as usize].hir;
    let s = c.hir.statics[hir as usize];
    // The declared name (entry.Decl.Name), not the package-qualified one.
    let declaredIdent = c.front.ast.items[c.statics[entry as usize].item as usize].name;
    var name = Vector<u8>.create();
    appendBytes(mut name, c.name(c.front.ast.idents[declaredIdent as usize].symbol))?;
    let function = c.function;
    if (function == none()) {
        var message = Vector<u8>.create();
        appendText(mut message, "static '")?;
        appendBytes(mut message, name.view())?;
        appendText(
            mut message,
            "' cannot be used in a constant or static initialiser, which is evaluated at compile time (type-system.md §39.4)",
        )?;
        c.error(notStaticInitializer(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (s.mutable) {
        var what = Vector<u8>.create();
        appendText(mut what, "using 'static mut ")?;
        appendBytes(mut what, name.view())?;
        appendText(mut what, "'")?;
        if (!requireUnsafe(c, span, what.view())?) {
            return c.errorResult(span.start, span.end);
        }
    }
    var local = none();
    for (l in c.staticLocals.view()) {
        if (l.function == function && l.staticIndex == hir) {
            local = l.local;
        }
    }
    if (local == none()) {
        let typ = c.types.referenceTo(s.typ, s.mutable)?;
        var text = Vector<u8>.create();
        appendText(mut text, "static_")?;
        appendBytes(mut text, name.view())?;
        let symbol = c.front.symbols.intern(text.view())?.id;
        local = c.hir.addLocal(function, symbol, typ, false, false, span.start, span.end)?;
        c.staticLocals.push(StaticLocal { function: function, staticIndex: hir, local: local })?;
    }
    let referenceType = c.hir.locals[local as usize].typ;
    let reference = c.expr(HirExpr.LocalRef(local), referenceType, span.start, span.end)?;
    return c.expr(HirExpr.Deref(reference), s.typ, span.start, span.end);
}

/// The static whose address a local holds (the reference's _staticAddressLocals), or none.
fn staticOfLocal(c: borrow Checker, local: u32) -> u32 {
    for (l in c.staticLocals.view()) {
        if (l.local == local) {
            return l.staticIndex;
        }
    }
    return none();
}

/// A function's static-address locals, declared at its start before flow analysis sees the body
/// (DeclareStaticLocals).
fn declareStaticLocals(c: borrow mut Checker, function: u32) -> Result<void, AllocError> {
    let body = c.hir.functions[function as usize].body;
    if (body == none()) {
        return Ok();
    }
    var declarations = Vector<u32>.create();
    for (k in 0..c.staticLocals.length) {
        let l = c.staticLocals[k];
        if (l.function != function) {
            continue;
        }
        let local = c.hir.locals[l.local as usize];
        let address = c.expr(HirExpr.StaticAddress(l.staticIndex), local.typ, local.start, local.end)?;
        declarations.push(c.hir.addStmt(HirStmt.LocalDecl(l.local, address), local.start, local.end)?)?;
    }
    if (declarations.length == 0) {
        return Ok();
    }
    let statements = match (c.hir.stmts[body as usize]) {
        HirStmt.Block(s) => s,
        _ => emptyRange(),
    };
    for (k in 0..statements.count) {
        declarations.push(c.hir.at(statements, k))?;
    }
    let list = c.hir.list(declarations.view())?;
    let span = c.hir.stmtSpans[body as usize];
    c.hir.functions[function as usize].body = c.hir.addStmt(HirStmt.Block(list), span.start, span.end)?;
    return Ok();
}

/// Type-checks each static's type and initialiser (CheckStaticInitializers, §39.1–§39.4); FoldStatics evaluates them.
fn checkStaticInitializers(c: borrow mut Checker) -> Result<void, AllocError> {
    for (k in 0..c.statics.length) {
        let entry = c.statics[k];
        let item = c.front.ast.items[entry.item as usize];
        var typeSyntax = none();
        var valueSyntax = none();
        match (item.kind) {
            ItemKind.Static(_, t, v) => {
                typeSyntax = t;
                valueSyntax = v;
            }
            _ => {}
        }
        let savedFile = c.file;
        let savedFunction = c.function;
        let savedLoop = c.loopDepth;
        let savedScopes = c.scopes.length;
        let savedStarts = c.scopeStarts.length;
        c.file = entry.file;
        c.function = none();
        c.loopDepth = 0;
        c.pushScope()?;
        let s = c.hir.statics[entry.hir as usize];
        let typ = s.typ;
        let typeSpan = c.front.ast.typeSpans[typeSyntax as usize];
        // A view of static string data is the one reference a static may hold, and it is safe to share.
        if (!s.mutable && typ != c.types.error && !c.types.isShare(typ)? && !c.types.isStringView(typ)) {
            var message = Vector<u8>.create();
            appendText(mut message, "a static is shared by every thread, so its type must be 'Share', and ")?;
            appendQuotedType(mut message, c, typ)?;
            appendText(mut message, " is not (type-system.md §39.2; §38.1)")?;
            c.error(staticNotAllowed(), typeSpan.start, typeSpan.end, message)?;
        } else if (c.types.isScoped(typ) && !c.types.isStringView(typ)) {
            var message = Vector<u8>.create();
            appendText(mut message, "a static of type ")?;
            appendQuotedType(mut message, c, typ)?;
            appendText(
                mut message,
                " would hold a reference, which a static initialiser cannot make (type-system.md §39.4)",
            )?;
            c.error(staticNotAllowed(), typeSpan.start, typeSpan.end, message)?;
        }
        c.inStaticInitializer = true;
        let checked = checkExpr(c, valueSyntax, typ)?;
        c.inStaticInitializer = false;
        c.statics[k].checked = checked;
        c.scopes.truncate(savedScopes);
        c.scopeStarts.truncate(savedStarts);
        c.file = savedFile;
        c.function = savedFunction;
        c.loopDepth = savedLoop;
    }
    return Ok();
}

fn isConstantValue(c: borrow Checker, e: u32) -> bool => match (c.hir.exprs[e as usize]) {
    HirExpr.IntConst(_) => true,
    HirExpr.BoolConst(_) => true,
    HirExpr.FloatConst(_) => true,
    _ => false,
};

/// Evaluates every static's initialiser, and checks every `@constant` function's body (FoldStatics, §39.4).
fn foldStatics(c: borrow mut Checker) -> Result<void, AllocError> {
    let saved = c.file;
    for (k in 0..c.statics.length) {
        let entry = c.statics[k];
        c.file = entry.file;
        var value = none();
        if (entry.checked != none()) {
            let none0 = Vector<FoldBinding>.create();
            value = staticFold(c, entry.checked, none0.view(), false, 0)?;
        } else {
            let item = c.front.ast.items[entry.item as usize];
            let valueSyntax = match (item.kind) {
                ItemKind.Static(_, _, v) => v,
                _ => none(),
            };
            let span = c.front.ast.exprSpans[valueSyntax as usize];
            value = c.errorResult(span.start, span.end)?;
        }
        c.hir.statics[entry.hir as usize].value = value;
    }
    for (k in 0..c.hir.functions.length) {
        let f = borrow c.hir.functions[k];
        if (!f.registered || !containsU32(c.constantFunctions, f.syntax) || f.isGeneric || functionIsInstantiation(
            c,
            truncate<u32>(k),
        )) {
            continue;
        }
        let syntax = f.syntax;
        if (c.front.ast.functions[syntax as usize].isExtern) {
            continue;
        }
        c.file = c.hir.functions[k].file;
        let function = truncate<u32>(k);
        let body = constantBody(c, function);
        if (body == none()) {
            let id = c.front.ast.idents[c.front.ast.functions[syntax as usize].name as usize];
            var message = Vector<u8>.create();
            appendText(
                mut message,
                "a '@constant' function's body must be a single expression: '=> e' or '{ return e; }' (type-system.md §39.4)",
            )?;
            c.error(notStaticInitializer(), id.start, id.end, message)?;
            continue;
        }
        var bindings = Vector<FoldBinding>.create();
        let parameterCount = c.hir.functions[k].parameters.length;
        for (j in 0..parameterCount) {
            let p = c.hir.functions[k].parameters[j];
            let local = c.hir.locals[p as usize];
            let value = c.expr(HirExpr.LocalRef(p), local.typ, local.start, local.end)?;
            bindings.push(FoldBinding { local: p, value: value })?;
        }
        staticFold(c, body, bindings.view(), true, 0)?;
    }
    c.file = saved;
    return Ok();
}

/// The expression a `@constant` function returns, if its body is just that (ConstantBody), or none.
fn constantBody(c: borrow Checker, function: u32) -> u32 {
    let body = c.hir.functions[function as usize].body;
    if (body == none()) {
        return none();
    }
    let statements = match (c.hir.stmts[body as usize]) {
        HirStmt.Block(s) => s,
        _ => emptyRange(),
    };
    if (statements.count != 1) {
        return none();
    }
    return match (c.hir.stmts[c.hir.at(statements, 0) as usize]) {
        HirStmt.Return(value) => value,
        _ => none(),
    };
}

/// The text of a string literal, as a view expression (StringLiteralOf); none for anything else.
fn stringLiteralOf(c: borrow Checker, view: u32) -> Range {
    return match (c.hir.exprs[view as usize]) {
        HirExpr.StringConst(text) => text,
        HirExpr.BorrowTemp(_, value) => match (c.hir.exprs[value as usize]) {
            HirExpr.StringConst(text) => text,
            _ => Range { start: 0, count: 0xFFFFFFFF },
        },
        HirExpr.Deref(inner) => stringLiteralOf(c, inner),
        _ => Range { start: 0, count: 0xFFFFFFFF },
    };
}

fn staticFail(c: borrow mut Checker, e: u32, why: StringView) -> Result<u32, AllocError> {
    let span = c.hir.exprSpans[e as usize];
    var message = Vector<u8>.create();
    appendText(mut message, why)?;
    appendText(mut message, ": not a static initialiser (type-system.md §39.4)")?;
    c.error(notStaticInitializer(), span.start, span.end, message)?;
    return c.errorResult(span.start, span.end);
}

/// A copy of `e` with new operands, the same type and span (the reference's `with`).
fn rebuilt(c: borrow mut Checker, e: u32, node: HirExpr) -> Result<u32, AllocError> {
    let typ = c.hir.exprTypes[e as usize];
    let span = c.hir.exprSpans[e as usize];
    return c.expr(node, typ, span.start, span.end);
}

/// A static initialiser's value (StaticFold, §39.4), or N0338 and an error value. `bindings` maps a `@constant`
/// function's parameters to their values (or, when checking its body, to themselves).
fn staticFold(
    c: borrow mut Checker,
    e: u32,
    bindings: Slice<FoldBinding>,
    hasBindings: bool,
    depth: u32,
) -> Result<u32, AllocError> {
    if (depth > 64) {
        return staticFail(c, e, "'@constant' calls nest too deeply");
    }
    let span = c.hir.exprSpans[e as usize];
    match (c.hir.exprs[e as usize]) {
        HirExpr.Error => { return Ok(e); }
        HirExpr.IntConst(_) => { return Ok(e); }
        HirExpr.BoolConst(_) => { return Ok(e); }
        HirExpr.FloatConst(_) => { return Ok(e); }
        HirExpr.StringConst(_) => { return Ok(e); }
        HirExpr.StaticCString(_) => { return Ok(e); }
        HirExpr.BuiltinCall(function, _) => {
            if (function == bfLayoutOf() || function == bfOffsetOf()) {
                return Ok(e);
            }
            return staticFail(c, e, "this expression");
        }
        HirExpr.LocalRef(local) => {
            if (hasBindings) {
                for (b in bindings) {
                    if (b.local == local) {
                        return Ok(b.value);
                    }
                }
            }
            return staticFail(c, e, "a variable");
        }
        HirExpr.Unary(op, operand) => {
            let folded = staticFold(c, operand, bindings, hasBindings, depth + 1)?;
            let node = rebuilt(c, e, HirExpr.Unary(op, folded))?;
            return operators(c, node);
        }
        HirExpr.Binary(op, left, right) => {
            let l = staticFold(c, left, bindings, hasBindings, depth + 1)?;
            let r = staticFold(c, right, bindings, hasBindings, depth + 1)?;
            let node = rebuilt(c, e, HirExpr.Binary(op, l, r))?;
            return operators(c, node);
        }
        HirExpr.Truncate(operand) => {
            let folded = staticFold(c, operand, bindings, hasBindings, depth + 1)?;
            let node = rebuilt(c, e, HirExpr.Truncate(folded))?;
            return operators(c, node);
        }
        HirExpr.Cast(operand) => {
            // A string literal's address as a C string (§39.4).
            match (c.hir.exprs[operand as usize]) {
                HirExpr.BuiltinCall(function, arguments) => {
                    if (function == bfSlicePtr() && arguments.count == 1) {
                        let text = stringLiteralOf(c, c.hir.at(arguments, 0));
                        if (text.count != 0xFFFFFFFF) {
                            return rebuilt(c, e, HirExpr.StaticCString(text));
                        }
                    }
                }
                _ => {}
            }
            let folded = staticFold(c, operand, bindings, hasBindings, depth + 1)?;
            let allowed = match (c.hir.exprs[folded as usize]) {
                HirExpr.IntConst(_) => true,
                HirExpr.BoolConst(_) => true,
                HirExpr.FloatConst(_) => true,
                HirExpr.Error => true,
                HirExpr.LocalRef(_) => true,
                HirExpr.Unary(_, _) => true,
                HirExpr.Binary(_, _, _) => true,
                HirExpr.Cast(_) => true,
                HirExpr.Truncate(_) => true,
                _ => false,
            };
            if (!allowed) {
                return staticFail(c, e, "only a number, a bool or a string literal's address may be cast");
            }
            let node = rebuilt(c, e, HirExpr.Cast(folded))?;
            return operators(c, node);
        }
        HirExpr.StructLiteral(fields) => {
            var values = Vector<HirFieldValue>.create();
            var failed = false;
            for (k in 0..fields.count) {
                let field = c.hir.fieldValues[(fields.start + k) as usize];
                let value = staticFold(c, field.value, bindings, hasBindings, depth + 1)?;
                if (isErrorExpr(c, value)) {
                    failed = true;
                }
                values.push(HirFieldValue { field: field.field, value: value })?;
            }
            if (failed) {
                return c.errorResult(span.start, span.end);
            }
            let start = truncate<u32>(c.hir.fieldValues.length);
            for (v in values.view()) {
                c.hir.fieldValues.push(v)?;
            }
            return rebuilt(c, e, HirExpr.StructLiteral(Range { start: start, count: truncate<u32>(values.length) }));
        }
        HirExpr.ArrayLiteral(elements) => {
            var values = Vector<u32>.create();
            var failed = false;
            for (k in 0..elements.count) {
                let element = c.hir.at(elements, k);
                let value = staticFold(c, element, bindings, hasBindings, depth + 1)?;
                if (isErrorExpr(c, value)) {
                    failed = true;
                }
                values.push(value)?;
            }
            if (failed) {
                return c.errorResult(span.start, span.end);
            }
            let list = c.hir.list(values.view())?;
            return rebuilt(c, e, HirExpr.ArrayLiteral(list));
        }
        HirExpr.ArrayRepeat(value) => {
            let folded = staticFold(c, value, bindings, hasBindings, depth + 1)?;
            if (isErrorExpr(c, folded)) {
                return Ok(folded);
            }
            return rebuilt(c, e, HirExpr.ArrayRepeat(folded));
        }
        HirExpr.Call(callee, arguments) => {
            let calleeSyntax = c.hir.functions[callee as usize].syntax;
            if (!containsU32(c.constantFunctions, calleeSyntax)) {
                var why = Vector<u8>.create();
                appendText(mut why, "'")?;
                appendBytes(mut why, c.name(c.hir.functions[callee as usize].name))?;
                appendText(mut why, "' is not '@constant'")?;
                var message = Vector<u8>.create();
                appendBytes(mut message, why.view())?;
                appendText(mut message, ": not a static initialiser (type-system.md §39.4)")?;
                c.error(notStaticInitializer(), span.start, span.end, message)?;
                return c.errorResult(span.start, span.end);
            }
            if (c.front.ast.functions[calleeSyntax as usize].isExtern) {
                // `here` is the address of the place the macro's result initialises, so it must point to that type.
                let result = c.hir.functions[callee as usize].returnType;
                for (k in 0..arguments.count) {
                    let argument = c.hir.at(arguments, k);
                    let isHere = match (c.hir.exprs[argument as usize]) {
                        HirExpr.Here => true,
                        _ => false,
                    };
                    let pointee = c.types.info(c.hir.exprTypes[argument as usize]).pointee;
                    if (isHere && pointee != result) {
                        let hereSpan = c.hir.exprSpans[argument as usize];
                        var message = Vector<u8>.create();
                        appendText(mut message, "'here' is the address of the ")?;
                        appendQuotedType(mut message, c, result)?;
                        appendText(mut message, " that '")?;
                        appendBytes(mut message, c.name(c.hir.functions[callee as usize].name))?;
                        appendText(mut message, "' initialises, not a ")?;
                        appendQuotedType(mut message, c, pointee)?;
                        appendText(mut message, " (type-system.md §39.4)")?;
                        c.error(notStaticInitializer(), hereSpan.start, hereSpan.end, message)?;
                        return c.errorResult(span.start, span.end);
                    }
                }
                var values = Vector<u32>.create();
                var failed = false;
                for (k in 0..arguments.count) {
                    let argument = c.hir.at(arguments, k);
                    let isHere = match (c.hir.exprs[argument as usize]) {
                        HirExpr.Here => true,
                        _ => false,
                    };
                    let value = if (isHere) argument else staticFold(c, argument, bindings, hasBindings, depth + 1)?;
                    if (isErrorExpr(c, value)) {
                        failed = true;
                    }
                    values.push(value)?;
                }
                if (failed) {
                    return c.errorResult(span.start, span.end);
                }
                let list = c.hir.list(values.view())?;
                return rebuilt(c, e, HirExpr.Call(callee, list));
            }
            let body = constantBody(c, callee);
            if (body == none()) {
                return c.errorResult(span.start, span.end); // reported on the function
            }
            var bound = Vector<FoldBinding>.create();
            var failed = false;
            for (k in 0..arguments.count) {
                let argument = c.hir.at(arguments, k);
                let value = staticFold(c, argument, bindings, hasBindings, depth + 1)?;
                if (isErrorExpr(c, value)) {
                    failed = true;
                }
                if ((k as usize) < c.hir.functions[callee as usize].parameters.length) {
                    bound.push(
                        FoldBinding { local: c.hir.functions[callee as usize].parameters[k as usize], value: value },
                    )?;
                }
            }
            if (failed) {
                return c.errorResult(span.start, span.end);
            }
            // When checking a @constant body, its parameters stay symbolic.
            return staticFold(c, body, bound.view(), true, depth + 1);
        }
        HirExpr.Here => { return staticFail(c, e, "'here' is only a C constant macro's argument"); }
        HirExpr.EnumValue(_, _) => { return staticFail(c, e, "an enum value"); }
        HirExpr.Closure(_, _) => { return staticFail(c, e, "a closure"); }
        HirExpr.Deref(_) => { return staticFail(c, e, "a variable"); }
        _ => { return staticFail(c, e, "this expression"); }
    }
}

/// An operator applied to folded operands (Operators, §39.4): folded too when every operand is a constant, else left
/// as it is, its operands being a `@constant` function's parameters while its body is checked.
fn operators(c: borrow mut Checker, e: u32) -> Result<u32, AllocError> {
    var operands = Vector<u32>.create();
    match (c.hir.exprs[e as usize]) {
        HirExpr.Unary(_, operand) => { operands.push(operand)?; }
        HirExpr.Binary(_, left, right) => {
            operands.push(left)?;
            operands.push(right)?;
        }
        HirExpr.Truncate(operand) => { operands.push(operand)?; }
        HirExpr.Cast(operand) => { operands.push(operand)?; }
        _ => {}
    }
    var allConstant = true;
    for (o in operands.view()) {
        if (isErrorExpr(c, o)) {
            let span = c.hir.exprSpans[e as usize];
            return c.errorResult(span.start, span.end);
        }
        if (!isConstantValue(c, o)) {
            allConstant = false;
        }
    }
    return if (allConstant) fold(c, e) else Ok(e);
}

/// `here` (IsHere, §39.4; ADR 0027): a name, not a keyword, so a variable or item called `here` hides it.
fn isHere(c: borrow mut Checker, e: u32) -> Result<bool, AllocError> {
    let name = match (c.front.ast.exprs[e as usize]) {
        ExprNode.Name(n, typeArguments) => if (typeArguments.count == 0) n else none(),
        _ => none(),
    };
    if (name == none() || !inStaticConstruction(c)) {
        return Ok(false);
    }
    let symbol = c.front.ast.idents[name as usize].symbol;
    if (!sameText(c.name(symbol), "here")) {
        return Ok(false);
    }
    return match (c.lookup(symbol)?) {
        Entity.None => Ok(true),
        _ => Ok(false),
    };
}

/// `here`, typed by the C constant macro parameter it is given to (CheckHere); StaticFold checks that it is one.
fn checkHere(c: borrow mut Checker, expected: u32, span: Span) -> Result<u32, AllocError> {
    if (expected != none() && c.types.is(expected, TypeKind.RawPointer) && c.types.info(expected).mutablePointer) {
        let pointee = c.types.info(expected).pointee;
        if (!c.types.is(pointee, TypeKind.Void) && !c.types.is(pointee, TypeKind.CChar)) {
            return c.expr(HirExpr.Here, expected, span.start, span.end);
        }
    }
    var message = Vector<u8>.create();
    appendText(
        mut message,
        "'here' is the address of the place a C constant macro initialises: pass it as the macro's '*mut T' argument (type-system.md §39.4)",
    )?;
    c.error(notStaticInitializer(), span.start, span.end, message)?;
    return c.errorResult(span.start, span.end);
}

// ---- layoutOf (§30.1) ----

/// Can TypeTable.layoutOf lay the type out (HasLayout)? Not if any part of it is an error (already reported).
fn hasLayout(c: borrow Checker, typ: u32, depth: u32) -> Result<bool, AllocError> {
    if (depth > 64 || c.types.isGeneric(typ) || c.types.isCLaidOut(typ, 0)) {
        return Ok(false);
    }
    var flat = Vector<u32>.create();
    var fields = Vector<u32>.create();
    flatten(c, typ, none(), mut flat, mut fields)?;
    for (inner in flat.view()) {
        if (c.types.is(inner, TypeKind.Error)) {
            return Ok(false);
        }
        let t = c.types.info(inner);
        if (t.structDef != none() && c.types.structs[t.structDef as usize].isRecursive) {
            return Ok(false);
        }
        if (t.enumDef != none() && c.types.enums[t.enumDef as usize].isRecursive) {
            return Ok(false);
        }
        var contained = Vector<u32>.create();
        var containedFields = Vector<u32>.create();
        containedTypes(c, inner, mut contained, mut containedFields)?;
        for (part in contained.view()) {
            if (!hasLayout(c, part, depth + 1)?) {
                return Ok(false);
            }
        }
    }
    return Ok(true);
}

/// `layoutOf<T>()` (CheckLayoutOf, §30.1): lib/core's `Layout { size, align }` of `T`.
fn checkLayoutOf(c: borrow mut Checker, typeArguments: Range, arguments: Range, span: Span) -> Result<u32, AllocError> {
    if (typeArguments.count != 1 || arguments.count != 0) {
        var message = Vector<u8>.create();
        appendText(mut message, "layoutOf takes one type argument and no arguments: layoutOf<T>()")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let typeSyntax = c.front.ast.at(typeArguments, 0);
    c.allowImported = true;
    let measured = c.resolveType(typeSyntax, false)?;
    let layoutSymbol = c.intern("Layout")?;
    let layout = match (foundEntity(c.coreItems, Word { value: layoutSymbol as u64 })) {
        Entity.Struct(index) => c.structs[index as usize].typ,
        _ => none(),
    };
    if (layout == none() || c.types.isBottom(measured)) {
        return c.errorResult(span.start, span.end);
    }
    if (c.types.isUnsized(measured)) {
        let typeSpan = c.front.ast.typeSpans[typeSyntax as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "layoutOf needs a type with a size, and ")?;
        appendQuotedType(mut message, c, measured)?;
        appendText(mut message, " is not one (type-system.md §30.1)")?;
        c.error(invalidOperandTypes(), typeSpan.start, typeSpan.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let usize = c.types.usize;
    if (c.types.isGeneric(measured)) {
        return layoutLiteral(c, layout, 0, 1, span); // a generic version is never lowered (§20.3)
    }
    if (c.types.isCLaidOut(measured, 0)) {
        // The measured type rides on a null pointer to it, so every pass sees an ordinary built-in call.
        let zero = c.expr(HirExpr.IntConst(IntValue { negative: false, magnitude: 0 }), usize, span.start, span.end)?;
        let pointer = c.types.pointerTo(measured, false)?;
        let cast = c.expr(HirExpr.Cast(zero), pointer, span.start, span.end)?;
        let values = [cast];
        let list = c.hir.list(values[..])?;
        return c.expr(HirExpr.BuiltinCall(bfLayoutOf(), list), layout, span.start, span.end);
    }
    if (!hasLayout(c, measured, 0)?) {
        return c.errorResult(span.start, span.end); // reported where the type is declared
    }
    let sizeAlign = c.types.layoutOf(measured);
    return layoutLiteral(c, layout, truncate<u64>(sizeAlign.size), sizeAlign.align as u64, span);
}

/// `offsetOf<T>(field)` (CheckOffsetOf, §30.1; ADR 0030): a field's offset in bytes, as `usize`; for a C-laid-out `T`
/// a built-in C writes as `offsetof`. One deliberate divergence: the reference reads the field's offset without laying
/// the struct out first, so it is 0 unless something had already asked for the layout (novac 0.6.0); ceesafec lays it
/// out and gives the true offset (docs/p3-plan.md).
fn checkOffsetOf(c: borrow mut Checker, typeArguments: Range, arguments: Range, span: Span) -> Result<u32, AllocError> {
    var fieldName = none();
    var fieldSpan = span;
    if (arguments.count == 1) {
        let argument = c.front.ast.at(arguments, 0);
        match (c.front.ast.exprs[argument as usize]) {
            ExprNode.Name(n, t) => {
                if (t.count == 0) {
                    fieldName = n;
                    fieldSpan = c.front.ast.exprSpans[argument as usize];
                }
            }
            _ => {}
        }
    }
    if (typeArguments.count != 1 || fieldName == none()) {
        var message = Vector<u8>.create();
        appendText(mut message, "offsetOf takes one type argument and a field's name: offsetOf<T>(field)")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    let typeSyntax = c.front.ast.at(typeArguments, 0);
    c.allowImported = true;
    let measured = c.resolveType(typeSyntax, false)?;
    if (c.types.isBottom(measured)) {
        return c.errorResult(span.start, span.end);
    }
    let usize = c.types.usize;
    if (!c.types.is(measured, TypeKind.Struct)) {
        let typeSpan = c.front.ast.typeSpans[typeSyntax as usize];
        var message = Vector<u8>.create();
        appendText(mut message, "offsetOf needs a struct type, and ")?;
        appendQuotedType(mut message, c, measured)?;
        appendText(mut message, " is not one (type-system.md §30.1)")?;
        c.error(offsetOfField(), typeSpan.start, typeSpan.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (c.types.isGeneric(measured)) {
        return c.expr(HirExpr.IntConst(IntValue { negative: false, magnitude: 0 }), usize, span.start, span.end);
    }
    let definition = c.types.info(measured).structDef;
    let symbol = c.front.ast.idents[fieldName as usize].symbol;
    let member = findField(c, definition, symbol);
    if (member == none()) {
        var message = Vector<u8>.create();
        appendQuotedType(mut message, c, measured)?;
        appendText(mut message, " has no field ")?;
        appendQuotedName(mut message, c, symbol)?;
        appendText(mut message, " (type-system.md §30.1)")?;
        c.error(offsetOfField(), fieldSpan.start, fieldSpan.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    if (c.types.isCLaidOut(measured, 0)) {
        // As layoutOf: the type rides on a null pointer to it, and the field on its index.
        let zero = c.expr(HirExpr.IntConst(IntValue { negative: false, magnitude: 0 }), usize, span.start, span.end)?;
        let pointer = c.types.pointerTo(measured, false)?;
        let cast = c.expr(HirExpr.Cast(zero), pointer, span.start, span.end)?;
        let index = c.types.fields[member as usize].index as u64;
        let indexValue = c.expr(
            HirExpr.IntConst(IntValue { negative: false, magnitude: index }),
            usize,
            span.start,
            span.end,
        )?;
        let values = [cast, indexValue];
        let list = c.hir.list(values[..])?;
        return c.expr(HirExpr.BuiltinCall(bfOffsetOf(), list), usize, span.start, span.end);
    }
    if (!hasLayout(c, measured, 0)?) {
        return c.errorResult(span.start, span.end); // reported where the type is declared
    }
    c.types.layoutOf(measured); // lays the struct out, which sets its fields' offsets
    let offset = c.types.fields[member as usize].offset as u64;
    return c.expr(HirExpr.IntConst(IntValue { negative: false, magnitude: offset }), usize, span.start, span.end);
}

/// `callerAddress()` (CheckCallerAddress, §28.4; ADR 0030): in the body of an `@export` function, the address its C
/// caller returns to, as `usize`.
fn checkCallerAddress(
    c: borrow mut Checker,
    typeArguments: Range,
    arguments: Range,
    span: Span,
) -> Result<u32, AllocError> {
    if (typeArguments.count != 0 || arguments.count != 0) {
        var message = Vector<u8>.create();
        appendText(mut message, "callerAddress takes no arguments: callerAddress()")?;
        c.error(argumentCount(), span.start, span.end, message)?;
        checkArgumentsLoosely(c, arguments)?;
        return c.errorResult(span.start, span.end);
    }
    let function = c.function;
    if (function == none() || !c.hir.functions[function as usize].exported) {
        var message = Vector<u8>.create();
        appendText(
            mut message,
            "callerAddress() is only valid in the body of an @export function, whose C caller it names (ADR 0030)",
        )?;
        c.error(callerAddressOutsideExport(), span.start, span.end, message)?;
        return c.errorResult(span.start, span.end);
    }
    c.hir.functions[function as usize].usesCallerAddress = true;
    let none0 = Vector<u32>.create();
    let list = c.hir.list(none0.view())?;
    let usize = c.types.usize;
    return c.expr(HirExpr.BuiltinCall(bfCallerAddress(), list), usize, span.start, span.end);
}

fn offsetOfField() -> u32 => 339;
fn callerAddressOutsideExport() -> u32 => 340;

fn layoutLiteral(c: borrow mut Checker, layout: u32, size: u64, align: u64, span: Span) -> Result<u32, AllocError> {
    let definition = c.types.info(layout).structDef;
    let sizeSymbol = c.intern("size")?;
    let alignSymbol = c.intern("align")?;
    let usize = c.types.usize;
    let sizeValue = c.expr(
        HirExpr.IntConst(IntValue { negative: false, magnitude: size }),
        usize,
        span.start,
        span.end,
    )?;
    let alignValue = c.expr(
        HirExpr.IntConst(IntValue { negative: false, magnitude: align }),
        usize,
        span.start,
        span.end,
    )?;
    let start = truncate<u32>(c.hir.fieldValues.length);
    c.hir.fieldValues.push(HirFieldValue { field: findField(c, definition, sizeSymbol), value: sizeValue })?;
    c.hir.fieldValues.push(HirFieldValue { field: findField(c, definition, alignSymbol), value: alignValue })?;
    return c.expr(HirExpr.StructLiteral(Range { start: start, count: 2 }), layout, span.start, span.end);
}

// ---- The freestanding profile (cosmoos/profiles.md §4.1) ----

/// A type that needs the hosted runtime (IsHostedOnly): a heap allocator, or anything allocating from one; I/O.
fn isHostedOnlyType(c: borrow Checker, typ: u32) -> bool {
    let t = c.types.info(typ);
    if (c.types.is(typ, TypeKind.Box) && (isPoolBox(c, typ) || isAllocatorType(c, t.allocator))) {
        return true;
    }
    if (c.types.is(
        typ,
        TypeKind.Vector,
    ) || c.types.is(typ, TypeKind.StableVector) || c.types.is(typ, TypeKind.SlotMap) ||
        c.types.is(typ, TypeKind.Resource) || c.types.is(typ, TypeKind.Thread)) {
        return true;
    }
    let region = regionIndex(t.region);
    return region == 1 || region == 4 || region == 3 || isAllocatorType(c, typ) || typ == c.ioErrorType;
}

/// Built-in names whose every use needs the hosted runtime (IsHostedOnly(Builtin)).
fn isHostedOnlyBuiltin(b: u32) -> bool =>
    !(b == builtinTruncate() ||
        b == builtinFixedBufferAllocator() || b == builtinPtr() || b == builtinSlice() || b == builtinSliceMut() ||
        b == builtinStringView() || b == builtinCpu() || b == builtinTarget());

/// N0293 once per place (HostedOnly): `what` is not available in the freestanding profile.
fn hostedOnly(c: borrow mut Checker, span: Span, what: Slice<u8>) -> Result<void, AllocError> {
    for (r in c.profileReports.view()) {
        if (r.file == c.file && r.start == span.start && r.end == span.end) {
            return Ok();
        }
    }
    let file = c.file;
    c.profileReports.push(LayoutUse { typ: 0, start: span.start, end: span.end, file: file })?;
    var message = Vector<u8>.create();
    appendBytes(mut message, what)?;
    appendText(
        mut message,
        " needs the hosted runtime and is not available with --profile freestanding (cosmoos/profiles.md §4.1)",
    )?;
    return c.error(hostedOnlyCode(), span.start, span.end, message);
}

/// `Box.create`, `Vector<T>.create`, `Console.write`, … in the freestanding profile (Synth's first case): N0293, and
/// true. A user allocator needs no runtime (§30.3), and neither do raw box conversions (§34.2).
fn hostedOnlyCall(c: borrow mut Checker, e: u32) -> Result<bool, AllocError> {
    var callee = none();
    var arguments = emptyRange();
    match (c.front.ast.exprs[e as usize]) {
        ExprNode.Call(f, a) => {
            callee = f;
            arguments = a;
        }
        _ => { return Ok(false); }
    }
    var target = none();
    var member = none();
    match (c.front.ast.exprs[callee as usize]) {
        ExprNode.Member(t, m) => {
            target = t;
            member = m;
        }
        _ => { return Ok(false); }
    }
    let name = match (c.front.ast.exprs[target as usize]) {
        ExprNode.Name(n, _) => n,
        _ => none(),
    };
    if (name == none()) {
        return Ok(false);
    }
    let symbol = c.front.ast.idents[name as usize].symbol;
    let builtin = match (c.lookup(symbol)?) {
        Entity.Builtin(b) => b,
        _ => none(),
    };
    if (builtin == none() || !isHostedOnlyBuiltin(builtin)) {
        return Ok(false);
    }
    let memberName = c.name(c.front.ast.idents[member as usize].symbol);
    if (builtin == builtinBox() && (sameText(memberName, "createIn") || sameText(memberName, "intoRaw") ||
        sameText(memberName, "fromRaw"))) {
        return Ok(false);
    }
    let nameSpan = c.front.ast.exprSpans[target as usize]; // the name with its type arguments
    var what = Vector<u8>.create();
    appendText(mut what, "'")?;
    appendBytes(mut what, c.name(symbol))?;
    appendText(mut what, "'")?;
    hostedOnly(c, nameSpan, what.view())?;
    checkArgumentsLoosely(c, arguments)?;
    return Ok(true);
}
