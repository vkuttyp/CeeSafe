    7 => "Invalid char literal: empty, more than one character, or unterminated",
    8 => "Invalid digit for the radix, or no digits after a radix prefix",
    9 => "Unknown literal suffix",
    10 => "Misplaced digit separator `_` (must sit between two digits)",
    100 => "Expected a specific token",
    101 => "Expected an item (`fn` or `const`) at the top level",
    102 => "Expected an expression",
    103 => "Comparison operators chained",
    104 => "Invalid assignment target",
    105 => "Expected a type",
    106 => "Namespace declaration not first in the file",
    107 => "Expected a field or `fn` inside a struct body",
    108 => "Expected a `match` pattern (`_`, a literal, or `E.V(…)`)",
    109 => "An `import` declaration after an item",
    110 =>
        "Nested more than 1,000 levels deep (grammar.md §2.2: blocks, statements, types, patterns, unary operands, and each link of an operator, call or member chain). The rest of the file is not parsed",
    200 => "Name not found (variable, function, or built-in member)",
    201 => "Item defined twice in the package",
    202 => "Parameter declared twice",
    203 => "Local redeclares a local or parameter in scope (no shadowing of locals)",
    204 => "Unknown type name",
