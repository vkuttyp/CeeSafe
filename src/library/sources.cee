 desired: u32, order: i32) -> u32;\n    @effects()\n    fn ceesafe_atomic_add_ord_u32(p: *mut u32, v: u32, order: i32) -> u32;\n}\n\n/// The ordering of an atomic load (ADR 0021): C11's memory_order_relaxed, _acquire and _seq_cst.\npublic enum LoadOrdering { Relaxed, Acquire, SequentiallyConsistent }\n\n/// The ordering of an atomic store: C11's memory_order_relaxed, _release and _seq_cst.\npublic enum StoreOrdering { Relaxed, Release, SequentiallyConsistent }\n\n/// The ordering of an atomic read-modify-write (swap, compare-exchange, add, subtract): C11's memory_order_relaxed,\n/// _acquire, _release, _acq_rel and _seq_cst. A compare-exchange that fails orders as a load: AcquireRelease as\n/// Acquire, Release as Relaxed, the others as themselves.\npublic enum Ordering { Relaxed, Acquire, Release, AcquireRelease, SequentiallyConsistent }\n\n// The runtime's codes (ceesafe/rt.h): 0 relaxed, 1 acquire, 2 release, 3 acquire-release, 4 sequentially\n// consistent. A load never passes 2 or 3, and a store never 1 or 3, so no ordering C11 leaves undefined is used.\nfn loadCode(order: LoadOrdering) -> i32 => match (order) {\n    LoadOrdering.Relaxed => 0,\n    LoadOrdering.Acquire => 1,\n    LoadOrdering.SequentiallyConsistent => 4,\n};\n\nfn storeCode(order: StoreOrdering) -> i32 => match (order) {\n    StoreOrdering.Relaxed => 0,\n    StoreOrdering.Release => 2,\n    StoreOrdering.SequentiallyConsistent => 4,\n};\n\nfn code(order: Ordering) -> i32 => match (order) {\n    Ordering.Relaxed => 0,\n    Ordering.Acquire => 1,\n    Ordering.Release => 2,\n    Ordering.AcquireRelease => 3,\n    Ordering.SequentiallyConsistent => 4,\n};\n\n/// A u64 that threads may read and change at once: every operation is atomic and sequentially consistent.\n@threadSafe\n@noncopy\npublic struct AtomicU64 {\n    private value: u64;\n\n    /// A new atomic holding `value`.\n    public fn create(value: u64) -> AtomicU64 => AtomicU64 { value: value };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4): `static N: AtomicU64 = AtomicU64.constant(0);`.\n    @constan",
    3 =>
        "t\n    public fn constant(value: u64) -> AtomicU64 => AtomicU64 { value: value };\n\n    /// Safety: the runtime accesses `value` only atomically, and safe code reaches it only through these methods.\n    public fn load(borrow this) -> u64 => unsafe { ceesafe_atomic_load_u64(this.cell()) };\n\n    /// Safety: as load.\n    public fn store(borrow this, value: u64) { unsafe { ceesafe_atomic_store_u64(this.cell(), value); } }\n\n    /// Safety: as load.\n    public fn swap(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_swap_u64(this.cell(), value) };\n\n    /// Ok(the old value) if it was `expected` and is now `desired`; else Err(the value it has).\n    /// Safety: as load.\n    public fn compareExchange(borrow this, expected: u64, desired: u64) -> Result<u64, u64> {\n        let old = unsafe { ceesafe_atomic_cas_u64(this.cell(), expected, desired) };\n        if (old == expected) {\n            return Ok(old);\n        }\n        return Err(old);\n    }\n\n    /// Adds, wrapping; returns the old value.\n    /// Safety: as load.\n    public fn fetchAdd(borrow this, value: u64) -> u64 => unsafe { ceesafe_atomic_add_u64(this.cell(), value) };\n\n    /// Subtracts, wrapping; returns the old value.\n    /// Safety: as load.\n    public fn fetchSub(borrow this, value: u64) -> u64 =>\n        unsafe { ceesafe_atomic_add_u64(this.cell(), 0u64.wrappingSub(value)) };\n\n    /// load, with an ordering (ADR 0021).\n    /// Safety: as load.\n    public fn loadWith(borrow this, order: LoadOrdering) -> u64 =>\n        unsafe { ceesafe_atomic_load_ord_u64(this.cell(), loadCode(order)) };\n\n    /// store, with an ordering.\n    /// Safety: as load.\n    public fn storeWith(borrow this, value: u64, order: StoreOrdering) {\n        unsafe { ceesafe_atomic_store_ord_u64(this.cell(), value, storeCode(order)); }\n    }\n\n    /// swap, with an ordering.\n    /// Safety: as load.\n    public fn swapWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_swap_ord_u64(this.cell(), value, code(order)) };\n\n    /// compareExchange, with an ordering; a failure orders as Ordering says.\n    /// Safety: as load.\n    public fn compareExchangeWith(borrow this, expected: u64, desired: u64, order: Ordering) -> Result<u64, u64> {\n        let old = unsafe { ceesafe_atomic_cas_ord_u64(this.cell(), expected, desired, code(order)) };\n        if (old == expected) {\n            return Ok(old);\n        }\n        return Err(old);\n    }\n\n    /// fetchAdd, with an ordering.\n    /// Safety: as load.\n    public fn fetchAddWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_add_ord_u64(this.cell(), value, code(order)) };\n\n    /// fetchSub, with an ordering.\n    /// Safety: as load.\n    public fn fetchSubWith(borrow this, value: u64, order: Ordering) -> u64 =>\n        unsafe { ceesafe_atomic_add_ord_u64(this.cell(), 0u64.wrappingSub(value), code(order)) };\n\n    fn cell(borrow this) -> *mut u64 => borrow this.value as *u64 as *mut u64;\n}\n\n/// A u32 that threads may read and change at once, as AtomicU64.\n@threadSafe\n@noncopy\npublic struct AtomicU32 {\n    private value: u32;\n\n    /// A new atomic holding `value`.\n    public fn create(value: u32) -> AtomicU32 => AtomicU32 { value: value };\n\n    /// The same as create, in a static's initialiser (type-system.md §39.4): `static N: AtomicU32 = AtomicU32.constant(0);`.\n    @constant\n    public fn constant(value: u32) -> AtomicU32 => AtomicU32 { value: value };\n\n    /// Safety: as AtomicU64.load.\n    public fn load(borrow this) -> u32 => unsafe { ceesafe_atomic_load_u32(this.cell()) };\n\n    /// Safety: as AtomicU64.load.\n    public fn store(borrow this, value: u32) { unsafe { ceesafe_atomic_store_u32(this.cell(), value); } }\n\n    /// Safety: as AtomicU64.load.\n    public fn swap(borrow this, value: u32) -> u32 => unsafe { ceesafe_atomic_swap_u32(this.cell(), value) };\n\n    /// Safety: as AtomicU64.load.\n    public fn compareExchange(borrow this, expected: u32, desired: u32) -> Result<u32, u32> {\n   ",
