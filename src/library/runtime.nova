        "/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */\n/*\n * Threads and mutexes for the hosted profile (type-system.md §38, ADR 0016; the atomics are in nova/rt.h): POSIX threads, Win32 on Windows,\n * or CosmoOS userland's cosmo_thread_* and cosmo_mutex_* (NV_COSMOOS, set by integrations/cosmoos). Linked only into\n * programs that use them (c-backend.md §6). Thread and mutex memory comes from nova_alloc,\n * so the fault-injection sweep reaches it.\n */\n#include \"nova/rt.h\"\n\n#if defined(NV_COSMOOS)\n#include <cosmo/thread.h>\n#elif defined(_WIN32)\n#define WIN32_LEAN_AND_MEAN\n#include <windows.h>\n#else\n#include <pthread.h>\n#endif\n\nstruct nv_thread {\n#if defined(NV_COSMOOS)\n    cosmo_thread_t thread;\n#elif defined(_WIN32)\n    HANDLE handle;\n#else\n    pthread_t thread;\n#endif\n    void *(*body)(void *);\n    void *arg;\n};\n\n#if defined(_WIN32) && !defined(NV_COSMOOS)\nstatic DWORD WINAPI nova_thread_entry(LPVOID p) {\n    nv_thread *t = (nv_thread *)p;\n    (void)t->body(t->arg);\n    return 0;\n}\n#endif\n\nnv_thread *nova_thread_start(void *(*body)(void *), void *arg) {\n    nv_thread *t = (nv_thread *)nova_alloc(sizeof *t, NV_ALLOC_SYSTEM);\n    if (t == NULL) {\n        return NULL;\n    }\n    t->body = body;\n    t->arg = arg;\n#if defined(NV_COSMOOS)\n    if (cosmo_thread_start(&t->thread, body, arg, 0) != 0) {\n        nova_free(t, NV_ALLOC_SYSTEM);\n        return NULL;\n    }\n#elif defined(_WIN32)\n    t->handle = CreateThread(NULL, 0, nova_thread_entry, t, 0, NULL);\n    if (t->handle == NULL) {\n        nova_free(t, NV_ALLOC_SYSTEM);\n        return NULL;\n    }\n#else\n    if (pthread_create(&t->thread, NULL, body, arg) != 0) {\n        nova_free(t, NV_ALLOC_SYSTEM);\n        return NULL;\n    }\n#endif\n    return t;\n}\n\nvoid nova_thread_join(nv_thread *t) {\n#if defined(NV_COSMOOS)\n    (void)cosmo_thread_join(&t->thread, NULL);\n#elif defined(_WIN32)\n    (void)WaitForSingleObject(t->handle, INFINI