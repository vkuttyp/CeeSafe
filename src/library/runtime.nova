    21 =>
        "/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */\n/*\n * Nova runtime platform layer for hosted C environments (Linux, macOS, CosmoOS userland libc).\n * Uses only standard C library functions; Windows (MSVC, best effort) also uses its C runtime's\n * binary-mode and _exit calls (docs/c-backend.md §1.1).\n */\n#if defined(_WIN32) && !defined(_CRT_SECURE_NO_WARNINGS)\n#define _CRT_SECURE_NO_WARNINGS /* getenv is not deprecated in standard C */\n#endif\n#include \"nova/rt.h\"\n\n#include <stdio.h>\n#include <stdlib.h>\n#ifdef _WIN32\n#include <fcntl.h>\n#include <io.h>\n#endif\n\n/* Windows translates \"\\n\" to \"\\r\\n\" in text mode: Nova's output is bytes, so both streams become binary. */\nstatic void nova_binary_streams(void) {\n#ifdef _WIN32\n    static bool done;\n    if (!done) {\n        done = true;\n        (void)_setmode(_fileno(stdout), _O_BINARY);\n        (void)_setmode(_fileno(stderr), _O_BINARY);\n    }\n#endif\n}\n\nvoid nova_platform_write_stdout(const uint8_t *bytes, size_t length) {\n    nova_binary_streams();\n    (void)fwrite(bytes, 1u, length, stdout);\n}\n\nvoid nova_platform_write_stderr(const uint8_t *bytes, size_t length) {\n    nova_binary_streams();\n    /* Flush stdout first so output printed before a panic appears before the message. */\n    (void)fflush(stdout);\n    (void)fwrite(bytes, 1u, length, stderr);\n}\n\n_Noreturn void nova_platform_exit(int32_t code) {\n    exit((int)code); /* flushes stdio */\n}\n\n_Noreturn void nova_platform_abort(void) {\n    (void)fflush(stdout);\n    (void)fflush(stderr);\n#ifdef _WIN32\n    _exit(134); /* the status abort() gives on Linux and macOS (128 + SIGABRT); Windows' abort() gives 3 */\n#else\n    abort();\n#endif\n}\n\nvoid *nova_platform_alloc(size_t size) {\n    return malloc(size); /* aligned for max_align_t */\n}\n\nvoid *nova_platform_realloc(void *p, size_t size) {\n    return realloc(p, size); /* aligned for max_align_t */\n}\n\nvoid nova_platform_free(void *p) {\n    free(p);\n}\n\nuint64_t nova_platform_config(const char *name) {\n    const char *text = getenv(name);\n    if (text == NULL) {\n        return 0u;\n    }\n    uint64_t value = 0u;\n    for (; *text >= '0' && *text <= '9'; text++) {\n        value = value * 10u + (uint64_t)(*text - '0');\n    }\n    return value;\n}\n",
    22 =>
        "/* SPDX-License-Identifier: GPL-2.0-only WITH Classpath-exception-2.0 */\n/*\n * Nova runtime: program arguments, files and TCP sockets (type-system.md §26) for hosted C\n * environments (Linux, macOS) and CosmoOS userland. Only public C library functions (L1, OD-15).\n * Windows (MSVC, best effort; docs/c-backend.md §1.1): files and processes through its C runtime;\n * TCP is not supported there. Host services (type-system.md §26.7-§26.10, ADR 0028) work on all three.\n */\n#if defined(_WIN32) && !defined(_CRT_SECURE_NO_WARNINGS)\n#define _CRT_SECURE_NO_WARNINGS\n#endif\n#include \"nova/rt.h\"\n\n#include <errno.h>\n#include <fcntl.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#ifdef _WIN32\n#include <direct.h>\n#include <io.h>\n#include <process.h>\n#include <sys/stat.h>\n#define WIN32_LEAN_AND_MEAN\n#include <windows.h>\n#else\n#include <dirent.h>\n#include <netinet/in.h>\n#include <spawn.h>\n#include <sys/socket.h>\n#include <sys/stat.h>\n#include <sys/wait.h>\n#include <unistd.h>\n#endif\n\n#if !defined(COSMO_AF_INET) && !defined(_WIN32)\nextern char **environ;\n#endif\n\n/* ---- Program arguments ------------------------------------------------------------------ */\n\nstatic int32_t nova_argc;\nstatic const uint8_t *const *nova_argv;\n\nvoid nova_rt_args(int32_t count, const uint8_t *const *arguments) {\n    nova_argc = count;\n    nova_argv = arguments;\n}\n\nuint64_t nova_arg_count(void) {\n    return nova_argc > 0 ? (uint64_t)nova_argc : 0u;\n}\n\nbool nova_arg(uint64_t index, nv_str *out) {\n    if (index >= nova_arg_count()) return false;\n    const uint8_t *text = nova_argv[index];\n    uint64_t length = 0;\n    while (text[length] != 0) length++;\n    if (!nova_utf8_valid(text, length)) return false;\n    *out = (nv_str){ .ptr = text, .len = length };\n    return true;\n}\n\n/* ---- Errors ----------------------------------------------------------------------------- */\n\nuint32_t nova_io_kind(int32_t error) {\n    switch (error) {\n    case ENOENT: return NV_IO_NOT_FOUND;\n    case EACCES: case EPERM: return NV_IO_PERMISSION_DENIED;\n    case EEXIST: return NV_IO_ALREADY_EXISTS;\n    case EISDIR: return NV_IO_IS_DIRECTORY;\n    case ENOTDIR: return NV_IO_NOT_DIRECTORY;\n    case EINVAL: case ENAMETOOLONG: return NV_IO_INVALID_INPUT;\n    case EPIPE: return NV_IO_BROKEN_PIPE;\n    case ECONNREFUSED: return NV_IO_CONNECTION_REFUSED;\n    case EADDRINUSE: return NV_IO_ADDRESS_IN_USE;\n    case ENOMEM: return NV_IO_OUT_OF_MEMORY;\n    default: return NV_IO_OTHER;\n    }\n}\n\nstatic nv_io_result nova_io_ok(int64_t value) { return (nv_io_result){ .value = value, .error = 0 }; }\n\nstatic nv_io_result nova_io_errno(void) {\n    int32_t error = (int32_t)errno;\n    return (nv_io_result){ .value = 0, .error = error != 0 ? error : EIO };\n}\n\nstatic nv_io_result nova_io_fail(int32_t error) { return (nv_io_result){ .value = 0, .error = error }; }\n\n/* ---- Files ------------------------------------------------------------------------------ */\n\n/* A NUL-terminated copy of `path` in `buffer`; false if it contains a zero byte or is too long. */\nstatic bool nova_c_path(nv_str path, char buffer[4096]) {\n    if (path.len >= 4096u) return false;\n    for (uint64_t i = 0; i < path.len; i++) {\n        if (path.ptr[i] == 0) return false;\n        buffer[i] = (char)path.ptr[i];\n    }\n    buffer[path.len] = 0;\n    return true;\n}\n\nnv_io_result nova_file_open(nv_str path, uint32_t mode) {\n    char name[4096];\n    if (!nova_c_path(path, name)) return nova_io_fail(EINVAL);\n    int fd;\n    do {\n#ifdef _WIN32\n        fd = mode == 0u ? _open(name, _O_RDONLY | _O_BINARY)\n                        : _open(name, _O_WRONLY | _O_CREAT | _O_TRUNC | _O_BINARY, _S_IREAD | _S_IWRITE);\n#else\n        fd = mode == 0u ? open(name, O_RDONLY) : open(name, O_WRONLY | O_CREAT | O_TRUNC, 0644);\n#endif\n    } while (fd < 0 && errno == EINTR);\n    return fd < 0 ? nova_io_errno() : nova_io_ok(fd);\n}\n\nnv_io_result nova_file_remove(nv_str path) {\n    char name[4096];\n    if (!nova_c_path(path, name)) return nova_io_fail(EINVAL);\n#if",
