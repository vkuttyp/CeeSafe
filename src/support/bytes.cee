// Byte-string operations the compiler needs and Nova's library lacks (docs/p1-probes.md §4, N1c). Source text and
// names are bytes; StringView.fromUtf8 (novac 0.4.0) turns checked bytes into text where a String needs them.

/// FNV-1a, 64-bit. Used only to find entries, never to order output.
fn hashBytes(bytes: Slice<u8>) -> u64 {
    var h: u64 = 0xcbf29ce484222325;
    for (b in bytes) {
        h = (h ^ b as u64).wrappingMul(0x100000001b3);
    }
    return h;
}

fn sameBytes(a: Slice<u8>, b: Slice<u8>) -> bool {
    if (a.length != b.length) {
        return false;
    }
    for (i in 0..a.length) {
        if (a[i] != b[i]) {
            return false;
        }
    }
    return true;
}

/// Ordinal comparison, as C#'s StringComparer.Ordinal on ASCII and as a byte-wise compare on UTF-8 (which orders by
/// code point): -1, 0 or 1.
fn compareBytes(a: Slice<u8>, b: Slice<u8>) -> i32 {
    let n = if (a.length < b.length) a.length else b.length;
    for (i in 0..n) {
        if (a[i] != b[i]) {
            return if (a[i] < b[i]) -1 else 1;
        }
    }
    return if (a.length < b.length) -1 else if (a.length > b.length) 1 else 0;
}

fn sameText(a: Slice<u8>, b: StringView) -> bool => sameBytes(a, b.bytes());

fn appendBytes(target: borrow mut Vector<u8>, bytes: Slice<u8>) -> Result<void, AllocError> {
    for (b in bytes) {
        target.push(b)?;
    }
    return Ok();
}

fn appendText(target: borrow mut Vector<u8>, text: StringView) -> Result<void, AllocError> => appendBytes(
    target,
    text.bytes(),
);

/// A new vector holding a copy of `bytes`.
fn copyBytes(bytes: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var result = Vector<u8>.create();
    appendBytes(mut result, bytes)?;
    return Ok(result);
}

/// Appends `value` in decimal.
fn appendDecimal(target: borrow mut Vector<u8>, value: u64) -> Result<void, AllocError> {
    var buffer = [0u8; 20];
    var n: usize = 0;
    var v = value;
    loop {
        buffer[n] = '0' + truncate<u8>(v % 10);
        n += 1;
        v /= 10;
        if (v == 0) {
            break;
        }
    }
    while (n > 0) {
        n -= 1;
        target.push(buffer[n])?;
    }
    return Ok();
}

/// Appends `value` in uppercase hexadecimal with at least `width` digits (.NET's "X4" for width 4).
fn appendHex(target: borrow mut Vector<u8>, value: u64, width: usize) -> Result<void, AllocError> {
    var buffer = [0u8; 16];
    var n: usize = 0;
    var v = value;
    while (v != 0 || n < width) {
        let d = truncate<u8>(v % 16);
        buffer[n] = if (d < 10) '0' + d else 'A' + (d - 10);
        n += 1;
        v /= 16;
        if (n == 16) {
            break;
        }
    }
    while (n > 0) {
        n -= 1;
        target.push(buffer[n])?;
    }
    return Ok();
}

/// Appends the UTF-8 encoding of a Unicode scalar value (a surrogate or a value above U+10FFFF becomes U+FFFD).
fn appendUtf8(target: borrow mut Vector<u8>, scalar: u32) -> Result<void, AllocError> {
    let c: u32 = if (scalar > 0x10FFFF || (scalar >= 0xD800 && scalar <= 0xDFFF)) 0xFFFD else scalar;
    if (c < 0x80) {
        target.push(truncate<u8>(c))?;
    } else if (c < 0x800) {
        target.push(truncate<u8>(0xC0 | (c >> 6)))?;
        target.push(truncate<u8>(0x80 | (c & 0x3F)))?;
    } else if (c < 0x10000) {
        target.push(truncate<u8>(0xE0 | (c >> 12)))?;
        target.push(truncate<u8>(0x80 | ((c >> 6) & 0x3F)))?;
        target.push(truncate<u8>(0x80 | (c & 0x3F)))?;
    } else {
        target.push(truncate<u8>(0xF0 | (c >> 18)))?;
        target.push(truncate<u8>(0x80 | ((c >> 12) & 0x3F)))?;
        target.push(truncate<u8>(0x80 | ((c >> 6) & 0x3F)))?;
        target.push(truncate<u8>(0x80 | (c & 0x3F)))?;
    }
    return Ok();
}
