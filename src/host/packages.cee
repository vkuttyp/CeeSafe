// Package mode for `check` (the reference's Manifest, Workspace.Resolve without fetching, and Program.LoadPackage):
// P3 S8b (tooling.md §4). Only what checking a package needs: the nearest `nova.toml`, its `[package]` name, `sources`,
// `profile`, `float`, `kernel` and `trusted`, and path dependencies, resolved breadth first. The full manifest, its
// errors, git and registry dependencies and the lock's contents are P8; a lock must exist, as novac requires.

/// One `key = value` of a manifest, flattened: `[table]`, `key`, and for an inline table the inner key.
struct TomlEntry {
    table: Vector<u8>;
    key: Vector<u8>;
    inner: Vector<u8>; // empty unless the value is an inline table's
    isString: bool;
    isBool: bool;
    boolValue: bool;
    text: Vector<u8>;            // a string's value
    strings: Vector<Vector<u8>>; // an array of strings
    isArray: bool;
}

/// A path dependency: its name, and its directory relative to the dependent's.
struct PathDependency {
    name: Vector<u8>;
    path: Vector<u8>;
}

/// What package mode reads from one manifest.
struct PackageManifest {
    name: Vector<u8>;
    directory: Vector<u8>; // absolute
    sources: Vector<Vector<u8>>;
    dependencies: Vector<PathDependency>;
    freestanding: bool;
    floatAllowed: bool;
    kernel: bool;
    trusted: bool;
    object: bool;               // kind = "object": `build` makes a relocatable object (cosmoos/profiles.md §4.3)
    cFiles: Vector<Vector<u8>>; // `c = [...]`, relative to the package (type-system.md §28.6)
}

/// A package of the build: its manifest and its Nova files (absolute paths), in the reference's order.
struct LoadedPackage {
    manifest: PackageManifest;
    files: Vector<Vector<u8>>;
}

fn isTomlSpace(b: u8) -> bool => b == ' ' || b == '\t' || b == '\r';

fn isBareKeyByte(b: u8) -> bool =>
    (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_' || b == '-';

/// A small TOML reader: tables, bare keys, strings, booleans, arrays of strings, inline tables of strings (what
/// manifests use). Returns an error text for anything else.
fn parseToml(
    text: Slice<u8>,
    out: borrow mut Vector<TomlEntry>,
    problem: borrow mut Vector<u8>,
) -> Result<bool, AllocError> {
    var table = Vector<u8>.create();
    var pos: usize = 0;
    while (pos < text.length) {
        while (pos < text.length && (isTomlSpace(text[pos]) || text[pos] == '\n')) {
            pos += 1;
        }
        if (pos >= text.length) {
            break;
        }
        if (text[pos] == '#') {
            while (pos < text.length && text[pos] != '\n') {
                pos += 1;
            }
            continue;
        }
        if (text[pos] == '[') {
            pos += 1;
            if (pos < text.length && text[pos] == '[') {
                appendText(problem, "arrays of tables are not read by ceesafec yet (ROADMAP P8)")?;
                return Ok(false);
            }
            table = Vector<u8>.create();
            while (pos < text.length && text[pos] != ']' && text[pos] != '\n') {
                if (!isTomlSpace(text[pos])) {
                    table.push(text[pos])?;
                }
                pos += 1;
            }
            if (pos >= text.length || text[pos] != ']') {
                appendText(problem, "a table header needs ']'")?;
                return Ok(false);
            }
            pos += 1;
            continue;
        }
        var key = Vector<u8>.create();
        if (!readKey(text, mut pos, mut key)) {
            appendText(problem, "expected a key")?;
            return Ok(false);
        }
        skipSpaces(text, mut pos);
        if (pos >= text.length || text[pos] != '=') {
            appendText(problem, "expected '=' after a key")?;
            return Ok(false);
        }
        pos += 1;
        skipSpaces(text, mut pos);
        if (pos < text.length && text[pos] == '{') {
            pos += 1;
            loop {
                skipSpaces(text, mut pos);
                if (pos < text.length && text[pos] == '}') {
                    pos += 1;
                    break;
                }
                var inner = Vector<u8>.create();
                if (!readKey(text, mut pos, mut inner)) {
                    appendText(problem, "expected a key in an inline table")?;
                    return Ok(false);
                }
                skipSpaces(text, mut pos);
                if (pos >= text.length || text[pos] != '=') {
                    appendText(problem, "expected '=' in an inline table")?;
                    return Ok(false);
                }
                pos += 1;
                skipSpaces(text, mut pos);
                var entry = newEntry(table.view(), key.view())?;
                entry.inner = inner;
                if (!readValue(text, mut pos, mut entry, problem)?) {
                    return Ok(false);
                }
                out.push(entry)?;
                skipSpaces(text, mut pos);
                if (pos < text.length && text[pos] == ',') {
                    pos += 1;
                }
            }
        } else {
            var entry = newEntry(table.view(), key.view())?;
            if (!readValue(text, mut pos, mut entry, problem)?) {
                return Ok(false);
            }
            out.push(entry)?;
        }
        skipSpaces(text, mut pos);
        if (pos < text.length && text[pos] == '#') {
            while (pos < text.length && text[pos] != '\n') {
                pos += 1;
            }
        }
        if (pos < text.length && text[pos] != '\n') {
            appendText(problem, "expected the end of the line after a value")?;
            return Ok(false);
        }
    }
    return Ok(true);
}

fn newEntry(table: Slice<u8>, key: Slice<u8>) -> Result<TomlEntry, AllocError> =>
    Ok(
        TomlEntry {
            table: copyBytes(table)?,
            key: copyBytes(key)?,
            inner: Vector<u8>.create(),
            isString: false,
            isBool: false,
            boolValue: false,
            text: Vector<u8>.create(),
            strings: Vector<Vector<u8>>.create(),
            isArray: false,
        },
    );

fn skipSpaces(text: Slice<u8>, pos: borrow mut usize) {
    while (pos < text.length && isTomlSpace(text[pos])) {
        pos += 1;
    }
}

fn readKey(text: Slice<u8>, pos: borrow mut usize, key: borrow mut Vector<u8>) -> bool {
    while (pos < text.length && isBareKeyByte(text[pos])) {
        match (key.push(text[pos])) {
            Ok() => {}
            Err(_) => { return false; }
        }
        pos += 1;
    }
    return key.length > 0;
}

fn readString(text: Slice<u8>, pos: borrow mut usize, out: borrow mut Vector<u8>) -> Result<bool, AllocError> {
    if (pos >= text.length || text[pos] != '"') {
        return Ok(false);
    }
    pos += 1;
    while (pos < text.length && text[pos] != '"' && text[pos] != '\n') {
        if (text[pos] == '\\' && pos + 1 < text.length) {
            pos += 1;
            let escaped = text[pos];
            out.push(if (escaped == 'n') '\n' else if (escaped == 't') '\t' else escaped)?;
        } else {
            out.push(text[pos])?;
        }
        pos += 1;
    }
    if (pos >= text.length || text[pos] != '"') {
        return Ok(false);
    }
    pos += 1;
    return Ok(true);
}

fn readValue(
    text: Slice<u8>,
    pos: borrow mut usize,
    entry: borrow mut TomlEntry,
    problem: borrow mut Vector<u8>,
) -> Result<bool, AllocError> {
    if (pos < text.length && text[pos] == '"') {
        entry.isString = true;
        if (!readString(text, pos, mut entry.text)?) {
            appendText(problem, "an unterminated string")?;
            return Ok(false);
        }
        return Ok(true);
    }
    if (pos < text.length && text[pos] == '[') {
        pos += 1;
        entry.isArray = true;
        loop {
            while (pos < text.length && (isTomlSpace(text[pos]) || text[pos] == '\n')) {
                pos += 1;
            }
            if (pos < text.length && text[pos] == ']') {
                pos += 1;
                return Ok(true);
            }
            var item = Vector<u8>.create();
            if (!readString(text, pos, mut item)?) {
                appendText(problem, "ceesafec reads arrays of strings only (ROADMAP P8)")?;
                return Ok(false);
            }
            entry.strings.push(item)?;
            while (pos < text.length && (isTomlSpace(text[pos]) || text[pos] == '\n')) {
                pos += 1;
            }
            if (pos < text.length && text[pos] == ',') {
                pos += 1;
            }
        }
    }
    let rest = text[pos..];
    if (rest.length >= 4 && sameText(rest[..4], "true")) {
        entry.isBool = true;
        entry.boolValue = true;
        pos += 4;
        return Ok(true);
    }
    if (rest.length >= 5 && sameText(rest[..5], "false")) {
        entry.isBool = true;
        pos += 5;
        return Ok(true);
    }
    // Other values (numbers, dates) are kept as text; package mode reads none of them.
    while (pos < text.length && text[pos] != '\n' && text[pos] != ',' && text[pos] != '}' && text[pos] != '#') {
        entry.text.push(text[pos])?;
        pos += 1;
    }
    return Ok(true);
}

// ---- Paths ----

/// `directory/relative`, normalised (`.` and `..` resolved); `relative` may be absolute.
fn joinPath(directory: Slice<u8>, relative: Slice<u8>) -> Result<Vector<u8>, AllocError> {
    var whole = Vector<u8>.create();
    if (relative.length == 0 || relative[0] != '/') {
        appendBytes(mut whole, directory)?;
        whole.push('/')?;
    }
    appendBytes(mut whole, relative)?;
    var parts = Vector<Vector<u8>>.create();
    var start: usize = 0;
    let bytes = whole.view();
    for (k in 0..(bytes.length + 1)) {
        if (k == bytes.length || bytes[k] == '/') {
            let part = bytes[start..k];
            if (part.length == 0 || sameText(part, ".")) {} else if (sameText(part, "..")) {
                if (parts.length > 0) {
                    parts.truncate(parts.length - 1);
                }
            } else {
                parts.push(copyBytes(part)?)?;
            }
            start = k + 1;
        }
    }
    var result = Vector<u8>.create();
    for (p in parts.view()) {
        result.push('/')?;
        appendBytes(mut result, p.view())?;
    }
    if (result.length == 0) {
        result.push('/')?;
    }
    return Ok(result);
}

fn fileExists(path: Slice<u8>) -> bool {
    let text = match (StringView.fromUtf8(path)) {
        Some(t) => t,
        null => { return false; }
    };
    return match (File.kind(text)) {
        Ok(kind) => kind != null,
        Err(_) => false,
    };
}

fn isDirectory(path: Slice<u8>) -> bool {
    let text = match (StringView.fromUtf8(path)) {
        Some(t) => t,
        null => { return false; }
    };
    return match (File.kind(text)) {
        Ok(kind) => match (kind) {
            Some(PathKind.Directory) => true,
            _ => false,
        },
        Err(_) => false,
    };
}

/// Every `*.cee` file under `directory`, absolute, recursively.
fn sourceFilesUnder(directory: Slice<u8>, out: borrow mut Vector<Vector<u8>>) -> Result<void, AllocError> {
    let text = match (StringView.fromUtf8(directory)) {
        Some(t) => t,
        null => { return Ok(); }
    };
    let names = match (Directory.list(text)) {
        Ok(n) => n,
        Err(_) => { return Ok(); }
    };
    for (k in 0..names.length) {
        let name = names[k].view().bytes();
        if (sameText(name, ".") || sameText(name, "..")) {
            continue;
        }
        let path = joinPath(directory, name)?;
        if (isDirectory(path.view())) {
            sourceFilesUnder(path.view(), out)?;
        } else if (hasSourceExtension(name)) {
            out.push(path)?;
        }
    }
    return Ok();
}

/// Byte order of two paths (the reference's ordinal comparison).
fn lessBytes(a: Slice<u8>, b: Slice<u8>) -> bool {
    let n = if (a.length < b.length) a.length else b.length;
    for (k in 0..n) {
        if (a[k] != b[k]) {
            return a[k] < b[k];
        }
    }
    return a.length < b.length;
}

/// The package's Nova sources, absolute, in ordinal order of their paths relative to the package (SourceFiles).
fn sourceFiles(manifest: borrow PackageManifest, out: borrow mut Vector<Vector<u8>>) -> Result<void, AllocError> {
    for (source in manifest.sources.view()) {
        let directory = joinPath(manifest.directory.view(), source.view())?;
        if (isDirectory(directory.view())) {
            sourceFilesUnder(directory.view(), out)?;
        }
    }
    // Paths below one directory sort as their relative paths do; insertion sort keeps it simple and deterministic.
    for (i in 1..out.length) {
        var j = i;
        while (j > 0 && lessBytes(out[j].view(), out[j - 1].view())) {
            out.swap(j, j - 1);
            j -= 1;
        }
    }
    // Distinct.
    var distinct = Vector<Vector<u8>>.create();
    for (k in 0..out.length) {
        if (k == 0 || !sameBytes(out[k].view(), out[k - 1].view())) {
            distinct.push(copyBytes(out[k].view())?)?;
        }
    }
    out.truncate(0);
    for (d in distinct.view()) {
        out.push(copyBytes(d.view())?)?;
    }
    return Ok();
}

// ---- Manifests ----

fn hasSourceExtension(name: Slice<u8>) -> bool => name.length > 4 && sameText(name[(name.length - 4)..], ".cee");

/// The manifest's file name. Nova's `nova.toml` packages are not read (Decision 0003).
fn manifestName() -> StringView => "ceesafe.toml";

fn lockName() -> StringView => "ceesafe.lock";

fn hasManifest(directory: Slice<u8>) -> Result<bool, AllocError> {
    let path = joinPath(directory, manifestName().bytes())?;
    return Ok(fileExists(path.view()));
}

/// Whether a directory holds a Nova package (`nova.toml`), which CeeSafe does not read: its messages say so.
fn hasNovaManifest(directory: Slice<u8>) -> Result<bool, AllocError> {
    let path = joinPath(directory, "nova.toml".bytes())?;
    return Ok(fileExists(path.view()));
}

/// Reads `directory/ceesafe.toml`. On failure, `problem` says why.
fn readManifest(directory: Slice<u8>, problem: borrow mut Vector<u8>) -> Result<PackageManifest?, AllocError> {
    if (!hasManifest(directory)? && hasNovaManifest(directory)?) {
        appendBytes(problem, directory)?;
        appendText(
            problem,
            " is a Nova package (nova.toml): CeeSafe reads only ceesafe.toml packages (Decision 0003)",
        )?;
        return Ok(null);
    }
    let path = joinPath(directory, manifestName().bytes())?;
    let pathText = match (StringView.fromUtf8(path.view())) {
        Some(t) => t,
        null => { return Ok(null); }
    };
    let bytes = match (readFile(pathText)) {
        Ok(b) => b,
        Err(_) => {
            appendText(problem, "cannot read ")?;
            appendBytes(problem, path.view())?;
            return Ok(null);
        }
    };
    var entries = Vector<TomlEntry>.create();
    var syntax = Vector<u8>.create();
    if (!parseToml(bytes.view(), mut entries, mut syntax)?) {
        appendBytes(problem, path.view())?;
        appendText(problem, ": ")?;
        appendBytes(problem, syntax.view())?;
        return Ok(null);
    }
    var manifest = PackageManifest {
        name: Vector<u8>.create(),
        directory: copyBytes(directory)?,
        sources: Vector<Vector<u8>>.create(),
        dependencies: Vector<PathDependency>.create(),
        freestanding: false,
        floatAllowed: true,
        kernel: false,
        trusted: false,
        object: false,
        cFiles: Vector<Vector<u8>>.create(),
    };
    var sourcesGiven = false;
    for (e in entries.view()) {
        if (sameText(e.table.view(), "package") && e.inner.length == 0) {
            let key = e.key.view();
            if (sameText(key, "name") && e.isString) {
                manifest.name = copyBytes(e.text.view())?;
            } else if (sameText(key, "profile") && e.isString) {
                manifest.freestanding = sameText(e.text.view(), "freestanding");
            } else if (sameText(key, "float") && e.isBool) {
                manifest.floatAllowed = e.boolValue;
            } else if (sameText(key, "kernel") && e.isString) {
                manifest.kernel = true;
            } else if (sameText(key, "kind") && e.isString) {
                manifest.object = sameText(e.text.view(), "object");
            } else if (sameText(key, "c") && e.isArray) {
                for (s in e.strings.view()) {
                    manifest.cFiles.push(copyBytes(s.view())?)?;
                }
            } else if (sameText(key, "trusted") && e.isBool) {
                manifest.trusted = e.boolValue;
            } else if (sameText(key, "sources") && e.isArray) {
                sourcesGiven = true;
                for (s in e.strings.view()) {
                    manifest.sources.push(copyBytes(s.view())?)?;
                }
            }
        } else if (sameText(e.table.view(), "dependencies")) {
            if (e.inner.length == 0 || !sameText(e.inner.view(), "path")) {
                appendBytes(problem, path.view())?;
                appendText(problem, ": dependency '")?;
                appendBytes(problem, e.key.view())?;
                appendText(
                    problem,
                    "' is not a path dependency; git and registry dependencies are not ported yet (ROADMAP P8)",
                )?;
                return Ok(null);
            }
            manifest.dependencies.push(
                PathDependency { name: copyBytes(e.key.view())?, path: copyBytes(e.text.view())? },
            )?;
        }
    }
    if (!sourcesGiven) {
        manifest.sources.push(copyBytes("src".bytes())?)?;
    }
    if (manifest.name.length == 0) {
        appendBytes(problem, path.view())?;
        appendText(problem, ": [package] needs a name")?;
        return Ok(null);
    }
    return Ok(manifest);
}

/// The directory of the nearest `ceesafe.toml`, here or above (Manifest.FindDirectory), or none.
fn findManifestDirectory(start: Slice<u8>) -> Result<Vector<u8>?, AllocError> {
    var directory = copyBytes(start)?;
    loop {
        if (hasManifest(directory.view())?) {
            return Ok(directory);
        }
        if (directory.length <= 1) {
            return Ok(null);
        }
        directory = joinPath(directory.view(), "..".bytes())?;
    }
}

/// The root package and its dependencies, breadth first (Workspace.ResolveAll without fetching), each with its files.
/// A dependency reached again keeps its first manifest.
fn resolvePackages(
    rootDirectory: Slice<u8>,
    out: borrow mut Vector<LoadedPackage>,
    problem: borrow mut Vector<u8>,
) -> Result<bool, AllocError> {
    let root = match (readManifest(rootDirectory, problem)?) {
        Some(m) => m,
        null => { return Ok(false); }
    };
    var queue = Vector<Vector<u8>>.create(); // directories to load, with their names alongside
    var names = Vector<Vector<u8>>.create();
    for (d in root.dependencies.view()) {
        queue.push(joinPath(root.directory.view(), d.path.view())?)?;
        names.push(copyBytes(d.name.view())?)?;
    }
    let rootName = copyBytes(root.name.view())?;
    var files = Vector<Vector<u8>>.create();
    sourceFiles(root, mut files)?;
    out.push(LoadedPackage { manifest: root, files: files })?;
    var next: usize = 0;
    while (next < queue.length) {
        let directory = copyBytes(queue[next].view())?;
        let name = copyBytes(names[next].view())?;
        next += 1;
        if (sameBytes(name.view(), rootName.view())) {
            appendText(problem, "'")?;
            appendBytes(problem, name.view())?;
            appendText(problem, "' depends on the root package: a cycle")?;
            return Ok(false);
        }
        var known = false;
        for (p in out.view()) {
            if (sameBytes(p.manifest.name.view(), name.view())) {
                known = true;
            }
        }
        if (known) {
            continue;
        }
        let manifest = match (readManifest(directory.view(), problem)?) {
            Some(m) => m,
            null => { return Ok(false); }
        };
        for (d in manifest.dependencies.view()) {
            queue.push(joinPath(manifest.directory.view(), d.path.view())?)?;
            names.push(copyBytes(d.name.view())?)?;
        }
        var dependencyFiles = Vector<Vector<u8>>.create();
        sourceFiles(manifest, mut dependencyFiles)?;
        out.push(LoadedPackage { manifest: manifest, files: dependencyFiles })?;
    }
    return Ok(true);
}
